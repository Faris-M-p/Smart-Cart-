@model InVariantUpdateView
@{
    ViewData["Title"] = "Edit variant";
    var variant = ViewBag.Variant as OutputVariantSelect;
    var variantsUrl = Url.Action("Variants", "Product", new { productId = Model.FkProduct })!;
    var returnUrl = ViewBag.ReturnUrl as string ?? variantsUrl;
    var productUrl = Url.Action("Details", "Product", new { id = Model.FkProduct })!;
    var basePrice = variant?.ProductSellingPrice ?? 0m;
    var basePriceText = basePrice.ToString("0.00", System.Globalization.CultureInfo.InvariantCulture);
    var currentPrice = basePrice + Model.AdditionalPrice;
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Catalog</span></li>
        <li class="breadcrumb-item"><a asp-controller="Product" asp-action="Index">Products</a></li>
        <li class="breadcrumb-item"><a href="@productUrl">@(variant?.ProductCode ?? "Product")</a></li>
        <li class="breadcrumb-item"><a href="@variantsUrl">Variants</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Edit variant</h1>

@if (variant is not null)
{
    <div class="alert alert-light border d-flex flex-wrap justify-content-between align-items-center gap-2">
        <div>
            <div class="fw-medium">@variant.ProductName</div>
            <div class="small text-muted">@variant.ProductCode</div>
        </div>
        <div class="text-end">
            <div class="small text-muted">Base selling price</div>
            <div class="fw-semibold">@basePrice.ToString("N2")</div>
        </div>
    </div>
}

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
        <form id="variantForm"
              asp-controller="Product"
              asp-action="EditVariant"
              asp-route-id="@Model.IdProductVariant"
              method="post"
              data-sc-ajax-form="true"
              data-base-price="@basePriceText"
              novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdProductVariant" />
            <input type="hidden" asp-for="FkProduct" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label" asp-for="VariantName"></label><span class="text-danger ms-1" aria-hidden="true">*</span>
                    <input class="form-control" asp-for="VariantName" maxlength="200" autocomplete="off" data-auto-source="VariantName" />
                    <span asp-validation-for="VariantName" class="text-danger"></span>
                    <div class="form-text">Must be unique for this product.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="SkuCode"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="SkuCode" maxlength="50" autocomplete="off" data-no-enter-submit
                               data-auto-target="SkuCode" data-auto-from="VariantName"
                               data-auto-prefix="@variant?.ProductCode" data-auto-max="50"
                               data-auto-state="persisted" data-auto-generated="false" />
                        <button type="button" class="btn btn-outline-secondary" data-auto-regenerate="SkuCode" title="Suggest a SKU" aria-label="Suggest a variant SKU">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="SkuCode" class="text-danger"></span>
                    <div class="form-text">Optional. The current SKU stays until you suggest another.</div>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="Barcode"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="Barcode" maxlength="50" autocomplete="off" data-no-enter-submit
                               data-auto-target="Barcode" data-auto-max="50"
                               data-auto-state="persisted" data-auto-generated="false" />
                        <button type="button" class="btn btn-outline-secondary" data-auto-barcode="Barcode" title="Suggest an internal barcode" aria-label="Suggest an internal barcode">
                            <i class="bi bi-upc-scan" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="Barcode" class="text-danger"></span>
                    <div class="form-text">Optional. Generate suggests an internal barcode starting with 200. It is not a manufacturer or GS1 barcode.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="AdditionalPrice"></label>
                    <input class="form-control" asp-for="AdditionalPrice" asp-format="{0:0.00}" inputmode="decimal" autocomplete="off" data-decimal="2" />
                    <span asp-validation-for="AdditionalPrice" class="text-danger"></span>
                    <div class="form-text">Added to the product's selling price. Selling price of this variant: <strong data-variant-price-preview>@currentPrice.ToString("N2")</strong></div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>
            </div>

            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" data-sc-busy-text="Saving…">Save changes</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/product/variant.js" asp-append-version="true"></script>
}
