<div class="modal fade" id="scConfirmModal" tabindex="-1" aria-labelledby="scConfirmModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header">
                <h2 class="modal-title fs-5" id="scConfirmModalLabel" data-sc-confirm-title>Confirm</h2>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" data-sc-confirm-body>Are you sure?</div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" data-sc-confirm-ok>Confirm</button>
            </div>
        </div>
    </div>
</div>
