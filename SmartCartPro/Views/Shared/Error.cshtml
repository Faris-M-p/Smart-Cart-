@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <h1 class="h4 text-danger">Something went wrong</h1>
        <p class="text-muted">An error occurred while processing your request.</p>
        @if (Model.ShowRequestId)
        {
            <p class="small"><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
    </div>
</div>
