@using SmartCartPro.Helpers
@{
    ViewData["MetisMode"] = "admin";
    var title = ViewData["Title"] as string ?? "SmartCart Pro";
    var isPlatform = AuthClaims.IsPlatformSuperAdminUser(User);
    var storeName = isPlatform ? "Platform" : (AuthClaims.GetStoreName(User) ?? "Store");
    var fkStore = AuthClaims.GetFkStore(User);
    string Nav(string ctrl, string act = "Index") =>
        string.Equals(ViewContext.RouteData.Values["controller"]?.ToString(), ctrl, StringComparison.OrdinalIgnoreCase)
        && string.Equals(ViewContext.RouteData.Values["action"]?.ToString(), act, StringComparison.OrdinalIgnoreCase)
            ? "nav-link active" : "nav-link";
}
<!DOCTYPE html>
<html lang="en" data-bs-theme="light">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <title>@title · SmartCart Pro</title>
    <meta name="theme-color" content="#2563eb" />
    <partial name="_MetisAssets" />
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />
</head>
<body data-page="dashboard" class="admin-layout">
<a href="#main-content" class="skip-link">Skip to main content</a>
<div class="admin-app">
<div class="admin-wrapper" id="admin-wrapper">

<header class="admin-header">
    <nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom">
        <div class="container-fluid">
            <div class="admin-header-start">
                <a class="navbar-brand d-flex align-items-center mb-0" asp-controller="Home" asp-action="Index">
                    <span class="h4 mb-0 fw-bold text-primary-emphasis">SmartCart</span>
                </a>
                <button class="hamburger-menu" type="button" data-sc-sidebar-toggle aria-label="Toggle sidebar" aria-expanded="true">
                    <i class="bi bi-list"></i>
                </button>
            </div>
            <div class="search-container d-none d-lg-block">
                <div class="position-relative">
                    <input type="search" class="form-control" placeholder="Search products, invoices, customers…" aria-label="Search" />
                    <i class="bi bi-search position-absolute top-50 end-0 translate-middle-y me-3"></i>
                </div>
            </div>
            <div class="admin-header-end navbar-nav flex-row align-items-center">
                <span class="badge text-bg-light border me-2 d-none d-lg-inline" title="@(isPlatform ? "platform" : $"fk_store={fkStore}")">@(isPlatform ? "Super Admin" : $"Store: {storeName}")</span>
                <a class="btn btn-outline-secondary btn-sm me-2 d-none d-md-inline-flex" asp-controller="Auth" asp-action="ChangePassword">Password</a>
                <a class="btn btn-outline-secondary btn-sm" asp-controller="Auth" asp-action="LogoutGet">Sign out</a>
            </div>
        </div>
    </nav>
</header>

<aside class="admin-sidebar" id="admin-sidebar">
    <div class="sidebar-content">
        <nav class="sidebar-nav">
            <ul class="nav flex-column">
                <li class="nav-item">
                    <a class="@Nav("Home")" asp-controller="Home" asp-action="Index">
                        <i class="bi bi-speedometer2"></i><span>Dashboard</span>
                    </a>
                </li>

                <li class="nav-item mt-2"><small class="text-muted px-3 text-uppercase fw-bold">Catalog</small></li>
                <li class="nav-item">
                    <a class="@Nav("Catalog","Categories")" asp-controller="Catalog" asp-action="Categories">
                        <i class="bi bi-folder"></i><span>Categories</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Catalog","Brands")" asp-controller="Catalog" asp-action="Brands">
                        <i class="bi bi-tags"></i><span>Brands</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Catalog","Products")" asp-controller="Catalog" asp-action="Products">
                        <i class="bi bi-box"></i><span>Products</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Catalog","Variants")" asp-controller="Catalog" asp-action="Variants">
                        <i class="bi bi-upc"></i><span>SKU / Variants</span>
                    </a>
                </li>

                <li class="nav-item mt-2"><small class="text-muted px-3 text-uppercase fw-bold">Purchase &amp; stock</small></li>
                <li class="nav-item">
                    <a class="@Nav("Inventory","Suppliers")" asp-controller="Inventory" asp-action="Suppliers">
                        <i class="bi bi-truck"></i><span>Suppliers</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Inventory","Purchases")" asp-controller="Inventory" asp-action="Purchases">
                        <i class="bi bi-file-earmark-text"></i><span>Purchases</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Inventory","Stock")" asp-controller="Inventory" asp-action="Stock">
                        <i class="bi bi-stack"></i><span>Inventory</span>
                    </a>
                </li>

                <li class="nav-item mt-2"><small class="text-muted px-3 text-uppercase fw-bold">Sales</small></li>
                <li class="nav-item">
                    <a class="@Nav("Sales","Pos")" asp-controller="Sales" asp-action="Pos">
                        <i class="bi bi-cash-register"></i><span>POS Billing</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Sales","Invoices")" asp-controller="Sales" asp-action="Invoices">
                        <i class="bi bi-receipt"></i><span>Sales invoices</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Sales","Returns")" asp-controller="Sales" asp-action="Returns">
                        <i class="bi bi-arrow-return-left"></i><span>Sales returns</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Sales","OnlineOrders")" asp-controller="Sales" asp-action="OnlineOrders">
                        <i class="bi bi-bag-check"></i><span>Online orders</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Customers")" asp-controller="Customers" asp-action="Index">
                        <i class="bi bi-people"></i><span>Customers</span>
                    </a>
                </li>

                <li class="nav-item mt-2"><small class="text-muted px-3 text-uppercase fw-bold">Reports</small></li>
                <li class="nav-item">
                    <a class="@Nav("Reports","Sales")" asp-controller="Reports" asp-action="Sales">
                        <i class="bi bi-graph-up"></i><span>Sales report</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Reports","Products")" asp-controller="Reports" asp-action="Products">
                        <i class="bi bi-bar-chart"></i><span>Product report</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Reports","Customers")" asp-controller="Reports" asp-action="Customers">
                        <i class="bi bi-person-lines-fill"></i><span>Customer report</span>
                    </a>
                </li>

                <li class="nav-item mt-2"><small class="text-muted px-3 text-uppercase fw-bold">Administration</small></li>
                <li class="nav-item">
                    <a class="@Nav("Admin","Employees")" asp-controller="Admin" asp-action="Employees">
                        <i class="bi bi-person-badge"></i><span>Employees</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Admin","Roles")" asp-controller="Admin" asp-action="Roles">
                        <i class="bi bi-shield-lock"></i><span>Roles &amp; permissions</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Company","Index")" asp-controller="Company" asp-action="Index">
                        <i class="bi bi-building"></i><span>Company</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Store","Index")" asp-controller="Store" asp-action="Index">
                        <i class="bi bi-shop"></i><span>Stores</span>
                    </a>
                </li>
                <li class="nav-item">
                    <a class="@Nav("Admin","Settings")" asp-controller="Admin" asp-action="Settings">
                        <i class="bi bi-gear"></i><span>Settings</span>
                    </a>
                </li>
            </ul>
        </nav>
    </div>
</aside>

<main class="admin-main" id="main-content">
    <div class="container-fluid py-4">
        @RenderBody()
    </div>
</main>

</div>
</div>
<script src="~/js/admin-sidebar.js" asp-append-version="true"></script>
@await RenderSectionAsync("Scripts", required: false)
</body>
</html>
