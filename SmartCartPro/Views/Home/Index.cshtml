@using SmartCartPro.Helpers
@model SmartCartPro.Models.OutputDashboardSelect
@{
    ViewData["Title"] = Model.DisplayName;
    var isSetup = Model.Mode == "setup";
}

<div class="dash-container"
     id="dashboardPage"
     data-essentials-url="@Url.Action("Essentials", "Dashboard")"
     data-adv-sales-url="@Url.Action("AdvancedSales", "Dashboard")"
     data-adv-categories-url="@Url.Action("AdvancedCategories", "Dashboard")"
     data-adv-stock-url="@Url.Action("AdvancedStock", "Dashboard")"
     data-adv-purchases-url="@Url.Action("AdvancedPurchases", "Dashboard")"
     data-adv-team-url="@Url.Action("AdvancedTeam", "Dashboard")"
     data-adv-profit-url="@Url.Action("AdvancedProfit", "Dashboard")"
     data-role="@Model.Role"
     data-can-see-profit="@Model.CanSeeProfit.ToString().ToLowerInvariant()">

    <!-- Header -->
    <div class="page-head">
        <div>
            <h1 id="pageTitle">@Model.DisplayName</h1>
            @if (isSetup)
            {
                <p id="pageSub">Create your company and first store. You will have full access once a store is selected.</p>
            }
            else
            {
                <p id="pageSub">@(string.IsNullOrWhiteSpace(Model.StoreName) ? "Store" : Model.StoreName) · @Model.Currency · @Model.TimeZoneId</p>
            }
        </div>
        @if (!isSetup)
        {
            <div class="head-tools">
                <div class="seg" role="group" aria-label="Date range" id="range">
                    <button data-r="today" class="active">Today</button>
                    <button data-r="d7">7 days</button>
                    <button data-r="d30">30 days</button>
                    <button data-r="month">This month</button>
                </div>
                <span class="updated-time" id="updated"></span>
                <button class="dash-btn" id="refresh" title="Reload live metrics">
                    <i class="bi bi-arrow-clockwise"></i>Refresh
                </button>
            </div>
        }
    </div>

    @if (isSetup)
    {
        <div class="qa mt-3">
            @foreach (var action in Model.QuickActions)
            {
                <a href="/@action.Controller/@action.Action">
                    <i class="bi bi-@action.Icon me-1"></i>@action.Title
                </a>
            }
        </div>
    }
    else
    {
        <!-- Alerts Strip -->
        <div class="alerts" id="alerts"></div>

        <!-- Quick Actions Row -->
        <div class="qa" id="qa">
            @foreach (var action in Model.QuickActions)
            {
                <a href="/@action.Controller/@action.Action">
                    <i class="bi bi-@action.Icon me-1"></i>@action.Title
                </a>
            }
        </div>

        <!-- ESSENTIAL: KPI Cards -->
        <section class="kpis @(Model.Role == "cashier" ? "k4" : "")" id="kpis" aria-label="Key figures">
            <!-- Skeletons rendered by JS on load -->
        </section>

        <!-- ESSENTIAL: Trend + Payment Modes -->
        <div class="dash-grid g-2-1">
            <div class="dash-panel">
                <div class="ph">
                    <h3 id="trendTitle">Sales trend</h3>
                    <small id="trendSub"></small>
                </div>
                <div class="dash-chart" id="trend" style="height:250px"></div>
                <div class="legend">
                    <span><i class="sw" style="background:var(--c1)"></i><span id="lgCur">This period</span></span>
                    <span><i class="sw dash"></i><span id="lgPrev">Previous period</span></span>
                </div>
            </div>
            <div class="dash-panel">
                <div class="ph">
                    <h3>Payment modes</h3>
                    <small id="payTotal"></small>
                </div>
                <div id="pay"></div>
            </div>
        </div>

        <!-- ESSENTIAL: Top 5, Low Stock, Recent Invoices -->
        <div class="dash-grid g-3">
            <div class="dash-panel" data-hide="cashier">
                <div class="ph">
                    <h3>Top 5 products</h3>
                    <a id="top5Link" href="@Url.Action("ItemSales", "Reports")">Item sales report</a>
                </div>
                <div id="top5"></div>
            </div>
            <div class="dash-panel" data-hide="cashier">
                <div class="ph">
                    <h3>Low stock</h3>
                    <a id="lowLink" href="@Url.Action("LowStock", "Inventory")">All low stock</a>
                </div>
                <div id="low"></div>
            </div>
            <div class="dash-panel" id="invPanel">
                <div class="ph">
                    <h3 id="invTitle">Recent invoices</h3>
                    <a id="invLink" href="@Url.Action("Invoices", "Sales")">All invoices</a>
                </div>
                <div id="inv"></div>
            </div>
        </div>

        <!-- ADVANCED TRIGGER BAR -->
        <div class="adv-bar" id="advBar" data-hide="cashier" @(Model.CanSeeAdvanced ? "" : "hidden")>
            <i class="bi bi-stars" style="color:var(--c1);font-size:22px"></i>
            <div class="t">
                <b>Advanced insights</b>
                <small>Hourly sales, categories, stock health, sales vs purchases, channels, cashiers@(Model.CanSeeProfit ? ", profit" : ""). Loaded only when you open it.</small>
            </div>
            <button class="dash-btn dash-btn-primary" id="advBtn" aria-expanded="false" aria-controls="advanced">
                <i class="bi bi-chevron-down"></i><span>Show advanced</span>
            </button>
        </div>

        <!-- ADVANCED INSIGHTS (Lazy-loaded via parallel AJAX) -->
        <section id="advanced" aria-label="Advanced insights">
            <h2 class="adv-title">Advanced insights <span class="badge-lazy">Loaded on demand</span></h2>
            
            <div class="dash-grid g-2">
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Hourly sales</h3>
                        <small>Peak hours · <span class="rngLbl"></span></small>
                    </div>
                    <div class="dash-chart" id="a-hourly" style="height:220px"></div>
                </div>
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Category-wise sales</h3>
                        <a href="@Url.Action("CategorySales", "Reports")">Category report</a>
                    </div>
                    <div id="a-cat"></div>
                </div>
            </div>

            <div class="dash-grid g-auto">
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Stock health</h3>
                        <small>Current stock</small>
                    </div>
                    <div id="a-stock"></div>
                </div>
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Counter vs online</h3>
                        <small class="rngLbl"></small>
                    </div>
                    <div id="a-channel"></div>
                </div>
                @if (Model.CanSeeProfit)
                {
                    <div class="dash-panel" data-only="owner">
                        <div class="ph">
                            <h3>Gross profit</h3>
                            <small class="rngLbl"></small>
                        </div>
                        <div id="a-profit"></div>
                        <div class="only-owner-note">Visible only with the “View cost and profit” permission.</div>
                    </div>
                }
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Day-of-week pattern</h3>
                        <small>Last 4 weeks</small>
                    </div>
                    <div class="dash-chart" id="a-dow" style="height:200px"></div>
                </div>
            </div>

            <div class="dash-grid g-2">
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Sales vs purchases</h3>
                        <small>Last 6 months</small>
                    </div>
                    <div class="dash-chart" id="a-svp" style="height:230px"></div>
                    <div class="legend">
                        <span><i class="sw" style="background:var(--c1)"></i>Sales</span>
                        <span><i class="sw" style="background:var(--c3)"></i>Purchases</span>
                    </div>
                </div>
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Top 10 products</h3>
                        <div class="mini-seg" id="t10seg">
                            <button data-m="rev" class="active">Revenue</button>
                            <button data-m="qty">Qty</button>
                        </div>
                    </div>
                    <div id="a-top10"></div>
                </div>
            </div>

            <div class="dash-grid g-2">
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Cashier performance</h3>
                        <small class="rngLbl"></small>
                    </div>
                    <div id="a-cashier"></div>
                </div>
                <div class="dash-panel">
                    <div class="ph">
                        <h3>Store comparison</h3>
                        <small>Shown only when company has 2+ stores</small>
                    </div>
                    <div id="a-stores"></div>
                </div>
            </div>
        </section>
    }
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/dashboard.css" asp-append-version="true" />
}

@section Scripts {
    @if (!isSetup)
    {
        <script src="~/js/dashboard/charts.js" asp-append-version="true"></script>
        <script src="~/js/dashboard/dashboard.js" asp-append-version="true"></script>
    }
}
