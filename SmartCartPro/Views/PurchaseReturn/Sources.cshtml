@model IReadOnlyList<OutputPurchaseListItem>
@{
    ViewData["Title"] = "Select Purchase to Return";
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchase Returns</a></li>
        <li class="breadcrumb-item active" aria-current="page">Select Purchase</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Select Purchase to Return</h1>
        <p class="text-muted mb-0">Returns must be linked to an approved purchase invoice.</p>
    </div>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="bi bi-arrow-left me-1"></i>Back to Returns
    </a>
</div>

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-warning mb-3">@TempData["ErrorMessage"]</div>
}

<div class="card border-0 shadow-sm mb-4">
    <div class="card-body">
        <form method="get" asp-action="Sources" class="d-flex gap-2">
            <input id="search" name="search" value="@ViewBag.Search" class="form-control" placeholder="Search by Purchase #, Invoice # or Supplier…" />
            <button type="submit" class="btn btn-primary">Search</button>
        </form>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th>Purchase #</th>
                    <th>Supplier Invoice #</th>
                    <th>Purchase Date</th>
                    <th>Supplier</th>
                    <th class="text-end">Total Amount</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Count == 0)
                {
                    <tr>
                        <td colspan="6" class="text-center py-4 text-muted">
                            No approved purchases available for return.
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var p in Model)
                    {
                        <tr>
                            <td class="fw-semibold">@p.PurchaseNumber</td>
                            <td>@(string.IsNullOrWhiteSpace(p.InvoiceNumber) ? "—" : p.InvoiceNumber)</td>
                            <td>@p.PurchaseDate.ToString("dd MMM yyyy")</td>
                            <td>@p.SupplierName</td>
                            <td class="text-end fw-semibold">₹@p.TotalAmount.ToString("N2")</td>
                            <td class="text-end">
                                <a asp-action="Create" asp-route-purchaseId="@p.IdPurchase" class="btn btn-sm btn-primary">
                                    <i class="bi bi-arrow-return-left me-1"></i>Create Return
                                </a>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>
