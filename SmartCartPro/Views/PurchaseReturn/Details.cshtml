@model OutputPurchaseReturnSelect
@{
    ViewData["Title"] = Model.ReturnNumber + " — Purchase Return";
    var canManage = await Access.CanAsync("purchasereturns.manage");
    var canPost = await Access.CanAsync("purchasereturns.post");
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchase Returns</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.ReturnNumber</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="h3 mb-0">@Model.ReturnNumber</h1>
            <span class="badge @(Model.Status == "Approved" ? "bg-success-subtle text-success" : Model.Status == "Cancelled" ? "bg-danger-subtle text-danger" : "bg-warning-subtle text-warning") fs-6">
                @Model.Status
            </span>
        </div>
        <p class="text-muted mb-0">
            @Model.SupplierName · @Model.ReturnDate.ToString("dd MMM yyyy") · @Model.StoreName
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to list
        </a>
        <button type="button" onclick="window.print()" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>Print Return Note
        </button>
        @if (canPost && Model.CanApprove)
        {
            <form asp-action="Approve" asp-route-id="@Model.IdPurchaseReturn" method="post" class="d-inline" onsubmit="return confirm('Approve this return, reduce stock from inventory, and credit supplier balance?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-success">
                    <i class="bi bi-check-circle me-1"></i>Approve &amp; Post Return
                </button>
            </form>
        }
        @if (canManage && Model.CanCancel)
        {
            <details class="d-inline-block text-start">
                <summary class="btn btn-outline-danger">Cancel Return</summary>
                <div class="p-3 border rounded bg-white shadow position-absolute mt-1 end-0" style="z-index: 100; min-width: 280px;">
                    <form asp-action="Cancel" asp-route-id="@Model.IdPurchaseReturn" method="post">
                        @Html.AntiForgeryToken()
                        <label class="form-label small fw-semibold">Cancellation Reason</label>
                        <input name="reason" class="form-control form-control-sm mb-2" required placeholder="Reason for cancelling" />
                        <button type="submit" class="btn btn-danger btn-sm w-100">Confirm Cancel</button>
                    </form>
                </div>
            </details>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Original Purchase Details</h6>
                <dl class="row small mb-0">
                    <dt class="col-4 text-muted">Purchase #</dt>
                    <dd class="col-8">
                        <a asp-controller="Purchase" asp-action="Details" asp-route-id="@Model.FkPurchase" class="fw-semibold text-decoration-none">
                            @Model.PurchaseNumber
                        </a>
                    </dd>
                    <dt class="col-4 text-muted">Supplier</dt>
                    <dd class="col-8">
                        <a asp-controller="Supplier" asp-action="Details" asp-route-id="@Model.FkSupplier" class="text-decoration-none">
                            @Model.SupplierName
                        </a>
                    </dd>
                    <dt class="col-4 text-muted">Store</dt>
                    <dd class="col-8">@Model.StoreName</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Return Information</h6>
                <dl class="row small mb-0">
                    <dt class="col-4 text-muted">Return Date</dt>
                    <dd class="col-8">@Model.ReturnDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-4 text-muted">Total Credit</dt>
                    <dd class="col-8 fw-bold fs-6 text-success">₹@Model.TotalAmount.ToString("N2")</dd>
                    <dt class="col-4 text-muted">Reason</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.Reason) ? "—" : Model.Reason)</dd>
                    <dt class="col-4 text-muted">Notes</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm mb-3">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Returned Items (@Model.Lines.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 2.5rem;">#</th>
                    <th>Product</th>
                    <th class="text-end">Quantity</th>
                    <th class="text-end">Unit Cost</th>
                    <th class="text-end">Tax Credit</th>
                    <th class="text-end">Total Credit</th>
                </tr>
            </thead>
            <tbody>
                @{ var n = 0; }
                @foreach (var line in Model.Lines)
                {
                    n++;
                    <tr>
                        <td class="text-muted">@n</td>
                        <td>
                            <div class="fw-semibold">@line.ProductName</div>
                            @if (!string.IsNullOrWhiteSpace(line.VariantName))
                            {
                                <small class="text-muted">@line.VariantName</small>
                            }
                        </td>
                        <td class="text-end fw-semibold">@line.Quantity.ToString("0.###")</td>
                        <td class="text-end">₹@line.UnitCost.ToString("N2")</td>
                        <td class="text-end">₹@line.TaxAmount.ToString("N2")</td>
                        <td class="text-end fw-bold text-success">₹@line.LineTotal.ToString("N2")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
