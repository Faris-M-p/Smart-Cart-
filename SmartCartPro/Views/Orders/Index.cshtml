@model IReadOnlyList<SmartCartPro.Entities.Order>
@{
    ViewData["Title"] = "Orders";
}
<h1>Orders</h1>
<p class="text-muted">Loaded through IOrderService → IOrderRepository (EF Core).</p>
<ul>
@foreach (var item in Model)
{
    <li>@item.OrderNumber — @item.Status — @item.TotalAmount</li>
}
</ul>
