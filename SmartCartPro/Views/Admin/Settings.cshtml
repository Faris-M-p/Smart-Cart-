@{
    ViewData["Title"] = "Settings";
}
@await Html.PartialAsync("_PageHeader", (Title: "Settings", Subtitle: "Company and store settings (from settings table)", ActionText: "", ActionUrl: ""))
<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form class="row g-3">
            <div class="col-md-6">
                <label class="form-label">POS invoice prefix</label>
                <input class="form-control" value="INV" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Currency</label>
                <input class="form-control" value="INR" />
            </div>
            <div class="col-md-6">
                <label class="form-label">Timezone</label>
                <input class="form-control" value="Asia/Kolkata" />
            </div>
            <div class="col-md-6">
                <div class="form-check mt-4">
                    <input class="form-check-input" type="checkbox" id="neg-stock" />
                    <label class="form-check-label" for="neg-stock">Allow negative stock on POS</label>
                </div>
            </div>
            <div class="col-12">
                <button type="button" class="btn btn-primary">Save settings</button>
            </div>
        </form>
    </div>
</div>
