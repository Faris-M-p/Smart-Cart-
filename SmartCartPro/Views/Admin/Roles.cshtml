        <table class="table align-middle mb-0">
            <thead><tr><th>Code</th><th>Role</th><th>System</th><th>Status</th></tr></thead>
            <tbody>
                <tr><td>SUPER_ADMIN</td><td>Super Administrator</td><td>Yes</td><td><span class="badge text-bg-success">Active</span></td></tr>
                <tr><td>STORE_MANAGER</td><td>Store Manager</td><td>Yes</td><td><span class="badge text-bg-success">Active</span></td></tr>
                <tr><td>CASHIER</td><td>Cashier</td><td>Yes</td><td><span class="badge text-bg-success">Active</span></td></tr>
                <tr><td>INVENTORY</td><td>Inventory Clerk</td><td>Yes</td><td><span class="badge text-bg-success">Active</span></td></tr>
            </tbody>
        </table>
    </div>
</div>
