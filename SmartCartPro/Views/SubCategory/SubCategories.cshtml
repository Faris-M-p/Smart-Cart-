@model OutputSubCategoryList
@{
    ViewData["Title"] = "Sub-categories";
    var canManage = await Access.CanAsync("products.manage");
    var f = Model.Filter;
    var categories = ViewBag.Categories as IReadOnlyList<OutputCategorySelect>
        ?? Array.Empty<OutputCategorySelect>();
    var currentListUrl = Context.Request.Path + Context.Request.QueryString;
    var statusValue = f.ActiveOnly is null ? "" : (f.ActiveOnly.Value ? "true" : "false");
    var hasFilters = !string.IsNullOrWhiteSpace(f.Search) || f.ActiveOnly is not null || f.FkCategory is not null;
    var setActiveUrl = Url.Action("SetSubCategoryActive", "Catalog")!;
    var addUrl = Url.Action("CreateSubCategory", "Catalog", new { fkCategory = f.FkCategory, returnUrl = currentListUrl });

    var categoryItems = new List<SelectListItem>
    {
        new("All categories", "", f.FkCategory is null)
    };
    foreach (var cat in categories)
    {
        var catLabel = cat.IsActive ? cat.CategoryName : cat.CategoryName + " (inactive)";
        categoryItems.Add(new SelectListItem(catLabel, cat.IdCategory.ToString(), f.FkCategory == cat.IdCategory));
    }

    var statusItems = new List<SelectListItem>
    {
        new("All", "", statusValue == ""),
        new("Active", "true", statusValue == "true"),
        new("Inactive", "false", statusValue == "false")
    };
    var pageSizeItems = new[] { 10, 25, 50, 100 }
        .Select(size => new SelectListItem(size.ToString(), size.ToString(), f.PageSize == size))
        .ToList();

    var pageHeader = (
        Title: "Sub-categories",
        Subtitle: "Second-level product groups, each belonging to one category",
        ActionText: canManage ? "Add sub-category" : null,
        ActionUrl: canManage ? addUrl : null);

    string SortUrl(string sortBy)
    {
        var desc = string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase) && !f.SortDesc;
        return Url.Action("SubCategories", new
        {
            FkCategory = f.FkCategory,
            Search = f.Search,
            ActiveOnly = f.ActiveOnly,
            Page = 1,
            PageSize = f.PageSize,
            SortBy = sortBy,
            SortDesc = desc
        })!;
    }

    string SortIcon(string sortBy)
    {
        if (!string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return "bi-arrow-down-up text-muted";
        return f.SortDesc ? "bi-sort-down" : "bi-sort-up";
    }

    string Truncate(string? text, int max = 80)
    {
        if (string.IsNullOrWhiteSpace(text)) return "—";
        return text.Length > max ? text[..max] + "…" : text;
    }

    var pager = new PagerViewModel
    {
        TotalCount = Model.TotalCount,
        Page = Model.Page,
        PageSize = Model.PageSize,
        Action = "SubCategories",
        RouteValues = new Dictionary<string, object?>
        {
            ["FkCategory"] = f.FkCategory,
            ["Search"] = f.Search,
            ["ActiveOnly"] = f.ActiveOnly,
            ["SortBy"] = f.SortBy,
            ["SortDesc"] = f.SortDesc
        }
    };
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Catalog</span></li>
        <li class="breadcrumb-item active" aria-current="page">Sub-categories</li>
    </ol>
</nav>

<partial name="_PageHeader" model="pageHeader" />

<div id="subCategoryListPage">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="SubCategories" class="row g-2 align-items-end mb-3">
                <div class="col-md-3">
                    <label class="form-label" for="subCategoryCategory">Category</label>
                    <select id="subCategoryCategory" name="FkCategory" class="form-select" asp-items="categoryItems" data-sc-auto-submit></select>
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="subCategorySearch">Search</label>
                    <input id="subCategorySearch" type="search" name="Search" value="@f.Search"
                           class="form-control" placeholder="Sub-category or category name" autocomplete="off" />
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="subCategoryStatus">Status</label>
                    <select id="subCategoryStatus" name="ActiveOnly" class="form-select" asp-items="statusItems" data-sc-auto-submit></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="subCategoryPageSize">Page size</label>
                    <select id="subCategoryPageSize" name="PageSize" class="form-select" asp-items="pageSizeItems" data-sc-auto-submit></select>
                </div>
                <div class="col-md-2">
                    <input type="hidden" name="SortBy" value="@f.SortBy" />
                    <input type="hidden" name="SortDesc" value="@f.SortDesc.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="Page" value="1" />
                    <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
                </div>
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    @if (hasFilters)
                    {
                        <p class="text-muted mb-3">No sub-categories match your filters.</p>
                        <a class="btn btn-outline-secondary" asp-action="SubCategories">Clear filters</a>
                    }
                    else if (canManage)
                    {
                        <p class="text-muted mb-3">No sub-categories yet.</p>
                        <a class="btn btn-primary" href="@addUrl"><i class="bi bi-plus-lg me-1"></i>Add sub-category</a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No sub-categories yet.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("categoryname")">
                                        Category <i class="bi @SortIcon("categoryname")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("subcategoryname")">
                                        Sub-category <i class="bi @SortIcon("subcategoryname")"></i>
                                    </a>
                                </th>
                                <th class="d-none d-lg-table-cell">Description</th>
                                <th class="d-none d-md-table-cell text-end">
                                    <a class="text-decoration-none text-body" href="@SortUrl("displayorder")">
                                        Order <i class="bi @SortIcon("displayorder")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("isactive")">
                                        Status <i class="bi @SortIcon("isactive")"></i>
                                    </a>
                                </th>
                                @if (canManage)
                                {
                                    <th class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var toggleVerb = item.IsActive ? "Deactivate" : "Activate";
                            var toggleTitle = toggleVerb + " sub-category";
                            var toggleClass = item.IsActive ? "btn-warning" : "btn-primary";
                            var toggleNext = (!item.IsActive).ToString().ToLowerInvariant();
                            var toggleBody = item.IsActive
                                ? "Deactivate \"" + item.SubCategoryName + "\"? It will no longer be offered when creating or editing products."
                                : "Activate \"" + item.SubCategoryName + "\"? It will be offered again on product forms.";
                            <tr>
                                <td>@item.CategoryName</td>
                                <td class="fw-medium">@item.SubCategoryName</td>
                                <td class="d-none d-lg-table-cell text-muted small">@Truncate(item.Description)</td>
                                <td class="d-none d-md-table-cell text-end">@item.DisplayOrder</td>
                                <td>
                                    <partial name="_StatusBadge" model="item.IsActive" />
                                </td>
                                @if (canManage)
                                {
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-primary me-1"
                                           asp-action="EditSubCategory"
                                           asp-route-id="@item.IdSubCategory"
                                           asp-route-returnUrl="@currentListUrl">Edit</a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-sc-post="@setActiveUrl"
                                                data-sc-param-id="@item.IdSubCategory"
                                                data-sc-param-isactive="@toggleNext"
                                                data-sc-confirm="@toggleBody"
                                                data-sc-confirm-title="@toggleTitle"
                                                data-sc-confirm-ok="@toggleVerb"
                                                data-sc-confirm-class="@toggleClass"
                                                data-sc-after="reload">@toggleVerb</button>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <partial name="_Pager" model="pager" />
            }
        </div>
    </div>
</div>

@if (canManage)
{
    <partial name="_ConfirmModal" />
}

@section Scripts {
    <script src="~/js/catalog/subcategory.js" asp-append-version="true"></script>
}
