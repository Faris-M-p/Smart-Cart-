@model InCustomerUpdateView
@{
    ViewData["Title"] = "Edit customer";
    var returnUrl = ViewBag.ReturnUrl as string
        ?? Url.Action("Index", "Customers");
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Sales</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Customers</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Edit customer</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form id="customerForm"
              asp-action="Edit"
              asp-route-id="@Model.IdCustomer"
              method="post"
              data-sc-ajax-form="true"
              novalidate>
            <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
            <input type="hidden" asp-for="IdCustomer" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="row g-3">
                <div class="col-md-8">
                    <label class="form-label" asp-for="FullName"></label>
                    <input class="form-control" asp-for="FullName" autocomplete="off" data-auto-source="FullName" />
                    <span asp-validation-for="FullName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="CustomerCode"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="CustomerCode" maxlength="20" autocomplete="off"
                               data-auto-target="CustomerCode" data-auto-from="FullName"
                               data-auto-max="20" data-auto-state="persisted" data-auto-generated="false" />
                        <button type="button" class="btn btn-outline-secondary" data-auto-regenerate="CustomerCode" title="Suggest a code" aria-label="Suggest a customer code">
                            <i class="bi bi-arrow-repeat" aria-hidden="true"></i>
                        </button>
                    </div>
                    <span asp-validation-for="CustomerCode" class="text-danger"></span>
                    <div class="form-text">Leave blank to keep the current unique code. The button suggests one from the name.</div>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="Phone"></label>
                    <input class="form-control" asp-for="Phone" type="tel" autocomplete="off" />
                    <span asp-validation-for="Phone" class="text-danger"></span>
                </div>
                <div class="col-md-5">
                    <label class="form-label" asp-for="Email"></label>
                    <input class="form-control" asp-for="Email" type="email" autocomplete="off" />
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="col-md-3 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/customers/customers.js" asp-append-version="true"></script>
}
