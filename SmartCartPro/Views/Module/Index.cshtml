@model InModuleFeatureTreeView
@{
    ViewData["Title"] = "Modules";
    var saveUrl = Url.Action("Save", "Module");
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Administration</span></li>
        <li class="breadcrumb-item active" aria-current="page">Modules</li>
    </ol>
</nav>

@await Html.PartialAsync("_PageHeader", (Title: "Modules", Subtitle: "Configure which modules, menus and individual features are available to this company.", ActionText: (string?)null, ActionUrl: (string?)null))

<div id="moduleFeaturePage" class="sc-feature-page" data-save-url="@saveUrl">
    <script type="application/json" id="moduleFeatureData">@Json.Serialize(Model)</script>

    <section class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-lg">
                    <label class="form-label" for="moduleFeatureSearch">Search modules, menus and features</label>
                    <div class="sc-feature-search" id="moduleFeatureSearchBox">
                        <i class="bi bi-search" aria-hidden="true"></i>
                        <input id="moduleFeatureSearch" type="search" class="form-control" placeholder="e.g. stock valuation, returns, reviews" autocomplete="off">
                        <button type="button" class="btn btn-sm btn-link sc-feature-clear d-none" id="moduleFeatureClear" aria-label="Clear search">
                            <i class="bi bi-x-lg" aria-hidden="true"></i>
                        </button>
                    </div>
                </div>
                <div class="col-lg-auto">
                    <div class="form-label">Preset</div>
                    <div class="btn-group sc-feature-presets" role="group" aria-label="Presets">
                        <button type="button" class="btn btn-outline-primary" data-preset="BASIC">Basic</button>
                        <button type="button" class="btn btn-outline-primary" data-preset="PREMIUM">Premium</button>
                        <button type="button" class="btn btn-outline-secondary" data-preset="CUSTOM">Custom</button>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <section class="row g-3 mb-3" id="moduleFeatureCards" aria-label="Feature summary"></section>

    <div class="sc-feature-note rounded p-3 mb-3 d-flex gap-2">
        <i class="bi bi-info-circle text-primary" aria-hidden="true"></i>
        <div>
            <strong>Core features are required and cannot be disabled.</strong>
            Feature availability is controlled by the company license. User role permissions are configured separately.
        </div>
    </div>

    <section class="card border-0 shadow-sm">
        <div class="card-body py-2 d-flex flex-wrap justify-content-between align-items-center gap-2 border-bottom">
            <div class="d-flex flex-wrap gap-2">
                <button type="button" class="btn btn-sm btn-outline-secondary" id="moduleFeatureExpand">
                    <i class="bi bi-arrows-expand me-1" aria-hidden="true"></i>Expand All
                </button>
                <button type="button" class="btn btn-sm btn-outline-secondary" id="moduleFeatureCollapse">
                    <i class="bi bi-arrows-collapse me-1" aria-hidden="true"></i>Collapse All
                </button>
                <button type="button" class="btn btn-sm btn-link" id="moduleFeatureToggle"></button>
            </div>
            <div class="small text-muted d-flex flex-wrap gap-3">
                <span><i class="bi bi-square-fill text-primary me-1" aria-hidden="true"></i>Module</span>
                <span><i class="bi bi-square-fill text-secondary me-1" aria-hidden="true"></i>Menu</span>
                <span><i class="bi bi-square text-secondary me-1" aria-hidden="true"></i>Feature / page / report</span>
            </div>
        </div>
        <div class="sc-feature-head">
            <div>Module / Feature</div>
            <div>Type</div>
            <div>Enabled</div>
        </div>
        <div id="moduleFeatureTree"></div>
    </section>
</div>

<div class="sc-feature-save" id="moduleFeatureSaveBar">
    <div class="sc-feature-status d-flex align-items-center gap-2" id="moduleFeatureStatus">
        <span class="sc-feature-pulse" aria-hidden="true"></span>
        <span data-status-text>All changes saved</span>
    </div>
    <div class="flex-grow-1"></div>
    <button type="button" class="btn btn-outline-secondary" id="moduleFeatureDiscard" disabled>Discard changes</button>
    <button type="button" class="btn btn-primary" id="moduleFeatureSave" disabled>
        <i class="bi bi-save me-1" aria-hidden="true"></i>Save Configuration
    </button>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/modules.css" asp-append-version="true" />
}

@section Scripts {
    <script src="~/js/admin/module.js" asp-append-version="true"></script>
}
