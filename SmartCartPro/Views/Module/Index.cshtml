@model InModuleAssignView
@{
    ViewData["Title"] = "Modules";
    var enabled = (Model.EnabledModuleIds ?? new List<int>()).OrderBy(x => x).ToList();
    var currentPreset = "CUSTOM";
    foreach (var preset in Model.Presets)
    {
        var ids = preset.ModuleIds.OrderBy(x => x).ToList();
        if (ids.Count == enabled.Count && ids.SequenceEqual(enabled))
        {
            currentPreset = preset.PresetCode;
            break;
        }
    }

    var applyUrl = Url.Action("ApplyPreset", "Module")!;
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Administration</span></li>
        <li class="breadcrumb-item active" aria-current="page">Modules</li>
    </ol>
</nav>

@await Html.PartialAsync("_PageHeader", (Title: "Modules", Subtitle: "Enable licensed features for this installation. Core modules from the Basic preset stay on.", ActionText: (string?)null, ActionUrl: (string?)null))

<div id="modulePage">
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div class="text-muted small mb-2">Presets</div>
            <div class="d-flex flex-wrap gap-2">
                @foreach (var preset in Model.Presets)
                {
                    var isCurrent = string.Equals(currentPreset, preset.PresetCode, StringComparison.OrdinalIgnoreCase);
                    <button type="button"
                            class="btn @(isCurrent ? "btn-primary" : "btn-outline-primary")"
                            data-sc-post="@applyUrl"
                            data-sc-param-selectedpresetcode="@preset.PresetCode"
                            data-sc-confirm="Apply the @preset.PresetName preset and save immediately? Current custom toggles will be replaced."
                            data-sc-confirm-title="Apply @preset.PresetName"
                            data-sc-confirm-ok="Apply"
                            data-sc-after="reload">
                        @preset.PresetName
                    </button>
                }
                <button type="button" class="btn @(currentPreset == "CUSTOM" ? "btn-primary" : "btn-outline-secondary")" disabled>
                    Custom
                </button>
            </div>
            <p class="small text-muted mt-3 mb-0">
                Basic and Premium come from seed data. Custom is whatever you tick below and save.
            </p>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
            <form id="moduleForm"
                  asp-action="Save"
                  method="post"
                  data-sc-ajax-form="true"
                  novalidate>
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th style="width: 3rem;"></th>
                                <th>Module</th>
                                <th class="d-none d-md-table-cell">Description</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var module in Model.AllModules)
                        {
                            var isOn = module.IsEnabled || module.IsCore;
                            <tr>
                                <td>
                                    @if (module.IsCore)
                                    {
                                        <input type="hidden" name="EnabledModuleIds" value="@module.IdModule" />
                                        <input class="form-check-input" type="checkbox" checked disabled
                                               title="Core module — stays on" />
                                    }
                                    else if (isOn)
                                    {
                                        <input class="form-check-input" type="checkbox" name="EnabledModuleIds"
                                               value="@module.IdModule" checked />
                                    }
                                    else
                                    {
                                        <input class="form-check-input" type="checkbox" name="EnabledModuleIds"
                                               value="@module.IdModule" />
                                    }
                                </td>
                                <td>
                                    <div class="fw-medium">@module.ModuleName</div>
                                    <div class="small text-muted">@module.ModuleCode
                                        @if (module.IsCore)
                                        {
                                            <span class="badge text-bg-secondary ms-1">Core</span>
                                        }
                                    </div>
                                </td>
                                <td class="d-none d-md-table-cell text-muted">@module.Description</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
                <div class="mt-4 d-flex flex-wrap gap-2">
                    <button type="submit" class="btn btn-primary">Save</button>
                </div>
            </form>
        </div>
    </div>
</div>

<partial name="_ConfirmModal" />

@section Scripts {
    <script src="~/js/admin/module.js" asp-append-version="true"></script>
}
