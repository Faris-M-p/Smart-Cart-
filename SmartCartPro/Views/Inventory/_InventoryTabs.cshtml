@* Section tabs shared by every Inventory screen. Model = the active key: stock | low | history | opening | adjust | transfer *@
@model string
@{
    var canAdjust = await Access.CanAsync("inventory.adjust");

    string Cls(string key) => string.Equals(Model, key, StringComparison.OrdinalIgnoreCase) ? "nav-link active" : "nav-link";
}
<ul class="nav nav-pills flex-wrap gap-1 mb-3" aria-label="Inventory sections">
    <li class="nav-item">
        <a class="@Cls("stock")" asp-controller="Inventory" asp-action="Stock"><i class="bi bi-stack me-1" aria-hidden="true"></i>Stock</a>
    </li>
    <li class="nav-item">
        <a class="@Cls("low")" asp-controller="Inventory" asp-action="LowStock"><i class="bi bi-exclamation-triangle me-1" aria-hidden="true"></i>Low stock</a>
    </li>
    <li class="nav-item">
        <a class="@Cls("history")" asp-controller="Inventory" asp-action="History"><i class="bi bi-clock-history me-1" aria-hidden="true"></i>Movement history</a>
    </li>
    @if (canAdjust)
    {
        <li class="nav-item">
            <a class="@Cls("opening")" asp-controller="Inventory" asp-action="Opening"><i class="bi bi-box-arrow-in-down me-1" aria-hidden="true"></i>Opening stock</a>
        </li>
        <li class="nav-item">
            <a class="@Cls("adjust")" asp-controller="Inventory" asp-action="Adjust"><i class="bi bi-sliders me-1" aria-hidden="true"></i>Adjust</a>
        </li>
        <li class="nav-item">
            <a class="@Cls("transfer")" asp-controller="Inventory" asp-action="Transfer"><i class="bi bi-arrow-left-right me-1" aria-hidden="true"></i>Transfer</a>
        </li>
    }
</ul>
