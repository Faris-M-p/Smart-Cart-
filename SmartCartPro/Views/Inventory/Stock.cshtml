@{
    ViewData["Title"] = "Inventory";
}
@await Html.PartialAsync("_PageHeader", (Title: "Inventory", Subtitle: "On-hand quantities for the active store", ActionText: "Stock adjustment", ActionUrl: "#"))
<div class="card border-0 shadow-sm">
