@model OutputPurchaseOrderSelect
@{
    ViewData["Title"] = Model.OrderNumber + " — Purchase Order Requirement";
    var canManage = await Access.CanAsync("purchaseorders.manage");
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchase Orders</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.OrderNumber</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
    <div>
        <div class="d-flex flex-wrap align-items-center gap-2">
            <h1 class="h3 mb-0">@Model.OrderNumber</h1>
            <span class="badge @(Model.Status == "Closed" ? "bg-secondary-subtle text-secondary" : "bg-primary-subtle text-primary") fs-6">
                @Model.Status
            </span>
        </div>
        <p class="text-muted mb-0">
            Internal product requirement list · @Model.OrderDate.ToString("dd MMM yyyy") · @Model.StoreName
        </p>
    </div>
    <div class="d-flex flex-wrap gap-2">
        <a asp-action="Index" class="btn btn-outline-secondary">
            <i class="bi bi-arrow-left me-1"></i>Back to List
        </a>
        <a asp-action="Print" asp-route-id="@Model.IdPurchaseOrder" target="_blank" class="btn btn-outline-secondary">
            <i class="bi bi-printer me-1"></i>Print Requirement Sheet
        </a>
        @if (canManage)
        {
            <a asp-action="Edit" asp-route-id="@Model.IdPurchaseOrder" class="btn btn-outline-primary">
                <i class="bi bi-pencil me-1"></i>Edit
            </a>
            <form asp-action="Delete" asp-route-id="@Model.IdPurchaseOrder" method="post" class="d-inline" onsubmit="return confirm('Delete this purchase order requirement?');">
                @Html.AntiForgeryToken()
                <button type="submit" class="btn btn-outline-danger">
                    <i class="bi bi-trash me-1"></i>Delete
                </button>
            </form>
        }
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Order Information</h6>
                <dl class="row small mb-0">
                    <dt class="col-4 text-muted">Order Date</dt>
                    <dd class="col-8">@Model.OrderDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-4 text-muted">Target Supplier</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.SupplierName) ? "General / Open" : Model.SupplierName)</dd>
                    <dt class="col-4 text-muted">Store</dt>
                    <dd class="col-8">@Model.StoreName</dd>
                    <dt class="col-4 text-muted">Created By</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.CreatorName) ? "Staff" : Model.CreatorName)</dd>
                </dl>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card border-0 shadow-sm h-100">
            <div class="card-body">
                <h6 class="text-muted text-uppercase small fw-semibold mb-2">Remarks &amp; Summary</h6>
                <dl class="row small mb-0">
                    <dt class="col-4 text-muted">Total Items</dt>
                    <dd class="col-8 fw-semibold">@Model.Lines.Count</dd>
                    <dt class="col-4 text-muted">Total Quantity</dt>
                    <dd class="col-8 fw-bold text-primary">@Model.Lines.Sum(l => l.Quantity).ToString("0.###")</dd>
                    <dt class="col-4 text-muted">Remarks</dt>
                    <dd class="col-8">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

<div class="card border-0 shadow-sm">
    <div class="card-header bg-white py-3">
        <h5 class="card-title mb-0">Requirement Lines (@Model.Lines.Count)</h5>
    </div>
    <div class="table-responsive">
        <table class="table align-middle mb-0">
            <thead class="table-light">
                <tr>
                    <th style="width: 40px;">#</th>
                    <th>Product</th>
                    <th class="text-end">Required Quantity</th>
                    <th class="text-end">Est. Unit Cost</th>
                    <th>Line Remark</th>
                </tr>
            </thead>
            <tbody>
                @{ var n = 0; }
                @foreach (var line in Model.Lines)
                {
                    n++;
                    <tr>
                        <td class="text-muted">@n</td>
                        <td>
                            <div class="fw-semibold">@line.ProductName</div>
                            <div class="small text-muted">
                                @if (!string.IsNullOrWhiteSpace(line.VariantName))
                                {
                                    <span>@line.VariantName</span>
                                    @if (!string.IsNullOrWhiteSpace(line.ProductCode)) { <span> · </span> }
                                }
                                @if (!string.IsNullOrWhiteSpace(line.ProductCode))
                                {
                                    <span>@line.ProductCode</span>
                                }
                            </div>
                        </td>
                        <td class="text-end fw-bold text-primary">@line.Quantity.ToString("0.###")</td>
                        <td class="text-end">@(line.UnitCost > 0 ? "₹" + line.UnitCost.ToString("N2") : "—")</td>
                        <td>@(string.IsNullOrWhiteSpace(line.Notes) ? "—" : line.Notes)</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

