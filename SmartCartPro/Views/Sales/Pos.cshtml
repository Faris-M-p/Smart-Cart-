@model SmartCartPro.Models.OutputPosSelect
@{
    ViewData["Title"] = "POS";
    var canManageCustomers = await Access.CanAsync("customers.manage") || await Access.CanAsync("pos.sell");
    var hasSession = Model.OpenSession is not null;
    var session = Model.OpenSession;
}
@section Styles {
    <link rel="stylesheet" href="~/css/pos.css" asp-append-version="true" />
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Sales</span></li>
        <li class="breadcrumb-item active" aria-current="page">POS</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">POS</h1>
        <p class="text-muted mb-0">@Model.StoreName</p>
    </div>
    <div class="d-flex flex-wrap gap-2 align-items-center">
        @if (hasSession)
        {
            <span class="badge text-bg-success-subtle text-success border">
                <i class="bi bi-cash-drawer me-1" aria-hidden="true"></i>Session open
            </span>
            <span class="small text-muted">
                <time data-sc-utc="@TimeDisplay.Iso(session!.OpenedAt)" data-sc-format="datetime">@session.OpenedAt.ToString("dd MMM yyyy HH:mm")</time>
            </span>
        }
        <a class="btn btn-outline-secondary btn-sm" asp-action="Session">
            <i class="bi bi-clock-history me-1"></i>Sessions
        </a>
        <a class="btn btn-outline-secondary btn-sm" asp-action="Invoices">
            <i class="bi bi-receipt me-1"></i>Invoices
        </a>
    </div>
</div>

@if (!hasSession)
{
    <div class="card border-0 shadow-sm" id="posOpenSessionCard">
        <div class="card-body py-4">
            <div class="text-center mb-4">
                <i class="bi bi-cash-stack display-5 text-muted" aria-hidden="true"></i>
                <h2 class="h4 mt-3">Open a cash session to start selling</h2>
                <p class="text-muted mb-0">Count the opening float and open the till. Only one session can be open for this store.</p>
            </div>
            <form id="posOpenSessionForm" method="post" asp-action="OpenSession" novalidate class="mx-auto" style="max-width: 28rem;">
                @Html.AntiForgeryToken()
                <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
                <div class="mb-3">
                    <label class="form-label" for="posOpeningFloat">Opening float</label>
                    <input id="posOpeningFloat" name="OpeningFloat" type="number" min="0" step="0.01" value="0" class="form-control form-control-lg" />
                    <span class="text-danger small" data-valmsg-for="OpeningFloat"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="posSessionNotes">Notes <span class="text-muted fw-normal">(optional)</span></label>
                    <textarea id="posSessionNotes" name="Notes" class="form-control" rows="2" maxlength="500"></textarea>
                </div>
                <button type="submit" class="btn btn-primary btn-lg w-100" data-sc-busy-text="Opening…">
                    <i class="bi bi-unlock me-1"></i>Open session
                </button>
            </form>
        </div>
    </div>
}
else
{
    <div id="posPage"
         class="pos-shell"
         data-store-id="@Model.FkStore"
         data-currency="@Model.CurrencyCode"
         data-search-url="@Url.Action("ProductSearch")"
         data-barcode-url="@Url.Action("ProductByBarcode")"
         data-create-url="@Url.Action("CreateSale")"
         data-customer-search-url="@Url.Action("Search", "Customers")"
         data-customer-create-url="@Url.Action("QuickCreate", "Customers")"
         data-print-url="@Url.Action("InvoicePrint")"
         data-can-quick-create="@canManageCustomers.ToString().ToLowerInvariant()">

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card border-0 shadow-sm mb-3">
                    <div class="card-body">
                        <label class="form-label" for="posSearch">Scan or search <span class="text-muted small">F2</span></label>
                        <div class="input-group input-group-lg">
                            <span class="input-group-text"><i class="bi bi-upc-scan" aria-hidden="true"></i></span>
                            <input id="posSearch" type="search" class="form-control" placeholder="Name, SKU or barcode — Enter to scan" autocomplete="off" autofocus />
                        </div>
                    </div>
                </div>
                <div class="card border-0 shadow-sm">
                    <div class="card-body p-0">
                        <div id="posResults" class="pos-results" role="listbox" aria-label="Search results"></div>
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <div class="card border-0 shadow-sm pos-bill">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label" for="posCustomer">Customer</label>
                            <div class="input-group">
                                <input id="posCustomer" type="search" class="form-control" placeholder="Walk-in — type a name or phone" autocomplete="off" />
                                @if (canManageCustomers)
                                {
                                    <button type="button" class="btn btn-outline-secondary" id="posCustomerAdd" title="Quick create">
                                        <i class="bi bi-person-plus" aria-hidden="true"></i>
                                    </button>
                                }
                                <button type="button" class="btn btn-outline-secondary" id="posCustomerClear" title="Walk-in">
                                    <i class="bi bi-x-lg" aria-hidden="true"></i>
                                </button>
                            </div>
                            <div class="small text-muted mt-1" id="posCustomerLabel">Walk-in</div>
                        </div>

                        <div class="table-responsive pos-cart-wrap mb-3">
                            <table class="table align-middle mb-0">
                                <thead>
                                    <tr>
                                        <th>Item</th>
                                        <th class="text-end" style="width: 5.5rem;">Qty</th>
                                        <th class="text-end" style="width: 5.5rem;">Disc.</th>
                                        <th class="text-end">Total</th>
                                        <th class="text-end" style="width: 2rem;"></th>
                                    </tr>
                                </thead>
                                <tbody id="posCartBody"></tbody>
                            </table>
                            <div id="posCartEmpty" class="text-center text-muted py-4">
                                Scan a product or pick one from the list.
                            </div>
                        </div>

                        <dl class="row mb-3 pos-totals">
                            <dt class="col-6">Subtotal</dt>
                            <dd class="col-6 text-end" id="posSubtotal">0.00</dd>
                            <dt class="col-6">Discount</dt>
                            <dd class="col-6 text-end" id="posDiscount">0.00</dd>
                            <dt class="col-6">Tax</dt>
                            <dd class="col-6 text-end" id="posTax">0.00</dd>
                            <dt class="col-6 fs-5">Total</dt>
                            <dd class="col-6 text-end fs-5 fw-semibold" id="posTotal">0.00</dd>
                        </dl>

                        <div class="mb-3">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <label class="form-label mb-0">Payments</label>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="posAddPayment">
                                    <i class="bi bi-plus-lg me-1"></i>Add
                                </button>
                            </div>
                            <div id="posPayments"></div>
                            <div class="d-flex justify-content-between small mt-2">
                                <span class="text-muted">Paid / due</span>
                                <span><span id="posPaid">0.00</span> / <span id="posDue">0.00</span></span>
                            </div>
                            <div class="d-flex justify-content-between small" id="posChangeRow">
                                <span class="text-muted">Change (cash)</span>
                                <span id="posChange">0.00</span>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label" for="posNotes">Notes</label>
                            <textarea id="posNotes" class="form-control" rows="2" maxlength="500"></textarea>
                        </div>

                        <div class="d-grid">
                            <button type="button" class="btn btn-success btn-lg" id="posComplete" data-sc-busy-text="Completing…">
                                Complete sale <span class="small opacity-75">F9</span>
                            </button>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div id="posSuccessModal" class="sc-modal d-none" hidden>
        <div class="sc-modal-dialog">
            <div class="sc-modal-content">
                <h2 class="h5 mb-2">Sale completed</h2>
                <p class="mb-1">Invoice <strong id="posSuccessInvoice"></strong></p>
                <p class="mb-3">Total <strong id="posSuccessTotal"></strong> · Change <strong id="posSuccessChange"></strong></p>
                <div class="d-flex flex-wrap gap-2">
                    <a class="btn btn-primary" id="posSuccessPrint" href="#" target="_blank" rel="noopener">
                        <i class="bi bi-printer me-1"></i>Print
                    </a>
                    <button type="button" class="btn btn-outline-secondary" id="posSuccessNew">New sale</button>
                </div>
            </div>
        </div>
    </div>

    <div id="posQuickCreateModal" class="sc-modal d-none" hidden>
        <div class="sc-modal-dialog">
            <form id="posQuickCreateForm" class="sc-modal-content" novalidate>
                <h2 class="h5 mb-3">Quick customer</h2>
                <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
                <div class="mb-2">
                    <label class="form-label" for="qcFullName">Full name</label>
                    <input id="qcFullName" name="FullName" class="form-control" maxlength="150" required />
                    <span class="text-danger small" data-valmsg-for="FullName"></span>
                </div>
                <div class="mb-2">
                    <label class="form-label" for="qcPhone">Phone</label>
                    <input id="qcPhone" name="Phone" class="form-control" maxlength="30" />
                    <span class="text-danger small" data-valmsg-for="Phone"></span>
                </div>
                <div class="mb-3">
                    <label class="form-label" for="qcEmail">Email</label>
                    <input id="qcEmail" name="Email" type="email" class="form-control" maxlength="150" />
                    <span class="text-danger small" data-valmsg-for="Email"></span>
                </div>
                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" data-sc-busy-text="Saving…">Save</button>
                    <button type="button" class="btn btn-outline-secondary" id="posQuickCreateCancel">Cancel</button>
                </div>
            </form>
        </div>
    </div>
}

@section Scripts {
    <script src="~/js/sales/pos-cart.js" asp-append-version="true"></script>
    <script src="~/js/sales/pos.js" asp-append-version="true"></script>
}
