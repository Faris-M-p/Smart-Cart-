@using System.Globalization
@model SmartCartPro.Models.OutputSaleList
@{
    ViewData["Title"] = "Invoices";
    var canSell = await Access.CanAsync("pos.sell");
    var f = Model.Filter ?? new SmartCartPro.Models.InputSaleList();
    var fromText = f.From?.ToString("yyyy-MM-dd");
    var toText = f.To?.ToString("yyyy-MM-dd");
    var customerId = f.CustomerId ?? f.FkCustomer;
    var hasFilter = !string.IsNullOrWhiteSpace(f.Search)
                    || !string.IsNullOrWhiteSpace(f.Status)
                    || !string.IsNullOrWhiteSpace(f.PaymentMethod)
                    || customerId is not null
                    || f.From is not null
                    || f.To is not null;

    string Money(decimal value) => value.ToString("N2");
    string Raw(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);

    string SortUrl(string sortBy)
    {
        var desc = string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase) && !f.SortDesc;
        return Url.Action("Invoices", new
        {
            Search = f.Search,
            Status = f.Status,
            PaymentMethod = f.PaymentMethod,
            CustomerId = customerId,
            From = fromText,
            To = toText,
            Page = 1,
            PageSize = f.PageSize,
            SortBy = sortBy,
            SortDesc = desc
        })!;
    }

    string SortIcon(string sortBy)
    {
        if (!string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return "bi-arrow-down-up text-muted";
        return f.SortDesc ? "bi-sort-down" : "bi-sort-up";
    }

    var pager = new SmartCartPro.Models.PagerViewModel
    {
        TotalCount = Model.TotalCount,
        Page = Model.Page,
        PageSize = Model.PageSize,
        Action = "Invoices",
        RouteValues = new Dictionary<string, object?>
        {
            ["Search"] = f.Search,
            ["Status"] = f.Status,
            ["PaymentMethod"] = f.PaymentMethod,
            ["CustomerId"] = customerId,
            ["From"] = fromText,
            ["To"] = toText,
            ["PageSize"] = f.PageSize,
            ["SortBy"] = f.SortBy,
            ["SortDesc"] = f.SortDesc
        }
    };
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Sales</span></li>
        <li class="breadcrumb-item active" aria-current="page">Invoices</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Invoices</h1>
        <p class="text-muted mb-0">POS sales for this store</p>
    </div>
    @if (canSell)
    {
        <a class="btn btn-primary" asp-action="Pos">
            <i class="bi bi-plus-lg me-1"></i>New sale
        </a>
    }
</div>

<div id="invoiceListPage">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Invoices" class="row g-2 align-items-end mb-3">
                <div class="col-lg-3 col-md-6">
                    <label class="form-label" for="invoiceSearch">Search</label>
                    <input id="invoiceSearch" type="search" name="Search" value="@f.Search"
                           class="form-control" placeholder="Invoice #, customer or phone" autocomplete="off" />
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label" for="invoiceStatus">Status</label>
                    <select id="invoiceStatus" name="Status" class="form-select" data-sc-auto-submit>
                        @if (string.IsNullOrEmpty(f.Status))
                        { <option value="" selected>All statuses</option> }
                        else
                        { <option value="">All statuses</option> }
                        @if (f.Status == "completed")
                        { <option value="completed" selected>Completed</option> }
                        else
                        { <option value="completed">Completed</option> }
                        @if (f.Status == "cancelled")
                        { <option value="cancelled" selected>Cancelled</option> }
                        else
                        { <option value="cancelled">Cancelled</option> }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label" for="invoicePay">Payment</label>
                    <select id="invoicePay" name="PaymentMethod" class="form-select" data-sc-auto-submit>
                        @if (string.IsNullOrEmpty(f.PaymentMethod))
                        { <option value="" selected>All methods</option> }
                        else
                        { <option value="">All methods</option> }
                        @foreach (var method in new[] { "cash", "card", "upi", "wallet", "bank", "other" })
                        {
                            var label = char.ToUpperInvariant(method[0]) + method[1..];
                            if (f.PaymentMethod == method)
                            { <option value="@method" selected>@label</option> }
                            else
                            { <option value="@method">@label</option> }
                        }
                    </select>
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label" for="invoiceFrom">From</label>
                    <input id="invoiceFrom" type="date" name="From" value="@fromText" class="form-control" />
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label" for="invoiceTo">To</label>
                    <input id="invoiceTo" type="date" name="To" value="@toText" class="form-control" />
                </div>
                <div class="col-lg-2 col-md-4 col-6">
                    <label class="form-label" for="invoicePageSize">Page size</label>
                    <select id="invoicePageSize" name="PageSize" class="form-select" data-sc-auto-submit>
                        @foreach (var size in new[] { 10, 25, 50, 100 })
                        {
                            if (f.PageSize == size)
                            { <option value="@size" selected>@size</option> }
                            else
                            { <option value="@size">@size</option> }
                        }
                    </select>
                </div>
                <div class="col-lg-3 col-md-4 d-flex gap-2">
                    @if (customerId is int cid)
                    {
                        <input type="hidden" name="customerId" value="@cid" />
                    }
                    <input type="hidden" name="SortBy" value="@f.SortBy" />
                    <input type="hidden" name="SortDesc" value="@f.SortDesc.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="Page" value="1" />
                    <button type="submit" class="btn btn-outline-primary flex-grow-1">Apply</button>
                    @if (hasFilter)
                    {
                        <a class="btn btn-outline-secondary" asp-action="Invoices">Clear</a>
                    }
                </div>
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    <i class="bi bi-receipt display-5 text-muted" aria-hidden="true"></i>
                    @if (hasFilter)
                    {
                        <p class="text-muted my-3">No invoices match your filters.</p>
                        <a class="btn btn-outline-secondary" asp-action="Invoices">Clear filters</a>
                    }
                    else
                    {
                        <p class="text-muted my-3">No invoices yet.</p>
                        @if (canSell)
                        {
                            <a class="btn btn-primary" asp-action="Pos">
                                <i class="bi bi-plus-lg me-1"></i>New sale
                            </a>
                        }
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("invoicenumber")">
                                        Invoice <i class="bi @SortIcon("invoicenumber")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("saledate")">
                                        Date <i class="bi @SortIcon("saledate")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("customer")">
                                        Customer <i class="bi @SortIcon("customer")"></i>
                                    </a>
                                </th>
                                <th class="text-end">
                                    <a class="text-decoration-none text-body" href="@SortUrl("totalamount")">
                                        Total <i class="bi @SortIcon("totalamount")"></i>
                                    </a>
                                </th>
                                <th class="text-end d-none d-md-table-cell">
                                    <a class="text-decoration-none text-body" href="@SortUrl("paidamount")">
                                        Paid <i class="bi @SortIcon("paidamount")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("status")">
                                        Status <i class="bi @SortIcon("status")"></i>
                                    </a>
                                </th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            <tr class="@(item.Status == "cancelled" ? "text-muted" : null)">
                                <td class="fw-medium text-nowrap">
                                    <a class="text-decoration-none" asp-action="InvoiceDetails" asp-route-id="@item.IdSale">@item.InvoiceNumber</a>
                                </td>
                                <td class="text-nowrap">
                                    <time data-sc-utc="@TimeDisplay.Iso(item.SaleDate)" data-sc-format="datetime">@item.SaleDate.ToString("dd MMM yyyy HH:mm")</time>
                                </td>
                                <td>@(string.IsNullOrWhiteSpace(item.CustomerName) ? "Walk-in" : item.CustomerName)</td>
                                <td class="text-end text-nowrap"><span data-sc-money="@Raw(item.TotalAmount)">@Money(item.TotalAmount)</span></td>
                                <td class="text-end text-nowrap d-none d-md-table-cell"><span data-sc-money="@Raw(item.PaidAmount)">@Money(item.PaidAmount)</span></td>
                                <td><partial name="_InvoiceStatusBadge" model="item.Status" /></td>
                                <td class="text-end text-nowrap">
                                    <a class="btn btn-sm btn-outline-primary" asp-action="InvoiceDetails" asp-route-id="@item.IdSale" title="View">
                                        <i class="bi bi-eye" aria-hidden="true"></i><span class="visually-hidden">View</span>
                                    </a>
                                    <a class="btn btn-sm btn-outline-secondary ms-1" asp-action="InvoicePrint" asp-route-id="@item.IdSale" target="_blank" rel="noopener" title="Print">
                                        <i class="bi bi-printer" aria-hidden="true"></i><span class="visually-hidden">Print</span>
                                    </a>
                                </td>
                            </tr>
                        }
                        </tbody>
                        <tfoot>
                            <tr class="fw-semibold">
                                <td colspan="3">Page totals</td>
                                <td class="text-end"><span data-sc-money="@Raw(Model.PageTotalAmount)">@Money(Model.PageTotalAmount)</span></td>
                                <td class="text-end d-none d-md-table-cell"><span data-sc-money="@Raw(Model.PagePaidAmount)">@Money(Model.PagePaidAmount)</span></td>
                                <td colspan="2"></td>
                            </tr>
                        </tfoot>
                    </table>
                </div>
                <partial name="_Pager" model="pager" />
            }
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/sales/invoices.js" asp-append-version="true"></script>
}
