@using SmartCartPro.Helpers
@model SmartCartPro.Models.InPurchaseCreateView
@{
    ViewData["Title"] = "New Purchase";
    var suppliers = ViewBag.Suppliers as IReadOnlyList<SmartCartPro.Models.OutputSupplierSelect>
                    ?? new List<SmartCartPro.Models.OutputSupplierSelect>();
    var supplierItems = suppliers
        .Select(s => new SelectListItem(s.SupplierName, s.IdSupplier.ToString()))
        .ToList();
    var storeName = AuthClaims.GetStoreName(User) ?? "your store";
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
        <li class="breadcrumb-item active" aria-current="page">New</li>
    </ol>
</nav>
<h1 class="h3 mb-1">New Purchase</h1>
<p class="text-muted mb-3">Record purchase invoice and stock arrival into <strong>@storeName</strong>.</p>

<div id="purchaseFormPage"
     data-mode="create"
     data-status="new"
     data-submit-url="@Url.Action("Create")"
     data-lookup-url="@Url.Action("ProductLookup")"
     data-supplier-balance-url="@Url.Action("SupplierBalance")"
     data-lines="[]">
    <form id="purchaseForm" novalidate>
        <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
        @Html.AntiForgeryToken()

        <div class="card border-0 shadow-sm mb-3">
            <div class="card-body">
                <div class="row g-3">
                    <div class="col-md-4">
                        <label class="form-label fw-semibold" asp-for="FkSupplier"></label>
                        <select class="form-select" asp-for="FkSupplier" asp-items="supplierItems" id="supplierSelect">
                            <option value="0">Select supplier…</option>
                        </select>
                        <span asp-validation-for="FkSupplier" class="text-danger small"></span>
                        
                        <!-- Supplier Balance Badge / Card -->
                        <div id="supplierBalanceBox" class="mt-2 p-2 rounded bg-light border d-none small">
                            <span class="text-muted">Current Balance: </span>
                            <span id="supplierBalanceAmount" class="fw-bold"></span>
                            <span id="supplierBalanceNote" class="badge ms-1"></span>
                        </div>

                        @if (suppliers.Count == 0)
                        {
                            <div class="form-text text-warning">
                                No active suppliers yet. <a asp-controller="Supplier" asp-action="Create">Add a supplier</a> first.
                            </div>
                        }
                    </div>

                    <div class="col-md-2">
                        <label class="form-label fw-semibold" asp-for="PurchaseDate"></label>
                        <input class="form-control" asp-for="PurchaseDate" type="date" />
                        <span asp-validation-for="PurchaseDate" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="InvoiceNumber"></label>
                        <input class="form-control" asp-for="InvoiceNumber" autocomplete="off" placeholder="Supplier Invoice #" required />
                        <span asp-validation-for="InvoiceNumber" class="text-danger small"></span>
                    </div>

                    <div class="col-md-3">
                        <label class="form-label fw-semibold" asp-for="InvoiceDate"></label>
                        <input class="form-control" asp-for="InvoiceDate" type="date" />
                        <span asp-validation-for="InvoiceDate" class="text-danger small"></span>
                    </div>

                    <!-- Approval & Immediate Payment Section -->
                    <div class="col-12 border-top pt-3">
                        <div class="row g-3 align-items-center">
                            <div class="col-md-4">
                                <div class="form-check form-switch">
                                    <input class="form-check-input" type="checkbox" asp-for="MarkAsApproved" id="markAsApprovedSwitch" checked>
                                    <label class="form-check-label fw-semibold" for="markAsApprovedSwitch">
                                        Mark as Approved
                                    </label>
                                </div>
                                <div class="form-text small">Immediately adds items to stock and posts to ledger.</div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" asp-for="AmountPaid">Immediate Payment (₹)</label>
                                <input class="form-control form-control-sm" asp-for="AmountPaid" type="number" step="0.01" min="0" placeholder="0.00" />
                                <span asp-validation-for="AmountPaid" class="text-danger small"></span>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label small fw-semibold" asp-for="PaymentMethod">Payment Method</label>
                                <select class="form-select form-select-sm" asp-for="PaymentMethod">
                                    <option value="Cash">Cash</option>
                                    <option value="Bank Transfer">Bank Transfer</option>
                                    <option value="UPI">UPI</option>
                                    <option value="Cheque">Cheque</option>
                                    <option value="Card">Card</option>
                                    <option value="Other">Other</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <div class="col-12 border-top pt-2">
                        <label class="form-label small fw-semibold" asp-for="Notes"></label>
                        <textarea class="form-control form-control-sm" asp-for="Notes" rows="2" placeholder="Optional purchase notes"></textarea>
                        <span asp-validation-for="Notes" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_PurchaseLines" />

        <div class="d-flex flex-wrap gap-2 mt-3">
            <button type="button" class="btn btn-primary" data-save="approve" data-sc-busy-text="Saving…">
                <i class="bi bi-check2-circle me-1"></i> Save as Approved
            </button>
            <button type="button" class="btn btn-outline-primary" data-save="pending" data-sc-busy-text="Saving…">
                <i class="bi bi-clock me-1"></i> Save as Pending
            </button>
            <a class="btn btn-outline-secondary" asp-action="Index">Cancel</a>
        </div>
    </form>
</div>

@section Scripts {
    <script src="~/js/purchasing/purchase-form.js" asp-append-version="true"></script>
}
