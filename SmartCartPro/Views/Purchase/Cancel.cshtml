@using System.Globalization
@model SmartCartPro.Models.OutputPurchaseSelect
@{
    ViewData["Title"] = "Cancel " + Model.PurchaseNumber;

    string Money(decimal value) => value.ToString("N2");
    string Raw(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
        <li class="breadcrumb-item"><a asp-action="Details" asp-route-id="@Model.IdPurchase">@Model.PurchaseNumber</a></li>
        <li class="breadcrumb-item active" aria-current="page">Cancel</li>
    </ol>
</nav>
<div class="d-flex flex-wrap align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">Cancel @Model.PurchaseNumber</h1>
    <partial name="_PurchaseStatusBadge" model="Model.Status" />
</div>

<div class="row">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <dl class="row mb-3">
                    <dt class="col-sm-4 fw-normal text-muted">Supplier</dt>
                    <dd class="col-sm-8">@Model.SupplierName</dd>
                    <dt class="col-sm-4 fw-normal text-muted">Purchase Date</dt>
                    <dd class="col-sm-8">@Model.PurchaseDate.ToString("dd MMM yyyy")</dd>
                    <dt class="col-sm-4 fw-normal text-muted">Invoice #</dt>
                    <dd class="col-sm-8">@(string.IsNullOrWhiteSpace(Model.InvoiceNumber) ? "—" : Model.InvoiceNumber)</dd>
                    <dt class="col-sm-4 fw-normal text-muted">Total Amount</dt>
                    <dd class="col-sm-8"><span data-sc-money="@Raw(Model.TotalAmount)">₹@Money(Model.TotalAmount)</span></dd>
                </dl>

                <div class="alert alert-warning" role="alert">
                    Cancelling a pending purchase will permanently drop it. Once cancelled, it cannot be edited, approved, or reopened.
                </div>

                <form id="purchaseCancelForm" asp-action="Cancel" asp-route-id="@Model.IdPurchase" method="post">
                    @Html.AntiForgeryToken()
                    <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>

                    <div class="mb-3">
                        <label class="form-label" for="cancelReason">Reason for cancellation</label>
                        <textarea id="cancelReason" name="Reason" class="form-control" rows="3"
                                  placeholder="Explain why this purchase is being cancelled…"
                                  required minlength="2" maxlength="500"></textarea>
                        <span class="text-danger small" data-valmsg-for="Reason"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-danger" data-sc-busy-text="Cancelling…">
                            Cancel Purchase
                        </button>
                        <a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.IdPurchase">
                            Back
                        </a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="~/js/purchasing/purchase.js" asp-append-version="true"></script>
}
