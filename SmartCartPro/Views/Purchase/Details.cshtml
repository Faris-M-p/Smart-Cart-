@using System.Globalization
@model SmartCartPro.Models.OutputPurchaseSelect
@{
    ViewData["Title"] = Model.PurchaseNumber;
    var canManage = await Access.CanAsync("purchases.manage");
    var notice = ViewBag.Notice as string;

    string Money(decimal value) => value.ToString("N2");
    string Raw(decimal value) => value.ToString("0.####", CultureInfo.InvariantCulture);
    string Qty(decimal value) => value.ToString("0.###");
    string Utc(DateTime value) =>
        DateTime.SpecifyKind(value, DateTimeKind.Utc).ToString("yyyy-MM-dd'T'HH:mm:ss'Z'", CultureInfo.InvariantCulture);
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Purchase &amp; stock</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Purchases</a></li>
        <li class="breadcrumb-item active" aria-current="page">@Model.PurchaseNumber</li>
    </ol>
</nav>

<div id="purchaseDetailsPage">
    <div class="d-flex flex-wrap justify-content-between align-items-start gap-2 mb-3">
        <div>
            <div class="d-flex flex-wrap align-items-center gap-2">
                <h1 class="h3 mb-0">@Model.PurchaseNumber</h1>
                <partial name="_PurchaseStatusBadge" model="Model.Status" />
            </div>
            <p class="text-muted mb-0">
                @Model.SupplierName · @Model.PurchaseDate.ToString("dd MMM yyyy") · @Model.StoreName
            </p>
        </div>
        <div class="d-flex flex-wrap gap-2">
            <a class="btn btn-outline-secondary" asp-action="Index">
                <i class="bi bi-arrow-left me-1"></i>Back to list
            </a>
            <a class="btn btn-outline-secondary" asp-action="Print" asp-route-id="@Model.IdPurchase" target="_blank" rel="noopener">
                <i class="bi bi-printer me-1"></i>Print
            </a>
            @if (canManage && Model.CanApprove)
            {
                <form asp-action="Approve" asp-route-id="@Model.IdPurchase" method="post" class="d-inline" onsubmit="return confirm('Approve purchase and add products into inventory?');">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="btn btn-success">
                        <i class="bi bi-check-circle me-1"></i>Approve into Stock
                    </button>
                </form>
            }
            @if (canManage && Model.CanEdit)
            {
                <a class="btn btn-outline-primary" asp-action="Edit" asp-route-id="@Model.IdPurchase">
                    <i class="bi bi-pencil me-1"></i>Edit
                </a>
            }
            @if (canManage && Model.CanReturn)
            {
                <a class="btn btn-warning" asp-controller="PurchaseReturn" asp-action="Create" asp-route-purchaseId="@Model.IdPurchase">
                    <i class="bi bi-arrow-return-left me-1"></i>Return to Supplier
                </a>
            }
            @if (canManage && Model.CanCancel)
            {
                <a class="btn btn-outline-danger" asp-action="Cancel" asp-route-id="@Model.IdPurchase">
                    <i class="bi bi-x-circle me-1"></i>Cancel Purchase
                </a>
            }
        </div>
    </div>

    @if (!string.IsNullOrWhiteSpace(notice))
    {
        <div class="alert alert-warning" role="alert">@notice</div>
    }

    @if (Model.Cancelled)
    {
        <div class="alert alert-danger" role="alert">
            <strong>Cancelled</strong>
            @if (Model.CancelledOn is not null)
            {
                <span> on <time data-sc-local-datetime datetime="@Utc(Model.CancelledOn.Value)">@Model.CancelledOn.Value.ToString("dd MMM yyyy HH:mm") UTC</time></span>
            }
            @if (!string.IsNullOrWhiteSpace(Model.CancelledReason))
            {
                <div class="mt-1">Reason: @Model.CancelledReason</div>
            }
        </div>
    }
    else if (Model.Status == "Pending")
    {
        <div class="alert alert-info" role="alert">
            This purchase is pending approval. Review the lines and click <strong>Approve into Stock</strong> to update inventory and post to the supplier ledger.
        </div>
    }

    <div class="row g-3 mb-3">
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted text-uppercase mb-3">Supplier</h2>
                    <div class="fw-semibold">
                        <a asp-controller="Supplier" asp-action="Details" asp-route-id="@Model.FkSupplier" class="text-decoration-none">
                            @Model.SupplierName
                        </a>
                    </div>
                    @if (!string.IsNullOrWhiteSpace(Model.SupplierCode))
                    {
                        <div class="text-muted small">Code: @Model.SupplierCode</div>
                    }
                    <dl class="row small mb-0 mt-2">
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierPhone))
                        {
                            <dt class="col-4 fw-normal text-muted">Phone</dt>
                            <dd class="col-8 mb-1">@Model.SupplierPhone</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierEmail))
                        {
                            <dt class="col-4 fw-normal text-muted">Email</dt>
                            <dd class="col-8 mb-1 text-break">@Model.SupplierEmail</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierTaxNumber))
                        {
                            <dt class="col-4 fw-normal text-muted">Tax no.</dt>
                            <dd class="col-8 mb-1">@Model.SupplierTaxNumber</dd>
                        }
                        @if (!string.IsNullOrWhiteSpace(Model.SupplierAddress))
                        {
                            <dt class="col-4 fw-normal text-muted">Address</dt>
                            <dd class="col-8 mb-1">@Model.SupplierAddress</dd>
                        }
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted text-uppercase mb-3">Invoice Details</h2>
                    <dl class="row small mb-0">
                        <dt class="col-5 fw-normal text-muted">Invoice #</dt>
                        <dd class="col-7 mb-1 fw-semibold">@(string.IsNullOrWhiteSpace(Model.InvoiceNumber) ? "—" : Model.InvoiceNumber)</dd>
                        <dt class="col-5 fw-normal text-muted">Invoice Date</dt>
                        <dd class="col-7 mb-1">@(Model.InvoiceDate?.ToString("dd MMM yyyy") ?? Model.PurchaseDate.ToString("dd MMM yyyy"))</dd>
                        <dt class="col-5 fw-normal text-muted">Purchase Date</dt>
                        <dd class="col-7 mb-1">@Model.PurchaseDate.ToString("dd MMM yyyy")</dd>
                        <dt class="col-5 fw-normal text-muted">Store</dt>
                        <dd class="col-7 mb-1">@Model.StoreName</dd>
                        <dt class="col-5 fw-normal text-muted">Created</dt>
                        <dd class="col-7 mb-1"><time data-sc-local-datetime datetime="@Utc(Model.CreatedAt)">@Model.CreatedAt.ToString("dd MMM yyyy HH:mm") UTC</time></dd>
                        @if (Model.ApprovedAt is not null)
                        {
                            <dt class="col-5 fw-normal text-muted text-success">Approved</dt>
                            <dd class="col-7 mb-1 text-success"><time data-sc-local-datetime datetime="@Utc(Model.ApprovedAt.Value)">@Model.ApprovedAt.Value.ToString("dd MMM yyyy HH:mm") UTC</time></dd>
                        }
                        <dt class="col-5 fw-normal text-muted">Notes</dt>
                        <dd class="col-7 mb-0 text-break">@(string.IsNullOrWhiteSpace(Model.Notes) ? "—" : Model.Notes)</dd>
                    </dl>
                </div>
            </div>
        </div>

        <div class="col-lg-4">
            <div class="card border-0 shadow-sm h-100">
                <div class="card-body">
                    <h2 class="h6 text-muted text-uppercase mb-3">Totals &amp; Settlement</h2>
                    <dl class="row mb-0">
                        <dt class="col-6 fw-normal text-muted">Subtotal</dt>
                        <dd class="col-6 text-end mb-1"><span data-sc-money="@Raw(Model.SubTotal)">₹@Money(Model.SubTotal)</span></dd>
                        <dt class="col-6 fw-normal text-muted">Discount</dt>
                        <dd class="col-6 text-end mb-1"><span data-sc-money="@Raw(Model.DiscountAmount)">₹@Money(Model.DiscountAmount)</span></dd>
                        <dt class="col-6 fw-normal text-muted">Tax</dt>
                        <dd class="col-6 text-end mb-1"><span data-sc-money="@Raw(Model.TaxAmount)">₹@Money(Model.TaxAmount)</span></dd>
                        @if (Model.Charges > 0)
                        {
                            <dt class="col-6 fw-normal text-muted">Charges</dt>
                            <dd class="col-6 text-end mb-1"><span data-sc-money="@Raw(Model.Charges)">₹@Money(Model.Charges)</span></dd>
                        }
                        <dt class="col-6 border-top pt-2">Total Amount</dt>
                        <dd class="col-6 text-end border-top pt-2 mb-1 fw-bold fs-5 text-primary"><span data-sc-money="@Raw(Model.TotalAmount)">₹@Money(Model.TotalAmount)</span></dd>
                        <dt class="col-6 fw-normal text-muted small border-top pt-2">Amount Paid</dt>
                        <dd class="col-6 text-end small mb-0 border-top pt-2 text-success fw-semibold">₹@Money(Model.AmountPaid) (@(Model.PaymentMethod ?? "None"))</dd>
                        <dt class="col-6 fw-normal text-muted small">Balance Due</dt>
                        <dd class="col-6 text-end small mb-0 fw-semibold text-danger">₹@Money(Math.Max(0m, Model.TotalAmount - Model.AmountPaid))</dd>
                    </dl>
                </div>
            </div>
        </div>
    </div>

    <!-- Items Grid -->
    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent d-flex justify-content-between align-items-center">
            <h2 class="h6 mb-0">Purchased Items <span class="text-muted fw-normal">(@Model.Lines.Count)</span></h2>
        </div>
        <div class="table-responsive">
            <table class="table align-middle mb-0">
                <thead class="table-light">
                    <tr>
                        <th style="width: 2.5rem;">#</th>
                        <th>Product</th>
                        <th class="text-end">Quantity</th>
                        <th class="text-end">Unit Cost</th>
                        <th class="text-end">Discount</th>
                        <th class="text-end">Tax %</th>
                        <th class="text-end">Tax Amount</th>
                        <th class="text-end">Line Total</th>
                        <th class="text-end">Returned</th>
                    </tr>
                </thead>
                <tbody>
                @{ var n = 0; }
                @foreach (var line in Model.Lines)
                {
                    n++;
                    <tr>
                        <td class="text-muted">@n</td>
                        <td>
                            <div class="fw-medium">@line.ProductName</div>
                            <div class="small text-muted">
                                @if (!string.IsNullOrWhiteSpace(line.VariantName))
                                {
                                    <span>@line.VariantName</span>
                                    @if (!string.IsNullOrWhiteSpace(line.ProductCode)) { <span> · </span> }
                                }
                                @if (!string.IsNullOrWhiteSpace(line.ProductCode))
                                {
                                    <span>@line.ProductCode</span>
                                }
                            </div>
                        </td>
                        <td class="text-end fw-semibold">@Qty(line.Quantity)</td>
                        <td class="text-end">₹@Money(line.UnitCost)</td>
                        <td class="text-end">₹@Money(line.DiscountAmount)</td>
                        <td class="text-end">@line.TaxRate.ToString("0.##")%</td>
                        <td class="text-end">₹@Money(line.TaxAmount)</td>
                        <td class="text-end fw-bold">₹@Money(line.LineTotal)</td>
                        <td class="text-end">
                            @if (line.ReturnedQty > 0)
                            {
                                <span class="badge bg-warning-subtle text-dark">@Qty(line.ReturnedQty)</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
    </div>
</div>
