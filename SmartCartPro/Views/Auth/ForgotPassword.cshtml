@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<div class="auth-body">
    <div class="auth-heading">
        <h1>Forgot password</h1>
        <p>We will email a reset link when auth is connected.</p>
    </div>
    <form class="auth-form" asp-controller="Auth" asp-action="ResetPassword" method="get">
        <div class="mb-3">
            <label class="form-label" for="forgot-email">Email address</label>
            <input type="email" class="form-control" id="forgot-email" placeholder="you@company.com" />
        </div>
        <button type="submit" class="btn btn-primary w-100">Send reset link</button>
    </form>
    <p class="auth-footnote"><a asp-controller="Auth" asp-action="Login">Back to sign in</a></p>
</div>
