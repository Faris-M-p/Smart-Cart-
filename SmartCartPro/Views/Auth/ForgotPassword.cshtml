@model SmartCartPro.Models.InForgotPasswordView
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Forgot password";
}
<div class="auth-body">
    <div class="auth-heading">
        <h1>Forgot password</h1>
        <p>Enter your email or username and we will email you a link to choose a new password.</p>
    </div>

    <div id="forgotSent" class="alert alert-success py-2 px-3 small d-none" role="status"></div>

    <form id="forgotForm" class="auth-form" asp-controller="Auth" asp-action="ForgotPassword" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div data-sc-form-summary class="alert alert-danger py-2 px-3 small d-none" role="alert"></div>

        <div class="mb-4">
            <label class="form-label" asp-for="UserNameOrEmail"></label>
            <input class="form-control" asp-for="UserNameOrEmail" autocomplete="username" placeholder="you@company.com" autofocus />
            <span asp-validation-for="UserNameOrEmail" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100" data-sc-busy-text="Sending…">Send reset link</button>
    </form>

    <p class="auth-footnote"><a asp-controller="Auth" asp-action="Login">Back to sign in</a></p>
</div>

@section Scripts {
    <script src="~/js/auth/auth.js" asp-append-version="true"></script>
}
