@model SmartCartPro.Models.InResetPasswordView
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Reset password";
    var tokenError = ViewData["TokenError"] as string;
}
<div class="auth-body">
    @if (!string.IsNullOrEmpty(tokenError))
    {
        <div class="auth-heading">
            <h1>Link not valid</h1>
            <p>@tokenError</p>
        </div>
        <a class="btn btn-primary w-100" asp-controller="Auth" asp-action="ForgotPassword">Request a new link</a>
        <p class="auth-footnote"><a asp-controller="Auth" asp-action="Login">Back to sign in</a></p>
    }
    else
    {
        <div class="auth-heading">
            <h1>Reset password</h1>
            <p>Choose a new password for your SmartCart account.</p>
        </div>

        <form id="resetForm" class="auth-form" asp-controller="Auth" asp-action="ResetPassword" method="post" novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="Token" />

            <div data-sc-form-summary class="alert alert-danger py-2 px-3 small d-none" role="alert"></div>

            <div class="mb-3">
                <label class="form-label" asp-for="NewPassword"></label>
                <input class="form-control" asp-for="NewPassword" autocomplete="new-password" autofocus />
                <div class="form-text">8–64 characters with an uppercase letter, a lowercase letter, a digit and a special character.</div>
                <span asp-validation-for="NewPassword" class="text-danger small"></span>
            </div>
            <div class="mb-4">
                <label class="form-label" asp-for="ConfirmPassword"></label>
                <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
                <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
            </div>
            <button type="submit" class="btn btn-primary w-100" data-sc-busy-text="Updating…">Update password</button>
        </form>

        <p class="auth-footnote"><a asp-controller="Auth" asp-action="Login">Back to sign in</a></p>
    }
</div>

@section Scripts {
    <script src="~/js/auth/auth.js" asp-append-version="true"></script>
}
