@model SmartCartPro.Models.InChangePasswordView
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Change password";
    var mustChange = ViewData["MustChange"] as bool? ?? false;
}
<div class="auth-body">
    <div class="auth-heading">
        <h1>Change password</h1>
        @if (mustChange)
        {
            <p>For your security, set a new password before you continue.</p>
        }
        else
        {
            <p>Update your password for this account.</p>
        }
    </div>

    <form id="changePasswordForm" class="auth-form" asp-controller="Auth" asp-action="ChangePassword" method="post" novalidate>
        @Html.AntiForgeryToken()

        <div data-sc-form-summary class="alert alert-danger py-2 px-3 small d-none" role="alert"></div>

        <div class="mb-3">
            <label class="form-label" asp-for="CurrentPassword"></label>
            <input class="form-control" asp-for="CurrentPassword" autocomplete="current-password" autofocus />
            <span asp-validation-for="CurrentPassword" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="NewPassword"></label>
            <input class="form-control" asp-for="NewPassword" autocomplete="new-password" />
            <div class="form-text">8–64 characters with an uppercase letter, a lowercase letter, a digit and a special character.</div>
            <span asp-validation-for="NewPassword" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label class="form-label" asp-for="ConfirmPassword"></label>
            <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100" data-sc-busy-text="Updating…">Update password</button>
    </form>

    @if (!mustChange)
    {
        <p class="auth-footnote"><a asp-controller="Home" asp-action="Index">Back to dashboard</a></p>
    }
</div>

@section Scripts {
    <script src="~/js/auth/auth.js" asp-append-version="true"></script>
}
