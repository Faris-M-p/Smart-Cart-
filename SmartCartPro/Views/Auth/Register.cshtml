@model SmartCartPro.Models.RegisterInput
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}
<div class="auth-body">
    <div class="auth-heading">
        <h1>Register company</h1>
        <p>Bootstrap company, default store, and admin user in one step.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

    <form class="auth-form" asp-controller="Auth" asp-action="Register" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
            <label class="form-label" asp-for="CompanyName"></label>
            <input class="form-control" asp-for="CompanyName" placeholder="Acme Retail" />
            <span asp-validation-for="CompanyName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="StoreName"></label>
            <input class="form-control" asp-for="StoreName" placeholder="Main Store" />
            <span asp-validation-for="StoreName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="FullName"></label>
            <input class="form-control" asp-for="FullName" placeholder="Admin User" />
            <span asp-validation-for="FullName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Email"></label>
            <input class="form-control" asp-for="Email" autocomplete="email" placeholder="admin@company.com" />
            <span asp-validation-for="Email" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="UserName"></label>
            <input class="form-control" asp-for="UserName" autocomplete="username" placeholder="admin" />
            <span asp-validation-for="UserName" class="text-danger small"></span>
        </div>
        <div class="mb-3">
            <label class="form-label" asp-for="Password"></label>
            <input class="form-control" asp-for="Password" autocomplete="new-password" />
            <span asp-validation-for="Password" class="text-danger small"></span>
        </div>
        <div class="mb-4">
            <label class="form-label" asp-for="ConfirmPassword"></label>
            <input class="form-control" asp-for="ConfirmPassword" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Create account</button>
    </form>
    <p class="auth-footnote">Already set up? <a asp-controller="Auth" asp-action="Login">Sign in</a></p>
</div>
