@model SmartCartPro.Models.VerifyOtpInput
@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Verify code";
    var maskedEmail = ViewData["MaskedEmail"] as string ?? "your email";
    var info = TempData["OtpInfo"] as string;
}
<div class="auth-body">
    <div class="auth-heading">
        <h1>Check your email</h1>
        <p>We sent a one-time code to <strong>@maskedEmail</strong>. Enter it to finish Super Admin sign-in.</p>
    </div>

    @if (!string.IsNullOrWhiteSpace(info))
    {
        <div class="alert alert-success py-2 px-3 small" role="status">@info</div>
    }
    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 px-3 small" role="alert"></div>

    <form class="auth-form" asp-controller="Auth" asp-action="VerifyOtp" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="ChallengeToken" />
        <input type="hidden" asp-for="ReturnUrl" />
        <div class="mb-4">
            <label class="form-label" asp-for="Code"></label>
            <input class="form-control form-control-lg text-center letter-spacing-wide"
                   asp-for="Code"
                   inputmode="numeric"
                   autocomplete="one-time-code"
                   placeholder="6-digit code"
                   autofocus />
            <span asp-validation-for="Code" class="text-danger small"></span>
        </div>
        <button type="submit" class="btn btn-primary w-100">Verify and continue</button>
    </form>

    <form class="mt-3" asp-controller="Auth" asp-action="ResendOtp" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" name="challengeToken" value="@Model.ChallengeToken" />
        <input type="hidden" name="returnUrl" value="@Model.ReturnUrl" />
        <button type="submit" class="btn btn-link w-100">Resend code</button>
    </form>

    <p class="auth-footnote"><a asp-controller="Auth" asp-action="Login">Back to sign in</a></p>
</div>
