@model SmartCartPro.Models.InRoleCreateView
@{
    ViewData["Title"] = "Add role";
    var returnUrl = ViewBag.ReturnUrl as string ?? Url.Action("Index", "Role")!;
    var permissions = ViewBag.Permissions as List<SmartCartPro.Models.OutputPermissionSelect> ?? new List<SmartCartPro.Models.OutputPermissionSelect>();
    var selected = new HashSet<int>(Model.PermissionIds);
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Administration</span></li>
        <li class="breadcrumb-item"><a asp-action="Index">Roles &amp; permissions</a></li>
        <li class="breadcrumb-item active" aria-current="page">Add</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Add role</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <form id="roleForm"
              asp-action="Create"
              method="post"
              data-sc-ajax-form="true"
              novalidate>
            <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
            <input type="hidden" name="returnUrl" value="@returnUrl" />

            <div class="row g-3 mb-4">
                <div class="col-md-6">
                    <label class="form-label" asp-for="RoleName"></label>
                    <input class="form-control" asp-for="RoleName" maxlength="100" autocomplete="off" />
                    <span asp-validation-for="RoleName" class="text-danger"></span>
                </div>
                <div class="col-md-3">
                    <label class="form-label" asp-for="RoleCode"></label>
                    <input class="form-control text-uppercase" asp-for="RoleCode" maxlength="30" autocomplete="off"
                           autocapitalize="characters" spellcheck="false" />
                    <span asp-validation-for="RoleCode" class="text-danger"></span>
                    <div class="form-text">Short unique code such as STORE_MANAGER. It cannot be changed later.</div>
                </div>
                <div class="col-md-3 d-flex align-items-start pt-md-4">
                    <div class="form-check mt-md-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Description"></label>
                    <textarea class="form-control" asp-for="Description" rows="2" maxlength="500"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
            </div>

            <h2 class="h6 text-uppercase text-muted mb-3">Permissions</h2>
            @await Html.PartialAsync("_PermissionMatrix", (Permissions: permissions, Selected: selected, ReadOnly: false))

            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary" data-sc-busy-text="Creating…">Create role</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/admin/role.js" asp-append-version="true"></script>
}
