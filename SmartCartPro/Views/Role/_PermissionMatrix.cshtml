@model (List<SmartCartPro.Models.OutputPermissionSelect> Permissions, HashSet<int> Selected, bool ReadOnly)
@{
    var (permissions, selected, readOnly) = Model;
    var groups = permissions
        .GroupBy(p => new { p.FkModule, p.ModuleCode, p.ModuleName, p.ModuleDisplayOrder })
        .OrderBy(g => g.Key.ModuleDisplayOrder)
        .ThenBy(g => g.Key.ModuleName)
        .ToList();
}
@if (permissions.Count == 0)
{
    <div class="alert alert-warning mb-0" role="alert">
        <i class="bi bi-exclamation-triangle me-1"></i>
        The permission catalog is empty. Run the permission seed script before creating roles.
    </div>
}
else
{
    <div data-sc-permission-matrix>
        <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-2">
            <div class="small text-muted" aria-live="polite">
                <span data-sc-perm-total>0</span> of @permissions.Count permissions selected
            </div>
            @if (!readOnly)
            {
                <div class="btn-group btn-group-sm" role="group" aria-label="Permission shortcuts">
                    <button type="button" class="btn btn-outline-secondary" data-sc-perm-all>Select all</button>
                    <button type="button" class="btn btn-outline-secondary" data-sc-perm-none>Clear all</button>
                </div>
            }
        </div>
        <div class="row g-3">
            @foreach (var group in groups)
            {
                var moduleId = "perm-module-" + group.Key.ModuleCode.ToLowerInvariant();
                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 border" data-sc-perm-module>
                        <div class="card-header bg-light d-flex justify-content-between align-items-center py-2">
                            <div class="form-check mb-0">
                                <input class="form-check-input" type="checkbox" id="@moduleId"
                                       disabled="@readOnly" data-sc-perm-module-toggle />
                                <label class="form-check-label fw-semibold" for="@moduleId">@group.Key.ModuleName</label>
                            </div>
                            <span class="badge text-bg-light border" data-sc-perm-count></span>
                        </div>
                        <ul class="list-group list-group-flush">
                            @foreach (var permission in group.OrderBy(x => x.DisplayOrder).ThenBy(x => x.PermissionName))
                            {
                                var inputId = "perm-" + permission.IdPermission;
                                var isChecked = selected.Contains(permission.IdPermission);
                                <li class="list-group-item">
                                    <div class="form-check mb-0">
                                        <input class="form-check-input" type="checkbox" name="PermissionIds"
                                               value="@permission.IdPermission" id="@inputId"
                                               checked="@isChecked" disabled="@readOnly"
                                               data-sc-perm data-perm-code="@permission.PermissionCode" />
                                        <label class="form-check-label" for="@inputId">@permission.PermissionName</label>
                                        <div class="small text-muted"><code>@permission.PermissionCode</code></div>
                                    </div>
                                </li>
                            }
                        </ul>
                    </div>
                </div>
            }
        </div>
        @if (!readOnly)
        {
            <div class="form-text mt-2">Ticking an action permission also ticks the view permission of the same module.</div>
        }
        <span class="text-danger small d-block mt-2" data-valmsg-for="PermissionIds"></span>
    </div>
}
