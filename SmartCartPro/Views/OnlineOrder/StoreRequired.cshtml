@{
    ViewData["Title"] = ViewData["Title"] as string ?? "Online orders";
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Sales</span></li>
        <li class="breadcrumb-item active" aria-current="page">@ViewData["Title"]</li>
    </ol>
</nav>

<div class="card border-0 shadow-sm">
    <div class="card-body text-center py-5">
        <i class="bi bi-shop display-4 text-muted" aria-hidden="true"></i>
        <h1 class="h4 mt-3">Sign in as a store user to use this screen</h1>
        <p class="text-muted mx-auto mb-4" style="max-width: 36rem;">
            Online orders belong to a store, and platform administrator accounts are not tied to one.
            Sign in with a store account to confirm, pack, ship or cancel storefront orders.
        </p>
        <a class="btn btn-outline-secondary" asp-controller="Home" asp-action="Index">Back to dashboard</a>
    </div>
</div>
