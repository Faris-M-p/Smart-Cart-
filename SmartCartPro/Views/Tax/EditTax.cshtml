@model InTaxUpdateView
@{
    ViewData["Title"] = "Edit tax";
    var returnUrl = ViewBag.ReturnUrl as string
        ?? Url.Action("Taxes", "Catalog");
    // Culture-neutral value for the number input (browsers always expect "." as the decimal separator).
    var taxRateText = Model.TaxRate.ToString("0.####", System.Globalization.CultureInfo.InvariantCulture);
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Catalog</span></li>
        <li class="breadcrumb-item"><a asp-action="Taxes">Taxes</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Edit tax</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
        <form id="taxForm"
              asp-action="EditTax"
              asp-route-id="@Model.IdTax"
              method="post"
              data-sc-ajax-form="true"
              novalidate>
            @* Antiforgery token: emitted once by the form tag helper (asp-action + method=post); an extra @Html.AntiForgeryToken() would post it twice. *@
            <input type="hidden" asp-for="IdTax" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="TaxCode"></label>
                    <input class="form-control" asp-for="TaxCode" maxlength="20" autocomplete="off" />
                    <span asp-validation-for="TaxCode" class="text-danger"></span>
                    <div class="form-text">Short code, unique (up to 20 characters).</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" asp-for="TaxName"></label>
                    <input class="form-control" asp-for="TaxName" maxlength="100" autocomplete="off" />
                    <span asp-validation-for="TaxName" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="TaxRate"></label>
                    <div class="input-group">
                        <input class="form-control" asp-for="TaxRate" type="number" step="0.0001" min="0" max="100"
                               inputmode="decimal" value="@taxRateText" />
                        <span class="input-group-text">%</span>
                    </div>
                    <span asp-validation-for="TaxRate" class="text-danger d-block"></span>
                    <div class="form-text">0 to 100, up to 4 decimal places.</div>
                </div>
                <div class="col-md-8">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsInclusive" />
                        <label class="form-check-label" asp-for="IsInclusive"></label>
                        <div class="form-text mt-0">Tick when selling prices already include this tax.</div>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/catalog/tax.js" asp-append-version="true"></script>
}
