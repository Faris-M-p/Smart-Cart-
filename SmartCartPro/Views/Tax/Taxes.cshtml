@model OutputTaxList
@{
    ViewData["Title"] = "Taxes";
    var canManage = await Access.CanAsync("products.manage");
    var f = Model.Filter;
    var currentListUrl = Context.Request.Path + Context.Request.QueryString;
    var statusValue = f.ActiveOnly is null ? "" : (f.ActiveOnly.Value ? "true" : "false");
    var hasFilters = !string.IsNullOrWhiteSpace(f.Search) || f.ActiveOnly is not null;
    var setActiveUrl = Url.Action("SetTaxActive", "Catalog")!;
    var addUrl = Url.Action("CreateTax", "Catalog", new { returnUrl = currentListUrl });

    var statusItems = new List<SelectListItem>
    {
        new("All", "", statusValue == ""),
        new("Active", "true", statusValue == "true"),
        new("Inactive", "false", statusValue == "false")
    };
    var pageSizeItems = new[] { 10, 25, 50, 100 }
        .Select(size => new SelectListItem(size.ToString(), size.ToString(), f.PageSize == size))
        .ToList();

    var pageHeader = (
        Title: "Taxes",
        Subtitle: "Company-wide tax rates that can be assigned to products",
        ActionText: canManage ? "Add tax" : null,
        ActionUrl: canManage ? addUrl : null);

    string SortUrl(string sortBy)
    {
        var desc = string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase) && !f.SortDesc;
        return Url.Action("Taxes", new
        {
            Search = f.Search,
            ActiveOnly = f.ActiveOnly,
            Page = 1,
            PageSize = f.PageSize,
            SortBy = sortBy,
            SortDesc = desc
        })!;
    }

    string SortIcon(string sortBy)
    {
        if (!string.Equals(f.SortBy, sortBy, StringComparison.OrdinalIgnoreCase))
            return "bi-arrow-down-up text-muted";
        return f.SortDesc ? "bi-sort-down" : "bi-sort-up";
    }

    var pager = new PagerViewModel
    {
        TotalCount = Model.TotalCount,
        Page = Model.Page,
        PageSize = Model.PageSize,
        Action = "Taxes",
        RouteValues = new Dictionary<string, object?>
        {
            ["Search"] = f.Search,
            ["ActiveOnly"] = f.ActiveOnly,
            ["SortBy"] = f.SortBy,
            ["SortDesc"] = f.SortDesc
        }
    };
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Catalog</span></li>
        <li class="breadcrumb-item active" aria-current="page">Taxes</li>
    </ol>
</nav>

<partial name="_PageHeader" model="pageHeader" />

<div id="taxListPage">
    <div class="card border-0 shadow-sm">
        <div class="card-body">
            <form method="get" asp-action="Taxes" class="row g-2 align-items-end mb-3">
                <div class="col-md-5">
                    <label class="form-label" for="taxSearch">Search</label>
                    <input id="taxSearch" type="search" name="Search" value="@f.Search"
                           class="form-control" placeholder="Tax name or code" autocomplete="off" />
                </div>
                <div class="col-md-3">
                    <label class="form-label" for="taxStatus">Status</label>
                    <select id="taxStatus" name="ActiveOnly" class="form-select" asp-items="statusItems" data-sc-auto-submit></select>
                </div>
                <div class="col-md-2">
                    <label class="form-label" for="taxPageSize">Page size</label>
                    <select id="taxPageSize" name="PageSize" class="form-select" asp-items="pageSizeItems" data-sc-auto-submit></select>
                </div>
                <div class="col-md-2">
                    <input type="hidden" name="SortBy" value="@f.SortBy" />
                    <input type="hidden" name="SortDesc" value="@f.SortDesc.ToString().ToLowerInvariant()" />
                    <input type="hidden" name="Page" value="1" />
                    <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
                </div>
            </form>

            @if (Model.Items.Count == 0)
            {
                <div class="text-center py-5">
                    @if (hasFilters)
                    {
                        <p class="text-muted mb-3">No taxes match your filters.</p>
                        <a class="btn btn-outline-secondary" asp-action="Taxes">Clear filters</a>
                    }
                    else if (canManage)
                    {
                        <p class="text-muted mb-3">No taxes yet.</p>
                        <a class="btn btn-primary" href="@addUrl"><i class="bi bi-plus-lg me-1"></i>Add tax</a>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No taxes yet.</p>
                    }
                </div>
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("taxcode")">
                                        Code <i class="bi @SortIcon("taxcode")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("taxname")">
                                        Tax <i class="bi @SortIcon("taxname")"></i>
                                    </a>
                                </th>
                                <th class="text-end">
                                    <a class="text-decoration-none text-body" href="@SortUrl("taxrate")">
                                        Rate <i class="bi @SortIcon("taxrate")"></i>
                                    </a>
                                </th>
                                <th class="d-none d-md-table-cell">
                                    <a class="text-decoration-none text-body" href="@SortUrl("isinclusive")">
                                        Pricing <i class="bi @SortIcon("isinclusive")"></i>
                                    </a>
                                </th>
                                <th>
                                    <a class="text-decoration-none text-body" href="@SortUrl("isactive")">
                                        Status <i class="bi @SortIcon("isactive")"></i>
                                    </a>
                                </th>
                                @if (canManage)
                                {
                                    <th class="text-end">Actions</th>
                                }
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var item in Model.Items)
                        {
                            var toggleVerb = item.IsActive ? "Deactivate" : "Activate";
                            var toggleTitle = toggleVerb + " tax";
                            var toggleClass = item.IsActive ? "btn-warning" : "btn-primary";
                            var toggleNext = (!item.IsActive).ToString().ToLowerInvariant();
                            var toggleBody = item.IsActive
                                ? "Deactivate \"" + item.TaxName + "\"? It will no longer be offered when creating or editing products."
                                : "Activate \"" + item.TaxName + "\"? It will be offered again on product forms.";
                            var rateText = item.TaxRate.ToString("0.####") + "%";
                            <tr>
                                <td class="fw-medium text-nowrap">@item.TaxCode</td>
                                <td>@item.TaxName</td>
                                <td class="text-end text-nowrap">@rateText</td>
                                <td class="d-none d-md-table-cell">
                                    @if (item.IsInclusive)
                                    {
                                        <span class="badge text-bg-info">Tax inclusive</span>
                                    }
                                    else
                                    {
                                        <span class="badge text-bg-light border">Tax exclusive</span>
                                    }
                                </td>
                                <td>
                                    <partial name="_StatusBadge" model="item.IsActive" />
                                </td>
                                @if (canManage)
                                {
                                    <td class="text-end text-nowrap">
                                        <a class="btn btn-sm btn-outline-primary me-1"
                                           asp-action="EditTax"
                                           asp-route-id="@item.IdTax"
                                           asp-route-returnUrl="@currentListUrl">Edit</a>
                                        <button type="button"
                                                class="btn btn-sm btn-outline-secondary"
                                                data-sc-post="@setActiveUrl"
                                                data-sc-param-id="@item.IdTax"
                                                data-sc-param-isactive="@toggleNext"
                                                data-sc-confirm="@toggleBody"
                                                data-sc-confirm-title="@toggleTitle"
                                                data-sc-confirm-ok="@toggleVerb"
                                                data-sc-confirm-class="@toggleClass"
                                                data-sc-after="reload">@toggleVerb</button>
                                    </td>
                                }
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>

                <partial name="_Pager" model="pager" />
            }
        </div>
    </div>
</div>

@if (canManage)
{
    <partial name="_ConfirmModal" />
}

@section Scripts {
    <script src="~/js/catalog/tax.js" asp-append-version="true"></script>
}
