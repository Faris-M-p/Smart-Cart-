@model SmartCartPro.Models.InCategoryUpdateView
@{
    ViewData["Title"] = "Edit category";
    var returnUrl = ViewBag.ReturnUrl as string
        ?? Url.Action("Categories", "Catalog");
}
<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><span class="text-muted">Catalog</span></li>
        <li class="breadcrumb-item"><a asp-action="Categories">Categories</a></li>
        <li class="breadcrumb-item active" aria-current="page">Edit</li>
    </ol>
</nav>
<h1 class="h3 mb-3">Edit category</h1>

<div class="card border-0 shadow-sm">
    <div class="card-body">
        <div class="alert alert-danger d-none" data-sc-form-summary role="alert"></div>
        <form id="categoryForm"
              asp-action="EditCategory"
              asp-route-id="@Model.IdCategory"
              method="post"
              data-sc-ajax-form="true"
              novalidate>
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="IdCategory" />
            <input type="hidden" name="returnUrl" value="@returnUrl" />
            <div class="row g-3">
                <div class="col-md-4">
                    <label class="form-label" asp-for="CategoryCode"></label>
                    <input class="form-control" asp-for="CategoryCode" autocomplete="off" />
                    <span asp-validation-for="CategoryCode" class="text-danger"></span>
                    <div class="form-text">Optional short code (max 20 characters).</div>
                </div>
                <div class="col-md-8">
                    <label class="form-label" asp-for="CategoryName"></label>
                    <input class="form-control" asp-for="CategoryName" autocomplete="off" />
                    <span asp-validation-for="CategoryName" class="text-danger"></span>
                </div>
                <div class="col-12">
                    <label class="form-label" asp-for="Description"></label>
                    <textarea class="form-control" asp-for="Description" rows="3"></textarea>
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="col-md-4">
                    <label class="form-label" asp-for="DisplayOrder"></label>
                    <input class="form-control" asp-for="DisplayOrder" />
                    <span asp-validation-for="DisplayOrder" class="text-danger"></span>
                    <div class="form-text">Lower numbers appear first in lists.</div>
                </div>
                <div class="col-md-4 d-flex align-items-end">
                    <div class="form-check mb-2">
                        <input class="form-check-input" asp-for="IsActive" />
                        <label class="form-check-label" asp-for="IsActive"></label>
                    </div>
                </div>
            </div>
            <div class="mt-4 d-flex flex-wrap gap-2">
                <button type="submit" class="btn btn-primary">Save</button>
                <a class="btn btn-outline-secondary" href="@returnUrl">Cancel</a>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/catalog/category.js" asp-append-version="true"></script>
}
