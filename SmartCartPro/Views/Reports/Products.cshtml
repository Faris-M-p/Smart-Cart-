@model SmartCartPro.Models.OutputReportProducts
@{
    ViewData["Title"] = "Product report";
    var f = Model.Filter;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var fromText = f.DateFrom?.ToString("yyyy-MM-dd", invariant);
    var toText = f.DateTo?.ToString("yyyy-MM-dd", invariant);
    var chartJson = System.Text.Json.JsonSerializer.Serialize(Model.Chart);
    var csvUrl = Url.Action("ProductsCsv", new { f.DateFrom, f.DateTo, f.FkStore, f.FkCategory, f.Top, f.RankBy });
    var tops = new[] { 10, 25, 50, 100 };
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Products</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Product report</h1>
        <p class="text-muted mb-0">Top sellers for the selected range. Low stock lives on Inventory.</p>
    </div>
    <div class="sc-report-actions d-flex gap-2">
        <a class="btn btn-outline-secondary" asp-controller="Inventory" asp-action="LowStock">Low stock</a>
        <button type="button" class="btn btn-outline-secondary" data-sc-print><i class="bi bi-printer me-1"></i>Print</button>
        <a class="btn btn-outline-primary" href="@csvUrl"><i class="bi bi-download me-1"></i>CSV</a>
    </div>
</div>

<div data-sc-report>
    <form method="get" asp-action="Products" class="row g-2 align-items-end mb-3 sc-report-filters">
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="prodFrom">From</label>
            <input id="prodFrom" type="date" name="DateFrom" value="@fromText" class="form-control" />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="prodTo">To</label>
            <input id="prodTo" type="date" name="DateTo" value="@toText" class="form-control" />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="prodCat">Category</label>
            <select id="prodCat" name="FkCategory" class="form-select" data-sc-auto-submit>
                @if (f.FkCategory == 0)
                {
                    <option value="0" selected>All categories</option>
                }
                else
                {
                    <option value="0">All categories</option>
                }
                @foreach (var cat in Model.Categories)
                {
                    if (cat.IdCategory == f.FkCategory)
                    {
                        <option value="@cat.IdCategory" selected>@cat.CategoryName</option>
                    }
                    else
                    {
                        <option value="@cat.IdCategory">@cat.CategoryName</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-2 col-lg-1">
            <label class="form-label" for="prodTop">Top</label>
            <select id="prodTop" name="Top" class="form-select" data-sc-auto-submit>
                @foreach (var n in tops)
                {
                    if (f.Top == n)
                    {
                        <option value="@n" selected>@n</option>
                    }
                    else
                    {
                        <option value="@n">@n</option>
                    }
                }
            </select>
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="prodRank">Rank by</label>
            <select id="prodRank" name="RankBy" class="form-select" data-sc-auto-submit>
                @if (f.RankBy == "revenue")
                {
                    <option value="qty">Quantity</option>
                    <option value="revenue" selected>Revenue</option>
                }
                else
                {
                    <option value="qty" selected>Quantity</option>
                    <option value="revenue">Revenue</option>
                }
            </select>
        </div>
        @if (Model.ShowStorePicker)
        {
            <div class="col-6 col-md-3 col-lg-2">
                <label class="form-label" for="prodStore">Store</label>
                <select id="prodStore" name="FkStore" class="form-select" data-sc-auto-submit>
                    @if (f.FkStore == 0)
                    {
                        <option value="0" selected>All stores</option>
                    }
                    else
                    {
                        <option value="0">All stores</option>
                    }
                    @foreach (var store in Model.Stores)
                    {
                        if (store.IdStore == f.FkStore)
                        {
                            <option value="@store.IdStore" selected>@store.StoreName</option>
                        }
                        else
                        {
                            <option value="@store.IdStore">@store.StoreName</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="col-6 col-lg-1">
            <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
        </div>
    </form>

    <partial name="_ReportKpis" model="Model.Kpis" />

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            <div data-sc-chart="bars" data-sc-chart-title="Top products" data-sc-chart-json="@chartJson"></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-body">
            @if (Model.Rows.Count == 0)
            {
                <partial name="_ReportEmpty" model='"No product sales in this range"' />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>Code</th>
                                <th>Category</th>
                                <th class="text-end">Qty sold</th>
                                <th class="text-end">Revenue</th>
                                <th class="text-end">Transactions</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td class="fw-medium">@row.ProductName</td>
                                <td>@(string.IsNullOrWhiteSpace(row.ProductCode) ? "—" : row.ProductCode)</td>
                                <td>@(string.IsNullOrWhiteSpace(row.CategoryName) ? "—" : row.CategoryName)</td>
                                <td class="text-end">@row.QuantitySold.ToString("0.###")</td>
                                <td class="text-end">@Model.Currency @row.Revenue.ToString("N2")</td>
                                <td class="text-end">@row.TransactionCount</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/sc-charts.js" asp-append-version="true"></script>
    <script src="~/js/reports/reports.js" asp-append-version="true"></script>
}
