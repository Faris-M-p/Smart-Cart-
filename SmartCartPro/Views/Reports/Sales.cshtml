@model SmartCartPro.Models.OutputReportSales
@{
    ViewData["Title"] = "Sales report";
    var f = Model.Filter;
    var invariant = System.Globalization.CultureInfo.InvariantCulture;
    var fromText = f.DateFrom?.ToString("yyyy-MM-dd", invariant);
    var toText = f.DateTo?.ToString("yyyy-MM-dd", invariant);
    var chartJson = System.Text.Json.JsonSerializer.Serialize(Model.Chart);
    var csvUrl = Url.Action("SalesCsv", new { f.DateFrom, f.DateTo, f.FkStore, f.GroupBy });
}

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb mb-0">
        <li class="breadcrumb-item"><a asp-action="Index">Reports</a></li>
        <li class="breadcrumb-item active" aria-current="page">Sales</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
        <h1 class="h3 mb-1">Sales report</h1>
        <p class="text-muted mb-0">Completed invoices in @Model.TimeZoneId. Cancelled bills are listed separately.</p>
    </div>
    <div class="sc-report-actions d-flex gap-2">
        <button type="button" class="btn btn-outline-secondary" data-sc-print><i class="bi bi-printer me-1"></i>Print</button>
        <a class="btn btn-outline-primary" href="@csvUrl"><i class="bi bi-download me-1"></i>CSV</a>
    </div>
</div>

<div data-sc-report>
    <form method="get" asp-action="Sales" class="row g-2 align-items-end mb-3 sc-report-filters">
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="salesFrom">From</label>
            <input id="salesFrom" type="date" name="DateFrom" value="@fromText" class="form-control" />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="salesTo">To</label>
            <input id="salesTo" type="date" name="DateTo" value="@toText" class="form-control" />
        </div>
        <div class="col-6 col-md-3 col-lg-2">
            <label class="form-label" for="salesGroup">Group by</label>
            <select id="salesGroup" name="GroupBy" class="form-select" data-sc-auto-submit>
                @if (f.GroupBy == "month")
                {
                    <option value="day">Day</option>
                    <option value="month" selected>Month</option>
                }
                else
                {
                    <option value="day" selected>Day</option>
                    <option value="month">Month</option>
                }
            </select>
        </div>
        @if (Model.ShowStorePicker)
        {
            <div class="col-6 col-md-3 col-lg-3">
                <label class="form-label" for="salesStore">Store</label>
                <select id="salesStore" name="FkStore" class="form-select" data-sc-auto-submit>
                    @if (f.FkStore == 0)
                    {
                        <option value="0" selected>All stores</option>
                    }
                    else
                    {
                        <option value="0">All stores</option>
                    }
                    @foreach (var store in Model.Stores)
                    {
                        if (store.IdStore == f.FkStore)
                        {
                            <option value="@store.IdStore" selected>@store.StoreName</option>
                        }
                        else
                        {
                            <option value="@store.IdStore">@store.StoreName</option>
                        }
                    }
                </select>
            </div>
        }
        <div class="col-6 col-lg-2">
            <button type="submit" class="btn btn-outline-primary w-100">Apply</button>
        </div>
    </form>

    <partial name="_ReportKpis" model="Model.Kpis" />

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-header bg-transparent border-0 pt-3">
            <h2 class="h6 mb-0">Net sales</h2>
        </div>
        <div class="card-body pt-0">
            <div data-sc-chart="line" data-sc-chart-title="Net sales" data-sc-chart-json="@chartJson"></div>
        </div>
    </div>

    <div class="card border-0 shadow-sm mb-3">
        <div class="card-body">
            @if (Model.Rows.Count == 0)
            {
                <partial name="_ReportEmpty" model='"No sales in this range"' />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead>
                            <tr>
                                <th>Period</th>
                                <th class="text-end">Invoices</th>
                                <th class="text-end">Gross</th>
                                <th class="text-end">Discounts</th>
                                <th class="text-end">Tax</th>
                                <th class="text-end">Net</th>
                                <th class="text-end">Avg bill</th>
                                <th class="text-end">Returns</th>
                            </tr>
                        </thead>
                        <tbody>
                        @foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td>@row.BucketLabel</td>
                                <td class="text-end">@row.InvoiceCount</td>
                                <td class="text-end">@Model.Currency @row.Gross.ToString("N2")</td>
                                <td class="text-end">@Model.Currency @row.DiscountAmount.ToString("N2")</td>
                                <td class="text-end">@Model.Currency @row.TaxAmount.ToString("N2")</td>
                                <td class="text-end">@Model.Currency @row.Net.ToString("N2")</td>
                                <td class="text-end">@Model.Currency @row.AverageBill.ToString("N2")</td>
                                <td class="text-end">@Model.Currency @row.Returns.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-transparent border-0 pt-3">
            <h2 class="h6 mb-0">Payments</h2>
        </div>
        <div class="card-body pt-0">
            @if (Model.Payments.Count == 0)
            {
                <partial name="_ReportEmpty" model='"No payments in this range"' />
            }
            else
            {
                <div class="table-responsive">
                    <table class="table align-middle mb-0">
                        <thead><tr><th>Method</th><th class="text-end">Count</th><th class="text-end">Amount</th></tr></thead>
                        <tbody>
                        @foreach (var pay in Model.Payments)
                        {
                            <tr>
                                <td class="text-capitalize">@pay.PaymentMethod</td>
                                <td class="text-end">@pay.PaymentCount</td>
                                <td class="text-end">@Model.Currency @pay.Amount.ToString("N2")</td>
                            </tr>
                        }
                        </tbody>
                    </table>
                </div>
            }
        </div>
    </div>
</div>

@section Styles {
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
}
@section Scripts {
    <script src="~/js/sc-charts.js" asp-append-version="true"></script>
    <script src="~/js/reports/reports.js" asp-append-version="true"></script>
}
