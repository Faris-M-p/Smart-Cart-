@model SmartCartPro.Models.OutputReportScreen
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>@Model.Title</title>
    <link rel="stylesheet" href="~/css/admin-shell.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/reports.css" asp-append-version="true" />
</head>
<body class="p-4 sc-print-sheet">
    <div class="d-flex justify-content-between align-items-start mb-3">
        <div>
            <h1 class="h4 mb-1">@Model.CompanyName</h1>
            <h2 class="h5 mb-1">@Model.Title</h2>
            <p class="mb-0">@Model.StoreLabel</p>
            @if (Model.ShowDates && Model.Filter.DateFrom.HasValue)
            {
                <p class="mb-0">@Model.Filter.DateFrom.Value.ToString("dd MMM yyyy") – @Model.Filter.DateTo?.ToString("dd MMM yyyy")</p>
            }
        </div>
        <div class="text-end small">
            <div>Printed by @Model.PrintedBy</div>
            <div>@Model.PrintedAtLocal.ToString("dd MMM yyyy HH:mm")</div>
            <button type="button" class="btn btn-sm btn-outline-secondary mt-2 d-print-none" onclick="window.print()">Save as PDF</button>
        </div>
    </div>
    @if (!string.IsNullOrWhiteSpace(Model.Notice))
    {
        <p class="small">@Model.Notice</p>
    }
    <table class="table table-sm align-middle">
        <thead>
            <tr>
                @foreach (var column in Model.Columns)
                {
                    <th class="@(column.Align == "end" ? "text-end" : "")">@column.Name</th>
                }
            </tr>
        </thead>
        <tbody>
            @foreach (var row in Model.Rows)
            {
                <tr>
                    @for (var i = 0; i < row.Length; i++)
                    {
                        var align = i < Model.Columns.Count && Model.Columns[i].Align == "end" ? "text-end" : "";
                        <td class="@align">@row[i].Text</td>
                    }
                </tr>
            }
        </tbody>
        @if (Model.Totals is { Length: > 0 })
        {
            <tfoot>
                <tr>
                    @for (var i = 0; i < Model.Totals.Length; i++)
                    {
                        var align = i < Model.Columns.Count && Model.Columns[i].Align == "end" ? "text-end" : "";
                        <th class="@align">@Model.Totals[i].Text</th>
                    }
                </tr>
            </tfoot>
        }
    </table>
    <p class="small text-muted">Grand totals are the totals row. This print includes the exported row set for the current filters.</p>
</body>
</html>
