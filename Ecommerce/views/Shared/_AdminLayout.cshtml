  <script>
    (function () {
      var path = (window.location.pathname || '').replace(/\/+$/, '') || '/';
      document.querySelectorAll('.pc-sidebar .pc-navbar a.pc-link[href^="/Admin"]').forEach(function (link) {
        var href = (link.getAttribute('href') || '').replace(/\/+$/, '');
        if (!href) return;
        var prefixes = (link.getAttribute('data-menu-prefixes') || href)
          .split(',')
          .map(function (value) { return value.trim().replace(/\/+$/, ''); })
          .filter(Boolean);
        var matched = prefixes.some(function (prefix) {
          return path === prefix || path.indexOf(prefix + '/') === 0;
        });
        if (matched) {
          var item = link.parentNode;
          item.classList.add('active');
          var parentHas = item.closest('.pc-hasmenu');
          while (parentHas) {
            parentHas.classList.add('pc-trigger', 'active');
            var submenu = parentHas.querySelector(':scope > .pc-submenu');
            if (submenu) submenu.style.display = 'block';
            parentHas = parentHas.parentElement ? parentHas.parentElement.closest('.pc-hasmenu') : null;
          }
        }
      });
    })();
  </script>
