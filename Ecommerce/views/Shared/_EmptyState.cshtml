@* Empty State Component - Compact version for tables *@
@{
    string title = ViewBag.EmptyTitle ?? "No Data Available";
    string message = ViewBag.EmptyMessage ?? "";
}

<div class="empty-state empty-state-compact">
    <div class="empty-icon no-data-icon">
        <div class="search-circle">
            <div class="search-handle"></div>
            <div class="x-mark">✕</div>
        </div>
    </div>
    
    <h3 class="empty-title">@Html.Raw(title)</h3>
    @if (!string.IsNullOrWhiteSpace(message))
    {
        <p class="empty-message">@Html.Raw(message)</p>
    }
</div>
