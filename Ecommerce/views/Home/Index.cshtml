@model Ecommerce.Models.HomeViewModel
@{
    Layout = "~/Views/Shared/_Layout.cshtml";

    bool hasBanners     = Model?.Banners != null && Model.Banners.Any();
    bool hasCategories  = Model?.FeaturedCategories != null && Model.FeaturedCategories.Any();
    bool hasProducts    = Model?.FeaturedProducts != null && Model.FeaturedProducts.Any();
    bool hasAnyContent  = hasBanners || hasCategories || hasProducts;
}

<main class="main__content_wrapper">

@if (!hasAnyContent)
{
    <!-- ============================================================
         NO CONTENT SET BY ADMIN — Default "Go Shop" Hero Section
    ============================================================ -->
    <section style="min-height: 80vh; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, #f8fafc 0%, #eff6ff 50%, #f0fdf4 100%);">
        <div class="container text-center py-5">
            <div class="mb-4">
                <svg width="140" height="140" viewBox="0 0 140 140" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="70" cy="70" r="70" fill="#EFF6FF"/>
                    <!-- Bag body -->
                    <rect x="30" y="55" width="80" height="58" rx="10" fill="#3B82F6"/>
                    <!-- Bag handle -->
                    <path d="M50 55C50 39.536 59.402 28 70 28C80.598 28 90 39.536 90 55" stroke="#2563EB" stroke-width="7" stroke-linecap="round" fill="none"/>
                    <!-- Smile -->
                    <path d="M56 88C56 88 62 98 70 98C78 98 84 88 84 88" stroke="white" stroke-width="5" stroke-linecap="round" fill="none"/>
                    <!-- Eyes -->
                    <circle cx="58" cy="76" r="5" fill="white"/>
                    <circle cx="82" cy="76" r="5" fill="white"/>
                    <circle cx="58" cy="76" r="2.5" fill="#1E40AF"/>
                    <circle cx="82" cy="76" r="2.5" fill="#1E40AF"/>
                    <!-- Star top-right -->
                    <polygon points="116,20 119,29 128,29 121,35 124,44 116,38 108,44 111,35 104,29 113,29" fill="#FBBF24"/>
                </svg>
            </div>

            <h1 class="fw-bold mb-3" style="font-size: 2.4rem; color: #1e293b;">
                Welcome to <span style="color: #3B82F6;">SmartCart</span>
            </h1>
            <p class="text-muted mb-5 mx-auto" style="font-size: 1.1rem; max-width: 480px; line-height: 1.7;">
                Discover quality products at great prices.<br>Browse our full shop to get started.
            </p>

            <a href="/Shop" class="btn btn-primary btn-lg rounded-pill px-5 py-3 shadow fw-semibold" style="font-size: 1.1rem; background: #3B82F6; border: none; letter-spacing: 0.5px;">
                <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" class="me-2 mb-1" viewBox="0 0 16 16">
                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .49.598l-1 5a.5.5 0 0 1-.465.401l-9.397.472L4.415 11H13a.5.5 0 0 1 0 1H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM3.102 4l.84 4.479 9.144-.459L13.89 4H3.102zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4z"/>
                </svg>
                Go to Shop
            </a>
        </div>
    </section>
}
else
{
    @* ====================== HERO BANNER SLIDER ====================== *@
    @if (hasBanners)
    {
        <section class="hero__slider--section color-scheme-2">
            <div class="hero__slider--inner hero__slider--activation swiper">
                <div class="hero__slider--wrapper swiper-wrapper">
                @foreach (var banner in Model!.Banners)
                {
                    var imgSrc = string.IsNullOrWhiteSpace(banner.ImageUrl) ? "" :
                                 (banner.ImageUrl.StartsWith("/") ? banner.ImageUrl : "/" + banner.ImageUrl);
                    var bgStyle = !string.IsNullOrEmpty(imgSrc)
                        ? $"background-image: linear-gradient(rgba(0,0,0,0.40), rgba(0,0,0,0.40)), url('{imgSrc}'); background-size: cover; background-position: center;"
                        : "background: linear-gradient(135deg, #1e3a8a 0%, #3b82f6 100%);";
                    var link = string.IsNullOrWhiteSpace(banner.TargetUrl) ? "/Shop" : banner.TargetUrl;

                    <div class="swiper-slide">
                        <div class="hero__slider--items home2__slider--bg" style="@bgStyle; min-height: 420px;">
                            <div class="container-fluid h-100">
                                <div class="hero__slider--items__inner hero__slider--bg2__inner h-100 d-flex align-items-center">
                                    <div class="slider__content" style="max-width: 600px;">
                                        @if (!string.IsNullOrWhiteSpace(banner.Subtitle))
                                        {
                                            <p class="text-white fw-semibold mb-2 text-uppercase" style="letter-spacing: 1.5px; font-size: 0.9rem; opacity: 0.9;">@banner.Subtitle</p>
                                        }
                                        <h2 class="slider__content--maintitle h1 text-white fw-bold mb-4" style="text-shadow: 0 2px 8px rgba(0,0,0,0.3);">
                                            @banner.Title
                                        </h2>
                                        <a class="bg__secondary2 slider__btn primary__btn" href="@link">
                                            Shop Now
                                            <svg class="primary__btn--arrow__icon" xmlns="http://www.w3.org/2000/svg" width="20" height="12" viewBox="0 0 6.2 6.2">
                                                <path d="M7.1,4l-.546.546L8.716,6.713H4v.775H8.716L6.554,9.654,7.1,10.2,9.233,8.067,10.2,7.1Z" transform="translate(-4 -4)" fill="currentColor"/>
                                            </svg>
                                        </a>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                }
                </div>
                <div class="swiper__nav--btn swiper-button-next"></div>
                <div class="swiper__nav--btn swiper-button-prev"></div>
            </div>
        </section>
    }

    @* ====================== FEATURED CATEGORIES ====================== *@
    @if (hasCategories)
    {
        <section class="banner__section banner__style2 section--padding color-scheme-2">
            <div class="container-fluid">
                <div class="section__heading text-center mb-35">
                    <h2 class="section__heading--maintitle style2">Shop by Categories</h2>
                </div>
                <div class="row row-cols-xl-4 row-cols-lg-3 row-cols-md-2 row-cols-1 g-4">
                @foreach (var cat in Model!.FeaturedCategories)
                {
                    var imgSrc = string.IsNullOrWhiteSpace(cat.ImageUrl) ? "/assets/img/banner/banner7.png" :
                                 (cat.ImageUrl.StartsWith("/") ? cat.ImageUrl : "/" + cat.ImageUrl);
                    <div class="col">
                        <div class="banner__items position__relative rounded overflow-hidden shadow-sm h-100">
                            <a class="banner__items--thumbnail d-block" href="/Shop?category=@cat.CategoryId">
                                <img class="banner__items--thumbnail__img w-100" src="@imgSrc" alt="@cat.CategoryName" style="height: 240px; object-fit: cover;">
                                <div class="banner__items--content style2">
                                    <h3 class="banner__items--content__title style2 text-uppercase fw-bold">@cat.CategoryName</h3>
                                    <span class="banner__items--content__link style2">SHOP NOW</span>
                                </div>
                            </a>
                        </div>
                    </div>
                }
                </div>
            </div>
        </section>
    }

    @* ====================== FEATURED PRODUCTS ====================== *@
    @if (hasProducts)
    {
        <section class="product__section section--padding color-scheme-2 pt-0">
            <div class="container-fluid">
                <div class="section__heading text-center mb-35">
                    <h2 class="section__heading--maintitle style2">Featured Products</h2>
                </div>
                <div class="product__section--inner">
                    <div class="row row-cols-xl-5 row-cols-lg-4 row-cols-md-3 row-cols-2 g-3">
                    @foreach (var prod in Model!.FeaturedProducts)
                    {
                        var imgSrc = string.IsNullOrWhiteSpace(prod.PrimaryImage) ? "/assets/img/product/product1.png" :
                                     (prod.PrimaryImage.StartsWith("/") ? prod.PrimaryImage : "/" + prod.PrimaryImage);
                        var url = !string.IsNullOrWhiteSpace(prod.Slug) ? $"/Shop/Details/{prod.Slug}" : $"/Shop/Details/{prod.ProductId}";
                        <div class="col mb-30">
                            <div class="product__items border rounded bg-white shadow-sm h-100">
                                <div class="product__items--thumbnail position-relative overflow-hidden rounded-top bg-light">
                                    <a class="product__items--link d-block" href="@url">
                                        <img class="product__items--img product__primary--img" src="@imgSrc" alt="@prod.ProductName" style="height: 220px; object-fit: cover; width: 100%;">
                                    </a>
                                </div>
                                <div class="product__items--content text-center p-3">
                                    <span class="small text-muted d-block mb-1 text-truncate">@prod.CategoryName</span>
                                    <h3 class="product__items--content__title h6 mb-2 text-truncate">
                                        <a class="text-dark" href="@url">@prod.ProductName</a>
                                    </h3>
                                    <span class="fw-bold text-primary fs-6">$@prod.Price.ToString("F2")</span>
                                </div>
                            </div>
                        </div>
                    }
                    </div>
                </div>
            </div>
        </section>
    }

    @* ====================== FALLBACK: No specific sections but hasAnyContent may be partially true ====================== *@
    @* If some sections are missing, show a small "Browse full shop" CTA at the bottom *@
    @if (!hasBanners && !hasCategories && !hasProducts)
    {
        <!-- This block won't render because hasAnyContent would be false and we'd have taken the earlier branch -->
    }
    else if (!hasBanners && !hasCategories)
    {
        <!-- only products shown, add a shop CTA below -->
        <section class="section--padding text-center pt-0">
            <a href="/Shop" class="btn btn-outline-primary rounded-pill px-4 py-2 fw-semibold">
                Browse Full Shop &rarr;
            </a>
        </section>
    }
}

</main>