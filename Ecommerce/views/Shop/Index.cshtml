@{
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewBag.Title = "Shop";
}

<link href="https://fonts.googleapis.com/css2?family=Jost:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/css/shop-listing.css">

<section class="shop-page">
    <section class="breadcrumb__section breadcrumb__bg">
        <div class="container">
            <div class="breadcrumb__content text-center">
                <h1 class="breadcrumb__content--title text-white mb-25">Shop</h1>
                <ul class="breadcrumb__content--menu d-flex justify-content-center">
                    <li class="breadcrumb__content--menu__items"><a class="text-white" href="/">Home</a></li>
                    <li class="breadcrumb__content--menu__items"><span class="text-white">Shop</span></li>
                </ul>
            </div>
        </div>
    </section>

    <section class="shop__section section--padding">
        <div class="container">
            <div class="shop__layout">
                <aside class="shop__sidebar">
                    <div class="single__widget widget__bg">
                        <h2 class="widget__title h3">Search</h2>
                        <form id="shop-search-form" class="shop-search-form" action="/Shop" method="get">
                            <input id="shop-search" class="shop-search-input" name="search" type="search" placeholder="Search products" autocomplete="off">
                            <button class="shop-apply-btn" type="submit">Search</button>
                        </form>
                    </div>
                    <div class="single__widget widget__bg">
                        <h2 class="widget__title h3">Filters</h2>
                        <label class="product__view--label" for="shop-category">Category</label>
                        <select id="shop-category" class="shop-filter-select"></select>
                        <label class="product__view--label" for="shop-subcategory">Subcategory</label>
                        <select id="shop-subcategory" class="shop-filter-select"></select>
                        <label class="product__view--label" for="shop-brand">Brand</label>
                        <select id="shop-brand" class="shop-filter-select"></select>
                        <label class="product__view--label">Price</label>
                        <div class="shop-filter-row">
                            <input id="shop-price-from" class="shop-filter-field" type="number" min="0" step="1" placeholder="From">
                            <input id="shop-price-to" class="shop-filter-field" type="number" min="0" step="1" placeholder="To">
                        </div>
                        <div class="shop-filter-actions">
                            <button id="shop-apply-filters" class="shop-apply-btn" type="button">Apply</button>
                            <button id="shop-reset-filters" class="shop-reset-btn" type="button">Reset</button>
                        </div>
                    </div>
                </aside>

                <div class="shop__product--wrapper">
                    <div class="shop__header bg__gray--color">
                        <p id="shop-showing-count" class="product__showing--count">Loading products...</p>
                        <div class="product__view--mode">
                            <div class="product__short--by">
                                <label class="product__view--label" for="shop-sort">Sort By</label>
                                <select id="shop-sort" class="product__view--select">
                                    <option value="4:DESC">Newest</option>
                                    <option value="1:ASC">Name A-Z</option>
                                    <option value="2:ASC">Price: Low to High</option>
                                    <option value="2:DESC">Price: High to Low</option>
                                </select>
                            </div>
                        </div>
                    </div>

                    <p id="shop-action-note" class="shop-bag-flash" hidden></p>
                    <div id="shop-product-grid" class="product__section--inner product__grid--inner"></div>
                    <div id="shop-loader" class="shop-status" hidden>Loading more products...</div>
                    <div id="shop-empty" class="shop-status" hidden>No products found.</div>
                    <div id="shop-end" class="shop-status" hidden>No more products.</div>
                    <div id="shop-scroll-sentinel" aria-hidden="true"></div>
                </div>
            </div>
        </div>
    </section>
</section>

<script src="/js/shop-listing.js"></script>
