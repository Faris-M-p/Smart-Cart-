@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">SubCategory Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">SubCategory</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row" data-permission-module="SubCategories">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>SubCategory List</h5>
                            <button type="button" class="btn btn-primary" data-action="Create" data-bs-toggle="modal" data-bs-target="#subCategoryModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New SubCategory
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <div class="row mb-3">
                            <div class="col-md-6 col-lg-5">
                                <label for="filterCategory" class="form-label">Category</label>
                                <div class="searchable-select">
                                    <select id="filterCategory" class="form-select" onchange="loadSubCategories(1)">
                                        <option value="">All Categories</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- SubCategory Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0 admin-master-list-table" id="subCategoryTable">
                                    <thead>
                                        <tr>
                                            <th class="col-name">SubCategory Name</th>
                                            <th class="col-category">Category</th>
                                            <th class="col-desc">Description</th>
                                            <th class="col-status">Status</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="subCategoryTableBody">
                                        <tr>
                                            <td colspan="5" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- SubCategory Modal (Create/Edit) -->
<div class="modal fade" id="subCategoryModal" tabindex="-1" aria-labelledby="subCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="subCategoryModalLabel">Add SubCategory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="subCategoryForm">
                    <input type="hidden" id="subCategoryID" name="SubCategoryID" value="0">
                    <div class="mb-3">
                        <label for="subCategoryName" class="form-label">SubCategory Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subCategoryName" name="SubCategoryName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="fkCategory" class="form-label">Category <span class="text-danger">*</span></label>
                        <div class="searchable-select">
                            <select class="form-select" id="fkCategory" name="FK_Category" required>
                                <option value="">Select Category</option>
                            </select>
                        </div>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        <div class="d-flex align-items-center gap-3">
                            <div id="subCategoryImagePlaceholder" class="list-entity-initials list-entity-initials-lg">—</div>
                            <img id="subCategoryImagePreview" src="" alt="Subcategory preview" class="list-entity-thumb list-entity-thumb-lg d-none">
                            <div>
                                <input type="file" class="form-control" id="subCategoryImage" accept=".jpg,.jpeg,.png,.webp">
                                <div class="form-text">Allowed: jpg, jpeg, png, webp. Max 2MB.</div>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2 d-none" id="btnRemoveSubCategoryImage" onclick="clearSubCategoryImage()">Remove image</button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="subCategoryIsActive" checked>
                        <label class="form-check-label" for="subCategoryIsActive">Status (active)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSubCategory()">Save SubCategory</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete SubCategory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this subcategory?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteSubCategoryID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="/Admin/assets/js/plugins/choices.min.js"></script>
<script src="/Admin/assets/js/common/searchable-select.js?v=select-media-1"></script>
<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let categories = [];
    let categoryMap = {};

    const TABLE_BODY_ID = 'subCategoryTableBody';
    const TABLE_COLUMN_COUNT = 5;

    // 2. API Endpoints
    const API = {
        getList: '/Admin/SubCategory/GetSubCategoryList',
        getById: '/Admin/SubCategory/GetById',
        create: '/Admin/SubCategory/Create',
        update: '/Admin/SubCategory/Update',
        delete: '/Admin/SubCategory/Delete',
        categories: '/Admin/SubCategory/GetCategories'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function () {
        document.getElementById('subCategoryModal').addEventListener('shown.bs.modal', function () {
            loadCategories();
        });

        document.getElementById('subCategoryImage').addEventListener('change', previewSubCategoryImage);
        document.getElementById('subCategoryName').addEventListener('input', refreshSubCategoryPlaceholder);
        loadCategories();
        loadSubCategories();
    });

    let removeSubCategoryImage = false;

    function nameInitials(name) {
        const text = String(name || '').trim();
        return text ? text.substring(0, 2) : '—';
    }

    function renderListThumb(imageUrl, name) {
        const media = imageUrl
            ? `<img src="${escapeAttr(imageUrl)}" alt="" class="list-entity-thumb">`
            : `<span class="list-entity-initials">${escapeHtml(nameInitials(name))}</span>`;
        return `<div class="list-entity-cell">${media}<span class="list-entity-name" title="${escapeAttr(name)}">${escapeHtml(name)}</span></div>`;
    }

    function resetSubCategoryImage() {
        removeSubCategoryImage = false;
        document.getElementById('subCategoryImage').value = '';
        setSubCategoryImagePreview('');
    }

    function setSubCategoryImagePreview(url) {
        const preview = document.getElementById('subCategoryImagePreview');
        const placeholder = document.getElementById('subCategoryImagePlaceholder');
        const removeBtn = document.getElementById('btnRemoveSubCategoryImage');
        if (url) {
            preview.src = url;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
            removeBtn.classList.remove('d-none');
            return;
        }
        preview.src = '';
        preview.classList.add('d-none');
        placeholder.classList.remove('d-none');
        placeholder.textContent = nameInitials(document.getElementById('subCategoryName').value);
        removeBtn.classList.add('d-none');
    }

    function previewSubCategoryImage() {
        const file = document.getElementById('subCategoryImage').files?.[0];
        if (!file) {
            return;
        }
        removeSubCategoryImage = false;
        setSubCategoryImagePreview(URL.createObjectURL(file));
        document.getElementById('btnRemoveSubCategoryImage').classList.remove('d-none');
    }

    function clearSubCategoryImage() {
        document.getElementById('subCategoryImage').value = '';
        removeSubCategoryImage = true;
        setSubCategoryImagePreview('');
    }

    function refreshSubCategoryPlaceholder() {
        if (document.getElementById('subCategoryImagePreview').classList.contains('d-none')) {
            document.getElementById('subCategoryImagePlaceholder').textContent =
                nameInitials(document.getElementById('subCategoryName').value);
        }
    }

    // 4. Event Handlers
    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        loadSubCategories(1);
    }

    // 5. Listing API
    async function loadSubCategories(page = 1) {
        currentPage = page;

        const filterCategoryID = adminSelect.getValue(document.getElementById('filterCategory')) || '';

        let filterCategoryIDs = '';
        if (filterCategoryID) {
            filterCategoryIDs = `[{"ID_Value":${filterCategoryID}}]`;
        }

        const input = {
            SearchText: '',
            FilterCategoryIDs: filterCategoryIDs,
            FilterSubCategoryIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: ''
        };

        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'SubCategory List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const rows = result.tableData ?? result.TableData ?? [];
            const settings = result.tableSettings ?? result.TableSettings;

            if (!rows?.length) {
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
                if (settings) {
                    displayPagination(settings);
                }
                return;
            }

            displaySubCategories(rows);
            displayPagination(settings);
        } catch (error) {
            listing.handleListingError(
                'SubCategory List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displaySubCategories(subCategories) {
        const tableBody = document.getElementById(TABLE_BODY_ID);
        tableBody.innerHTML = subCategories.map(subCat => createSubCategoryRow(subCat)).join('');
        initTableTooltips(tableBody);
    }

    // 7. Row Creation
    function createSubCategoryRow(subCat) {
        const cancelled = subCat.cancelled ?? subCat.Cancelled ?? false;
        const isActive = subCat.isActive ?? subCat.IsActive ?? true;
        const badgeClass = isActive ? 'bg-success' : 'bg-danger';
        const statusText = isActive ? 'Active' : 'Inactive';
        const id = subCat.id_SubCategory ?? subCat.iD_SubCategory ?? subCat.ID_SubCategory;
        const nameRaw = subCat.subCategoryName || subCat.SubCategoryName || '';
        const catRaw = subCat.categoryName || subCat.CategoryName || categoryMap[subCat.fkCategory ?? subCat.FK_Category] || 'N/A';
        const descRaw = subCat.description || subCat.Description || '';

        return `
            <tr>
                <td class="col-name">${renderListThumb(subCat.imageUrl || subCat.ImageUrl || '', nameRaw)}</td>
                <td class="col-category">${truncatedCellHtml(catRaw)}</td>
                <td class="col-desc">${truncatedCellHtml(descRaw)}</td>
                <td class="col-status">
                    <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip" data-bs-placement="top">${statusText}</span>
                </td>
                <td class="col-actions">
                    ${cancelled ? '' : `
                        <div class="table-actions">
                        <button type="button" class="btn-action" data-action="Edit" onclick="openEditModal(${id})" title="Edit" data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button type="button" class="btn-action" data-action="Delete" onclick="openDeleteModal(${id})" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="ti ti-trash"></i>
                        </button>
                        </div>
                    `}
                </td>
            </tr>
        `;
    }

    // 8. Create / Edit
    function openCreateModal() {
        document.getElementById('subCategoryModalLabel').textContent = 'Add SubCategory';
        document.getElementById('subCategoryForm').reset();
        document.getElementById('subCategoryID').value = '0';
        adminSelect.setValue(document.getElementById('fkCategory'), '');
        document.getElementById('subCategoryIsActive').checked = true;
        resetSubCategoryImage();
    }

    async function openEditModal(subCategoryID) {
        try {
            const response = await fetch(`${API.getById}/${subCategoryID}`);
            if (!response.ok) throw new Error('Failed to fetch subcategory');

            const subCategory = await response.json();
            const sid = subCategory.id_SubCategory ?? subCategory.iD_SubCategory ?? subCategory.ID_SubCategory;

            document.getElementById('subCategoryModalLabel').textContent = 'Edit SubCategory';
            document.getElementById('subCategoryID').value = String(sid);
            document.getElementById('subCategoryName').value = subCategory.subCategoryName || subCategory.SubCategoryName || '';
            adminSelect.setValue(
                document.getElementById('fkCategory'),
                subCategory.FK_Category ?? subCategory.fkCategory ?? subCategory.fK_Category ?? '');
            document.getElementById('description').value = subCategory.description || subCategory.Description || '';
            document.getElementById('subCategoryIsActive').checked =
                (subCategory.isActive ?? subCategory.IsActive ?? true) === true;
            resetSubCategoryImage();
            setSubCategoryImagePreview(subCategory.imageUrl || subCategory.ImageUrl || '');

            const modal = new bootstrap.Modal(document.getElementById('subCategoryModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading subcategory:', error);
            showError('Error', error.message || 'Could not load subcategory details.');
        }
    }

    async function saveSubCategory() {
        const subCategoryID = parseInt(document.getElementById('subCategoryID').value);
        const subCategoryName = document.getElementById('subCategoryName').value.trim();
        const fkCategory = parseInt(adminSelect.getValue(document.getElementById('fkCategory')), 10);
        const description = document.getElementById('description').value.trim();

        if (!subCategoryName) {
            showWarning('Validation', 'Please enter subcategory name.');
            return;
        }

        if (!fkCategory || fkCategory <= 0) {
            showWarning('Validation', 'Please select a category.');
            return;
        }

        const formData = new FormData();
        formData.append('SubCategoryID', String(subCategoryID));
        formData.append('SubCategoryName', subCategoryName);
        formData.append('FK_Category', String(fkCategory));
        formData.append('Description', description);
        formData.append('IsActive', document.getElementById('subCategoryIsActive').checked ? 'true' : 'false');
        formData.append('RemoveImage', removeSubCategoryImage ? 'true' : 'false');
        const imageFile = document.getElementById('subCategoryImage').files?.[0];
        if (imageFile) {
            formData.append('SubCategoryImage', imageFile);
        }

        const url = subCategoryID === 0 ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            let result = {};
            try {
                result = await response.json();
            } catch {
                result = {};
            }

            if (!response.ok) {
                const errMsg = result.responseMsg || result.ResponseMsg || result.message
                    || (Array.isArray(result.errors) ? result.errors.join(' ') : '')
                    || `Request failed (${response.status})`;
                showError('Could not save', errMsg);
                return;
            }

            if (result.statusCode ?? result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('subCategoryModal'));
                modal.hide();
                loadSubCategories(currentPage);
                showSuccess('Saved', result.responseMsg || result.ResponseMsg || 'SubCategory saved successfully.');
            } else {
                showError('Could not save', result.responseMsg || result.ResponseMsg || 'Error saving subcategory.');
            }
        } catch (error) {
            console.error('Error saving subcategory:', error);
            showError('Error', error.message || 'Error saving subcategory. Please try again.');
        }
    }

    // 9. Delete
    function openDeleteModal(subCategoryID) {
        document.getElementById('deleteSubCategoryID').value = subCategoryID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function confirmDelete() {
        const subCategoryID = parseInt(document.getElementById('deleteSubCategoryID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            SubCategoryID: subCategoryID,
            CancelledReason: reason
        };

        try {
            const response = await fetch(API.delete, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            let result = {};
            try {
                result = await response.json();
            } catch {
                result = {};
            }

            if (!response.ok) {
                const errMsg = result.responseMsg || result.ResponseMsg || result.message
                    || (Array.isArray(result.errors) ? result.errors.join(' ') : '')
                    || `Request failed (${response.status})`;
                showError('Could not delete', errMsg);
                return;
            }

            if (result.statusCode ?? result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadSubCategories(currentPage);
                showSuccess('Deleted', result.responseMsg || result.ResponseMsg || 'SubCategory deleted successfully.');
            } else {
                showError('Could not delete', result.responseMsg || result.ResponseMsg || 'Error deleting subcategory.');
            }
        } catch (error) {
            console.error('Error deleting subcategory:', error);
            showError('Error', error.message || 'Error deleting subcategory. Please try again.');
        }
    }

    // 10. Page-specific Helper Functions
    function displayPagination(settings) {
        if (!settings) return;

        const pageSize = settings.pageSize ?? settings.PageSize ?? 10;
        const pageIndex = settings.pageIndex ?? settings.PageIndex ?? 1;
        const totalCount = settings.totalCount ?? settings.TotalCount ?? 0;

        const totalPages = Math.ceil(totalCount / pageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((pageIndex - 1) * pageSize) + 1;
        const end = Math.min(pageIndex * pageSize, totalCount);
        paginationInfo.textContent = `${start} to ${end} of ${totalCount} entries`;

        let paginationHTML = '';

        if (pageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadSubCategories(${pageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= pageIndex - 1 && i <= pageIndex + 1)) {
                if (i === pageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadSubCategories(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === pageIndex - 2 || i === pageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        if (pageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadSubCategories(${pageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    async function loadCategories() {
        try {
            const response = await fetch(API.categories);
            if (!response.ok) throw new Error('Failed to fetch categories');

            categories = await response.json();
            categoryMap = {};
            categories.forEach(cat => {
                const cid = cat.categoryID ?? cat.CategoryID;
                const cname = cat.categoryName ?? cat.CategoryName ?? '';
                categoryMap[cid] = cname;
            });

            const items = categories
                .map(function (cat) {
                    const cid = cat.categoryID ?? cat.CategoryID;
                    const cname = cat.categoryName ?? cat.CategoryName ?? '';
                    if (!cid || !cname) return null;
                    return {
                        value: String(cid),
                        label: cname,
                        imageUrl: cat.imageUrl ?? cat.ImageUrl ?? ''
                    };
                })
                .filter(Boolean);

            adminSelect.fill(document.getElementById('filterCategory'), items, {
                placeholder: 'All Categories',
                searchPlaceholder: 'Search categories...'
            });
            adminSelect.fill(document.getElementById('fkCategory'), items, {
                placeholder: 'Select Category',
                searchPlaceholder: 'Search categories...'
            });
        } catch (error) {
            console.error('Error loading categories:', error);
        }
    }

    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '...' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
