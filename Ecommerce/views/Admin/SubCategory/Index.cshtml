@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ Main Content ] start -->
<div class="pc-container">
    <div class="pc-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <div class="page-header-title">
                            <h5 class="m-b-10">SubCategory Management</h5>
                        </div>
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                            <li class="breadcrumb-item"><a href="javascript: void(0)">SubCategory</a></li>
                            <li class="breadcrumb-item" aria-current="page">List</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>SubCategory List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#subCategoryModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New SubCategory
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Search and Filter -->
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <input type="text" id="searchText" class="form-control" placeholder="Search by subcategory name...">
                            </div>
                            <div class="col-md-2">
                                <select id="filterCategory" class="form-select">
                                    <option value="">All Categories</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <select id="pageSize" class="form-select">
                                    <option value="10">10 per page</option>
                                    <option value="25">25 per page</option>
                                    <option value="50">50 per page</option>
                                    <option value="100">100 per page</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-secondary w-100" onclick="loadSubCategories()">
                                    <i class="ti ti-search"></i> Search
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                                    <i class="ti ti-refresh"></i> Reset
                                </button>
                            </div>
                        </div>

                        <!-- SubCategory Table -->
                        <div class="table-responsive">
                            <table class="table table-hover table-borderless mb-0" id="subCategoryTable">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>SubCategory Name</th>
                                        <th>Category</th>
                                        <th>Description</th>
                                        <th>Created Date</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="subCategoryTableBody">
                                    <tr>
                                        <td colspan="7" class="text-center">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div id="paginationInfo" class="text-muted"></div>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
</div>

<!-- SubCategory Modal (Create/Edit) -->
<div class="modal fade" id="subCategoryModal" tabindex="-1" aria-labelledby="subCategoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="subCategoryModalLabel">Add SubCategory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="subCategoryForm">
                    <input type="hidden" id="subCategoryID" name="SubCategoryID" value="0">
                    <div class="mb-3">
                        <label for="subCategoryName" class="form-label">SubCategory Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="subCategoryName" name="SubCategoryName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="fkCategory" class="form-label">Category <span class="text-danger">*</span></label>
                        <select class="form-select" id="fkCategory" name="FK_Category" required>
                            <option value="">Select Category</option>
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSubCategory()">Save SubCategory</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete SubCategory</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this subcategory?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteSubCategoryID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;
    let categories = [];
    let categoryMap = {};

    // Load categories and subcategories on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadCategories();
        loadSubCategories();
        
        // Enter key search
        document.getElementById('searchText').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadSubCategories();
            }
        });
    });

    async function loadCategories() {
        try {
            const response = await fetch('/Admin/SubCategory/GetCategories');
            if (!response.ok) throw new Error('Failed to fetch categories');

            categories = await response.json();
            categoryMap = {};
            categories.forEach(cat => {
                categoryMap[cat.CategoryID] = cat.CategoryName;
            });

            // Populate category dropdowns
            const filterDropdown = document.getElementById('filterCategory');
            const formDropdown = document.getElementById('fkCategory');
            
            filterDropdown.innerHTML = '<option value="">All Categories</option>';
            formDropdown.innerHTML = '<option value="">Select Category</option>';
            
            categories.forEach(cat => {
                if (!cat.Cancelled) {
                    const option1 = new Option(cat.CategoryName, cat.CategoryID);
                    const option2 = new Option(cat.CategoryName, cat.CategoryID);
                    filterDropdown.add(option1);
                    formDropdown.add(option2);
                }
            });
        } catch (error) {
            console.error('Error loading categories:', error);
        }
    }

    async function loadSubCategories(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        const searchText = document.getElementById('searchText').value || '';
        const filterCategoryID = document.getElementById('filterCategory').value || '';

        let filterCategoryIDs = '';
        if (filterCategoryID) {
            filterCategoryIDs = `[{"ID_Value":${filterCategoryID}}]`;
        }

        const input = {
            SearchText: searchText,
            FilterCategoryIDs: filterCategoryIDs,
            FilterSubCategoryIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: '',
            SortMode: ''
        };

        try {
            const response = await fetch('/Admin/SubCategory/GetSubCategoryList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            const data = await response.json();
            displaySubCategories(data.TableData || []);
            displayPagination(data.TableSettings);
        } catch (error) {
            console.error('Error loading subcategories:', error);
            document.getElementById('subCategoryTableBody').innerHTML = 
                '<tr><td colspan="7" class="text-center text-danger">Error loading subcategories. Please try again.</td></tr>';
        }
    }

    function displaySubCategories(subCategories) {
        const tbody = document.getElementById('subCategoryTableBody');
        
        if (!subCategories || subCategories.length === 0) {
            tbody.innerHTML = '<tr><td colspan="7" class="text-center">No subcategories found.</td></tr>';
            return;
        }

        tbody.innerHTML = subCategories.map(subCat => `
            <tr>
                <td>${subCat.ID_SubCategory}</td>
                <td>${escapeHtml(subCat.SubCategoryName)}</td>
                <td>${escapeHtml(categoryMap[subCat.FK_Category] || 'N/A')}</td>
                <td>${escapeHtml(subCat.Description || '')}</td>
                <td>${subCat.CreatedDate ? new Date(subCat.CreatedDate).toLocaleDateString() : '-'}</td>
                <td>
                    <span class="badge ${subCat.Cancelled ? 'bg-danger' : 'bg-success'}">
                        ${subCat.Cancelled ? 'Deleted' : 'Active'}
                    </span>
                </td>
                <td class="text-end">
                    ${subCat.Cancelled ? '' : `
                        <button class="btn btn-sm btn-primary" onclick="openEditModal(${subCat.ID_SubCategory})" title="Edit">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="openDeleteModal(${subCat.ID_SubCategory})" title="Delete">
                            <i class="ti ti-trash"></i>
                        </button>
                    `}
                </td>
            </tr>
        `).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        paginationInfo.textContent = `Showing ${((settings.PageIndex - 1) * settings.PageSize) + 1} to ${Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount)} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        paginationHTML += `<li class="page-item ${settings.PageIndex <= 1 ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadSubCategories(${settings.PageIndex - 1}); return false;">Previous</a>
        </li>`;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 2 && i <= settings.PageIndex + 2)) {
                paginationHTML += `<li class="page-item ${i === settings.PageIndex ? 'active' : ''}">
                    <a class="page-link" href="#" onclick="loadSubCategories(${i}); return false;">${i}</a>
                </li>`;
            } else if (i === settings.PageIndex - 3 || i === settings.PageIndex + 3) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        paginationHTML += `<li class="page-item ${settings.PageIndex >= totalPages ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadSubCategories(${settings.PageIndex + 1}); return false;">Next</a>
        </li>`;

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('subCategoryModalLabel').textContent = 'Add SubCategory';
        document.getElementById('subCategoryForm').reset();
        document.getElementById('subCategoryID').value = '0';
        document.getElementById('fkCategory').value = '';
    }

    async function openEditModal(subCategoryID) {
        try {
            const response = await fetch(`/Admin/SubCategory/GetById/${subCategoryID}`);
            if (!response.ok) throw new Error('Failed to fetch subcategory');

            const subCategory = await response.json();
            
            document.getElementById('subCategoryModalLabel').textContent = 'Edit SubCategory';
            document.getElementById('subCategoryID').value = subCategory.ID_SubCategory;
            document.getElementById('subCategoryName').value = subCategory.SubCategoryName || '';
            document.getElementById('fkCategory').value = subCategory.FK_Category || '';
            document.getElementById('description').value = subCategory.Description || '';
            
            const modal = new bootstrap.Modal(document.getElementById('subCategoryModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading subcategory:', error);
            alert('Error loading subcategory details.');
        }
    }

    function openDeleteModal(subCategoryID) {
        document.getElementById('deleteSubCategoryID').value = subCategoryID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveSubCategory() {
        const subCategoryID = parseInt(document.getElementById('subCategoryID').value);
        const subCategoryName = document.getElementById('subCategoryName').value.trim();
        const fkCategory = parseInt(document.getElementById('fkCategory').value);
        const description = document.getElementById('description').value.trim();

        if (!subCategoryName) {
            alert('Please enter subcategory name.');
            return;
        }

        if (!fkCategory || fkCategory <= 0) {
            alert('Please select a category.');
            return;
        }

        const input = {
            SubCategoryID: subCategoryID,
            SubCategoryName: subCategoryName,
            FK_Category: fkCategory,
            Description: description
        };

        const url = subCategoryID === 0 ? '/Admin/SubCategory/Create' : '/Admin/SubCategory/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('subCategoryModal'));
                modal.hide();
                loadSubCategories(currentPage);
                alert(result.ResponseMsg || 'SubCategory saved successfully.');
            } else {
                alert(result.ResponseMsg || 'Error saving subcategory.');
            }
        } catch (error) {
            console.error('Error saving subcategory:', error);
            alert('Error saving subcategory. Please try again.');
        }
    }

    async function confirmDelete() {
        const subCategoryID = parseInt(document.getElementById('deleteSubCategoryID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            SubCategoryID: subCategoryID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/SubCategory/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadSubCategories(currentPage);
                alert(result.ResponseMsg || 'SubCategory deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting subcategory.');
            }
        } catch (error) {
            console.error('Error deleting subcategory:', error);
            alert('Error deleting subcategory. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('filterCategory').value = '';
        document.getElementById('pageSize').value = '10';
        loadSubCategories(1);
    }

    function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
