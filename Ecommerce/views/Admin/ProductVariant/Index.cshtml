@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Product Variant (SKU) Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Product Variant</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Product Variant (SKU) List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productVariantModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New SKU
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Product Selection -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="selectProduct" class="form-label">Select Product <span class="text-danger">*</span></label>
                                <select id="selectProduct" class="form-select" onchange="onProductChange()">
                                    <option value="">-- Select Product --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" class="btn btn-secondary w-100" onclick="loadProductVariants()" id="btnLoadVariants" disabled>
                                    <i class="ti ti-search"></i> Load SKUs
                                </button>
                            </div>
                        </div>

                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap" id="filterSection" style="display: none;">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search SKUs...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadProductVariants()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Variant Table -->
                        <div class="table-container" id="tableSection" style="display: none;">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="productVariantTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">SKU</th>
                                            <th class="text-muted">Product</th>
                                            <th class="text-muted">Combination</th>
                                            <th class="text-muted">Label</th>
                                            <th class="text-muted">MRP</th>
                                            <th class="text-muted">Price</th>
                                            <th class="text-muted">Active</th>
                                            <th class="text-muted">Default</th>
                                            <th class="text-muted">Created</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productVariantTableBody">
                                        <tr>
                                            <td colspan="11" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper" id="paginationSection" style="display: none;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadProductVariants()">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Product Variant Modal (Create/Edit) -->
<div class="modal fade" id="productVariantModal" tabindex="-1" aria-labelledby="productVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productVariantModalLabel">Add Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productVariantForm">
                    <input type="hidden" id="productVariantID" name="ID_ProductVariant" value="0">
                    <div class="mb-3">
                        <label for="modalProduct" class="form-label">Product <span class="text-danger">*</span></label>
                        <select class="form-select" id="modalProduct" name="FK_Product" required>
                            <option value="">Select Product</option>
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="sku" class="form-label">SKU <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="sku" name="SKU" maxlength="100" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="mrp" class="form-label">MRP</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="mrp" name="MRP" value="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="sellingPrice" class="form-label">Selling price <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="sellingPrice" name="SellingPrice" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="variantLabel" class="form-label">Variant label</label>
                        <input type="text" class="form-control" id="variantLabel" name="VariantLabel" maxlength="255" placeholder="Leave blank to auto-generate from values">
                        <div class="form-text" id="variantLabelPreview"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Variant values <span class="text-danger">*</span></label>
                        <div id="variantAttributesContainer">
                            <div class="variant-attribute-row mb-2">
                                <div class="row">
                                    <div class="col-md-5">
                                        <select class="form-select variant-select" required onchange="onVariantChange(this)">
                                            <option value="">Select Variant</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                                            <option value="">Select Value</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addVariantAttribute()">
                            <i class="ti ti-plus"></i> Add value
                        </button>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isActive" name="IsActive" checked>
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isDefault" name="IsDefault">
                            <label class="form-check-label" for="isDefault">
                                Is Default SKU
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveProductVariant()">Save SKU</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this SKU?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteProductVariantID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 20;
    let selectedProductId = 0;
    let products = [];
    let variants = [];
    let variantValues = [];
    let variantValueMap = {}; // Map variant ID to its values
    let productVariantSearchTimeout;
    let autoSkuEnabled = true;
    let autoLabelEnabled = true;
    let lastGeneratedSku = '';
    let lastGeneratedLabel = '';

    document.addEventListener('DOMContentLoaded', function() {
        loadProducts();
        loadVariants();

        const skuInput = document.getElementById('sku');
        const labelInput = document.getElementById('variantLabel');
        const modalProduct = document.getElementById('modalProduct');

        skuInput?.addEventListener('input', function () {
            const current = (this.value || '').trim();
            if (!current) {
                autoSkuEnabled = true;
                updateVariantLabelPreview();
                return;
            }
            autoSkuEnabled = current === lastGeneratedSku;
        });

        labelInput?.addEventListener('input', function () {
            const current = (this.value || '').trim();
            if (!current) {
                autoLabelEnabled = true;
                updateVariantLabelPreview();
                return;
            }
            autoLabelEnabled = current === lastGeneratedLabel;
        });

        modalProduct?.addEventListener('change', function () {
            updateVariantLabelPreview();
        });

        document.getElementById('searchText')?.addEventListener('input', function () {
            const value = this.value.trim();
            clearTimeout(productVariantSearchTimeout);
            productVariantSearchTimeout = setTimeout(function () {
                if (value.length === 0 || value.length >= 1) {
                    if ((parseInt(document.getElementById('selectProduct').value, 10) || 0) > 0) {
                        loadProductVariants(1);
                    }
                }
            }, 500);
        });
    });

    async function loadProducts() {
        try {
            // ProductListInputVIEW enforces PageSize <= 100
            const maxPageSize = 100;
            const all = [];
            let page = 1;
            let totalCount = null;

            // Fetch pages until we have all rows (for dropdown usage)
            while (totalCount == null || all.length < totalCount) {
            const response = await fetch('/Admin/Product/GetProductList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        PageIndex: page,
                        PageSize: maxPageSize,
                        SearchText: '',
                        FilterCategoryIDs: '',
                        FilterSubCategoryIDs: '',
                        FilterBrandIDs: '',
                        SortColumn: 0,
                        SortMode: 'ASC'
                    })
            });
            if (!response.ok) throw new Error('Failed to fetch products');

                const payload = await response.json();
                const success = payload.success ?? payload.Success ?? true;
                if (!success) {
                    throw new Error(payload.message ?? payload.Message ?? 'Failed to fetch products');
                }

                const data = payload.data ?? payload.Data ?? payload;
                const rows = data.tableData ?? data.TableData ?? [];
                const settings = data.tableSettings ?? data.TableSettings ?? null;

                all.push(...rows);
                if (settings && (settings.totalCount ?? settings.TotalCount) != null) {
                    totalCount = Number(settings.totalCount ?? settings.TotalCount) || 0;
                } else if (rows.length < maxPageSize) {
                    totalCount = all.length;
                }

                if (rows.length < maxPageSize) {
                    break;
                }
                page++;
            }

            products = all;

            const selectProduct = document.getElementById('selectProduct');
            const modalProduct = document.getElementById('modalProduct');
            
            selectProduct.innerHTML = '<option value="">-- Select Product --</option>';
            modalProduct.innerHTML = '<option value="">Select Product</option>';
            
            products.forEach(p => {
                const cancelled = p.cancelled ?? p.Cancelled;
                const pid = p.productId ?? p.ID_Product ?? p.iD_Product;
                const pname = p.name ?? p.Name ?? '';
                if (!cancelled && pid > 0) {
                    selectProduct.add(new Option(pname, String(pid)));
                    modalProduct.add(new Option(pname, String(pid)));
                }
            });
        } catch (error) {
            console.error('Error loading products:', error);
        }
    }

    async function loadVariants() {
        try {
            // VariantListInputVIEW enforces PageSize <= 100
            const response = await fetch('/Admin/Variant/GetVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    PageIndex: 1,
                    PageSize: 100,
                    SearchText: '',
                    FilterVariantIDs: '',
                    SortColumn: 0,
                    SortMode: 'ASC'
                })
            });
            if (!response.ok) throw new Error('Failed to fetch variants');

            const payload = await response.json();
            const success = payload.success ?? payload.Success ?? true;
            if (!success) {
                throw new Error(payload.message ?? payload.Message ?? 'Failed to fetch variants');
            }
            const data = payload.data ?? payload.Data ?? payload;
            variants = (data.tableData ?? data.TableData) ?? [];
            // Load variant values on-demand per selected variant (see fetchVariantValuesByVariantId)
            variantValues = [];
            variantValueMap = {};

            // Populate variant dropdowns in modal
            const variantSelects = document.querySelectorAll('.variant-select');
            variantSelects.forEach(select => {
                select.innerHTML = '<option value="">Select Variant</option>';
                variants.forEach(v => {
                    const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
                    const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
                    if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                        select.add(new Option(vname, vid));
                    }
                });
            });
        } catch (error) {
            console.error('Error loading variants:', error);
        }
    }

    async function fetchVariantValuesByVariantId(variantId) {
        const vid = Number(variantId) || 0;
        if (vid <= 0) return [];

        const key = String(vid);
        if (Array.isArray(variantValueMap[key]) && variantValueMap[key].length > 0) {
            return variantValueMap[key];
        }

        const response = await fetch(`/Admin/VariantValue/GetByVariant/${vid}`);
        if (!response.ok) {
            throw new Error('Failed to fetch variant values');
        }

        const rows = await response.json();
        const list = Array.isArray(rows) ? rows : [];

        variantValueMap[key] = list;
        return list;
    }

    function onProductChange() {
        selectedProductId = parseInt(document.getElementById('selectProduct').value) || 0;
        document.getElementById('btnLoadVariants').disabled = selectedProductId === 0;
        if (selectedProductId === 0) {
            document.getElementById('filterSection').style.display = 'none';
            document.getElementById('tableSection').style.display = 'none';
            document.getElementById('paginationSection').style.display = 'none';
        }
    }

    async function loadProductVariants(page = 1) {
        if (selectedProductId === 0) {
            showWarning('Validation Error', 'Please select a product first.');
            return;
        }

        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize')?.value) || 20;
        const searchText = document.getElementById('searchText')?.value || '';

        const input = {
            FK_Product: selectedProductId,
            SearchText: searchText,
            FilterVariantIDs: '',
            FilterVariantValueIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: 'ASC'
        };

        try {
            const response = await fetch('/Admin/ProductVariant/GetProductVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) throw new Error('Network response was not ok');

            const data = await response.json();
            const rows = data.tableData ?? data.TableData ?? [];
            const settings = data.tableSettings ?? data.TableSettings;
            displayProductVariants(rows);
            displayPagination(settings);
            
            document.getElementById('filterSection').style.display = 'block';
            document.getElementById('tableSection').style.display = 'block';
            document.getElementById('paginationSection').style.display = 'block';
        } catch (error) {
            console.error('Error loading product variants:', error);
            const tbody = document.getElementById('productVariantTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="11" class="empty-state">
                        <i class="ti ti-alert-circle"></i>
                        <h5>Error loading SKUs</h5>
                        <p class="text-muted">${escapeHtml(error.message || 'An error occurred while loading SKUs. Please try again.')}</p>
                    </td>
                </tr>
            `;
            showError('Error', error?.message || 'Error loading SKUs. Please try again.');
        }
    }

    function displayProductVariants(variants) {
        const tbody = document.getElementById('productVariantTableBody');
        
        if (!variants || variants.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="11" class="empty-state">
                        <i class="ti ti-package-off"></i>
                        <h5>No SKUs found</h5>
                        <p class="text-muted">No SKUs found for this product. Try selecting a different product.</p>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = variants.map(pv => {
            const id = pv.idProductVariant ?? pv.ID_ProductVariant;
            const sku = pv.sku ?? pv.SKU ?? '';
            const longCombo = pv.combination ?? pv.Combination ?? '';
            const shortSig = pv.attributeSignature ?? pv.AttributeSignature ?? '';
            const combo = longCombo || shortSig;
            const label = pv.variantLabel ?? pv.VariantLabel ?? '';
            const pname = pv.productName ?? pv.ProductName ?? '';
            const mrp = Number(pv.mrp ?? pv.MRP ?? 0);
            const sp = Number(pv.price ?? pv.Price ?? pv.sellingPrice ?? pv.SellingPrice ?? 0);
            const isDef = pv.isDefault ?? pv.IsDefault;
            const isAct = pv.isActive ?? pv.IsActive;
            const created = pv.createdAt ?? pv.CreatedAt;
            const defaultClass = isDef ? 'badge-active' : 'bg-secondary';
            const defaultText = isDef ? 'Yes' : 'No';
            const activeClass = isAct ? 'badge-active' : 'bg-secondary';
            const activeText = isAct ? 'Yes' : 'No';
            return `
                <tr>
                    <td>${id}</td>
                    <td>${escapeHtml(sku)}</td>
                    <td>${escapeHtml(pname || '—')}</td>
                    <td>${escapeHtml(combo || '—')}</td>
                    <td>${escapeHtml(label || '—')}</td>
                    <td>${mrp.toFixed(2)}</td>
                    <td>${sp.toFixed(2)}</td>
                    <td><span class="badge ${activeClass}">${activeText}</span></td>
                    <td><span class="badge ${defaultClass}">${defaultText}</span></td>
                    <td>${created ? new Date(created).toLocaleDateString() : '—'}</td>
                    <td class="text-end">
                        <button class="btn-action" onclick="openEditModal(${id})" title="Edit">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn-action" onclick="openDeleteModal(${id})" title="Delete">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const pageIndex = Number(settings.pageIndex ?? settings.PageIndex ?? 1);
        const pageSize = Number(settings.pageSize ?? settings.PageSize ?? 20);
        const totalCount = Number(settings.totalCount ?? settings.TotalCount ?? 0);

        const totalPages = Math.ceil(totalCount / pageSize) || 1;
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = totalCount === 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
        const end = Math.min(pageIndex * pageSize, totalCount);
        paginationInfo.textContent = `${start} to ${end} of ${totalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (pageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${pageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= pageIndex - 1 && i <= pageIndex + 1)) {
                if (i === pageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadProductVariants(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === pageIndex - 2 || i === pageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (pageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${pageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('productVariantModalLabel').textContent = 'Add Product Variant (SKU)';
        document.getElementById('productVariantForm').reset();
        document.getElementById('productVariantID').value = '0';
        document.getElementById('modalProduct').value = selectedProductId || '';
        document.getElementById('sku').value = '';
        document.getElementById('mrp').value = '0';
        document.getElementById('sellingPrice').value = '';
        document.getElementById('variantLabel').value = '';
        document.getElementById('variantLabelPreview').textContent = '';
        document.getElementById('isActive').checked = true;
        document.getElementById('isDefault').checked = false;
        autoSkuEnabled = true;
        autoLabelEnabled = true;
        lastGeneratedSku = '';
        lastGeneratedLabel = '';
        
        // Reset variant attributes to one row
        const container = document.getElementById('variantAttributesContainer');
        container.innerHTML = `
            <div class="variant-attribute-row mb-2">
                <div class="row">
                    <div class="col-md-5">
                        <select class="form-select variant-select" required onchange="onVariantChange(this)">
                            <option value="">Select Variant</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                            <option value="">Select Value</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
        populateVariantDropdowns();
        updateVariantLabelPreview();
    }

    async function openEditModal(productVariantID) {
        try {
            autoSkuEnabled = false;
            autoLabelEnabled = false;

            const response = await fetch(`/Admin/ProductVariant/GetById/${productVariantID}`);
            if (!response.ok) throw new Error('Failed to fetch product variant');

            const pv = await response.json();
            
            document.getElementById('productVariantModalLabel').textContent = 'Edit Product Variant (SKU)';
            document.getElementById('productVariantID').value = pv.idProductVariant ?? pv.ID_ProductVariant;
            document.getElementById('modalProduct').value = pv.fkProduct ?? pv.FK_Product;
            document.getElementById('sku').value = pv.sku ?? pv.SKU ?? '';
            document.getElementById('mrp').value = String(pv.mrp ?? pv.MRP ?? 0);
            document.getElementById('sellingPrice').value = String(pv.sellingPrice ?? pv.SellingPrice ?? '');
            document.getElementById('variantLabel').value = pv.variantLabel ?? pv.VariantLabel ?? '';
            document.getElementById('isActive').checked = pv.isActive ?? pv.IsActive ?? true;
            document.getElementById('isDefault').checked = pv.isDefault ?? pv.IsDefault ?? false;
            
            const container = document.getElementById('variantAttributesContainer');
            container.innerHTML = '';
            const vvList = pv.variantValues ?? pv.VariantValues;
            const attrList = pv.attributes ?? pv.Attributes ?? [];
            if (vvList && vvList.length > 0) {
                vvList.forEach(rv => {
                    const vid = rv.variantId ?? rv.VariantId ?? rv.fkVariant ?? rv.FK_Variant;
                    const vvid = rv.variantValueId ?? rv.VariantValueId ?? rv.fkVariantValue ?? rv.FK_VariantValue;
                    addVariantAttributeRow(vid, vvid);
                });
            } else if (attrList.length > 0) {
                attrList.forEach(attr => {
                    const vid = attr.fkVariant ?? attr.FK_Variant;
                    const vvid = attr.fkVariantValue ?? attr.FK_VariantValue;
                    addVariantAttributeRow(vid, vvid);
                });
            } else {
                addVariantAttributeRow();
            }
            
            updateVariantLabelPreview();
            const modal = new bootstrap.Modal(document.getElementById('productVariantModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading product variant:', error);
            showError('Error', 'Error loading SKU details.');
        }
    }

    function addVariantAttribute() {
        addVariantAttributeRow();
    }

    function addVariantAttributeRow(selectedVariantId = null, selectedValueId = null) {
        const container = document.getElementById('variantAttributesContainer');
        const row = document.createElement('div');
        row.className = 'variant-attribute-row mb-2';
        row.innerHTML = `
            <div class="row">
                <div class="col-md-5">
                    <select class="form-select variant-select" required onchange="onVariantChange(this)">
                        <option value="">Select Variant</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                        <option value="">Select Value</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                        <i class="ti ti-trash"></i>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
        
        const variantSelect = row.querySelector('.variant-select');
        const valueSelect = row.querySelector('.variant-value-select');
        
        // Populate variants
        variants.forEach(v => {
            const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
            const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
            if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                const option = new Option(vname, vid);
                if (selectedVariantId != null && selectedVariantId !== '' && Number(vid) === Number(selectedVariantId)) {
                    option.selected = true;
                }
                variantSelect.add(option);
            }
        });
        
        // If variant is selected, populate values
        if (selectedVariantId) {
            (async () => {
                try {
                    const rows = await fetchVariantValuesByVariantId(selectedVariantId);
                    populateVariantValues(valueSelect, selectedVariantId, selectedValueId, rows);
                } catch (e) {
                    console.error('Error loading variant values:', e);
                    populateVariantValues(valueSelect, 0);
                } finally {
                    updateVariantLabelPreview();
                }
            })();
        }
        updateVariantLabelPreview();
    }

    function populateVariantDropdowns() {
        const variantSelects = document.querySelectorAll('.variant-select');
        variantSelects.forEach(select => {
            select.innerHTML = '<option value="">Select Variant</option>';
            variants.forEach(v => {
                const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
                const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
                if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                    select.add(new Option(vname, vid));
                }
            });
        });
        updateVariantLabelPreview();
    }

    function onVariantChange(select) {
        const row = select.closest('.variant-attribute-row');
        const valueSelect = row.querySelector('.variant-value-select');
        const variantId = parseInt(select.value, 10);
        (async () => {
            try {
                const rows = await fetchVariantValuesByVariantId(variantId);
                populateVariantValues(valueSelect, variantId, null, rows);
            } catch (e) {
                console.error('Error loading variant values:', e);
                populateVariantValues(valueSelect, 0);
            } finally {
                updateVariantLabelPreview();
            }
        })();
    }

    function populateVariantValues(valueSelect, variantId, selectedValueId = null, overrideRows = null) {
        valueSelect.innerHTML = '<option value="">Select Value</option>';
        const key = String(Number(variantId) || 0);
        const source = overrideRows ?? (key !== '0' ? variantValueMap[key] : null);
        if (Array.isArray(source) && source.length > 0) {
            source.forEach(vv => {
                const vvid =
                    vv.variantValueID ?? vv.VariantValueID ??
                    vv.idVariantValue ?? vv.IdVariantValue ??
                    vv.id_VariantValue ?? vv.ID_VariantValue ?? vv.iD_VariantValue;
                const vvn = vv.name ?? vv.Name ?? vv.valueName ?? vv.ValueName ?? '';
                if (!vvid) return;
                const option = new Option(vvn, vvid);
                if (selectedValueId != null && selectedValueId !== '' && Number(vvid) === Number(selectedValueId)) {
                    option.selected = true;
                }
                valueSelect.add(option);
            });
        }
        updateVariantLabelPreview();
    }

    function updateVariantLabelPreview() {
        const el = document.getElementById('variantLabelPreview');
        if (!el) return;
        const auto = getAutoVariantLabel();
        const skuAuto = getAutoSku(auto);

        lastGeneratedLabel = auto;
        lastGeneratedSku = skuAuto;

        const skuInput = document.getElementById('sku');
        const labelInput = document.getElementById('variantLabel');

        if (labelInput && autoLabelEnabled) {
            labelInput.value = auto;
        }
        if (skuInput && autoSkuEnabled) {
            skuInput.value = skuAuto;
        }

        if (auto || skuAuto) {
            const parts = [];
            if (auto) {
                parts.push(`Auto label: ${auto}`);
            }
            if (skuAuto) {
                parts.push(`Auto SKU: ${skuAuto}`);
            }
            el.textContent = parts.join(' | ');
        } else {
            el.textContent = '';
        }
    }

    function getAutoVariantLabel() {
        const rows = [];
        document.querySelectorAll('.variant-attribute-row').forEach(row => {
            const vs = row.querySelector('.variant-select');
            const vsel = row.querySelector('.variant-value-select');
            const vvid = parseInt(vsel.value, 10) || 0;
            if (!vvid) return;
            const vname = vs.options[vs.selectedIndex]?.text?.trim() || '';
            const valName = vsel.options[vsel.selectedIndex]?.text?.trim() || '';
            if (valName) rows.push({ vname, valName });
        });
        rows.sort((a, b) => a.vname.localeCompare(b.vname, undefined, { sensitivity: 'base' }));
        return rows.map(r => r.valName).filter(Boolean).join(' - ');
    }

    function getAutoSku(autoLabel) {
        const productSelect = document.getElementById('modalProduct');
        const productName = productSelect?.options?.[productSelect.selectedIndex]?.text?.trim() || '';
        const safeProduct = normalizeSkuPart(productName);
        const safeLabel = normalizeSkuPart(autoLabel || '');
        const parts = [safeProduct, safeLabel].filter(Boolean);
        return parts.join('-').slice(0, 100);
    }

    function normalizeSkuPart(text) {
        return (text || '')
            .toUpperCase()
            .replace(/[^A-Z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }

    function removeVariantAttribute(button) {
        const container = document.getElementById('variantAttributesContainer');
        if (container.children.length > 1) {
            button.closest('.variant-attribute-row').remove();
            updateVariantLabelPreview();
        } else {
            showWarning('Validation Error', 'At least one variant value is required.');
        }
    }

    function openDeleteModal(productVariantID) {
        document.getElementById('deleteProductVariantID').value = productVariantID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    /** Returns { variantId, variantValueId }[]; throws Error on duplicate variant or value in form. */
    function collectVariantValuesFromForm() {
        const out = [];
        const seenVariant = new Set();
        const seenValue = new Set();
        document.querySelectorAll('.variant-attribute-row').forEach(row => {
            const variantSelect = row.querySelector('.variant-select');
            const valueSelect = row.querySelector('.variant-value-select');
            const variantId = parseInt(variantSelect.value, 10);
            const variantValueId = parseInt(valueSelect.value, 10);
            if (!variantId || !variantValueId) {
                return;
            }
            if (seenVariant.has(variantId)) {
                throw new Error('Each variant type may only appear once in the form.');
            }
            if (seenValue.has(variantValueId)) {
                throw new Error('Duplicate variant value selected.');
            }
            seenVariant.add(variantId);
            seenValue.add(variantValueId);
            out.push({ variantId, variantValueId });
        });
        return out;
    }

    async function saveProductVariant() {
        const productVariantID = parseInt(document.getElementById('productVariantID').value, 10);
        const fkProduct = parseInt(document.getElementById('modalProduct').value, 10);
        const labelInput = document.getElementById('variantLabel');
        const skuInput = document.getElementById('sku');
        let variantLabel = (labelInput.value || '').trim();
        let sku = (skuInput.value || '').trim();
        const mrp = parseFloat(document.getElementById('mrp').value) || 0;
        const sellingPrice = parseFloat(document.getElementById('sellingPrice').value);
        const isActive = document.getElementById('isActive').checked;
        const isDefault = document.getElementById('isDefault').checked;

        if (!fkProduct || fkProduct <= 0) {
            showWarning('Validation Error', 'Please select a product.');
            return;
        }
        if (!variantLabel) {
            variantLabel = getAutoVariantLabel();
            labelInput.value = variantLabel;
        }
        if (!sku) {
            sku = getAutoSku(variantLabel);
            skuInput.value = sku;
        }
        if (!sku) {
            showWarning('Validation Error', 'Please select product and variant values to auto-generate SKU, or enter SKU manually.');
            return;
        }
        if (!Number.isFinite(sellingPrice) || sellingPrice <= 0) {
            showWarning('Validation Error', 'Selling price must be greater than zero.');
            return;
        }

        let variantValues;
        try {
            variantValues = collectVariantValuesFromForm();
        } catch (e) {
            showWarning('Validation Error', e?.message || 'Invalid variant selection.');
            return;
        }

        if (variantValues.length === 0) {
            showWarning('Validation Error', 'Please add at least one complete variant row (variant + value).');
            return;
        }

        const input = {
            ID_ProductVariant: productVariantID,
            FK_Product: fkProduct,
            SKU: sku,
            MRP: mrp,
            SellingPrice: sellingPrice,
            VariantLabel: variantLabel,
            IsActive: isActive,
            IsDefault: isDefault,
            VariantValues: variantValues
        };

        const url = productVariantID === 0 ? '/Admin/ProductVariant/Create' : '/Admin/ProductVariant/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            let result = null;
            try {
                result = await response.json();
            } catch {
                result = null;
            }

            // Handle MVC validation 400s that return { message, errors }
            if (!response.ok) {
                handleApiError?.('failure', 'Save SKU', { url, method: 'POST', payload: input, response, result });
                const msg = result?.message || result?.Message || 'Validation failed.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showWarning('Validation Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showWarning('Validation Error', msg);
                }
                return;
            }

            const ok =
                (result?.statusCode ?? result?.StatusCode) === true ||
                (result?.success ?? result?.Success) === true;

            if (ok) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('productVariantModal'));
                modal.hide();
                loadProductVariants(currentPage);
                const msg = result?.responseMsg ?? result?.ResponseMsg ?? result?.message ?? result?.Message;
                showSuccess('Success', msg || 'SKU saved successfully.');
            } else {
                handleApiError?.('failure', 'Save SKU (business)', { url, method: 'POST', payload: input, response, result });
                // CommonResponse { StatusCode, ResponseMsg } OR other error shapes
                const msg = result?.responseMsg ?? result?.ResponseMsg ?? result?.message ?? result?.Message;
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showError('Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showError('Error', msg);
                }
            }
        } catch (error) {
            handleApiError?.('crash', 'Save SKU', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error saving SKU. Please try again.');
        }
    }

    async function confirmDelete() {
        const productVariantID = parseInt(document.getElementById('deleteProductVariantID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            ID_ProductVariant: productVariantID,
            CancelledReason: reason
        };

        try {
            const url = '/Admin/ProductVariant/Delete';
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            let result = null;
            try {
                result = await response.json();
            } catch {
                result = null;
            }

            if (!response.ok) {
                handleApiError?.('failure', 'Delete SKU', { url, method: 'POST', payload: input, response, result });
                const msg = result?.message || result?.Message || result?.ResponseMsg || 'Error deleting SKU.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showError('Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showError('Error', msg);
                }
                return;
            }

            if (result?.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadProductVariants(currentPage);
                showSuccess('Success', result?.ResponseMsg || 'SKU deleted successfully.');
            } else {
                handleApiError?.('failure', 'Delete SKU (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result?.ResponseMsg || 'Error deleting SKU.');
            }
        } catch (error) {
            handleApiError?.('crash', 'Delete SKU', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error deleting SKU. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '20';
        loadProductVariants(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
