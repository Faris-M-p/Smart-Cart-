    // 10. Page-specific Helper Functions
    function displayPagination(settings) {
        if (!settings) return;

        const pageIndex = Number(settings.pageIndex ?? settings.PageIndex ?? 1);
        const pageSize = Number(settings.pageSize ?? settings.PageSize ?? 10);
        const totalCount = Number(settings.totalCount ?? settings.TotalCount ?? 0);

        const totalPages = Math.ceil(totalCount / pageSize) || 1;
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = totalCount === 0 ? 0 : ((pageIndex - 1) * pageSize) + 1;
        const end = Math.min(pageIndex * pageSize, totalCount);
        paginationInfo.textContent = `${start} to ${end} of ${totalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (pageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${pageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= pageIndex - 1 && i <= pageIndex + 1)) {
                if (i === pageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadProductVariants(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === pageIndex - 2 || i === pageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (pageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${pageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    async function loadProducts() {
        try {
            // ProductListInputVIEW enforces PageSize <= 100
            const maxPageSize = 100;
            const all = [];
            let page = 1;
            let totalCount = null;

            // Fetch pages until we have all rows (for dropdown usage)
            while (totalCount == null || all.length < totalCount) {
            const response = await fetch(API.getProductList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        PageIndex: page,
                        PageSize: maxPageSize,
                        SearchText: '',
                        FilterCategoryIDs: '',
                        FilterSubCategoryIDs: '',
                        FilterBrandIDs: '',
                        SortColumn: 0,
                        SortMode: 'ASC'
                    })
            });
            if (!response.ok) throw new Error('Failed to fetch products');

                const payload = await response.json();
                const success = payload.success ?? payload.Success ?? true;
                if (!success) {
                    throw new Error(payload.message ?? payload.Message ?? 'Failed to fetch products');
                }

                const data = payload.data ?? payload.Data ?? payload;
                const rows = data.tableData ?? data.TableData ?? [];
                const settings = data.tableSettings ?? data.TableSettings ?? null;

                all.push(...rows);
                if (settings && (settings.totalCount ?? settings.TotalCount) != null) {
                    totalCount = Number(settings.totalCount ?? settings.TotalCount) || 0;
                } else if (rows.length < maxPageSize) {
                    totalCount = all.length;
                }

                if (rows.length < maxPageSize) {
                    break;
                }
                page++;
            }

            products = all;

            const items = products
                .map(function (p) {
                    const cancelled = p.cancelled ?? p.Cancelled;
                    const pid = p.productId ?? p.ID_Product ?? p.iD_Product;
                    const pname = p.name ?? p.Name ?? '';
                    if (cancelled || !(pid > 0) || !pname) return null;
                    return {
                        value: String(pid),
                        label: pname,
                        imageUrl: p.imageUrl ?? p.ImageUrl ?? ''
                    };
                })
                .filter(Boolean);

            adminSelect.fill(document.getElementById('selectProduct'), items, {
                placeholder: '-- Select Product --',
                searchPlaceholder: 'Search products...'
            });
            adminSelect.fill(document.getElementById('modalProduct'), items, {
                placeholder: 'Select Product',
                searchPlaceholder: 'Search products...'
            });
        } catch (error) {
            console.error('Error loading products:', error);
        }
    }

    async function loadVariants() {
        try {
            // VariantListInputVIEW enforces PageSize <= 100
            const response = await fetch(API.getVariantList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({
                    PageIndex: 1,
                    PageSize: 100,
                    SearchText: '',
                    FilterVariantIDs: '',
                    SortColumn: 0,
                    SortMode: 'ASC'
                })
            });
            if (!response.ok) throw new Error('Failed to fetch variants');

            const payload = await response.json();
            const success = payload.success ?? payload.Success ?? true;
            if (!success) {
                throw new Error(payload.message ?? payload.Message ?? 'Failed to fetch variants');
            }
            const data = payload.data ?? payload.Data ?? payload;
            variants = (data.tableData ?? data.TableData) ?? [];
            // Load variant values on-demand per selected variant (see fetchVariantValuesByVariantId)
            variantValueMap = {};

            // Populate variant dropdowns in modal
            const variantSelects = document.querySelectorAll('.variant-select');
            variantSelects.forEach(select => {
                select.innerHTML = '<option value="">Select Variant</option>';
                variants.forEach(v => {
                    const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
                    const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
                    if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                        select.add(new Option(vname, vid));
                    }
                });
            });
        } catch (error) {
            console.error('Error loading variants:', error);
        }
    }

    async function fetchVariantValuesByVariantId(variantId) {
        const vid = Number(variantId) || 0;
        if (vid <= 0) return [];

        const key = String(vid);
        if (Array.isArray(variantValueMap[key]) && variantValueMap[key].length > 0) {
            return variantValueMap[key];
        }

        const response = await fetch(`${API.getByVariant}/${vid}`);
        if (!response.ok) {
            throw new Error('Failed to fetch variant values');
        }

        const rows = await response.json();
        const list = Array.isArray(rows) ? rows : [];

        variantValueMap[key] = list;
        return list;
    }

    function nameInitials(name) {
        const text = String(name || '').trim();
        return text ? text.substring(0, 2) : '—';
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function renderListThumb(imageUrl, name) {
        const media = imageUrl
            ? `<img src="${escapeAttr(imageUrl)}" alt="" class="list-entity-thumb">`
            : `<span class="list-entity-initials">${escapeHtml(nameInitials(name))}</span>`;
        return `<div class="list-entity-cell">${media}<span class="list-entity-name" title="${escapeAttr(name)}">${escapeHtml(name)}</span></div>`;
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
