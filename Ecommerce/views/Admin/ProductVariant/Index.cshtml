@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Product Variant (SKU) Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Product Variant</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row" data-permission-module="ProductVariants">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">Product Variant (SKU) List</h5>
                            <button type="button" class="btn btn-primary" data-action="Create" data-bs-toggle="modal" data-bs-target="#productVariantModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New SKU
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="row mb-3">
                            <div class="col-md-6 col-lg-5">
                                <label for="selectProduct" class="form-label">Select Product <span class="text-danger">*</span></label>
                                <div class="searchable-select">
                                    <select id="selectProduct" class="form-select" onchange="onProductChange()">
                                        <option value="">-- Select Product --</option>
                                    </select>
                                </div>
                            </div>
                        </div>

                        <!-- Product Variant Table -->
                        <div class="table-container" id="tableSection">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0 admin-master-list-table" id="productVariantTable">
                                    <thead style="display: none;">
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">SKU</th>
                                            <th class="text-muted">Product</th>
                                            <th class="text-muted">Combination</th>
                                            <th class="text-muted">Label</th>
                                            <th class="text-muted">MRP</th>
                                            <th class="text-muted">Price</th>
                                            <th class="text-muted">Active</th>
                                            <th class="text-muted">Default</th>
                                            <th class="text-muted">Images</th>
                                            <th class="text-muted">Created</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productVariantTableBody"></tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top pagination-wrapper d-none" id="paginationSection">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                                    <option value="10" selected>10</option>
                                    <option value="20">20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Product Variant Modal (Create/Edit) -->
<div class="modal fade" id="productVariantModal" tabindex="-1" aria-labelledby="productVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productVariantModalLabel">Add Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productVariantForm">
                    <input type="hidden" id="productVariantID" name="ID_ProductVariant" value="0">
                    <div class="mb-3">
                        <label for="modalProduct" class="form-label">Product <span class="text-danger">*</span></label>
                        <div class="searchable-select">
                            <select class="form-select" id="modalProduct" name="FK_Product" required>
                                <option value="">Select Product</option>
                            </select>
                        </div>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="sku" class="form-label">SKU <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="sku" name="SKU" maxlength="100" required>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="mrp" class="form-label">MRP</label>
                            <input type="number" step="0.01" min="0" class="form-control" id="mrp" name="MRP" value="0">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="sellingPrice" class="form-label">Selling price <span class="text-danger">*</span></label>
                            <input type="number" step="0.01" min="0.01" class="form-control" id="sellingPrice" name="SellingPrice" required>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="variantLabel" class="form-label">Variant label</label>
                        <input type="text" class="form-control" id="variantLabel" name="VariantLabel" maxlength="255" placeholder="Leave blank to auto-generate from values">
                        <div class="form-text" id="variantLabelPreview"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Variant values <span class="text-danger">*</span></label>
                        <div id="variantAttributesContainer">
                            <div class="variant-attribute-row mb-2">
                                <div class="row">
                                    <div class="col-md-5">
                                        <select class="form-select variant-select" required onchange="onVariantChange(this)">
                                            <option value="">Select Variant</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                                            <option value="">Select Value</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addVariantAttribute()">
                            <i class="ti ti-plus"></i> Add value
                        </button>
                    </div>
                    <div class="mb-3 d-flex flex-wrap align-items-center gap-3">
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="isActive" name="IsActive" checked>
                            <label class="form-check-label" for="isActive">Active</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="sellOnline" name="SellOnline">
                            <label class="form-check-label" for="sellOnline">Sell online</label>
                        </div>
                        <div class="form-check mb-0">
                            <input class="form-check-input" type="checkbox" id="isDefault" name="IsDefault">
                            <label class="form-check-label" for="isDefault">Is Default SKU</label>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Product Images</label>
                        <div id="imageDropZone" class="border rounded p-3 text-center bg-light" style="cursor: pointer;">
                            <div class="mb-2">
                                <i class="ti ti-photo-up fs-3 text-primary"></i>
                            </div>
                            <div class="fw-semibold">Drag &amp; Drop Area</div>
                            <div class="small text-muted mb-2">or click to upload images</div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnPickImages">
                                <i class="ti ti-upload"></i> Upload Images
                            </button>
                            <input type="file" id="skuImageFiles" accept=".jpg,.jpeg,.png,.webp" multiple class="d-none">
                        </div>
                        <div class="form-text mt-1">Maximum 5 images. Allowed: jpg, jpeg, png, webp. Max 2MB each.</div>
                        <div id="skuImagePreviewList" class="row g-2 mt-2"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveProductVariant()">Save SKU</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this SKU?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteProductVariantID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="/Admin/assets/js/plugins/choices.min.js"></script>
<script src="/Admin/assets/js/common/searchable-select.js?v=select-media-1"></script>
<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let selectedProductId = 0;
    let products = [];
    let variants = [];
    let variantValueMap = {}; // Map variant ID to its values
    let autoSkuEnabled = true;
    let autoLabelEnabled = true;
    let lastGeneratedSku = '';
    let lastGeneratedLabel = '';
    let skuImageItems = [];
    let skuExistingImageIdsOnOpen = [];
    let skuImageDragKey = null;

    const TABLE_BODY_ID = 'productVariantTableBody';
    const TABLE_COLUMN_COUNT = 12;
    const SELECT_PRODUCT_MESSAGE = 'Please select a product to view SKUs.';

    // 2. API Endpoints
    const API = {
        getList: '/Admin/ProductVariant/GetProductVariantList',
        getById: '/Admin/ProductVariant/GetById',
        create: '/Admin/ProductVariant/Create',
        update: '/Admin/ProductVariant/Update',
        delete: '/Admin/ProductVariant/Delete',
        getImages: '/Admin/ProductVariant/GetImages',
        getProductList: '/Admin/Product/GetProductList',
        getVariantList: '/Admin/Variant/GetVariantList',
        getByVariant: '/Admin/VariantValue/GetByVariant'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function() {
        loadProducts();
        loadVariants();

        const skuInput = document.getElementById('sku');
        const labelInput = document.getElementById('variantLabel');
        const modalProduct = document.getElementById('modalProduct');

        skuInput?.addEventListener('input', function () {
            const current = (this.value || '').trim();
            if (!current) {
                autoSkuEnabled = true;
                updateVariantLabelPreview();
                return;
            }
            autoSkuEnabled = current === lastGeneratedSku;
        });

        labelInput?.addEventListener('input', function () {
            const current = (this.value || '').trim();
            if (!current) {
                autoLabelEnabled = true;
                updateVariantLabelPreview();
                return;
            }
            autoLabelEnabled = current === lastGeneratedLabel;
        });

        modalProduct?.addEventListener('change', function () {
            updateVariantLabelPreview();
        });

        const dropZone = document.getElementById('imageDropZone');
        const fileInput = document.getElementById('skuImageFiles');
        const pickButton = document.getElementById('btnPickImages');

        pickButton?.addEventListener('click', function () {
            fileInput?.click();
        });

        dropZone?.addEventListener('click', function (e) {
            if (e.target && e.target.closest('#btnPickImages')) {
                return;
            }
            fileInput?.click();
        });

        fileInput?.addEventListener('change', function () {
            if (this.files && this.files.length > 0) {
                appendSelectedImages(Array.from(this.files));
                this.value = '';
            }
        });

        dropZone?.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropZone.classList.add('border-primary');
        });

        dropZone?.addEventListener('dragleave', function () {
            dropZone.classList.remove('border-primary');
        });

        dropZone?.addEventListener('drop', function (e) {
            e.preventDefault();
            dropZone.classList.remove('border-primary');
            const files = Array.from(e.dataTransfer?.files || []);
            if (files.length > 0) {
                appendSelectedImages(files);
            }
        });

        renderSkuImagePreviews();
        showSelectProductState();
    });

    // 4. Event Handlers
    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        if (selectedProductId === 0) {
            return;
        }
        loadProductVariants(1);
    }

    function setSkuListingChromeVisible(visible) {
        document.getElementById('paginationSection').classList.toggle('d-none', !visible);
    }

    function setSkuTableHeadVisible(visible) {
        const thead = document.querySelector('#productVariantTable thead');
        if (thead) {
            thead.style.display = visible ? '' : 'none';
        }
    }

    function showSelectProductState() {
        setSkuListingChromeVisible(false);
        setSkuTableHeadVisible(false);
        window.emptyState.showListingEmpty(
            TABLE_BODY_ID,
            TABLE_COLUMN_COUNT,
            SELECT_PRODUCT_MESSAGE
        );
    }

    function onProductChange() {
        selectedProductId = parseInt(adminSelect.getValue(document.getElementById('selectProduct')), 10) || 0;
        if (selectedProductId === 0) {
            showSelectProductState();
            return;
        }
        loadProductVariants(1);
    }

    // 5. Listing API
    async function loadProductVariants(page = 1) {
        if (selectedProductId === 0) {
            showWarning('Validation Error', 'Please select a product first.');
            return;
        }

        currentPage = page;

        const input = {
            FK_Product: selectedProductId,
            SearchText: '',
            FilterVariantIDs: '',
            FilterVariantValueIDs: '',
            PageIndex: currentPage,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: 'ASC'
        };

        const listing = window.emptyState;
        setSkuListingChromeVisible(true);
        setSkuTableHeadVisible(false);
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'Product Variant List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const rows = result.tableData ?? result.TableData ?? [];
            const settings = result.tableSettings ?? result.TableSettings;

            if (!rows.length) {
                setSkuTableHeadVisible(false);
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
            } else {
                setSkuTableHeadVisible(true);
                displayProductVariants(rows);
            }

            if (settings) {
                displayPagination(settings);
            }
        } catch (error) {
            listing.handleListingError(
                'Product Variant List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displayProductVariants(productVariants) {
        const tbody = document.getElementById(TABLE_BODY_ID);
        tbody.innerHTML = productVariants.map(pv => createProductVariantRow(pv)).join('');
    }

    // 7. Row Creation
    function createProductVariantRow(pv) {
        const id = pv.idProductVariant ?? pv.ID_ProductVariant;
        const sku = pv.sku ?? pv.SKU ?? '';
        const imageUrl = pv.imageUrl ?? pv.ImageUrl ?? '';
        const longCombo = pv.combination ?? pv.Combination ?? '';
        const shortSig = pv.attributeSignature ?? pv.AttributeSignature ?? '';
        const combo = longCombo || shortSig;
        const label = pv.variantLabel ?? pv.VariantLabel ?? '';
        const pname = pv.productName ?? pv.ProductName ?? '';
        const mrp = Number(pv.mrp ?? pv.MRP ?? 0);
        const sp = Number(pv.price ?? pv.Price ?? pv.sellingPrice ?? pv.SellingPrice ?? 0);
        const isDef = pv.isDefault ?? pv.IsDefault;
        const isAct = pv.isActive ?? pv.IsActive;
        const sellOnline = pv.sellOnline ?? pv.SellOnline;
        const totalImages = Number(pv.totalImages ?? pv.TotalImages ?? 0);
        const created = pv.createdAt ?? pv.CreatedAt;
        const defaultClass = isDef ? 'badge-active' : 'bg-secondary';
        const defaultText = isDef ? 'Yes' : 'No';
        const activeClass = isAct ? 'badge-active' : 'bg-secondary';
        const activeText = isAct ? 'Yes' : 'No';
        const onlineClass = sellOnline ? 'badge-active' : 'bg-secondary';
        const onlineText = sellOnline ? 'Yes' : 'No';
        return `
            <tr>
                <td>${id}</td>
                <td class="col-name">${renderListThumb(imageUrl, sku)}</td>
                <td>${escapeHtml(pname || '—')}</td>
                <td>${escapeHtml(combo || '—')}</td>
                <td>${escapeHtml(label || '—')}</td>
                <td>${mrp.toFixed(2)}</td>
                <td>${sp.toFixed(2)}</td>
                <td>
                    <span class="badge ${activeClass}">${activeText}</span>
                    <span class="badge ${onlineClass} ms-1">${onlineText === 'Yes' ? 'Online' : 'Offline'}</span>
                </td>
                <td><span class="badge ${defaultClass}">${defaultText}</span></td>
                <td>${totalImages}</td>
                <td>${created ? new Date(created).toLocaleDateString() : '—'}</td>
                <td class="text-end">
                    <button class="btn-action" data-action="Edit" onclick="openEditModal(${id})" title="Edit">
                        <i class="ti ti-edit"></i>
                    </button>
                    <button class="btn-action" data-action="Delete" onclick="openDeleteModal(${id})" title="Delete">
                        <i class="ti ti-trash"></i>
                    </button>
                </td>
            </tr>
        `;
    }

    // 8. Create / Edit
    function openCreateModal() {
        document.getElementById('productVariantModalLabel').textContent = 'Add Product Variant (SKU)';
        document.getElementById('productVariantForm').reset();
        document.getElementById('productVariantID').value = '0';
        adminSelect.setValue(document.getElementById('modalProduct'), selectedProductId || '');
        document.getElementById('sku').value = '';
        document.getElementById('mrp').value = '0';
        document.getElementById('sellingPrice').value = '';
        document.getElementById('variantLabel').value = '';
        document.getElementById('variantLabelPreview').textContent = '';
        document.getElementById('isActive').checked = true;
        document.getElementById('sellOnline').checked = false;
        document.getElementById('isDefault').checked = false;
        autoSkuEnabled = true;
        autoLabelEnabled = true;
        lastGeneratedSku = '';
        lastGeneratedLabel = '';
        skuImageItems.forEach(x => {
            if (x.previewUrl && x.previewUrl.startsWith('blob:')) {
                URL.revokeObjectURL(x.previewUrl);
            }
        });
        skuImageItems = [];
        skuExistingImageIdsOnOpen = [];
        renderSkuImagePreviews();
        
        // Reset variant attributes to one row
        const container = document.getElementById('variantAttributesContainer');
        container.innerHTML = `
            <div class="variant-attribute-row mb-2">
                <div class="row">
                    <div class="col-md-5">
                        <select class="form-select variant-select" required onchange="onVariantChange(this)">
                            <option value="">Select Variant</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                            <option value="">Select Value</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
        populateVariantDropdowns();
        updateVariantLabelPreview();
    }

    async function openEditModal(productVariantID) {
        try {
            autoSkuEnabled = false;
            autoLabelEnabled = false;
            skuImageItems.forEach(x => {
                if (x.previewUrl && x.previewUrl.startsWith('blob:')) {
                    URL.revokeObjectURL(x.previewUrl);
                }
            });
            skuImageItems = [];
            skuExistingImageIdsOnOpen = [];

            const response = await fetch(`${API.getById}/${productVariantID}`);
            if (!response.ok) throw new Error('Failed to fetch product variant');

            const pv = await response.json();
            
            document.getElementById('productVariantModalLabel').textContent = 'Edit Product Variant (SKU)';
            document.getElementById('productVariantID').value = pv.idProductVariant ?? pv.ID_ProductVariant;
            adminSelect.setValue(document.getElementById('modalProduct'), pv.fkProduct ?? pv.FK_Product);
            document.getElementById('sku').value = pv.sku ?? pv.SKU ?? '';
            document.getElementById('mrp').value = String(pv.mrp ?? pv.MRP ?? 0);
            document.getElementById('sellingPrice').value = String(pv.sellingPrice ?? pv.SellingPrice ?? '');
            document.getElementById('variantLabel').value = pv.variantLabel ?? pv.VariantLabel ?? '';
            document.getElementById('isActive').checked = pv.isActive ?? pv.IsActive ?? true;
            document.getElementById('sellOnline').checked = pv.sellOnline ?? pv.SellOnline ?? false;
            document.getElementById('isDefault').checked = pv.isDefault ?? pv.IsDefault ?? false;
            
            const container = document.getElementById('variantAttributesContainer');
            container.innerHTML = '';
            const vvList = pv.variantValues ?? pv.VariantValues;
            const attrList = pv.attributes ?? pv.Attributes ?? [];
            if (vvList && vvList.length > 0) {
                vvList.forEach(rv => {
                    const vid = rv.variantId ?? rv.VariantId ?? rv.fkVariant ?? rv.FK_Variant;
                    const vvid = rv.variantValueId ?? rv.VariantValueId ?? rv.fkVariantValue ?? rv.FK_VariantValue;
                    addVariantAttributeRow(vid, vvid);
                });
            } else if (attrList.length > 0) {
                attrList.forEach(attr => {
                    const vid = attr.fkVariant ?? attr.FK_Variant;
                    const vvid = attr.fkVariantValue ?? attr.FK_VariantValue;
                    addVariantAttributeRow(vid, vvid);
                });
            } else {
                addVariantAttributeRow();
            }

            const imageResponse = await fetch(`${API.getImages}/${productVariantID}`);
            if (imageResponse.ok) {
                const images = await imageResponse.json();
                skuImageItems = (Array.isArray(images) ? images : []).map(img => ({
                    key: `existing_${img.idProductVariantImage ?? img.ID_ProductVariantImage}`,
                    isExisting: true,
                    imageId: img.idProductVariantImage ?? img.ID_ProductVariantImage ?? 0,
                    file: null,
                    imageUrl: img.imageUrl ?? img.ImageUrl ?? '',
                    previewUrl: img.imageUrl ?? img.ImageUrl ?? '',
                    isPrimary: (img.isPrimary ?? img.IsPrimary ?? false) === true
                }));
                if (!skuImageItems.some(x => x.isPrimary) && skuImageItems.length > 0) {
                    skuImageItems[0].isPrimary = true;
                }
                skuExistingImageIdsOnOpen = skuImageItems
                    .filter(x => x.isExisting && x.imageId > 0)
                    .map(x => x.imageId);
                renderSkuImagePreviews();
            }
            
            updateVariantLabelPreview();
            const modal = new bootstrap.Modal(document.getElementById('productVariantModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading product variant:', error);
            showError('Error', 'Error loading SKU details.');
        }
    }

    function addVariantAttribute() {
        addVariantAttributeRow();
    }

    function addVariantAttributeRow(selectedVariantId = null, selectedValueId = null) {
        const container = document.getElementById('variantAttributesContainer');
        const row = document.createElement('div');
        row.className = 'variant-attribute-row mb-2';
        row.innerHTML = `
            <div class="row">
                <div class="col-md-5">
                    <select class="form-select variant-select" required onchange="onVariantChange(this)">
                        <option value="">Select Variant</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <select class="form-select variant-value-select" required onchange="updateVariantLabelPreview()">
                        <option value="">Select Value</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                        <i class="ti ti-trash"></i>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
        
        const variantSelect = row.querySelector('.variant-select');
        const valueSelect = row.querySelector('.variant-value-select');
        
        // Populate variants
        variants.forEach(v => {
            const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
            const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
            if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                const option = new Option(vname, vid);
                if (selectedVariantId != null && selectedVariantId !== '' && Number(vid) === Number(selectedVariantId)) {
                    option.selected = true;
                }
                variantSelect.add(option);
            }
        });
        
        // If variant is selected, populate values
        if (selectedVariantId) {
            (async () => {
                try {
                    const rows = await fetchVariantValuesByVariantId(selectedVariantId);
                    populateVariantValues(valueSelect, selectedVariantId, selectedValueId, rows);
                } catch (e) {
                    console.error('Error loading variant values:', e);
                    populateVariantValues(valueSelect, 0);
                } finally {
                    updateVariantLabelPreview();
                }
            })();
        }
        updateVariantLabelPreview();
    }

    function populateVariantDropdowns() {
        const variantSelects = document.querySelectorAll('.variant-select');
        variantSelects.forEach(select => {
            select.innerHTML = '<option value="">Select Variant</option>';
            variants.forEach(v => {
                const vid = v.variantID ?? v.VariantID ?? v.ID_Variant;
                const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
                if (!v.Cancelled && (v.isActive ?? v.IsActive ?? true)) {
                    select.add(new Option(vname, vid));
                }
            });
        });
        updateVariantLabelPreview();
    }

    function onVariantChange(select) {
        const row = select.closest('.variant-attribute-row');
        const valueSelect = row.querySelector('.variant-value-select');
        const variantId = parseInt(select.value, 10);
        (async () => {
            try {
                const rows = await fetchVariantValuesByVariantId(variantId);
                populateVariantValues(valueSelect, variantId, null, rows);
            } catch (e) {
                console.error('Error loading variant values:', e);
                populateVariantValues(valueSelect, 0);
            } finally {
                updateVariantLabelPreview();
            }
        })();
    }

    function populateVariantValues(valueSelect, variantId, selectedValueId = null, overrideRows = null) {
        valueSelect.innerHTML = '<option value="">Select Value</option>';
        const key = String(Number(variantId) || 0);
        const source = overrideRows ?? (key !== '0' ? variantValueMap[key] : null);
        if (Array.isArray(source) && source.length > 0) {
            source.forEach(vv => {
                const vvid =
                    vv.variantValueID ?? vv.VariantValueID ??
                    vv.idVariantValue ?? vv.IdVariantValue ??
                    vv.id_VariantValue ?? vv.ID_VariantValue ?? vv.iD_VariantValue;
                const vvn = vv.name ?? vv.Name ?? vv.valueName ?? vv.ValueName ?? '';
                if (!vvid) return;
                const option = new Option(vvn, vvid);
                if (selectedValueId != null && selectedValueId !== '' && Number(vvid) === Number(selectedValueId)) {
                    option.selected = true;
                }
                valueSelect.add(option);
            });
        }
        updateVariantLabelPreview();
    }

    function updateVariantLabelPreview() {
        const el = document.getElementById('variantLabelPreview');
        if (!el) return;
        const auto = getAutoVariantLabel();
        const skuAuto = getAutoSku(auto);

        lastGeneratedLabel = auto;
        lastGeneratedSku = skuAuto;

        const skuInput = document.getElementById('sku');
        const labelInput = document.getElementById('variantLabel');

        if (labelInput && autoLabelEnabled) {
            labelInput.value = auto;
        }
        if (skuInput && autoSkuEnabled) {
            skuInput.value = skuAuto;
        }

        if (auto || skuAuto) {
            const parts = [];
            if (auto) {
                parts.push(`Auto label: ${auto}`);
            }
            if (skuAuto) {
                parts.push(`Auto SKU: ${skuAuto}`);
            }
            el.textContent = parts.join(' | ');
        } else {
            el.textContent = '';
        }
    }

    function getAutoVariantLabel() {
        const rows = [];
        document.querySelectorAll('.variant-attribute-row').forEach(row => {
            const vs = row.querySelector('.variant-select');
            const vsel = row.querySelector('.variant-value-select');
            const vvid = parseInt(vsel.value, 10) || 0;
            if (!vvid) return;
            const vname = vs.options[vs.selectedIndex]?.text?.trim() || '';
            const valName = vsel.options[vsel.selectedIndex]?.text?.trim() || '';
            if (valName) rows.push({ vname, valName });
        });
        rows.sort((a, b) => a.vname.localeCompare(b.vname, undefined, { sensitivity: 'base' }));
        return rows.map(r => r.valName).filter(Boolean).join(' - ');
    }

    function getAutoSku(autoLabel) {
        const productSelect = document.getElementById('modalProduct');
        const productName = productSelect?.options?.[productSelect.selectedIndex]?.text?.trim() || '';
        const safeProduct = normalizeSkuPart(productName);
        const safeLabel = normalizeSkuPart(autoLabel || '');
        const parts = [safeProduct, safeLabel].filter(Boolean);
        return parts.join('-').slice(0, 100);
    }

    function normalizeSkuPart(text) {
        return (text || '')
            .toUpperCase()
            .replace(/[^A-Z0-9]+/g, '-')
            .replace(/^-+|-+$/g, '');
    }

    function removeVariantAttribute(button) {
        const container = document.getElementById('variantAttributesContainer');
        if (container.children.length > 1) {
            button.closest('.variant-attribute-row').remove();
            updateVariantLabelPreview();
        } else {
            showWarning('Validation Error', 'At least one variant value is required.');
        }
    }

    function appendSelectedImages(files) {
        if (!Array.isArray(files) || files.length === 0) {
            return;
        }

        const allowed = new Set(['image/jpeg', 'image/png', 'image/webp']);
        const extAllowed = ['.jpg', '.jpeg', '.png', '.webp'];

        for (const file of files) {
            const nameLower = (file.name || '').toLowerCase();
            const hasValidExt = extAllowed.some(ext => nameLower.endsWith(ext));
            if (!allowed.has(file.type) && !hasValidExt) {
                showWarning('Validation Error', 'Only jpg, jpeg, png, and webp files are allowed.');
                continue;
            }
            if ((file.size || 0) > 2 * 1024 * 1024) {
                showWarning('Validation Error', 'Each image must be less than or equal to 2 MB.');
                continue;
            }
            if (skuImageItems.length >= 5) {
                showWarning('Validation Error', 'Maximum 5 images are allowed per SKU.');
                break;
            }

            const key = `new_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`;
            skuImageItems.push({
                key,
                isExisting: false,
                imageId: 0,
                file,
                imageUrl: '',
                previewUrl: URL.createObjectURL(file),
                isPrimary: false
            });
        }

        if (!skuImageItems.some(x => x.isPrimary) && skuImageItems.length > 0) {
            skuImageItems[0].isPrimary = true;
        }

        renderSkuImagePreviews();
    }

    function renderSkuImagePreviews() {
        const holder = document.getElementById('skuImagePreviewList');
        if (!holder) return;

        if (skuImageItems.length === 0) {
            holder.innerHTML = '<div class="col-12 text-muted small">No images selected.</div>';
            return;
        }

        holder.innerHTML = skuImageItems.map((item, index) => {
            const url = item.previewUrl || item.imageUrl || '';
            const primaryCls = item.isPrimary ? 'border-primary' : '';
            return `
                <div class="col-md-4">
                    <div class="card h-100 ${primaryCls}" draggable="true"
                        ondragstart="onSkuImageDragStart('${item.key}')"
                        ondragover="onSkuImageDragOver(event)"
                        ondrop="onSkuImageDrop('${item.key}')">
                        <img src="${escapeHtml(url)}" class="card-img-top" style="height: 140px; object-fit: cover;" alt="SKU image ${index + 1}">
                        <div class="card-body p-2">
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="skuPrimaryImage" ${item.isPrimary ? 'checked' : ''}
                                    onchange="setSkuPrimaryImage('${item.key}')">
                                <label class="form-check-label small">Primary</label>
                            </div>
                            <div class="d-flex justify-content-between">
                                <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeSkuImage('${item.key}')">
                                    <i class="ti ti-trash"></i>
                                </button>
                                <span class="small text-muted">#${index + 1}</span>
                            </div>
                        </div>
                    </div>
                </div>`;
        }).join('');
    }

    function onSkuImageDragStart(key) {
        skuImageDragKey = key;
    }

    function onSkuImageDragOver(e) {
        e.preventDefault();
    }

    function onSkuImageDrop(targetKey) {
        if (!skuImageDragKey || skuImageDragKey === targetKey) {
            return;
        }

        const fromIndex = skuImageItems.findIndex(x => x.key === skuImageDragKey);
        const toIndex = skuImageItems.findIndex(x => x.key === targetKey);
        if (fromIndex < 0 || toIndex < 0) {
            return;
        }

        const [moved] = skuImageItems.splice(fromIndex, 1);
        skuImageItems.splice(toIndex, 0, moved);
        skuImageDragKey = null;
        renderSkuImagePreviews();
    }

    function setSkuPrimaryImage(key) {
        skuImageItems = skuImageItems.map(x => ({ ...x, isPrimary: x.key === key }));
        renderSkuImagePreviews();
    }

    function removeSkuImage(key) {
        const idx = skuImageItems.findIndex(x => x.key === key);
        if (idx < 0) return;
        const item = skuImageItems[idx];
        if (item.previewUrl && item.previewUrl.startsWith('blob:')) {
            URL.revokeObjectURL(item.previewUrl);
        }
        skuImageItems.splice(idx, 1);
        if (!skuImageItems.some(x => x.isPrimary) && skuImageItems.length > 0) {
            skuImageItems[0].isPrimary = true;
        }
        renderSkuImagePreviews();
    }

    /** Returns { variantId, variantValueId }[]; throws Error on duplicate variant or value in form. */
    function collectVariantValuesFromForm() {
        const out = [];
        const seenVariant = new Set();
        const seenValue = new Set();
        document.querySelectorAll('.variant-attribute-row').forEach(row => {
            const variantSelect = row.querySelector('.variant-select');
            const valueSelect = row.querySelector('.variant-value-select');
            const variantId = parseInt(variantSelect.value, 10);
            const variantValueId = parseInt(valueSelect.value, 10);
            if (!variantId || !variantValueId) {
                return;
            }
            if (seenVariant.has(variantId)) {
                throw new Error('Each variant type may only appear once in the form.');
            }
            if (seenValue.has(variantValueId)) {
                throw new Error('Duplicate variant value selected.');
            }
            seenVariant.add(variantId);
            seenValue.add(variantValueId);
            out.push({ variantId, variantValueId });
        });
        return out;
    }

    async function saveProductVariant() {
        const productVariantID = parseInt(document.getElementById('productVariantID').value, 10);
        const fkProduct = parseInt(adminSelect.getValue(document.getElementById('modalProduct')), 10);
        const labelInput = document.getElementById('variantLabel');
        const skuInput = document.getElementById('sku');
        let variantLabel = (labelInput.value || '').trim();
        let sku = (skuInput.value || '').trim();
        const mrp = parseFloat(document.getElementById('mrp').value) || 0;
        const sellingPrice = parseFloat(document.getElementById('sellingPrice').value);
        const isActive = document.getElementById('isActive').checked;
        const sellOnline = document.getElementById('sellOnline').checked;
        const isDefault = document.getElementById('isDefault').checked;

        if (!fkProduct || fkProduct <= 0) {
            showWarning('Validation Error', 'Please select a product.');
            return;
        }
        if (!variantLabel) {
            variantLabel = getAutoVariantLabel();
            labelInput.value = variantLabel;
        }
        if (!sku) {
            sku = getAutoSku(variantLabel);
            skuInput.value = sku;
        }
        if (!sku) {
            showWarning('Validation Error', 'Please select product and variant values to auto-generate SKU, or enter SKU manually.');
            return;
        }
        if (!Number.isFinite(sellingPrice) || sellingPrice <= 0) {
            showWarning('Validation Error', 'Selling price must be greater than zero.');
            return;
        }

        let variantValues;
        try {
            variantValues = collectVariantValuesFromForm();
        } catch (e) {
            showWarning('Validation Error', e?.message || 'Invalid variant selection.');
            return;
        }

        if (variantValues.length === 0) {
            showWarning('Validation Error', 'Please add at least one complete variant row (variant + value).');
            return;
        }

        const currentExistingIds = skuImageItems
            .filter(x => x.isExisting && x.imageId > 0)
            .map(x => x.imageId);
        const removedImageIds = skuExistingImageIdsOnOpen.filter(id => !currentExistingIds.includes(id));
        const newItems = skuImageItems.filter(x => !x.isExisting && x.file);
        const primaryItem = skuImageItems.find(x => x.isPrimary);
        const primaryExistingImageId = primaryItem?.isExisting ? (primaryItem.imageId || 0) : 0;
        const primaryNewIndex = !primaryItem?.isExisting
            ? newItems.findIndex(x => x.key === primaryItem?.key)
            : -1;

        const formData = new FormData();
        formData.append('ID_ProductVariant', String(productVariantID));
        formData.append('FK_Product', String(fkProduct));
        formData.append('SKU', sku);
        formData.append('MRP', String(mrp));
        formData.append('SellingPrice', String(sellingPrice));
        formData.append('VariantLabel', variantLabel || '');
        formData.append('IsActive', String(isActive));
        formData.append('SellOnline', String(sellOnline));
        formData.append('IsDefault', String(isDefault));
        formData.append('VariantValuesJson', JSON.stringify(variantValues));

        currentExistingIds.forEach(id => formData.append('ExistingImageOrder', String(id)));
        removedImageIds.forEach(id => formData.append('RemovedImageIds', String(id)));
        newItems.forEach(item => formData.append('Files', item.file));

        if (primaryExistingImageId > 0) {
            formData.append('PrimaryImageId', String(primaryExistingImageId));
        } else if (primaryNewIndex >= 0) {
            formData.append('PrimaryIndex', String(primaryNewIndex));
        }

        const url = productVariantID === 0 ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            let result = null;
            try {
                result = await response.json();
            } catch {
                result = null;
            }

            // Handle MVC validation 400s that return { message, errors }
            if (!response.ok) {
                handleApiError?.('failure', 'Save SKU', { url, method: 'POST', payload: { productVariantID, fkProduct, variantValuesCount: variantValues.length }, response, result });
                const msg = result?.message || result?.Message || 'Validation failed.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showWarning('Validation Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showWarning('Validation Error', msg);
                }
                return;
            }

            const ok =
                (result?.statusCode ?? result?.StatusCode) === true ||
                (result?.success ?? result?.Success) === true;

            if (ok) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('productVariantModal'));
                modal.hide();
                loadProductVariants(currentPage);
                const msg = result?.responseMsg ?? result?.ResponseMsg ?? result?.message ?? result?.Message;
                showSuccess('Success', msg || 'SKU saved successfully.');
            } else {
                handleApiError?.('failure', 'Save SKU (business)', { url, method: 'POST', payload: { productVariantID, fkProduct, variantValuesCount: variantValues.length }, response, result });
                // CommonResponse { StatusCode, ResponseMsg } OR other error shapes
                const msg = result?.responseMsg ?? result?.ResponseMsg ?? result?.message ?? result?.Message;
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showError('Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showError('Error', msg);
                }
            }
        } catch (error) {
            handleApiError?.('crash', 'Save SKU', { url, method: 'POST', payload: { productVariantID, fkProduct, variantValuesCount: variantValues.length }, error });
            showError('Error', 'Error saving SKU. Please try again.');
        }
    }

