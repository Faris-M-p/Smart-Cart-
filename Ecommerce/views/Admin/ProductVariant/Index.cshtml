@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Product Variant (SKU) Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Product Variant</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Product Variant (SKU) List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#productVariantModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New SKU
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Product Selection -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label for="selectProduct" class="form-label">Select Product <span class="text-danger">*</span></label>
                                <select id="selectProduct" class="form-select" onchange="onProductChange()">
                                    <option value="">-- Select Product --</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <label class="form-label">&nbsp;</label>
                                <button type="button" class="btn btn-secondary w-100" onclick="loadProductVariants()" id="btnLoadVariants" disabled>
                                    <i class="ti ti-search"></i> Load SKUs
                                </button>
                            </div>
                        </div>

                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap" id="filterSection" style="display: none;">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search SKUs...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadProductVariants()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Product Variant Table -->
                        <div class="table-container" id="tableSection" style="display: none;">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="productVariantTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">Attributes</th>
                                            <th class="text-muted">Price Adjustment</th>
                                            <th class="text-muted">Is Default</th>
                                            <th class="text-muted">Stock</th>
                                            <th class="text-muted">Image</th>
                                            <th class="text-muted">Created Date</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="productVariantTableBody">
                                        <tr>
                                            <td colspan="8" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper" id="paginationSection" style="display: none;">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadProductVariants()">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Product Variant Modal (Create/Edit) -->
<div class="modal fade" id="productVariantModal" tabindex="-1" aria-labelledby="productVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productVariantModalLabel">Add Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productVariantForm">
                    <input type="hidden" id="productVariantID" name="ID_ProductVariant" value="0">
                    <div class="mb-3">
                        <label for="modalProduct" class="form-label">Product <span class="text-danger">*</span></label>
                        <select class="form-select" id="modalProduct" name="FK_Product" required>
                            <option value="">Select Product</option>
                        </select>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Variant Attributes <span class="text-danger">*</span></label>
                        <div id="variantAttributesContainer">
                            <div class="variant-attribute-row mb-2">
                                <div class="row">
                                    <div class="col-md-5">
                                        <select class="form-select variant-select" required>
                                            <option value="">Select Variant</option>
                                        </select>
                                    </div>
                                    <div class="col-md-5">
                                        <select class="form-select variant-value-select" required>
                                            <option value="">Select Value</option>
                                        </select>
                                    </div>
                                    <div class="col-md-2">
                                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                                            <i class="ti ti-trash"></i>
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <button type="button" class="btn btn-sm btn-outline-primary" onclick="addVariantAttribute()">
                            <i class="ti ti-plus"></i> Add Attribute
                        </button>
                    </div>
                    <div class="mb-3">
                        <label for="priceAdjustment" class="form-label">Price Adjustment</label>
                        <input type="number" step="0.01" class="form-control" id="priceAdjustment" name="PriceAdjustment" value="0">
                    </div>
                    <div class="mb-3">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="isDefault" name="IsDefault">
                            <label class="form-check-label" for="isDefault">
                                Is Default SKU
                            </label>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveProductVariant()">Save SKU</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Product Variant (SKU)</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this SKU?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteProductVariantID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 20;
    let selectedProductId = 0;
    let products = [];
    let variants = [];
    let variantValues = [];
    let variantValueMap = {}; // Map variant ID to its values

    document.addEventListener('DOMContentLoaded', function() {
        loadProducts();
        loadVariants();
        
        document.getElementById('searchText')?.addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadProductVariants();
            }
        });
    });

    async function loadProducts() {
        try {
            const response = await fetch('/Admin/Product/GetProductList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ PageIndex: 1, PageSize: 1000, SearchText: '', FilterCategoryIDs: '', FilterSubCategoryIDs: '', FilterBrandIDs: '', FilterStatusIDs: '', SortColumn: 0, SortMode: 'ASC' })
            });
            if (!response.ok) throw new Error('Failed to fetch products');

            const data = await response.json();
            products = data.TableData || [];

            const selectProduct = document.getElementById('selectProduct');
            const modalProduct = document.getElementById('modalProduct');
            
            selectProduct.innerHTML = '<option value="">-- Select Product --</option>';
            modalProduct.innerHTML = '<option value="">Select Product</option>';
            
            products.forEach(p => {
                if (!p.Cancelled) {
                    const option1 = new Option(p.Name, p.ID_Product);
                    const option2 = new Option(p.Name, p.ID_Product);
                    selectProduct.add(option1);
                    modalProduct.add(option2);
                }
            });
        } catch (error) {
            console.error('Error loading products:', error);
        }
    }

    async function loadVariants() {
        try {
            const response = await fetch('/Admin/Variant/GetVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ PageIndex: 1, PageSize: 1000, SearchText: '', FilterVariantIDs: '', SortColumn: 0, SortMode: 'ASC' })
            });
            if (!response.ok) throw new Error('Failed to fetch variants');

            const data = await response.json();
            variants = data.TableData || [];

            // Load variant values
            const variantValueResponse = await fetch('/Admin/VariantValue/GetVariantValueList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ PageIndex: 1, PageSize: 10000, SearchText: '', FilterVariantIDs: '', SortColumn: 0, SortMode: 'ASC' })
            });
            if (!variantValueResponse.ok) throw new Error('Failed to fetch variant values');

            const variantValueData = await variantValueResponse.json();
            variantValues = variantValueData.TableData || [];

            // Build variant value map
            variantValueMap = {};
            variantValues.forEach(vv => {
                if (!vv.Cancelled) {
                    if (!variantValueMap[vv.FK_Variant]) {
                        variantValueMap[vv.FK_Variant] = [];
                    }
                    variantValueMap[vv.FK_Variant].push(vv);
                }
            });

            // Populate variant dropdowns in modal
            const variantSelects = document.querySelectorAll('.variant-select');
            variantSelects.forEach(select => {
                select.innerHTML = '<option value="">Select Variant</option>';
                variants.forEach(v => {
                    if (!v.Cancelled) {
                        select.add(new Option(v.VariantName, v.ID_Variant));
                    }
                });
            });
        } catch (error) {
            console.error('Error loading variants:', error);
        }
    }

    function onProductChange() {
        selectedProductId = parseInt(document.getElementById('selectProduct').value) || 0;
        document.getElementById('btnLoadVariants').disabled = selectedProductId === 0;
        if (selectedProductId === 0) {
            document.getElementById('filterSection').style.display = 'none';
            document.getElementById('tableSection').style.display = 'none';
            document.getElementById('paginationSection').style.display = 'none';
        }
    }

    async function loadProductVariants(page = 1) {
        if (selectedProductId === 0) {
            alert('Please select a product first.');
            return;
        }

        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize')?.value) || 20;
        const searchText = document.getElementById('searchText')?.value || '';

        const input = {
            FK_Product: selectedProductId,
            SearchText: searchText,
            FilterVariantIDs: '',
            FilterVariantValueIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: 'ASC'
        };

        try {
            const response = await fetch('/Admin/ProductVariant/GetProductVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) throw new Error('Network response was not ok');

            const data = await response.json();
            displayProductVariants(data.TableData || []);
            displayPagination(data.TableSettings);
            
            document.getElementById('filterSection').style.display = 'block';
            document.getElementById('tableSection').style.display = 'block';
            document.getElementById('paginationSection').style.display = 'block';
        } catch (error) {
            console.error('Error loading product variants:', error);
            const tbody = document.getElementById('productVariantTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="empty-state">
                        <i class="ti ti-alert-circle"></i>
                        <h5>Error loading SKUs</h5>
                        <p class="text-muted">${escapeHtml(error.message || 'An error occurred while loading SKUs. Please try again.')}</p>
                    </td>
                </tr>
            `;
        }
    }

    function displayProductVariants(variants) {
        const tbody = document.getElementById('productVariantTableBody');
        
        if (!variants || variants.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="8" class="empty-state">
                        <i class="ti ti-package-off"></i>
                        <h5>No SKUs found</h5>
                        <p class="text-muted">No SKUs found for this product. Try selecting a different product.</p>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = variants.map(pv => {
            const defaultClass = pv.IsDefault ? 'badge-active' : 'bg-secondary';
            const defaultText = pv.IsDefault ? 'Yes' : 'No';
            
            return `
                <tr>
                    <td>${pv.ID_ProductVariant}</td>
                    <td>${escapeHtml(pv.AttributeSignature || 'N/A')}</td>
                    <td>${pv.PriceAdjustment >= 0 ? '+' : ''}${pv.PriceAdjustment.toFixed(2)}</td>
                    <td>
                        <span class="badge ${defaultClass}">
                            ${defaultText}
                        </span>
                    </td>
                    <td>${pv.StockAvailable || 0}</td>
                    <td>${pv.ImageURL ? `<img src="${escapeHtml(pv.ImageURL)}" style="max-width: 50px; max-height: 50px;" class="product-img" />` : '-'}</td>
                    <td>${pv.CreatedOn ? new Date(pv.CreatedOn).toLocaleDateString() : '-'}</td>
                    <td class="text-end">
                        <button class="btn-action" onclick="openEditModal(${pv.ID_ProductVariant})" title="Edit">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn-action" onclick="openDeleteModal(${pv.ID_ProductVariant})" title="Delete">
                            <i class="ti ti-trash"></i>
                        </button>
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((settings.PageIndex - 1) * settings.PageSize) + 1;
        const end = Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount);
        paginationInfo.textContent = `${start} to ${end} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (settings.PageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${settings.PageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 1 && i <= settings.PageIndex + 1)) {
                if (i === settings.PageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadProductVariants(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === settings.PageIndex - 2 || i === settings.PageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (settings.PageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadProductVariants(${settings.PageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('productVariantModalLabel').textContent = 'Add Product Variant (SKU)';
        document.getElementById('productVariantForm').reset();
        document.getElementById('productVariantID').value = '0';
        document.getElementById('modalProduct').value = selectedProductId || '';
        document.getElementById('priceAdjustment').value = '0';
        document.getElementById('isDefault').checked = false;
        
        // Reset variant attributes to one row
        const container = document.getElementById('variantAttributesContainer');
        container.innerHTML = `
            <div class="variant-attribute-row mb-2">
                <div class="row">
                    <div class="col-md-5">
                        <select class="form-select variant-select" required>
                            <option value="">Select Variant</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <select class="form-select variant-value-select" required>
                            <option value="">Select Value</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                            <i class="ti ti-trash"></i>
                        </button>
                    </div>
                </div>
            </div>
        `;
        populateVariantDropdowns();
    }

    async function openEditModal(productVariantID) {
        try {
            const response = await fetch(`/Admin/ProductVariant/GetById/${productVariantID}`);
            if (!response.ok) throw new Error('Failed to fetch product variant');

            const pv = await response.json();
            
            document.getElementById('productVariantModalLabel').textContent = 'Edit Product Variant (SKU)';
            document.getElementById('productVariantID').value = pv.ID_ProductVariant;
            document.getElementById('modalProduct').value = pv.FK_Product;
            document.getElementById('priceAdjustment').value = pv.PriceAdjustment;
            document.getElementById('isDefault').checked = pv.IsDefault;
            
            // Populate variant attributes
            const container = document.getElementById('variantAttributesContainer');
            container.innerHTML = '';
            pv.Attributes.forEach(attr => {
                addVariantAttributeRow(attr.FK_Variant, attr.FK_VariantValue);
            });
            if (pv.Attributes.length === 0) {
                addVariantAttributeRow();
            }
            
            const modal = new bootstrap.Modal(document.getElementById('productVariantModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading product variant:', error);
            alert('Error loading SKU details.');
        }
    }

    function addVariantAttribute() {
        addVariantAttributeRow();
    }

    function addVariantAttributeRow(selectedVariantId = null, selectedValueId = null) {
        const container = document.getElementById('variantAttributesContainer');
        const row = document.createElement('div');
        row.className = 'variant-attribute-row mb-2';
        row.innerHTML = `
            <div class="row">
                <div class="col-md-5">
                    <select class="form-select variant-select" required onchange="onVariantChange(this)">
                        <option value="">Select Variant</option>
                    </select>
                </div>
                <div class="col-md-5">
                    <select class="form-select variant-value-select" required>
                        <option value="">Select Value</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button type="button" class="btn btn-danger btn-sm w-100" onclick="removeVariantAttribute(this)">
                        <i class="ti ti-trash"></i>
                    </button>
                </div>
            </div>
        `;
        container.appendChild(row);
        
        const variantSelect = row.querySelector('.variant-select');
        const valueSelect = row.querySelector('.variant-value-select');
        
        // Populate variants
        variants.forEach(v => {
            if (!v.Cancelled) {
                const option = new Option(v.VariantName, v.ID_Variant);
                if (selectedVariantId && v.ID_Variant === selectedVariantId) {
                    option.selected = true;
                }
                variantSelect.add(option);
            }
        });
        
        // If variant is selected, populate values
        if (selectedVariantId) {
            populateVariantValues(valueSelect, selectedVariantId, selectedValueId);
        }
    }

    function populateVariantDropdowns() {
        const variantSelects = document.querySelectorAll('.variant-select');
        variantSelects.forEach(select => {
            select.innerHTML = '<option value="">Select Variant</option>';
            variants.forEach(v => {
                if (!v.Cancelled) {
                    select.add(new Option(v.VariantName, v.ID_Variant));
                }
            });
        });
    }

    function onVariantChange(select) {
        const row = select.closest('.variant-attribute-row');
        const valueSelect = row.querySelector('.variant-value-select');
        const variantId = parseInt(select.value);
        populateVariantValues(valueSelect, variantId);
    }

    function populateVariantValues(valueSelect, variantId, selectedValueId = null) {
        valueSelect.innerHTML = '<option value="">Select Value</option>';
        if (variantId && variantValueMap[variantId]) {
            variantValueMap[variantId].forEach(vv => {
                const option = new Option(vv.ValueName, vv.ID_VariantValue);
                if (selectedValueId && vv.ID_VariantValue === selectedValueId) {
                    option.selected = true;
                }
                valueSelect.add(option);
            });
        }
    }

    function removeVariantAttribute(button) {
        const container = document.getElementById('variantAttributesContainer');
        if (container.children.length > 1) {
            button.closest('.variant-attribute-row').remove();
        } else {
            alert('At least one variant attribute is required.');
        }
    }

    function openDeleteModal(productVariantID) {
        document.getElementById('deleteProductVariantID').value = productVariantID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveProductVariant() {
        const productVariantID = parseInt(document.getElementById('productVariantID').value);
        const fkProduct = parseInt(document.getElementById('modalProduct').value);
        const priceAdjustment = parseFloat(document.getElementById('priceAdjustment').value) || 0;
        const isDefault = document.getElementById('isDefault').checked;

        if (!fkProduct || fkProduct <= 0) {
            alert('Please select a product.');
            return;
        }

        // Collect variant attributes
        const variantAttributes = [];
        const rows = document.querySelectorAll('.variant-attribute-row');
        rows.forEach(row => {
            const variantSelect = row.querySelector('.variant-select');
            const valueSelect = row.querySelector('.variant-value-select');
            const variantId = parseInt(variantSelect.value);
            const valueId = parseInt(valueSelect.value);
            
            if (variantId && valueId) {
                variantAttributes.push({
                    FK_Variant: variantId,
                    FK_VariantValue: valueId
                });
            }
        });

        if (variantAttributes.length === 0) {
            alert('Please add at least one variant attribute.');
            return;
        }

        const input = {
            ID_ProductVariant: productVariantID,
            FK_Product: fkProduct,
            PriceAdjustment: priceAdjustment,
            IsDefault: isDefault,
            VariantAttributes: variantAttributes
        };

        const url = productVariantID === 0 ? '/Admin/ProductVariant/Create' : '/Admin/ProductVariant/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('productVariantModal'));
                modal.hide();
                loadProductVariants(currentPage);
                alert(result.ResponseMsg || 'SKU saved successfully.');
            } else {
                if (result.errors && result.errors.length > 0) {
                    alert('Validation errors:\n' + result.errors.join('\n'));
                } else {
                    alert(result.ResponseMsg || 'Error saving SKU.');
                }
            }
        } catch (error) {
            console.error('Error saving product variant:', error);
            alert('Error saving SKU. Please try again.');
        }
    }

    async function confirmDelete() {
        const productVariantID = parseInt(document.getElementById('deleteProductVariantID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            ID_ProductVariant: productVariantID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/ProductVariant/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadProductVariants(currentPage);
                alert(result.ResponseMsg || 'SKU deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting SKU.');
            }
        } catch (error) {
            console.error('Error deleting product variant:', error);
            alert('Error deleting SKU. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '20';
        loadProductVariants(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
