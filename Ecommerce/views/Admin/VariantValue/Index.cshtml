@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Variant value management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Variant value</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row" data-permission-module="VariantValues">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Variant values</h5>
                    <button type="button" class="btn btn-primary" data-action="Create" onclick="openCreateModal()">
                        <i class="ti ti-plus"></i> Add value
                    </button>
                </div>
            </div>
            <div class="card-body pt-3">
                <div class="row g-3 align-items-end mb-3">
                    <div class="col-md-6 col-lg-5">
                        <label for="variantSelect" class="form-label">Variant <span class="text-danger">*</span></label>
                        <div class="searchable-select">
                            <select id="variantSelect" class="form-select" onchange="onVariantSelectChange()">
                                <option value="">— Select variant —</option>
                            </select>
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <div class="table-scroll-wrapper">
                        <table class="table align-middle mb-0 admin-master-list-table" id="variantValueTable">
                            <thead>
                                <tr>
                                    <th class="col-name text-start">Name</th>
                                    <th class="col-desc text-start">Description</th>
                                    <th class="text-start" style="width:8rem;">Display order</th>
                                    <th class="col-actions text-start">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="variantValueTableBody">
                                <tr>
                                    <td colspan="4" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading…</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top pagination-wrapper">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Show</span>
                        <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <span class="text-muted small">per page</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span id="paginationInfo" class="text-muted small"></span>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="variantValueModal" tabindex="-1" aria-labelledby="variantValueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="variantValueModalLabel">Add variant value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="variantValueForm">
                    <input type="hidden" id="variantValueID" value="0">
                    <div class="mb-3">
                        <label for="fkVariantModal" class="form-label">Variant <span class="text-danger">*</span></label>
                        <select class="form-select" id="fkVariantModal" required></select>
                    </div>
                    <div class="mb-3">
                        <label for="name" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="name" maxlength="255" required>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="displayOrder" class="form-label">Display order</label>
                        <input type="number" class="form-control" id="displayOrder" value="0" min="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveVariantValue()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete variant value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this variant value?</p>
                <input type="hidden" id="deleteVariantValueID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="/Admin/assets/js/plugins/choices.min.js"></script>
<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let paginationInstance = null;

    const TABLE_BODY_ID = 'variantValueTableBody';
    const TABLE_COLUMN_COUNT = 4;

    // 2. API Endpoints
    const API = {
        getList: '/Admin/VariantValue/GetList',
        getById: '/Admin/VariantValue/GetById',
        create: '/Admin/VariantValue/Create',
        update: '/Admin/VariantValue/Update',
        delete: '/Admin/VariantValue/Delete',
        getVariants: '/Admin/VariantValue/GetVariants'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: 'pagination',
            infoId: 'paginationInfo',
            onPageChange: loadVariantValues
        });

        loadVariantsForDropdowns();
    });

    // 4. Event Handlers
    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        loadVariantValues(1);
    }

    function onVariantSelectChange() {
        loadVariantValues(1);
    }

    // 5. Listing API
    async function loadVariantValues(page = 1) {
        currentPage = page;
        const fk = getSelectedVariantId();
        if (fk <= 0) {
            window.emptyState.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
            if (paginationInstance) {
                paginationInstance.render({ pageIndex: 1, pageSize: pageSize, totalCount: 0 });
            }
            return;
        }

        const input = {
            fk_Variant: fk,
            searchText: '',
            filterVariantIDs: '',
            pageIndex: currentPage,
            pageSize: pageSize,
            sortColumn: 1,
            sortMode: 'ASC'
        };

        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'Variant Value List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const data = result?.data;

            if (!data?.tableData?.length) {
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
                if (paginationInstance && data?.tableSettings) {
                    paginationInstance.render(normalizeTableSettings(data.tableSettings));
                }
                return;
            }

            displayVariantValues(data.tableData);

            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(normalizeTableSettings(data.tableSettings));
            }
        } catch (error) {
            listing.handleListingError(
                'Variant Value List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displayVariantValues(rows) {
        const tableBody = document.getElementById(TABLE_BODY_ID);
        tableBody.innerHTML = rows.map(row => createVariantValueRow(row)).join('');
        initTableTooltips(tableBody);
    }

    // 7. Row Creation
    function createVariantValueRow(vv) {
        const id = vv.variantValueID ?? vv.VariantValueID ?? 0;
        const nm = vv.name ?? vv.Name ?? '';
        const desc = vv.description ?? vv.Description ?? '';
        const ord = vv.displayOrder ?? vv.DisplayOrder ?? 0;
        return `
                <tr>
                    <td class="col-name text-start">${truncatedCellHtml(nm)}</td>
                    <td class="col-desc text-start">${truncatedCellHtml(desc, 40)}</td>
                    <td class="text-start">${escapeHtml(String(ord))}</td>
                    <td class="col-actions text-start">
                        <div class="table-actions">
                            <button type="button" class="btn-action" data-action="Edit" onclick="openEditModal(${id})" title="Edit" data-bs-toggle="tooltip"><i class="ti ti-edit"></i></button>
                            <button type="button" class="btn-action" data-action="Delete" onclick="openDeleteModal(${id})" title="Delete" data-bs-toggle="tooltip"><i class="ti ti-trash"></i></button>
                        </div>
                    </td>
                </tr>`;
    }

    // 8. Create / Edit
    function openCreateModal() {
        const fk = getSelectedVariantId();
        if (fk <= 0) {
            if (typeof showWarning === 'function') {
                showWarning('Variant required', 'Select a variant in the list header before adding a value.');
            } else {
                alert('Select a variant first.');
            }
            return;
        }
        document.getElementById('variantValueModalLabel').textContent = 'Add variant value';
        document.getElementById('variantValueID').value = '0';
        document.getElementById('name').value = '';
        document.getElementById('description').value = '';
        document.getElementById('displayOrder').value = '0';
        document.getElementById('fkVariantModal').value = String(fk);
        new bootstrap.Modal(document.getElementById('variantValueModal')).show();
    }

    async function openEditModal(variantValueID) {
        try {
            const response = await fetch(API.getById + '/' + variantValueID);
            if (!response.ok) throw new Error('Not found');
            const x = await response.json();
            document.getElementById('variantValueModalLabel').textContent = 'Edit variant value';
            document.getElementById('variantValueID').value = String(x.variantValueID ?? x.VariantValueID ?? 0);
            document.getElementById('fkVariantModal').value = String(x.fk_Variant ?? x.FK_Variant ?? '');
            document.getElementById('name').value = x.name ?? x.Name ?? '';
            document.getElementById('description').value = x.description ?? x.Description ?? '';
            document.getElementById('displayOrder').value = String(x.displayOrder ?? x.DisplayOrder ?? 0);
            new bootstrap.Modal(document.getElementById('variantValueModal')).show();
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Could not load variant value.');
            else alert('Could not load variant value.');
        }
    }

    async function saveVariantValue() {
        const variantValueID = parseInt(document.getElementById('variantValueID').value, 10);
        const fkVariant = parseInt(document.getElementById('fkVariantModal').value, 10);
        const name = document.getElementById('name').value.trim();
        const description = document.getElementById('description').value.trim();
        const displayOrder = parseInt(document.getElementById('displayOrder').value, 10) || 0;

        if (!name) {
            if (typeof showWarning === 'function') showWarning('Validation', 'Please enter a name.');
            else alert('Please enter a name.');
            return;
        }
        if (!fkVariant || fkVariant <= 0) {
            if (typeof showWarning === 'function') showWarning('Validation', 'Please select a variant.');
            else alert('Please select a variant.');
            return;
        }

        const body = {
            variantValueID: variantValueID,
            fk_Variant: fkVariant,
            name: name,
            description: description,
            displayOrder: displayOrder
        };
        const url = variantValueID === 0 ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const result = await response.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('variantValueModal')).hide();
                loadVariantValues(currentPage);
                if (typeof showSuccess === 'function') {
                    showSuccess('Saved', result.responseMsg || result.ResponseMsg || 'Variant value saved.');
                }
            } else {
                if (typeof showError === 'function') {
                    showError('Error', result.responseMsg || result.ResponseMsg || 'Save failed.');
                } else {
                    alert(result.responseMsg || result.ResponseMsg || 'Save failed.');
                }
            }
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Save failed.');
            else alert('Save failed.');
        }
    }

    // 9. Delete
    function openDeleteModal(id) {
        document.getElementById('deleteVariantValueID').value = String(id);
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        const variantValueID = parseInt(document.getElementById('deleteVariantValueID').value, 10);
        try {
            const response = await fetch(API.delete, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ variantValueID: variantValueID })
            });
            const result = await response.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                loadVariantValues(currentPage);
                if (typeof showSuccess === 'function') {
                    showSuccess('Deleted', result.responseMsg || result.ResponseMsg || 'Deleted.');
                }
            } else {
                if (typeof showError === 'function') {
                    showError('Error', result.responseMsg || result.ResponseMsg || 'Delete failed.');
                } else {
                    alert(result.responseMsg || result.ResponseMsg || 'Delete failed.');
                }
            }
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Delete failed.');
            else alert('Delete failed.');
        }
    }

    // 10. Page-specific Helper Functions
    async function loadVariantsForDropdowns() {
        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
        try {
            const response = await fetch(API.getVariants);
            const variants = await response.json();
            if (!response.ok || variants?.success === false || !Array.isArray(variants)) {
                listing.handleListingError(
                    'Variant Dropdown Load',
                    { url: API.getVariants, method: 'GET', response, result: variants },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const pageSel = document.getElementById('variantSelect');
            const modalSel = document.getElementById('fkVariantModal');
            pageSel.innerHTML = '<option value="">— Select variant —</option>';
            modalSel.innerHTML = '<option value="">Select variant</option>';

            variants.forEach(function (v) {
                const vid = v.iD_Variant ?? v.ID_Variant ?? v.variantID ?? v.VariantID;
                const vname = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
                pageSel.add(new Option(vname, String(vid)));
                modalSel.add(new Option(vname, String(vid)));
            });

            if (typeof Choices !== 'undefined') {
                if (pageSel.choicesInstance) {
                    pageSel.choicesInstance.destroy();
                }
                pageSel.choicesInstance = new Choices(pageSel, {
                    searchEnabled: true,
                    searchPlaceholderValue: 'Search variants...',
                    itemSelectText: '',
                    shouldSort: false,
                    allowHTML: false,
                    position: 'bottom'
                });
            }

            listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
        } catch (error) {
            listing.handleListingError(
                'Variant Dropdown Load',
                { url: API.getVariants, method: 'GET', error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    function getSelectedVariantId() {
        const v = document.getElementById('variantSelect').value;
        const n = parseInt(v, 10);
        return isNaN(n) || n <= 0 ? 0 : n;
    }

    function normalizeTableSettings(s) {
        if (!s) return { pageIndex: 1, pageSize: 10, totalCount: 0 };
        return {
            pageIndex: s.pageIndex ?? s.PageIndex ?? 1,
            pageSize: s.pageSize ?? s.PageSize ?? 10,
            totalCount: s.totalCount ?? s.TotalCount ?? 0
        };
    }

    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '…' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
