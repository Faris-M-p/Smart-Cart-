@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Product management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Product</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<div class="row" data-permission-module="Products">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Product list</h5>
                    <button type="button" class="btn btn-primary" data-action="Create" data-bs-toggle="modal" data-bs-target="#productModal" onclick="openCreateModal()">
                        <i class="ti ti-plus"></i> Add product
                    </button>
                </div>
            </div>
            <div class="card-body pt-3">
                <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                    <div class="row g-2 flex-grow-1 align-items-end">
                        <div class="col-md-3">
                            <label for="searchText" class="form-label small text-muted mb-0">Search</label>
                            <div class="input-group search-input">
                                <span class="input-group-text"><i class="ti ti-search"></i></span>
                                <input type="text" id="searchText" class="form-control" placeholder="Search by name…">
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="filterCategory" class="form-label small text-muted mb-0">Category</label>
                            <div class="searchable-select">
                                <select id="filterCategory" class="form-select form-select-sm" onchange="onFilterCategoryChange()">
                                    <option value="">All</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="filterSubCategory" class="form-label small text-muted mb-0">Subcategory</label>
                            <div class="searchable-select">
                                <select id="filterSubCategory" class="form-select form-select-sm">
                                    <option value="">All</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <label for="filterBrand" class="form-label small text-muted mb-0">Brand</label>
                            <div class="searchable-select">
                                <select id="filterBrand" class="form-select form-select-sm">
                                    <option value="">All</option>
                                </select>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="table-container">
                    <div class="table-scroll-wrapper">
                        <table class="table align-middle mb-0 admin-master-list-table" id="productTable">
                            <thead>
                                <tr>
                                    <th class="col-name text-start">Name</th>
                                    <th class="text-start">Category</th>
                                    <th class="text-start">Brand</th>
                                    <th class="col-status text-start">Status</th>
                                    <th class="col-actions text-start">Actions</th>
                                </tr>
                            </thead>
                            <tbody id="productTableBody">
                                <tr>
                                    <td colspan="5" class="text-center py-5">
                                        <div class="spinner-border text-primary" role="status">
                                            <span class="visually-hidden">Loading…</span>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>

                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top pagination-wrapper">
                    <div class="d-flex align-items-center gap-2">
                        <span class="text-muted small">Show</span>
                        <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                            <option value="10">10</option>
                            <option value="25">25</option>
                            <option value="50">50</option>
                            <option value="100">100</option>
                        </select>
                        <span class="text-muted small">per page</span>
                    </div>
                    <div class="d-flex align-items-center gap-3">
                        <span id="paginationInfo" class="text-muted small"></span>
                        <nav aria-label="Page navigation">
                            <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="productModal" tabindex="-1" aria-labelledby="productModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="productModalLabel">Add product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="productForm">
                    <input type="hidden" id="productID" value="0">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="productName" class="form-label">Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="productName" maxlength="255" required>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="productSlug" class="form-label">Slug</label>
                            <input type="text" class="form-control" id="productSlug" maxlength="255" placeholder="Leave blank to generate from name">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="fkCategory" class="form-label">Category <span class="text-danger">*</span></label>
                            <div class="searchable-select">
                                <select class="form-select" id="fkCategory" required onchange="loadSubCategoriesForProduct()">
                                    <option value="">Select category</option>
                                </select>
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="fkSubCategory" class="form-label">Subcategory <span class="text-danger">*</span></label>
                            <div class="searchable-select">
                                <select class="form-select" id="fkSubCategory" required>
                                    <option value="">Select subcategory</option>
                                </select>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="fkBrand" class="form-label">Brand</label>
                        <div class="searchable-select">
                            <select class="form-select" id="fkBrand">
                                <option value="">Optional</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Product media</label>
                        <div id="productMediaDropZone" class="border rounded p-3 text-center bg-light" style="cursor: pointer;">
                            <div class="mb-2">
                                <i class="ti ti-photo-up fs-3 text-primary"></i>
                            </div>
                            <div class="fw-semibold">Drag &amp; drop images or one video</div>
                            <div class="small text-muted mb-2">or click to upload</div>
                            <button type="button" class="btn btn-sm btn-outline-primary" id="btnPickProductMedia">
                                <i class="ti ti-upload"></i> Upload media
                            </button>
                            <input type="file" id="productMediaFiles" accept=".jpg,.jpeg,.png,.webp,.mp4,.webm" multiple class="d-none">
                        </div>
                        <div class="form-text mt-1">Maximum 5 items. Maximum 1 video. Images: jpg, jpeg, png, webp (2MB). Video: mp4, webm (20MB).</div>
                        <div id="productMediaPreviewList" class="row g-2 mt-2"></div>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="productIsActive" checked>
                        <label class="form-check-label" for="productIsActive">Active</label>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="productSellOnline">
                        <label class="form-check-label" for="productSellOnline">Sell online</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveProduct()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete product</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this product?</p>
                <input type="hidden" id="deleteProductID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="/Admin/assets/js/plugins/choices.min.js"></script>
<script src="/Admin/assets/js/common/searchable-select.js?v=select-media-1"></script>
<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let paginationInstance = null;
    let searchTimeout = null;
    let productMediaItems = [];
    let productExistingMediaIdsOnOpen = [];
    let productMediaDragKey = null;

    const TABLE_BODY_ID = 'productTableBody';
    const TABLE_COLUMN_COUNT = 5;

    // 2. API Endpoints
    const API = {
        getList: '/Admin/Product/GetProductList',
        getById: '/Admin/Product/GetById',
        create: '/Admin/Product/Create',
        update: '/Admin/Product/Update',
        delete: '/Admin/Product/Delete',
        getMedia: '/Admin/Product/GetMedia',
        categories: '/Admin/Product/GetCategories',
        subCategories: '/Admin/Product/GetSubCategories',
        brands: '/Admin/Product/GetBrands'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: 'pagination',
            infoId: 'paginationInfo',
            onPageChange: loadProducts
        });

        document.getElementById('searchText').addEventListener('input', handleSearch);
        document.getElementById('filterSubCategory').addEventListener('change', function () { loadProducts(1); });
        document.getElementById('filterBrand').addEventListener('change', function () { loadProducts(1); });

        loadCategories();
        loadSubCategoriesForFilter();
        loadBrands();
        loadProducts();
        bindProductMediaDropZone();
    });

    // 4. Event Handlers
    function handleSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
            loadProducts(1);
        }, 500);
    }

    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        loadProducts(1);
    }

    // 5. Listing API
    async function loadProducts(page = 1) {
        currentPage = page;

        const input = {
            searchText: document.getElementById('searchText').value || '',
            filterCategoryIDs: filterJsonFromSelect('filterCategory'),
            filterSubCategoryIDs: filterJsonFromSelect('filterSubCategory'),
            filterBrandIDs: filterJsonFromSelect('filterBrand'),
            pageIndex: currentPage,
            pageSize: pageSize,
            sortColumn: 0,
            sortMode: ''
        };

        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'Product List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const data = result?.data;

            if (!data?.tableData?.length) {
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
                if (paginationInstance && data?.tableSettings) {
                    paginationInstance.render(normalizeTableSettings(data.tableSettings));
                }
                return;
            }

            displayProducts(data.tableData);

            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(normalizeTableSettings(data.tableSettings));
            }
        } catch (error) {
            listing.handleListingError(
                'Product List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displayProducts(products) {
        const tableBody = document.getElementById(TABLE_BODY_ID);
        tableBody.innerHTML = products.map(function (p) {
            return createProductRow(p);
        }).join('');
        initTableTooltips(tableBody);
    }

    // 7. Row Creation
    function createProductRow(p) {
        const id = p.productId ?? p.id_Product ?? p.ID_Product ?? 0;
        const name = p.name ?? p.Name ?? '';
        const imageUrl = p.imageUrl ?? p.ImageUrl ?? '';
        const cat = p.categoryName ?? p.CategoryName ?? '';
        const brand = p.brandName ?? p.BrandName ?? '';
        const active = p.isActive ?? p.IsActive ?? false;
        const sellOnline = p.sellOnline ?? p.SellOnline ?? false;
        const cancelled = p.cancelled ?? p.Cancelled ?? false;
        const badgeClass = active ? 'bg-success' : 'bg-secondary';
        const statusText = cancelled ? 'Deleted' : (active ? 'Active' : 'Inactive');
        const onlineClass = sellOnline ? 'bg-info' : 'bg-secondary';
        const onlineText = sellOnline ? 'Online' : 'Offline';
        return `
            <tr>
                <td class="col-name text-start">${renderListThumb(imageUrl, name)}</td>
                <td class="text-start">${truncatedCellHtml(cat, 30)}</td>
                <td class="text-start">${truncatedCellHtml(brand || '—', 25)}</td>
                <td class="col-status text-start">
                    <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip">${escapeHtml(statusText)}</span>
                    <span class="badge ${onlineClass} ms-1" title="${escapeAttr(onlineText)}" data-bs-toggle="tooltip">${escapeHtml(onlineText)}</span>
                </td>
                <td class="col-actions text-start">
                    ${cancelled ? '' : `
                    <div class="table-actions">
                        <button type="button" class="btn-action" data-action="Edit" onclick="openEditModal(${id})" title="Edit" data-bs-toggle="tooltip"><i class="ti ti-edit"></i></button>
                        <button type="button" class="btn-action" data-action="Delete" onclick="openDeleteModal(${id})" title="Delete" data-bs-toggle="tooltip"><i class="ti ti-trash"></i></button>
                    </div>`}
                </td>
            </tr>`;
    }

    // 8. Create / Edit
    function openCreateModal() {
        document.getElementById('productModalLabel').textContent = 'Add product';
        document.getElementById('productForm').reset();
        document.getElementById('productID').value = '0';
        adminSelect.setValue(document.getElementById('fkCategory'), '');
        adminSelect.fill(document.getElementById('fkSubCategory'), [], {
            placeholder: 'Select subcategory',
            searchPlaceholder: 'Search subcategories...'
        });
        adminSelect.setValue(document.getElementById('fkBrand'), '');
        document.getElementById('productIsActive').checked = true;
        document.getElementById('productSellOnline').checked = false;
        resetProductMedia();
    }

    async function openEditModal(productID) {
        try {
            const response = await fetch(`${API.getById}/${productID}`);
            if (!response.ok) throw new Error('Not found');
            const p = await response.json();
            document.getElementById('productModalLabel').textContent = 'Edit product';
            document.getElementById('productID').value = String(p.productId ?? p.id_Product ?? p.ID_Product ?? 0);
            document.getElementById('productName').value = p.name ?? p.Name ?? '';
            document.getElementById('productSlug').value = p.slug ?? p.Slug ?? '';
            document.getElementById('description').value = p.description ?? p.Description ?? '';
            document.getElementById('productIsActive').checked = (p.isActive ?? p.IsActive ?? true) === true;
            document.getElementById('productSellOnline').checked = (p.sellOnline ?? p.SellOnline ?? false) === true;
            const fkCat = p.fkCategory ?? p.fk_Category ?? p.FK_Category ?? '';
            adminSelect.setValue(document.getElementById('fkCategory'), fkCat);
            await loadSubCategoriesForProduct(p.fkSubCategory ?? p.fk_SubCategory ?? p.FK_SubCategory ?? '');
            const fb = p.fkBrand ?? p.fk_Brand ?? p.FK_Brand;
            adminSelect.setValue(document.getElementById('fkBrand'), fb != null && fb !== '' ? fb : '');
            await loadProductMediaForEdit(p.media ?? p.Media ?? [], productID);
            new bootstrap.Modal(document.getElementById('productModal')).show();
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Could not load product.');
            else alert('Could not load product.');
        }
    }

    async function saveProduct() {
        const productID = parseInt(document.getElementById('productID').value, 10);
        const name = document.getElementById('productName').value.trim();
        const slug = document.getElementById('productSlug').value.trim();
        const description = document.getElementById('description').value.trim();
        const fkCategoryRaw = adminSelect.getValue(document.getElementById('fkCategory'));
        const fkSubRaw = adminSelect.getValue(document.getElementById('fkSubCategory'));
        const fkCategory = parseInt(fkCategoryRaw, 10);
        const fkSubCategory = parseInt(fkSubRaw, 10);
        const fkBrandVal = adminSelect.getValue(document.getElementById('fkBrand'));
        const fkBrand = fkBrandVal ? parseInt(fkBrandVal, 10) : null;

        if (!name) {
            if (typeof showWarning === 'function') showWarning('Validation', 'Please enter a name.');
            else alert('Please enter a name.');
            return;
        }
        if (!fkCategoryRaw || isNaN(fkCategory) || fkCategory <= 0) {
            if (typeof showWarning === 'function') showWarning('Validation', 'Please select a category.');
            else alert('Please select a category.');
            return;
        }
        if (!fkSubRaw || isNaN(fkSubCategory) || fkSubCategory <= 0 || fkSubRaw === 'undefined') {
            if (typeof showWarning === 'function') {
                showWarning('Validation', 'Please select a subcategory again (wait for the list to load after choosing a category).');
            } else {
                alert('Please select a subcategory.');
            }
            return;
        }

        const currentExistingIds = productMediaItems
            .filter(x => x.isExisting && x.mediaId > 0)
            .map(x => x.mediaId);
        const removedMediaIds = productExistingMediaIdsOnOpen.filter(id => !currentExistingIds.includes(id));
        const newItems = productMediaItems.filter(x => !x.isExisting && x.file);
        const primaryItem = productMediaItems.find(x => x.isPrimary);
        const primaryExistingId = primaryItem?.isExisting ? (primaryItem.mediaId || 0) : 0;
        const primaryNewIndex = !primaryItem?.isExisting
            ? newItems.findIndex(x => x.key === primaryItem?.key)
            : -1;

        const formData = new FormData();
        formData.append('ID_Product', String(productID));
        formData.append('FK_Category', String(fkCategory));
        formData.append('FK_SubCategory', String(fkSubCategory));
        if (fkBrand) {
            formData.append('FK_Brand', String(fkBrand));
        }
        formData.append('Name', name);
        formData.append('Slug', slug);
        formData.append('Description', description);
        formData.append('IsActive', document.getElementById('productIsActive').checked ? 'true' : 'false');
        formData.append('SellOnline', document.getElementById('productSellOnline').checked ? 'true' : 'false');
        currentExistingIds.forEach(id => formData.append('ExistingMediaOrder', String(id)));
        removedMediaIds.forEach(id => formData.append('RemovedMediaIds', String(id)));
        newItems.forEach(item => formData.append('Files', item.file));
        if (primaryExistingId > 0) {
            formData.append('PrimaryMediaId', String(primaryExistingId));
        } else if (primaryNewIndex >= 0) {
            formData.append('PrimaryIndex', String(primaryNewIndex));
        }

        const url = productID === 0 ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });
            const result = await response.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('productModal')).hide();
                loadProducts(currentPage);
                if (typeof showSuccess === 'function') {
                    showSuccess('Saved', result.responseMsg || result.ResponseMsg || 'Product saved.');
                }
            } else {
                if (typeof showError === 'function') {
                    showError('Error', result.responseMsg || result.ResponseMsg || 'Save failed.');
                } else {
                    alert(result.responseMsg || result.ResponseMsg || 'Save failed.');
                }
            }
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Save failed.');
            else alert('Save failed.');
        }
    }

    // 9. Delete
    function openDeleteModal(productID) {
        document.getElementById('deleteProductID').value = String(productID);
        new bootstrap.Modal(document.getElementById('deleteModal')).show();
    }

    async function confirmDelete() {
        const productID = parseInt(document.getElementById('deleteProductID').value, 10);
        try {
            const response = await fetch(API.delete, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ id_Product: productID })
            });
            const result = await response.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('deleteModal')).hide();
                loadProducts(currentPage);
                if (typeof showSuccess === 'function') {
                    showSuccess('Deleted', result.responseMsg || result.ResponseMsg || 'Deleted.');
                }
            } else {
                if (typeof showError === 'function') {
                    showError('Error', result.responseMsg || result.ResponseMsg || 'Delete failed.');
                } else {
                    alert(result.responseMsg || result.ResponseMsg || 'Delete failed.');
                }
            }
        } catch (e) {
            console.error(e);
            if (typeof showError === 'function') showError('Error', 'Delete failed.');
            else alert('Delete failed.');
        }
    }

    // 10. Page-specific Helper Functions
    function nameInitials(name) {
        const text = String(name || '').trim();
        return text ? text.substring(0, 2) : '—';
    }

    function renderListThumb(imageUrl, name) {
        const media = imageUrl
            ? `<img src="${escapeAttr(imageUrl)}" alt="" class="list-entity-thumb">`
            : `<span class="list-entity-initials">${escapeHtml(nameInitials(name))}</span>`;
        return `<div class="list-entity-cell">${media}<span class="list-entity-name" title="${escapeAttr(name)}">${escapeHtml(name)}</span></div>`;
    }

    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '…' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function normalizeTableSettings(s) {
        if (!s) return { pageIndex: 1, pageSize: 10, totalCount: 0 };
        return {
            pageIndex: s.pageIndex ?? s.PageIndex ?? 1,
            pageSize: s.pageSize ?? s.PageSize ?? 10,
            totalCount: s.totalCount ?? s.TotalCount ?? 0
        };
    }

    function filterJsonFromSelect(selectId) {
        const v = adminSelect.getValue(document.getElementById(selectId));
        if (!v) return '';
        const n = parseInt(v, 10);
        if (isNaN(n) || n <= 0) return '';
        return `[{"ID_Value":${n}}]`;
    }

    /** Resolves IDs from API JSON (System.Text.Json camelCase can emit iD_SubCategory, etc.). */
    function pickCategoryId(cat) {
        if (!cat) return 0;
        const raw = cat.categoryID ?? cat.CategoryID ?? cat.iD_Category ?? cat.ID_Category;
        const n = parseInt(String(raw ?? ''), 10);
        return !isNaN(n) && n > 0 ? n : 0;
    }

    function pickSubCategoryId(sc) {
        if (!sc) return 0;
        const direct = sc.id_SubCategory ?? sc.ID_SubCategory ?? sc.iD_SubCategory ?? sc.subCategoryId ?? sc.SubCategoryId;
        let n = parseInt(String(direct ?? ''), 10);
        if (!isNaN(n) && n > 0) return n;
        for (const k of Object.keys(sc)) {
            const kl = k.toLowerCase();
            if (kl.includes('subcategory') && kl.includes('id')) {
                n = parseInt(String(sc[k]), 10);
                if (!isNaN(n) && n > 0) return n;
            }
        }
        return 0;
    }

    function pickBrandId(b) {
        if (!b) return 0;
        const raw = b.id_Brand ?? b.ID_Brand ?? b.iD_Brand ?? b.brandID ?? b.BrandID;
        const n = parseInt(String(raw ?? ''), 10);
        return !isNaN(n) && n > 0 ? n : 0;
    }

    function mapCategoryChoice(cat) {
        const id = pickCategoryId(cat);
        const name = cat.categoryName ?? cat.CategoryName ?? cat.name ?? cat.Name ?? '';
        if (!name || id <= 0) return null;
        return {
            value: String(id),
            label: name,
            imageUrl: cat.imageUrl ?? cat.ImageUrl ?? ''
        };
    }

    function mapSubCategoryChoice(sc) {
        const id = pickSubCategoryId(sc);
        const name = sc.subCategoryName ?? sc.SubCategoryName ?? sc.name ?? sc.Name ?? '';
        if (!name || id <= 0) return null;
        return {
            value: String(id),
            label: name,
            imageUrl: sc.imageUrl ?? sc.ImageUrl ?? ''
        };
    }

    function mapBrandChoice(b) {
        const id = pickBrandId(b);
        const name = b.name ?? b.Name ?? b.brandName ?? b.BrandName ?? '';
        if (!name || id <= 0) return null;
        return {
            value: String(id),
            label: name,
            imageUrl: b.imageUrl ?? b.ImageUrl ?? ''
        };
    }

    async function loadCategories() {
        try {
            const response = await fetch(API.categories);
            if (!response.ok) throw new Error('Failed to load categories');
            const categories = await response.json();
            const items = categories
                .filter(function (cat) { return !(cat.cancelled || cat.Cancelled); })
                .map(mapCategoryChoice)
                .filter(Boolean);

            adminSelect.fill(document.getElementById('filterCategory'), items, {
                placeholder: 'All',
                searchPlaceholder: 'Search categories...'
            });
            adminSelect.fill(document.getElementById('fkCategory'), items, {
                placeholder: 'Select category',
                searchPlaceholder: 'Search categories...'
            });
        } catch (e) {
            console.error(e);
        }
    }

    async function onFilterCategoryChange() {
        await loadSubCategoriesForFilter();
        loadProducts(1);
    }

    async function loadSubCategoriesForFilter() {
        const categoryId = adminSelect.getValue(document.getElementById('filterCategory'));
        const url = categoryId ? `${API.subCategories}?categoryId=${categoryId}` : API.subCategories;
        try {
            const response = await fetch(url);
            if (!response.ok) throw new Error('Failed to load subcategories');
            const list = await response.json();
            const items = list
                .filter(function (sc) { return !(sc.cancelled || sc.Cancelled); })
                .map(mapSubCategoryChoice)
                .filter(Boolean);

            adminSelect.fill(document.getElementById('filterSubCategory'), items, {
                placeholder: 'All',
                searchPlaceholder: 'Search subcategories...'
            });
        } catch (e) {
            console.error(e);
        }
    }

    async function loadSubCategoriesForProduct(selectedId) {
        const categoryId = adminSelect.getValue(document.getElementById('fkCategory'));
        const sel = document.getElementById('fkSubCategory');
        if (!categoryId) {
            adminSelect.fill(sel, [], {
                placeholder: 'Select subcategory',
                searchPlaceholder: 'Search subcategories...'
            });
            return;
        }
        try {
            const response = await fetch(`${API.subCategories}?categoryId=${categoryId}`);
            if (!response.ok) throw new Error('Failed to load subcategories');
            const list = await response.json();
            const items = list
                .filter(function (sc) { return !(sc.cancelled || sc.Cancelled); })
                .map(mapSubCategoryChoice)
                .filter(Boolean);

            adminSelect.fill(sel, items, {
                placeholder: 'Select subcategory',
                searchPlaceholder: 'Search subcategories...',
                selected: selectedId || ''
            });
        } catch (e) {
            console.error(e);
        }
    }

    async function loadBrands() {
        try {
            const response = await fetch(API.brands);
            if (!response.ok) throw new Error('Failed to load brands');
            const brands = await response.json();
            const items = brands.map(mapBrandChoice).filter(Boolean);

            adminSelect.fill(document.getElementById('filterBrand'), items, {
                placeholder: 'All',
                searchPlaceholder: 'Search brands...'
            });
            adminSelect.fill(document.getElementById('fkBrand'), items, {
                placeholder: 'Optional',
                searchPlaceholder: 'Search brands...'
            });
        } catch (e) {
            console.error(e);
        }
    }

    function bindProductMediaDropZone() {
        const dropZone = document.getElementById('productMediaDropZone');
        const fileInput = document.getElementById('productMediaFiles');
        const pickButton = document.getElementById('btnPickProductMedia');

        pickButton?.addEventListener('click', function (e) {
            e.preventDefault();
            fileInput?.click();
        });
        dropZone?.addEventListener('click', function (e) {
            if (e.target && e.target.closest('#btnPickProductMedia')) {
                return;
            }
            fileInput?.click();
        });
        fileInput?.addEventListener('change', function () {
            if (this.files && this.files.length > 0) {
                appendProductMedia(Array.from(this.files));
                this.value = '';
            }
        });
        dropZone?.addEventListener('dragover', function (e) {
            e.preventDefault();
            dropZone.classList.add('border-primary');
        });
        dropZone?.addEventListener('dragleave', function () {
            dropZone.classList.remove('border-primary');
        });
        dropZone?.addEventListener('drop', function (e) {
            e.preventDefault();
            dropZone.classList.remove('border-primary');
            const files = Array.from(e.dataTransfer?.files || []);
            if (files.length > 0) {
                appendProductMedia(files);
            }
        });
    }

    function resetProductMedia() {
        productMediaItems.forEach(item => {
            if (item.previewUrl && item.previewUrl.startsWith('blob:')) {
                URL.revokeObjectURL(item.previewUrl);
            }
        });
        productMediaItems = [];
        productExistingMediaIdsOnOpen = [];
        productMediaDragKey = null;
        renderProductMediaPreviews();
    }

    async function loadProductMediaForEdit(mediaRows, productId) {
        resetProductMedia();
        let rows = Array.isArray(mediaRows) ? mediaRows : [];
        if (rows.length === 0 && productId) {
            try {
                const response = await fetch(`${API.getMedia}/${productId}`);
                if (response.ok) {
                    rows = await response.json();
                }
            } catch (e) {
                console.error(e);
            }
        }

        productMediaItems = (Array.isArray(rows) ? rows : []).map(function (item) {
            const mediaId = item.idProductMedia ?? item.ID_ProductMedia ?? 0;
            const mediaType = item.mediaType ?? item.MediaType ?? 'Image';
            const mediaUrl = item.mediaUrl ?? item.MediaUrl ?? '';
            return {
                key: `existing_${mediaId}`,
                isExisting: true,
                mediaId: mediaId,
                file: null,
                mediaType: mediaType,
                mediaUrl: mediaUrl,
                previewUrl: mediaUrl,
                isPrimary: (item.isPrimary ?? item.IsPrimary ?? false) === true
            };
        });
        if (!productMediaItems.some(x => x.isPrimary) && productMediaItems.length > 0) {
            productMediaItems[0].isPrimary = true;
        }
        productExistingMediaIdsOnOpen = productMediaItems
            .filter(x => x.isExisting && x.mediaId > 0)
            .map(x => x.mediaId);
        renderProductMediaPreviews();
    }

    function appendProductMedia(files) {
        const imageExt = ['.jpg', '.jpeg', '.png', '.webp'];
        const videoExt = ['.mp4', '.webm'];

        for (const file of files) {
            const nameLower = (file.name || '').toLowerCase();
            const isImage = imageExt.some(ext => nameLower.endsWith(ext));
            const isVideo = videoExt.some(ext => nameLower.endsWith(ext));
            if (!isImage && !isVideo) {
                if (typeof showWarning === 'function') {
                    showWarning('Validation', 'Only jpg, jpeg, png, webp images and mp4/webm videos are allowed.');
                }
                continue;
            }
            if (isImage && (file.size || 0) > 2 * 1024 * 1024) {
                if (typeof showWarning === 'function') {
                    showWarning('Validation', 'Each image must be less than or equal to 2 MB.');
                }
                continue;
            }
            if (isVideo && (file.size || 0) > 20 * 1024 * 1024) {
                if (typeof showWarning === 'function') {
                    showWarning('Validation', 'Each video must be less than or equal to 20 MB.');
                }
                continue;
            }
            if (productMediaItems.length >= 5) {
                if (typeof showWarning === 'function') {
                    showWarning('Validation', 'Maximum 5 media items are allowed per product.');
                }
                break;
            }
            if (isVideo && productMediaItems.some(x => String(x.mediaType).toLowerCase() === 'video')) {
                if (typeof showWarning === 'function') {
                    showWarning('Validation', 'Only one video is allowed per product.');
                }
                continue;
            }

            productMediaItems.push({
                key: `new_${Date.now()}_${Math.random().toString(36).slice(2, 8)}`,
                isExisting: false,
                mediaId: 0,
                file: file,
                mediaType: isVideo ? 'Video' : 'Image',
                mediaUrl: '',
                previewUrl: URL.createObjectURL(file),
                isPrimary: false
            });
        }

        if (!productMediaItems.some(x => x.isPrimary) && productMediaItems.length > 0) {
            productMediaItems[0].isPrimary = true;
        }
        renderProductMediaPreviews();
    }

    function renderProductMediaPreviews() {
        const holder = document.getElementById('productMediaPreviewList');
        if (!holder) return;
        if (productMediaItems.length === 0) {
            holder.innerHTML = '<div class="col-12 text-muted small">No media selected.</div>';
            return;
        }

        holder.innerHTML = productMediaItems.map(function (item, index) {
            const url = item.previewUrl || item.mediaUrl || '';
            const isVideo = String(item.mediaType).toLowerCase() === 'video';
            const mediaHtml = isVideo
                ? `<video src="${escapeAttr(url)}" class="card-img-top" style="height: 140px; object-fit: cover;" muted></video>`
                : `<img src="${escapeAttr(url)}" class="card-img-top" style="height: 140px; object-fit: cover;" alt="Product media ${index + 1}">`;
            return `
                <div class="col-md-4">
                    <div class="card h-100 ${item.isPrimary ? 'border-primary' : ''}" draggable="true"
                        ondragstart="onProductMediaDragStart('${item.key}')"
                        ondragover="onProductMediaDragOver(event)"
                        ondrop="onProductMediaDrop('${item.key}')">
                        ${mediaHtml}
                        <div class="card-body p-2">
                            <div class="d-flex justify-content-between align-items-center mb-2">
                                <span class="badge ${isVideo ? 'bg-info' : 'bg-secondary'}">${isVideo ? 'Video' : 'Image'}</span>
                                <span class="small text-muted">#${index + 1}</span>
                            </div>
                            <div class="form-check mb-2">
                                <input class="form-check-input" type="radio" name="productPrimaryMedia" ${item.isPrimary ? 'checked' : ''}
                                    onchange="setProductPrimaryMedia('${item.key}')">
                                <label class="form-check-label small">Primary</label>
                            </div>
                            <button type="button" class="btn btn-sm btn-outline-danger" onclick="removeProductMedia('${item.key}')">
                                <i class="ti ti-trash"></i>
                            </button>
                        </div>
                    </div>
                </div>`;
        }).join('');
    }

    function onProductMediaDragStart(key) {
        productMediaDragKey = key;
    }

    function onProductMediaDragOver(e) {
        e.preventDefault();
    }

    function onProductMediaDrop(targetKey) {
        if (!productMediaDragKey || productMediaDragKey === targetKey) {
            return;
        }
        const fromIndex = productMediaItems.findIndex(x => x.key === productMediaDragKey);
        const toIndex = productMediaItems.findIndex(x => x.key === targetKey);
        if (fromIndex < 0 || toIndex < 0) {
            return;
        }
        const [moved] = productMediaItems.splice(fromIndex, 1);
        productMediaItems.splice(toIndex, 0, moved);
        productMediaDragKey = null;
        renderProductMediaPreviews();
    }

    function setProductPrimaryMedia(key) {
        productMediaItems = productMediaItems.map(x => ({ ...x, isPrimary: x.key === key }));
        renderProductMediaPreviews();
    }

    function removeProductMedia(key) {
        const idx = productMediaItems.findIndex(x => x.key === key);
        if (idx < 0) return;
        const item = productMediaItems[idx];
        if (item.previewUrl && item.previewUrl.startsWith('blob:')) {
            URL.revokeObjectURL(item.previewUrl);
        }
        productMediaItems.splice(idx, 1);
        if (!productMediaItems.some(x => x.isPrimary) && productMediaItems.length > 0) {
            productMediaItems[0].isPrimary = true;
        }
        renderProductMediaPreviews();
    }
</script>
