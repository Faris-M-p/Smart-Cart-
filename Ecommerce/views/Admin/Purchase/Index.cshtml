@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Purchase & Stock Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Purchase</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Purchase List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#purchaseModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Purchase
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search purchases...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">Supplier</label>
                                        <select id="filterSupplier" class="form-select">
                                            <option value="">All Suppliers</option>
                                        </select>
                                    </div>

                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">Payment Status</label>
                                        <select id="filterPaymentStatus" class="form-select">
                                            <option value="">All</option>
                                            <option value="Pending">Pending</option>
                                            <option value="Paid">Paid</option>
                                            <option value="PartialPaid">PartialPaid</option>
                                        </select>
                                    </div>
                                    
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">From Date</label>
                                        <input type="date" id="fromDate" class="form-control">
                                    </div>
                                    
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">To Date</label>
                                        <input type="date" id="toDate" class="form-control">
                                    </div>
                                    
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadPurchases()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Purchase Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="purchaseTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">GRN Number</th>
                                            <th class="text-muted">Invoice Number</th>
                                            <th class="text-muted">Supplier</th>
                                            <th class="text-muted">Purchase Date</th>
                                            <th class="text-muted">Total Amount</th>
                                            <th class="text-muted">Payment Status</th>
                                            <th class="text-muted">Created Date</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="purchaseTableBody">
                                        <tr>
                                            <td colspan="8" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadPurchases()">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Purchase Modal (Create/Edit) -->
<div class="modal fade" id="purchaseModal" tabindex="-1" aria-labelledby="purchaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="purchaseModalLabel">Add Purchase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="purchaseForm">
                    <input type="hidden" id="purchaseID" name="ID_Purchase" value="0">
                    
                    <!-- Purchase Header -->
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label for="fkSupplier" class="form-label">Supplier <span class="text-danger">*</span></label>
                            <select class="form-select" id="fkSupplier" name="FK_Supplier" required>
                                <option value="">Select Supplier</option>
                            </select>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-4">
                            <label for="purchaseDate" class="form-label">Purchase Date <span class="text-danger">*</span></label>
                            <input type="date" class="form-control" id="purchaseDate" name="PurchaseDate" required>
                        </div>
                        <div class="col-md-4">
                            <label for="invoiceNumber" class="form-label">Invoice Number</label>
                            <input type="text" class="form-control" id="invoiceNumber" name="InvoiceNumber" maxlength="100">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-md-12">
                            <label for="notes" class="form-label">Notes</label>
                            <textarea class="form-control" id="notes" name="Notes" rows="2" maxlength="500"></textarea>
                        </div>
                    </div>

                    <!-- Purchase Details -->
                    <div class="mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label mb-0">Purchase Details <span class="text-danger">*</span></label>
                            <button type="button" class="btn btn-sm btn-outline-primary" onclick="addPurchaseDetailRow()">
                                <i class="ti ti-plus"></i> Add Item
                            </button>
                        </div>
                        <div class="table-responsive">
                            <table class="table table-bordered" id="purchaseDetailsTable">
                                <thead>
                                    <tr>
                                        <th style="width: 25%">Product</th>
                                        <th style="width: 25%">SKU</th>
                                        <th style="width: 10%">Quantity</th>
                                        <th style="width: 12%">Purchase Price</th>
                                        <th style="width: 12%">MRP</th>
                                        <th style="width: 10%">Expiry Date</th>
                                        <th style="width: 6%">Action</th>
                                    </tr>
                                </thead>
                                <tbody id="purchaseDetailsTableBody">
                                    <!-- Rows will be added dynamically -->
                                </tbody>
                            </table>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="savePurchase()">Save Purchase</button>
            </div>
        </div>
    </div>
</div>

<!-- View Purchase Details Modal -->
<div class="modal fade" id="viewPurchaseModal" tabindex="-1" aria-labelledby="viewPurchaseModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="viewPurchaseModalLabel">Purchase Details</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="viewPurchaseModalBody">
                <!-- Content will be loaded dynamically -->
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Purchase</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this purchase? This will also cancel related stock entries.</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deletePurchaseID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let emptyState;
    let currentPage = 1;
    let pageSize = 20;
    let suppliers = [];
    let products = [];
    let productVariants = {}; // Map productId to variants
    let purchaseSearchTimeout;

    document.addEventListener('DOMContentLoaded', function() {
        emptyState = window.__emptyStateInstance || (window.__emptyStateInstance = new EmptyStateHandler());
        loadSuppliers();
        loadProducts();
        loadPurchases();

        document.getElementById('searchText')?.addEventListener('input', function () {
            const value = this.value.trim();
            clearTimeout(purchaseSearchTimeout);
            purchaseSearchTimeout = setTimeout(function () {
                if (value.length === 0 || value.length >= 1) {
                    loadPurchases(1);
                }
            }, 300);
        });
    });

    function showPurchaseLoading() {
        const tbody = document.getElementById('purchaseTableBody');
        tbody.innerHTML = `
            <tr>
                <td colspan="8" class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Loading...</span>
                    </div>
                </td>
            </tr>
        `;
    }

    function hasPurchaseFiltersApplied() {
        const searchText = (document.getElementById('searchText')?.value || '').trim();
        const supplier = (document.getElementById('filterSupplier')?.value || '').trim();
        const ps = (document.getElementById('filterPaymentStatus')?.value || '').trim();
        const from = (document.getElementById('fromDate')?.value || '').trim();
        const to = (document.getElementById('toDate')?.value || '').trim();
        return !!searchText || !!supplier || !!ps || !!from || !!to;
    }

    async function loadSuppliers() {
        try {
            const response = await fetch('/Admin/Purchase/GetSuppliers');
            if (!response.ok) throw new Error('Failed to fetch suppliers');

            suppliers = await response.json();
            const dropdown = document.getElementById('fkSupplier');
            const filterDropdown = document.getElementById('filterSupplier');
            
            dropdown.innerHTML = '<option value="">Select Supplier</option>';
            filterDropdown.innerHTML = '<option value="">All Suppliers</option>';
            
            suppliers.forEach(s => {
                const sid = s.supplierID ?? s.SupplierID ?? s.id_Supplier ?? s.iD_Supplier ?? s.ID_Supplier;
                const sname = s.name ?? s.Name ?? s.supplierName ?? s.SupplierName ?? '';
                dropdown.add(new Option(sname, sid));
                filterDropdown.add(new Option(sname, sid));
            });
        } catch (error) {
            console.error('Error loading suppliers:', error);
        }
    }

    async function loadProducts() {
        try {
            const response = await fetch('/Admin/Purchase/GetProducts');
            if (!response.ok) throw new Error('Failed to fetch products');

            products = await response.json();
        } catch (error) {
            console.error('Error loading products:', error);
        }
    }

    async function loadProductVariants(productId, selectElement) {
        if (!productId || productId <= 0) {
            selectElement.innerHTML = '<option value="">Select SKU</option>';
            return;
        }

        try {
            if (!productVariants[productId]) {
                const response = await fetch(`/Admin/Purchase/GetProductVariants/${productId}`);
                if (!response.ok) throw new Error('Failed to fetch product variants');
                productVariants[productId] = await response.json();
            }

            const variants = productVariants[productId];
            selectElement.innerHTML = '<option value="">Select SKU</option>';
            variants.forEach(v => {
                const vid = v.idProductVariant ?? v.ID_ProductVariant;
                const label = v.attributeSignature ?? v.AttributeSignature ?? v.sku ?? v.SKU ?? `SKU #${vid}`;
                const option = new Option(label, vid);
                selectElement.add(option);
            });
        } catch (error) {
            console.error('Error loading product variants:', error);
            selectElement.innerHTML = '<option value="">Error loading SKUs</option>';
        }
    }

    async function loadPurchases(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize')?.value) || 20;
        const searchText = document.getElementById('searchText')?.value || '';
        const filterSupplierID = document.getElementById('filterSupplier')?.value || '';
        const paymentStatus = document.getElementById('filterPaymentStatus')?.value || '';
        const fromDate = document.getElementById('fromDate')?.value || '';
        const toDate = document.getElementById('toDate')?.value || '';

        let filterSupplierIDs = '';
        if (filterSupplierID) {
            filterSupplierIDs = `[{"ID_Value":${filterSupplierID}}]`;
        }

        const input = {
            SearchText: searchText,
            FilterSupplierIDs: filterSupplierIDs,
            FromDate: fromDate || null,
            ToDate: toDate || null,
            PaymentStatus: paymentStatus,
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: 'DESC'
        };

        try {
            showPurchaseLoading();
            const response = await fetch('/Admin/Purchase/GetPurchaseList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError('failure', 'Purchase List Load', { url: '/Admin/Purchase/GetPurchaseList', method: 'POST', payload: input, response });
                emptyState.showInTable('purchaseTableBody', emptyState.states.serverError, {
                    title: 'Something went wrong while loading purchases',
                    message: 'Please try again in a moment.',
                    onRetry: 'loadPurchases(1)'
                }, 8);
                return;
            }

            const data = await response.json();
            const rows = data.tableData || data.TableData || [];
            const settings = data.tableSettings || data.TableSettings;
            displayPurchases(rows);
            displayPagination(settings);
        } catch (error) {
            handleApiError('crash', 'Purchase List Load', { url: '/Admin/Purchase/GetPurchaseList', method: 'POST', payload: input, error });
            emptyState.showInTable('purchaseTableBody', emptyState.states.serverError, {
                title: 'Something went wrong while loading purchases',
                message: 'Unable to connect to server.',
                onRetry: 'loadPurchases(1)'
            }, 8);
        }
    }

    function displayPurchases(purchases) {
        const tbody = document.getElementById('purchaseTableBody');
        
        if (!purchases || purchases.length === 0) {
            const filtered = hasPurchaseFiltersApplied();
            emptyState.showInTable('purchaseTableBody', emptyState.states.noData, {
                title: filtered ? 'No results match your filters' : 'No purchases found',
                message: filtered
                    ? 'Try adjusting your filters.'
                    : 'Try adjusting your filters or create a new purchase.',
                onReset: 'resetFilters()'
            }, 8);
            return;
        }

        tbody.innerHTML = purchases.map(p => {
            const pid = p.id_Purchase ?? p.ID_Purchase ?? 0;
            const grn = p.grnNumber ?? p.GRNNumber ?? (`GRN-${String(pid).padStart(6, '0')}`);
            const inv = p.invoiceNumber ?? p.InvoiceNumber ?? '-';
            const supplier = p.supplierName ?? p.SupplierName ?? 'N/A';
            const pdate = p.purchaseDate ?? p.PurchaseDate;
            const total = p.totalAmount ?? p.TotalAmount ?? 0;
            const pay = p.paymentStatus ?? p.PaymentStatus ?? 'Pending';
            const created = p.createdOn ?? p.CreatedOn;
            const cancelled = p.cancelled ?? p.Cancelled ?? false;
            
            return `
                <tr>
                    <td><strong>${escapeHtml(grn)}</strong></td>
                    <td>${escapeHtml(inv)}</td>
                    <td>${escapeHtml(supplier)}</td>
                    <td>${pdate ? new Date(pdate).toLocaleDateString() : '-'}</td>
                    <td><strong>₹${Number(total).toFixed(2)}</strong></td>
                    <td>${escapeHtml(pay)}</td>
                    <td>${created ? new Date(created).toLocaleDateString() : '-'}</td>
                    <td class="text-end">
                        ${cancelled ? '' : `
                            <button class="btn-action btn-view" onclick="viewPurchase(${pid})" title="View">
                                <i class="ti ti-eye"></i>
                            </button>
                            <button class="btn-action btn-edit" onclick="openEditModal(${pid})" title="Edit">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button class="btn-action btn-delete" onclick="openDeleteModal(${pid})" title="Delete">
                                <i class="ti ti-trash"></i>
                            </button>
                        `}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((settings.PageIndex - 1) * settings.PageSize) + 1;
        const end = Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount);
        paginationInfo.textContent = `${start} to ${end} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (settings.PageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadPurchases(${settings.PageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 1 && i <= settings.PageIndex + 1)) {
                if (i === settings.PageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadPurchases(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === settings.PageIndex - 2 || i === settings.PageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (settings.PageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadPurchases(${settings.PageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('purchaseModalLabel').textContent = 'Add Purchase';
        document.getElementById('purchaseForm').reset();
        document.getElementById('purchaseID').value = '0';
        document.getElementById('purchaseDate').value = new Date().toISOString().split('T')[0];
        document.getElementById('purchaseDetailsTableBody').innerHTML = '';
        addPurchaseDetailRow();
    }

    async function openEditModal(purchaseID) {
        try {
            const response = await fetch(`/Admin/Purchase/GetById/${purchaseID}`);
            if (!response.ok) throw new Error('Failed to fetch purchase');

            const purchaseData = await response.json();
            const purchase = purchaseData.PurchaseHeader;
            const details = purchaseData.PurchaseDetails || [];
            
            document.getElementById('purchaseModalLabel').textContent = 'Edit Purchase';
            document.getElementById('purchaseID').value = purchase.ID_Purchase;
            document.getElementById('fkSupplier').value = purchase.FK_Supplier;
            document.getElementById('purchaseDate').value = purchase.PurchaseDate ? new Date(purchase.PurchaseDate).toISOString().split('T')[0] : '';
            document.getElementById('invoiceNumber').value = purchase.InvoiceNumber || '';
            document.getElementById('notes').value = purchase.Notes || '';
            
            // Populate purchase details
            const tbody = document.getElementById('purchaseDetailsTableBody');
            tbody.innerHTML = '';
            if (details.length > 0) {
                for (const detail of details) {
                    await addPurchaseDetailRow(detail.ID_PurchaseDetail, detail.FK_Product, detail.FK_ProductVariant, detail.Quantity, detail.PurchasePrice, detail.MRP, detail.ExpiryDate);
                }
            } else {
                addPurchaseDetailRow();
            }
            
            const modal = new bootstrap.Modal(document.getElementById('purchaseModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading purchase:', error);
            handleApiError?.('crash', 'Purchase GetById (edit)', { url: `/Admin/Purchase/GetById/${purchaseID}`, method: 'GET', payload: { purchaseID }, error });
            showError('Error', 'Error loading purchase details.');
        }
    }

    async function viewPurchase(purchaseID) {
        try {
            const response = await fetch(`/Admin/Purchase/GetById/${purchaseID}`);
            if (!response.ok) throw new Error('Failed to fetch purchase');

            const purchaseData = await response.json();
            const purchase = purchaseData.PurchaseHeader;
            const details = purchaseData.PurchaseDetails || [];
            const stockBatches = purchaseData.StockBatches || [];
            
            let html = `
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Invoice Number:</strong> ${escapeHtml(purchase.InvoiceNumber || '-')}
                    </div>
                    <div class="col-md-6">
                        <strong>Supplier:</strong> ${escapeHtml(purchase.SupplierName || 'N/A')}
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-md-6">
                        <strong>Purchase Date:</strong> ${purchase.PurchaseDate ? new Date(purchase.PurchaseDate).toLocaleDateString() : '-'}
                    </div>
                    <div class="col-md-6">
                        <strong>Total Amount:</strong> ${purchase.TotalAmount?.toFixed(2) || '0.00'}
                    </div>
                </div>
                ${purchase.Notes ? `<div class="row mb-3"><div class="col-md-12"><strong>Notes:</strong> ${escapeHtml(purchase.Notes)}</div></div>` : ''}
                <hr>
                <h6>Purchase Details</h6>
                <div class="table-responsive">
                    <table class="table table-bordered">
                        <thead>
                            <tr>
                                <th>Product</th>
                                <th>SKU Attributes</th>
                                <th>Quantity</th>
                                <th>Purchase Price</th>
                                <th>MRP</th>
                                <th>Expiry Date</th>
                            </tr>
                        </thead>
                        <tbody>
            `;
            
            details.forEach(detail => {
                html += `
                    <tr>
                        <td>${escapeHtml(detail.ProductName || 'N/A')}</td>
                        <td>${escapeHtml(detail.VariantAttributes || '-')}</td>
                        <td>${detail.Quantity}</td>
                        <td>${detail.PurchasePrice?.toFixed(2) || '0.00'}</td>
                        <td>${detail.MRP?.toFixed(2) || '-'}</td>
                        <td>${detail.ExpiryDate ? new Date(detail.ExpiryDate).toLocaleDateString() : '-'}</td>
                    </tr>
                `;
            });
            
            html += `
                        </tbody>
                    </table>
                </div>
            `;
            
            if (stockBatches.length > 0) {
                html += `
                    <hr>
                    <h6>Stock Batches</h6>
                    <div class="table-responsive">
                        <table class="table table-bordered">
                            <thead>
                                <tr>
                                    <th>Stock ID</th>
                                    <th>SKU</th>
                                    <th>Quantity</th>
                                    <th>Created On</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                `;
                
                stockBatches.forEach(stock => {
                    html += `
                        <tr>
                            <td>${stock.ID_Stock}</td>
                            <td>SKU #${stock.FK_ProductVariant}</td>
                            <td>${stock.Quantity}</td>
                            <td>${stock.CreatedOn ? new Date(stock.CreatedOn).toLocaleDateString() : '-'}</td>
                            <td>
                                <span class="badge ${stock.Cancelled ? 'bg-danger' : 'bg-success'}">
                                    ${stock.Cancelled ? 'Cancelled' : 'Active'}
                                </span>
                            </td>
                        </tr>
                    `;
                });
                
                html += `
                            </tbody>
                        </table>
                    </div>
                `;
            }
            
            document.getElementById('viewPurchaseModalBody').innerHTML = html;
            const modal = new bootstrap.Modal(document.getElementById('viewPurchaseModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading purchase:', error);
            handleApiError?.('crash', 'Purchase GetById (view)', { url: `/Admin/Purchase/GetById/${purchaseID}`, method: 'GET', payload: { purchaseID }, error });
            showError('Error', 'Error loading purchase details.');
        }
    }

    async function addPurchaseDetailRow(purchaseDetailId = 0, productId = null, productVariantId = null, quantity = 0, purchasePrice = 0, mrp = null, expiryDate = null) {
        const tbody = document.getElementById('purchaseDetailsTableBody');
        const row = document.createElement('tr');
        row.className = 'purchase-detail-row';
        row.innerHTML = `
            <td>
                <select class="form-select product-select" onchange="onProductChange(this)" required>
                    <option value="">Select Product</option>
                </select>
                <input type="hidden" class="purchase-detail-id" value="${purchaseDetailId}">
            </td>
            <td>
                <select class="form-select product-variant-select" required>
                    <option value="">Select SKU</option>
                </select>
            </td>
            <td>
                <input type="number" class="form-control quantity-input" min="1" value="${quantity || ''}" required>
            </td>
            <td>
                <input type="number" step="0.01" class="form-control purchase-price-input" min="0" value="${purchasePrice || ''}" required>
            </td>
            <td>
                <input type="number" step="0.01" class="form-control mrp-input" min="0" value="${mrp || ''}">
            </td>
            <td>
                <input type="date" class="form-control expiry-date-input" value="${expiryDate ? new Date(expiryDate).toISOString().split('T')[0] : ''}">
            </td>
            <td>
                <button type="button" class="btn btn-danger btn-sm w-100" onclick="removePurchaseDetailRow(this)">
                    <i class="ti ti-trash"></i>
                </button>
            </td>
        `;
        tbody.appendChild(row);
        
        const productSelect = row.querySelector('.product-select');
        const variantSelect = row.querySelector('.product-variant-select');
        
        // Populate products (supports both camelCase + PascalCase)
        products.forEach(p => {
            const cancelled = p.cancelled ?? p.Cancelled;
            const pid = p.productId ?? p.ID_Product ?? p.iD_Product;
            const pname = p.name ?? p.Name ?? '';
            if (!cancelled && pid > 0) {
                const option = new Option(pname, String(pid));
                if (productId != null && Number(pid) === Number(productId)) {
                    option.selected = true;
                }
                productSelect.add(option);
            }
        });
        
        // If product is selected, load variants
        if (productId) {
            loadProductVariants(productId, variantSelect).then(() => {
                if (productVariantId) {
                    variantSelect.value = productVariantId;
                }
            });
        }
    }

    async function onProductChange(select) {
        const row = select.closest('.purchase-detail-row');
        const variantSelect = row.querySelector('.product-variant-select');
        const productId = parseInt(select.value);
        await loadProductVariants(productId, variantSelect);
    }

    function removePurchaseDetailRow(button) {
        const tbody = document.getElementById('purchaseDetailsTableBody');
        if (tbody.children.length > 1) {
            button.closest('.purchase-detail-row').remove();
        } else {
            showWarning('Validation Error', 'At least one purchase detail is required.');
        }
    }

    function openDeleteModal(purchaseID) {
        document.getElementById('deletePurchaseID').value = purchaseID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function savePurchase() {
        const purchaseID = parseInt(document.getElementById('purchaseID').value);
        const fkSupplier = parseInt(document.getElementById('fkSupplier').value);
        const purchaseDate = document.getElementById('purchaseDate').value;
        const invoiceNumber = document.getElementById('invoiceNumber').value.trim();
        const notes = document.getElementById('notes').value.trim();

        if (!fkSupplier || fkSupplier <= 0) {
            showWarning('Validation Error', 'Please select a supplier.');
            return;
        }

        if (!purchaseDate) {
            showWarning('Validation Error', 'Please select purchase date.');
            return;
        }

        // Collect purchase details
        const purchaseDetails = [];
        const rows = document.querySelectorAll('.purchase-detail-row');
        rows.forEach(row => {
            const productSelect = row.querySelector('.product-select');
            const variantSelect = row.querySelector('.product-variant-select');
            const quantityInput = row.querySelector('.quantity-input');
            const purchasePriceInput = row.querySelector('.purchase-price-input');
            const mrpInput = row.querySelector('.mrp-input');
            const expiryDateInput = row.querySelector('.expiry-date-input');
            const purchaseDetailId = parseInt(row.querySelector('.purchase-detail-id').value) || 0;
            
            const productVariantId = parseInt(variantSelect.value);
            const quantity = parseInt(quantityInput.value);
            const purchasePrice = parseFloat(purchasePriceInput.value);
            const mrp = mrpInput.value ? parseFloat(mrpInput.value) : null;
            const expiryDate = expiryDateInput.value || null;
            
            if (productVariantId && quantity > 0 && purchasePrice >= 0) {
                purchaseDetails.push({
                    ID_PurchaseDetail: purchaseDetailId,
                    FK_ProductVariant: productVariantId,
                    Quantity: quantity,
                    PurchasePrice: purchasePrice,
                    MRP: mrp,
                    ExpiryDate: expiryDate
                });
            }
        });

        if (purchaseDetails.length === 0) {
            showWarning('Validation Error', 'Please add at least one valid purchase detail.');
            return;
        }

        const input = {
            ID_Purchase: purchaseID,
            FK_Supplier: fkSupplier,
            PurchaseDate: purchaseDate,
            InvoiceNumber: invoiceNumber,
            Notes: notes,
            PurchaseDetails: purchaseDetails
        };

        const url = purchaseID === 0 ? '/Admin/Purchase/Create' : '/Admin/Purchase/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            let result = null;
            try { result = await response.json(); } catch { result = null; }

            if (!response.ok) {
                handleApiError?.('failure', 'Purchase Save', { url, method: 'POST', payload: input, response, result });
                const msg = result?.message || result?.Message || 'Validation failed.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showWarning('Validation Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showWarning('Validation Error', msg);
                }
                return;
            }

            const ok = (result?.statusCode ?? result?.StatusCode) === true;
            if (ok) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('purchaseModal'));
                modal.hide();
                loadPurchases(currentPage);
                showSuccess('Success', result?.responseMsg || result?.ResponseMsg || 'Purchase saved successfully.');
            } else {
                handleApiError?.('failure', 'Purchase Save (business)', { url, method: 'POST', payload: input, response, result });
                const msg = result?.responseMsg || result?.ResponseMsg || result?.message || result?.Message || 'Error saving purchase.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showError('Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showError('Error', msg);
                }
            }
        } catch (error) {
            console.error('Error saving purchase:', error);
            handleApiError?.('crash', 'Purchase Save', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error saving purchase. Please try again.');
        }
    }

    async function confirmDelete() {
        const purchaseID = parseInt(document.getElementById('deletePurchaseID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            ID_Purchase: purchaseID,
            CancelledReason: reason
        };

        try {
            const url = '/Admin/Purchase/Delete';
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            let result = null;
            try { result = await response.json(); } catch { result = null; }

            if (!response.ok) {
                handleApiError?.('failure', 'Purchase Delete', { url, method: 'POST', payload: input, response, result });
                const msg = result?.message || result?.Message || result?.ResponseMsg || 'Error deleting purchase.';
                const errs = result?.errors || result?.Errors || [];
                if (Array.isArray(errs) && errs.length > 0) {
                    showError('Error', escapeHtml(msg) + '<br><br>' + errs.map(escapeHtml).join('<br>'));
                } else {
                    showError('Error', msg);
                }
                return;
            }

            const ok = (result?.statusCode ?? result?.StatusCode) === true;
            if (ok) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadPurchases(currentPage);
                showSuccess('Success', result?.responseMsg || result?.ResponseMsg || 'Purchase deleted successfully.');
            } else {
                handleApiError?.('failure', 'Purchase Delete (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result?.responseMsg || result?.ResponseMsg || 'Error deleting purchase.');
            }
        } catch (error) {
            console.error('Error deleting purchase:', error);
            handleApiError?.('crash', 'Purchase Delete', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error deleting purchase. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('filterSupplier').value = '';
        document.getElementById('filterPaymentStatus').value = '';
        document.getElementById('fromDate').value = '';
        document.getElementById('toDate').value = '';
        document.getElementById('pageSize').value = '20';
        loadPurchases(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
