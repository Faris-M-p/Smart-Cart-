@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ Main Content ] start -->
<div class="pc-container">
    <div class="pc-content">
        <!-- [ breadcrumb ] start -->
        <div class="page-header">
            <div class="page-block">
                <div class="row align-items-center">
                    <div class="col-md-12">
                        <div class="page-header-title">
                            <h5 class="m-b-10">Brand Management</h5>
                        </div>
                        <ul class="breadcrumb">
                            <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                            <li class="breadcrumb-item"><a href="javascript: void(0)">Brand</a></li>
                            <li class="breadcrumb-item" aria-current="page">List</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ breadcrumb ] end -->
        
        <!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Brand List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#brandModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Brand
                            </button>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- Search and Filter -->
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <input type="text" id="searchText" class="form-control" placeholder="Search by brand name...">
                            </div>
                            <div class="col-md-2">
                                <select id="pageSize" class="form-select">
                                    <option value="10">10 per page</option>
                                    <option value="25">25 per page</option>
                                    <option value="50">50 per page</option>
                                    <option value="100">100 per page</option>
                                </select>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-secondary w-100" onclick="loadBrands()">
                                    <i class="ti ti-search"></i> Search
                                </button>
                            </div>
                            <div class="col-md-2">
                                <button type="button" class="btn btn-outline-secondary w-100" onclick="resetFilters()">
                                    <i class="ti ti-refresh"></i> Reset
                                </button>
                            </div>
                        </div>

                        <!-- Brand Table -->
                        <div class="table-responsive">
                            <table class="table table-hover table-borderless mb-0" id="brandTable">
                                <thead>
                                    <tr>
                                        <th>ID</th>
                                        <th>Brand Name</th>
                                        <th>Status</th>
                                        <th class="text-end">Actions</th>
                                    </tr>
                                </thead>
                                <tbody id="brandTableBody">
                                    <tr>
                                        <td colspan="4" class="text-center">
                                            <div class="spinner-border text-primary" role="status">
                                                <span class="visually-hidden">Loading...</span>
                                            </div>
                                        </td>
                                    </tr>
                                </tbody>
                            </table>
                        </div>

                        <!-- Pagination -->
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <div id="paginationInfo" class="text-muted"></div>
                            </div>
                            <div class="col-md-6">
                                <nav aria-label="Page navigation">
                                    <ul class="pagination justify-content-end" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- [ Main Content ] end -->
    </div>
</div>

<!-- Brand Modal (Create/Edit) -->
<div class="modal fade" id="brandModal" tabindex="-1" aria-labelledby="brandModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="brandModalLabel">Add Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="brandForm">
                    <input type="hidden" id="brandID" name="BrandID" value="0">
                    <div class="mb-3">
                        <label for="brandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brandName" name="BrandName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveBrand()">Save Brand</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this brand?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteBrandID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    // Load brands on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadBrands();
        
        // Enter key search
        document.getElementById('searchText').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadBrands();
            }
        });
    });

    async function loadBrands(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        const searchText = document.getElementById('searchText').value || '';

        const input = {
            SearchText: searchText,
            FilterBrandIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: '',
            SortMode: ''
        };

        try {
            const response = await fetch('/Admin/Brand/GetBrandList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            const data = await response.json();
            displayBrands(data.TableData || []);
            displayPagination(data.TableSettings);
        } catch (error) {
            console.error('Error loading brands:', error);
            document.getElementById('brandTableBody').innerHTML = 
                '<tr><td colspan="4" class="text-center text-danger">Error loading brands. Please try again.</td></tr>';
        }
    }

    function displayBrands(brands) {
        const tbody = document.getElementById('brandTableBody');
        
        if (!brands || brands.length === 0) {
            tbody.innerHTML = '<tr><td colspan="4" class="text-center">No brands found.</td></tr>';
            return;
        }

        tbody.innerHTML = brands.map(brand => `
            <tr>
                <td>${brand.BrandID}</td>
                <td>${escapeHtml(brand.BrandName)}</td>
                <td>
                    <span class="badge ${brand.Cancelled ? 'bg-danger' : 'bg-success'}">
                        ${brand.Cancelled ? 'Deleted' : 'Active'}
                    </span>
                </td>
                <td class="text-end">
                    ${brand.Cancelled ? '' : `
                        <button class="btn btn-sm btn-primary" onclick="openEditModal(${brand.BrandID})" title="Edit">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button class="btn btn-sm btn-danger" onclick="openDeleteModal(${brand.BrandID})" title="Delete">
                            <i class="ti ti-trash"></i>
                        </button>
                    `}
                </td>
            </tr>
        `).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        paginationInfo.textContent = `Showing ${((settings.PageIndex - 1) * settings.PageSize) + 1} to ${Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount)} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        paginationHTML += `<li class="page-item ${settings.PageIndex <= 1 ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadBrands(${settings.PageIndex - 1}); return false;">Previous</a>
        </li>`;

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 2 && i <= settings.PageIndex + 2)) {
                paginationHTML += `<li class="page-item ${i === settings.PageIndex ? 'active' : ''}">
                    <a class="page-link" href="#" onclick="loadBrands(${i}); return false;">${i}</a>
                </li>`;
            } else if (i === settings.PageIndex - 3 || i === settings.PageIndex + 3) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        paginationHTML += `<li class="page-item ${settings.PageIndex >= totalPages ? 'disabled' : ''}">
            <a class="page-link" href="#" onclick="loadBrands(${settings.PageIndex + 1}); return false;">Next</a>
        </li>`;

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('brandModalLabel').textContent = 'Add Brand';
        document.getElementById('brandForm').reset();
        document.getElementById('brandID').value = '0';
    }

    async function openEditModal(brandID) {
        try {
            const response = await fetch(`/Admin/Brand/GetById/${brandID}`);
            if (!response.ok) throw new Error('Failed to fetch brand');

            const brand = await response.json();
            
            document.getElementById('brandModalLabel').textContent = 'Edit Brand';
            document.getElementById('brandID').value = brand.BrandID;
            document.getElementById('brandName').value = brand.BrandName || '';
            
            const modal = new bootstrap.Modal(document.getElementById('brandModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading brand:', error);
            alert('Error loading brand details.');
        }
    }

    function openDeleteModal(brandID) {
        document.getElementById('deleteBrandID').value = brandID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveBrand() {
        const brandID = parseInt(document.getElementById('brandID').value);
        const brandName = document.getElementById('brandName').value.trim();

        if (!brandName) {
            alert('Please enter brand name.');
            return;
        }

        const input = {
            BrandID: brandID,
            BrandName: brandName
        };

        const url = brandID === 0 ? '/Admin/Brand/Create' : '/Admin/Brand/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('brandModal'));
                modal.hide();
                loadBrands(currentPage);
                alert(result.ResponseMsg || 'Brand saved successfully.');
            } else {
                if (result.errors && result.errors.length > 0) {
                    alert('Validation errors:\n' + result.errors.join('\n'));
                } else {
                    alert(result.ResponseMsg || 'Error saving brand.');
                }
            }
        } catch (error) {
            console.error('Error saving brand:', error);
            alert('Error saving brand. Please try again.');
        }
    }

    async function confirmDelete() {
        const brandID = parseInt(document.getElementById('deleteBrandID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            BrandID: brandID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/Brand/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadBrands(currentPage);
                alert(result.ResponseMsg || 'Brand deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting brand.');
            }
        } catch (error) {
            console.error('Error deleting brand:', error);
            alert('Error deleting brand. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '10';
        loadBrands(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
