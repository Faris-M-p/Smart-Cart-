@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Brand Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Brand</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Brand List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#brandModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Brand
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search brands...">
                                </div>
                            </div>
                        </div>

                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table align-middle mb-0 admin-master-list-table" id="brandTable">
                                    <thead>
                                        <tr>
                                            <th class="col-name">Brand Name</th>
                                            <th class="col-desc">Description</th>
                                            <th class="col-status">Status</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="brandTableBody">
                                        <tr>
                                            <td colspan="4" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadBrands()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>

                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Brand Modal (Create/Edit) -->
<div class="modal fade" id="brandModal" tabindex="-1" aria-labelledby="brandModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="brandModalLabel">Add Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="brandForm">
                    <input type="hidden" id="brandID" name="BrandID" value="0">
                    <div class="mb-3">
                        <label for="brandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brandName" name="BrandName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="brandIsActive" checked>
                        <label class="form-check-label" for="brandIsActive">Status (active)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveBrand()">Save Brand</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this brand?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteBrandID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;
    let paginationInstance;
    let brandSearchTimeout;

    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '...' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: "pagination",
            infoId: "paginationInfo",
            onPageChange: loadBrands
        });
        loadBrands();

        document.getElementById('searchText').addEventListener('input', function () {
            const value = this.value.trim();
            clearTimeout(brandSearchTimeout);
            brandSearchTimeout = setTimeout(function () {
                if (value.length === 0 || value.length >= 1) {
                    loadBrands(1);
                }
            }, 500);
        });
    });

    async function loadBrands(page = 1) {
        currentPage = page;

        const input = {
            searchText: document.getElementById('searchText').value || '',
            filterBrandIDs: '',
            pageIndex: page,
            pageSize: parseInt(document.getElementById('pageSize').value) || 10,
            sortColumn: 0,
            sortMode: ''
        };

        try {
            const response = await fetch('/Admin/Brand/GetBrandList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!result.success) {
                emptyState.showError(
                    'brandTableBody',
                    result.errors?.length
                        ? result.errors.join("<br>")
                        : result.message,
                    {
                        onRetry: 'loadBrands()',
                        title: 'Error loading brands'
                    },
                    4
                );
                return;
            }

            const data = result.data;

            if (!data?.tableData?.length) {
                emptyState.showNoData('brandTableBody', {
                    title: 'No brands found',
                    message: 'Try adjusting your search.',
                    onClear: 'clearSearch()'
                }, 4);
                return;
            }

            displayBrands(data.tableData);

            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(data.tableSettings);
            }
        } catch (error) {
            console.error(error);
            emptyState.showError(
                'brandTableBody',
                "Unable to connect to server.",
                {
                    onRetry: 'loadBrands()',
                    title: 'Server Error'
                },
                4
            );
        }
    }

    function displayBrands(brands) {
        const tbody = document.getElementById('brandTableBody');

        if (!brands || brands.length === 0) {
            emptyState.showNoData('brandTableBody', {
                title: 'No brands found',
                message: 'We can\'t find any brands matching your search.<br>Try adjusting your search term.',
                onClear: 'clearSearch()'
            }, 4);
            return;
        }

        tbody.innerHTML = brands.map(brand => {
            const isActive = brand.isActive ?? brand.IsActive ?? true;
            const badgeClass = isActive ? 'bg-success' : 'bg-danger';
            const statusText = isActive ? 'Active' : 'Inactive';
            const nameRaw = brand.brandName || brand.BrandName || '';
            const descRaw = brand.description || brand.Description || '';

            return `
                <tr>
                    <td class="col-name">${truncatedCellHtml(nameRaw)}</td>
                    <td class="col-desc">${truncatedCellHtml(descRaw)}</td>
                    <td class="col-status">
                        <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip" data-bs-placement="top">${statusText}</span>
                    </td>
                    <td class="col-actions">
                        ${brand.cancelled || brand.Cancelled ? '' : `
                            <div class="table-actions">
                            <button type="button" class="btn-action" onclick="openEditModal(${brand.brandID ?? brand.BrandID})" title="Edit" data-bs-toggle="tooltip" data-bs-placement="top">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button type="button" class="btn-action" onclick="openDeleteModal(${brand.brandID ?? brand.BrandID})" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top">
                                <i class="ti ti-trash"></i>
                            </button>
                            </div>
                        `}
                    </td>
                </tr>
            `;
        }).join('');
        initTableTooltips(tbody);
    }

    function openCreateModal() {
        document.getElementById('brandModalLabel').textContent = 'Add Brand';
        document.getElementById('brandForm').reset();
        document.getElementById('brandID').value = '0';
        document.getElementById('brandIsActive').checked = true;
    }

    async function openEditModal(brandID) {
        try {
            const response = await fetch(`/Admin/Brand/GetById/${brandID}`);
            if (!response.ok) throw new Error('Failed to fetch brand');

            const data = await response.json();
            const brand = data.tableData?.[0] ?? data.TableData?.[0] ?? data;
            const bid = brand.brandID ?? brand.BrandID ?? 0;
            if (!brand || bid <= 0) {
                throw new Error('Brand not found');
            }

            document.getElementById('brandModalLabel').textContent = 'Edit Brand';
            document.getElementById('brandID').value = String(bid);
            document.getElementById('brandName').value = brand.brandName || brand.BrandName || '';
            document.getElementById('description').value = brand.description || brand.Description || '';
            document.getElementById('brandIsActive').checked =
                (brand.isActive ?? brand.IsActive ?? true) === true;

            const modal = new bootstrap.Modal(document.getElementById('brandModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading brand:', error);
            showError('Error', 'Error loading brand details.');
        }
    }

    function openDeleteModal(brandID) {
        document.getElementById('deleteBrandID').value = brandID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveBrand() {
        const brandID = parseInt(document.getElementById('brandID').value);
        const brandName = document.getElementById('brandName').value.trim();
        const description = document.getElementById('description').value.trim();

        if (!brandName) {
            showWarning('Validation Error', 'Please enter brand name.');
            return;
        }

        const input = {
            brandID: brandID,
            brandName: brandName,
            description: description,
            isActive: document.getElementById('brandIsActive').checked
        };

        const url = brandID === 0 ? '/Admin/Brand/Create' : '/Admin/Brand/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'Brand Save', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('brandModal'));
                modal.hide();
                loadBrands(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Brand saved successfully.');
            } else {
                handleApiError?.('failure', 'Brand Save (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error saving brand.');
            }
        } catch (error) {
            console.error('Error saving brand:', error);
            handleApiError?.('crash', 'Brand Save', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error saving brand. Please try again.');
        }
    }

    async function confirmDelete() {
        const brandID = parseInt(document.getElementById('deleteBrandID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            brandID: brandID,
            cancelledReason: reason
        };

        try {
            const url = '/Admin/Brand/Delete';
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'Brand Delete', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadBrands(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Brand deleted successfully.');
            } else {
                handleApiError?.('failure', 'Brand Delete (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error deleting brand.');
            }
        } catch (error) {
            console.error('Error deleting brand:', error);
            handleApiError?.('crash', 'Brand Delete', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error deleting brand. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '10';
        loadBrands(1);
    }

    function clearSearch() {
        document.getElementById('searchText').value = '';
        loadBrands(1);
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
