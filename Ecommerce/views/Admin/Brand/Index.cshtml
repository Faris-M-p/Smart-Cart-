@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Brand Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Brand</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Brand List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#brandModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Brand
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search brands...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadBrands()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Brand Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="brandTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">Brand Name</th>
                                            <th class="text-muted">Status</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="brandTableBody">
                                        <tr>
                                            <td colspan="4" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadBrands()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Brand Modal (Create/Edit) -->
<div class="modal fade" id="brandModal" tabindex="-1" aria-labelledby="brandModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="brandModalLabel">Add Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="brandForm">
                    <input type="hidden" id="brandID" name="BrandID" value="0">
                    <div class="mb-3">
                        <label for="brandName" class="form-label">Brand Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="brandName" name="BrandName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveBrand()">Save Brand</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Brand</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this brand?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteBrandID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    // Load brands on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadBrands();
        
        // Enter key search
        document.getElementById('searchText').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadBrands();
            }
        });
    });

    async function loadBrands(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        const searchText = document.getElementById('searchText').value || '';

        const input = {
            SearchText: searchText,
            FilterBrandIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: 0,
            SortMode: ''
        };

        try {
            const response = await fetch('/Admin/Brand/GetBrandList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            const data = await response.json();
            displayBrands(data.TableData || []);
            displayPagination(data.TableSettings);
        } catch (error) {
            console.error('Error loading brands:', error);
            const tbody = document.getElementById('brandTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="empty-state">
                        <i class="ti ti-alert-circle"></i>
                        <h5>Error loading brands</h5>
                        <p class="text-muted">${escapeHtml(error.message || 'An error occurred while loading brands. Please try again.')}</p>
                    </td>
                </tr>
            `;
        }
    }

    function displayBrands(brands) {
        const tbody = document.getElementById('brandTableBody');
        
        if (!brands || brands.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="4" class="empty-state">
                        <i class="ti ti-package-off"></i>
                        <h5>No brands found</h5>
                        <p class="text-muted">Try adjusting your filters or search term</p>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = brands.map(brand => {
            const statusClass = brand.Cancelled ? 'badge-inactive' : 'badge-active';
            const statusText = brand.Cancelled ? 'Deleted' : 'Active';
            
            return `
                <tr>
                    <td>${brand.BrandID}</td>
                    <td>${escapeHtml(brand.BrandName)}</td>
                    <td>
                        <span class="badge ${statusClass}">
                            ${statusText}
                        </span>
                    </td>
                    <td class="text-end">
                        ${brand.Cancelled ? '' : `
                            <button class="btn-action" onclick="openEditModal(${brand.BrandID})" title="Edit">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button class="btn-action" onclick="openDeleteModal(${brand.BrandID})" title="Delete">
                                <i class="ti ti-trash"></i>
                            </button>
                        `}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((settings.PageIndex - 1) * settings.PageSize) + 1;
        const end = Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount);
        paginationInfo.textContent = `${start} to ${end} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (settings.PageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadBrands(${settings.PageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 1 && i <= settings.PageIndex + 1)) {
                if (i === settings.PageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadBrands(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === settings.PageIndex - 2 || i === settings.PageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (settings.PageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadBrands(${settings.PageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('brandModalLabel').textContent = 'Add Brand';
        document.getElementById('brandForm').reset();
        document.getElementById('brandID').value = '0';
    }

    async function openEditModal(brandID) {
        try {
            const response = await fetch(`/Admin/Brand/GetById/${brandID}`);
            if (!response.ok) throw new Error('Failed to fetch brand');

            const brand = await response.json();
            
            document.getElementById('brandModalLabel').textContent = 'Edit Brand';
            document.getElementById('brandID').value = brand.BrandID;
            document.getElementById('brandName').value = brand.BrandName || '';
            
            const modal = new bootstrap.Modal(document.getElementById('brandModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading brand:', error);
            alert('Error loading brand details.');
        }
    }

    function openDeleteModal(brandID) {
        document.getElementById('deleteBrandID').value = brandID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveBrand() {
        const brandID = parseInt(document.getElementById('brandID').value);
        const brandName = document.getElementById('brandName').value.trim();

        if (!brandName) {
            alert('Please enter brand name.');
            return;
        }

        const input = {
            BrandID: brandID,
            BrandName: brandName
        };

        const url = brandID === 0 ? '/Admin/Brand/Create' : '/Admin/Brand/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('brandModal'));
                modal.hide();
                loadBrands(currentPage);
                alert(result.ResponseMsg || 'Brand saved successfully.');
            } else {
                if (result.errors && result.errors.length > 0) {
                    alert('Validation errors:\n' + result.errors.join('\n'));
                } else {
                    alert(result.ResponseMsg || 'Error saving brand.');
                }
            }
        } catch (error) {
            console.error('Error saving brand:', error);
            alert('Error saving brand. Please try again.');
        }
    }

    async function confirmDelete() {
        const brandID = parseInt(document.getElementById('deleteBrandID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            BrandID: brandID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/Brand/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadBrands(currentPage);
                alert(result.ResponseMsg || 'Brand deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting brand.');
            }
        } catch (error) {
            console.error('Error deleting brand:', error);
            alert('Error deleting brand. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '10';
        loadBrands(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
