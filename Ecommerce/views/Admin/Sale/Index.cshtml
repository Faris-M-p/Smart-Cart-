@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<link rel="stylesheet" href="/Admin/assets/css/pos-billing.css?v=pos-2">

<div class="pos-workstation" data-permission-module="Sales">
    <div class="pos-topbar">
        <div class="pos-brand">
            <span class="pos-brand-mark">SC</span>
            <div>
                <div class="pos-brand-title">SmartCart POS</div>
                <div class="pos-brand-sub">Manual billing</div>
            </div>
        </div>

        <div class="pos-nav">
            <button type="button" class="pos-nav-btn" title="Previous bill" onclick="posBilling.navigateBill(-1)">
                <i class="ti ti-chevron-left"></i>
            </button>
            <div class="pos-bill-label">
                <span id="posBillTitle">New Bill</span>
                <span id="posBillStatus" class="pos-pill pos-pill-pending">PENDING</span>
            </div>
            <button type="button" class="pos-nav-btn" title="Next bill" onclick="posBilling.navigateBill(1)">
                <i class="ti ti-chevron-right"></i>
            </button>
        </div>

        <div class="pos-top-actions">
            <input type="search" id="posBillSearch" class="form-control form-control-sm pos-bill-search" placeholder="Bill # …">
            <button type="button" class="btn btn-outline-secondary btn-sm" data-bs-toggle="offcanvas" data-bs-target="#posHistoryOffcanvas">
                <i class="ti ti-history"></i> <span>History</span>
            </button>
            <button type="button" class="btn btn-outline-primary btn-sm" data-action="Create" onclick="posBilling.newBill()">
                <i class="ti ti-plus"></i> <span>F10 New Bill</span>
            </button>
            <span id="posClock" class="text-muted small"></span>
        </div>
    </div>

    <div id="posDrafts" class="pos-drafts"></div>

    <div class="pos-main">
        <div class="pos-left">
            <div class="pos-search">
                <div class="pos-search-wrap">
                    <i class="ti ti-search"></i>
                    <input type="search" id="posSkuSearch" class="form-control pos-search-input" placeholder="Search name, SKU or barcode…  F2" autocomplete="off">
                </div>
                <div id="posSkuResults" class="pos-results"></div>
            </div>

            <div class="pos-items">
                <div class="pos-items-head">
                    <div>Product</div>
                    <div>Qty</div>
                    <div>Price</div>
                    <div class="text-end">Total</div>
                    <div></div>
                </div>
                <div id="posItemsBody" class="pos-items-body"></div>
            </div>
        </div>

        <div class="pos-right">
            <div class="pos-side-card">
                <div class="pos-side-label">Bill summary</div>
                <div class="pos-sum-row">
                    <span>Items</span>
                    <span id="posItemCount">0 items</span>
                </div>
                <div class="pos-sum-row">
                    <span>Subtotal</span>
                    <span id="posSubtotal">₹0.00</span>
                </div>
                <div class="pos-sum-total">
                    <span>Total</span>
                    <strong id="posTotal">₹0.00</strong>
                </div>
            </div>

            <div class="pos-side-card pos-customer-box">
                <div class="pos-side-label">Customer (optional)</div>
                <div class="pos-customer-row">
                    <input type="search" id="posCustomerSearch" class="form-control form-control-sm" placeholder="Search mobile…" autocomplete="off">
                    <button type="button" class="btn btn-sm btn-outline-primary" data-action="Create" onclick="posBilling.openCreateCustomer()">+ New</button>
                </div>
                <div id="posCustomerResults" class="pos-customer-results"></div>
                <div id="posCustomerSelected" class="pos-customer-selected">
                    <div>
                        <strong>None</strong>
                        <span class="pos-result-meta">Customer is optional</span>
                    </div>
                </div>
            </div>

            <div class="pos-side-card">
                <div class="pos-side-label">Payment</div>
                <div class="pos-pay-grid">
                    <button type="button" class="pos-pay-btn is-active" data-pay="Cash" onclick="posBilling.setPayment('Cash')">Cash</button>
                    <button type="button" class="pos-pay-btn" data-pay="Card" onclick="posBilling.setPayment('Card')">Card</button>
                    <button type="button" class="pos-pay-btn" data-pay="UPI" onclick="posBilling.setPayment('UPI')">UPI</button>
                    <button type="button" class="pos-pay-btn" data-pay="Credit" onclick="posBilling.setPayment('Credit')">Credit</button>
                </div>
                <div id="posCashExtras" class="mt-2">
                    <label class="form-label small text-muted mb-1">Tendered</label>
                    <input type="number" min="0" step="0.01" id="posTendered" class="form-control form-control-sm" placeholder="0.00">
                    <div class="d-flex justify-content-between mt-2 small">
                        <span class="text-muted">Change</span>
                        <strong id="posChange">₹0.00</strong>
                    </div>
                </div>
                <label class="form-label small text-muted mb-1 mt-2">Notes</label>
                <textarea id="posNotes" class="form-control form-control-sm" rows="2" maxlength="500" placeholder="Optional"></textarea>
                <button type="button" id="posCompleteBtn" class="btn btn-primary pos-complete mt-3" data-action="Create" onclick="posBilling.completeBill()">Complete Bill</button>
                <button type="button" id="posHoldBtn" class="btn btn-link pos-hold" onclick="posBilling.holdBill()">Hold Bill</button>
                <a id="posViewReturn" class="btn btn-outline-secondary w-100 mt-2" href="#" style="display:none">Sales Return</a>
            </div>
        </div>
    </div>

    <div class="pos-shortcuts">
        <span><kbd>F2</kbd> Search</span>
        <span><kbd>F10</kbd> New Bill</span>
        <span><kbd>F8</kbd> Customer</span>
        <span><kbd>F9</kbd> Complete</span>
        <span><kbd>←</kbd> <kbd>→</kbd> Bills</span>
    </div>
</div>

<div class="modal fade pos-create-modal" id="posCreateCustomerModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="posCreateCustomerForm">
                <div class="modal-header">
                    <h5 class="modal-title">Create New Customer</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label">Name</label>
                        <input type="text" id="posNewCustomerName" class="form-control" maxlength="200" required>
                    </div>
                    <div class="mb-0">
                        <label class="form-label">Mobile Number</label>
                        <input type="tel" id="posNewCustomerPhone" class="form-control" maxlength="30" required>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-primary">Create</button>
                </div>
            </form>
        </div>
    </div>
</div>

<div class="offcanvas offcanvas-end pos-history-offcanvas" tabindex="-1" id="posHistoryOffcanvas">
    <div class="offcanvas-header">
        <h5 class="offcanvas-title">Completed bills</h5>
        <button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button>
    </div>
    <div class="offcanvas-body">
        <div class="d-flex gap-2 mb-3">
            <input type="search" id="posHistorySearch" class="form-control" placeholder="Search invoice, customer, phone...">
            <button type="button" class="btn btn-outline-secondary" onclick="posBilling.resetHistoryFilters()">Reset</button>
        </div>
        <div class="row g-2 mb-3">
            <div class="col-4">
                <select id="posHistoryPayment" class="form-select form-select-sm" onchange="posBilling.loadHistory(1)">
                    <option value="">All payments</option>
                    <option value="Cash">Cash</option>
                    <option value="Card">Card</option>
                    <option value="UPI">UPI</option>
                    <option value="Credit">Credit</option>
                </select>
            </div>
            <div class="col-4">
                <input type="date" id="posHistoryFrom" class="form-control form-control-sm" onchange="posBilling.loadHistory(1)">
            </div>
            <div class="col-4">
                <input type="date" id="posHistoryTo" class="form-control form-control-sm" onchange="posBilling.loadHistory(1)">
            </div>
        </div>
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0 admin-master-list-table">
                <thead>
                    <tr>
                        <th>Invoice</th>
                        <th>Customer</th>
                        <th>Date</th>
                        <th>Pay</th>
                        <th>Total</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody id="posHistoryBody"></tbody>
            </table>
        </div>
        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3">
            <span id="posHistoryInfo" class="text-muted small"></span>
            <nav><ul class="pagination pagination-sm mb-0" id="posHistoryPagination"></ul></nav>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete Sale</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>This restores the sold quantity back into stock.</p>
                <textarea class="form-control" id="deleteReason" rows="3" placeholder="Reason (optional)"></textarea>
                <input type="hidden" id="deleteSaleID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="posBilling.confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script src="/Admin/assets/js/pages/pos-billing.js?v=pos-2"></script>
