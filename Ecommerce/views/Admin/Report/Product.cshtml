@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Reports</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Reports</a></li>
                    <li class="breadcrumb-item" aria-current="page">Product Report</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Product Sales Report</h5>
                </div>
            </div>
            <div class="card-body">
                <!-- Filters -->
                <div class="row g-3 mb-4">
                    <div class="col-md-4">
                        <label class="form-label">Search Product</label>
                        <input type="text" id="searchText" class="form-control" placeholder="Product name...">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" id="btnFilter" class="btn btn-primary w-100">
                            <i class="ti ti-search me-1"></i> Filter
                        </button>
                    </div>
                </div>

                <!-- Loading / Error -->
                <div id="loadingMsg" class="text-center py-4" style="display:none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading products...</p>
                </div>
                <div id="errorMsg" class="alert alert-danger" style="display:none"></div>

                <!-- Table -->
                <div class="table-responsive">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Product / SKU</th>
                                <th>Category</th>
                                <th>Qty Sold</th>
                                <th>Sales Amount</th>
                                <th>Current Stock</th>
                            </tr>
                        </thead>
                        <tbody id="tbData">
                            <tr><td colspan="5" class="text-center text-muted py-4">Click Filter to load data.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div id="totalCount" class="text-muted small mt-1"></div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->

<script>
    document.getElementById('btnFilter').addEventListener('click', loadReport);
    loadReport();

    function fmt(n) { return '₹' + (n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

    function stockBadge(qty) {
        if (qty <= 0)  return '<span class="badge bg-danger">Out of Stock</span>';
        if (qty <= 5)  return '<span class="badge bg-warning text-dark">' + qty + ' (Low)</span>';
        return '<span class="badge bg-success">' + qty + '</span>';
    }

    function loadReport() {
        var searchText = document.getElementById('searchText').value || null;

        document.getElementById('errorMsg').style.display   = 'none';
        document.getElementById('loadingMsg').style.display  = 'block';
        document.getElementById('tbData').innerHTML = '';

        fetch('/Admin/Report/GetProductReport', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ searchText, pageIndex: 1, pageSize: 500 })
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            document.getElementById('loadingMsg').style.display = 'none';

            if (!result || !result.success) {
                document.getElementById('errorMsg').innerText = (result && result.message) || 'Failed to load report.';
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            var rows = (result.data && result.data.tableData) || [];
            var total = (result.data && result.data.tableSettings && result.data.tableSettings.totalCount) || rows.length;

            document.getElementById('totalCount').innerText = 'Showing ' + rows.length + ' of ' + total + ' SKUs';

            if (!rows.length) {
                document.getElementById('tbData').innerHTML = '<tr><td colspan="5" class="text-center text-muted py-4">No products found.</td></tr>';
                return;
            }

            document.getElementById('tbData').innerHTML = rows.map(function(x) {
                return '<tr>' +
                    '<td><strong>' + (x.productName || '-') + '</strong></td>' +
                    '<td>' + (x.categoryName || '-') + '</td>' +
                    '<td>' + (x.quantitySold || 0) + '</td>' +
                    '<td>' + fmt(x.salesAmount) + '</td>' +
                    '<td>' + stockBadge(x.currentStock) + '</td>' +
                    '</tr>';
            }).join('');
        })
        .catch(function(err) {
            document.getElementById('loadingMsg').style.display = 'none';
            document.getElementById('errorMsg').innerText = 'Request error: ' + err;
            document.getElementById('errorMsg').style.display = 'block';
        });
    }
</script>
