@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Reports</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript:void(0)">Reports</a></li>
                    <li class="breadcrumb-item" aria-current="page">Order Report</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
<div class="row">
    <div class="col-12">
        <div class="card">
            <div class="card-header">
                <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                    <h5 class="mb-0">Order Report</h5>
                </div>
            </div>
            <div class="card-body">
                <!-- Filters -->
                <div class="row g-3 mb-4">
                    <div class="col-md-2">
                        <label class="form-label">From Date</label>
                        <input type="date" id="fromDate" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">To Date</label>
                        <input type="date" id="toDate" class="form-control">
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Order Status</label>
                        <select id="orderStatus" class="form-select">
                            <option value="">All</option>
                            <option value="Placed">Placed</option>
                            <option value="Confirmed">Confirmed</option>
                            <option value="Shipped">Shipped</option>
                            <option value="Delivered">Delivered</option>
                            <option value="Cancelled">Cancelled</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Payment Status</label>
                        <select id="paymentStatus" class="form-select">
                            <option value="">All</option>
                            <option value="Pending">Pending</option>
                            <option value="Paid">Paid</option>
                            <option value="Failed">Failed</option>
                        </select>
                    </div>
                    <div class="col-md-2">
                        <label class="form-label">Search</label>
                        <input type="text" id="searchText" class="form-control" placeholder="Order # or Customer">
                    </div>
                    <div class="col-md-2 d-flex align-items-end">
                        <button type="button" id="btnFilter" class="btn btn-primary w-100">
                            <i class="ti ti-search me-1"></i> Filter
                        </button>
                    </div>
                </div>

                <!-- Loading / Error -->
                <div id="loadingMsg" class="text-center py-4" style="display:none">
                    <div class="spinner-border text-primary" role="status"></div>
                    <p class="mt-2 text-muted">Loading orders...</p>
                </div>
                <div id="errorMsg" class="alert alert-danger" style="display:none"></div>

                <!-- Table -->
                <div class="table-responsive" id="tableSection">
                    <table class="table table-hover align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Order No.</th>
                                <th>Customer</th>
                                <th>Order Date</th>
                                <th>Total</th>
                                <th>Pay Method</th>
                                <th>Pay Status</th>
                                <th>Order Status</th>
                            </tr>
                        </thead>
                        <tbody id="tbData">
                            <tr><td colspan="7" class="text-center text-muted py-4">Click Filter to load orders.</td></tr>
                        </tbody>
                    </table>
                </div>
                <div id="totalCount" class="text-muted small mt-1"></div>
            </div>
        </div>
    </div>
</div>
<!-- [ Main Content ] end -->

<script>
    document.getElementById('btnFilter').addEventListener('click', loadReport);

    function fmt(n) { return '₹' + (n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 }); }

    function statusBadge(s) {
        var map = { 'Placed':'primary','Confirmed':'info','Shipped':'warning','Delivered':'success','Cancelled':'danger','Paid':'success','Pending':'warning','Failed':'danger' };
        var cls = map[s] || 'secondary';
        return '<span class="badge bg-' + cls + '">' + (s || '-') + '</span>';
    }

    function loadReport() {
        var fromDate     = document.getElementById('fromDate').value     || null;
        var toDate       = document.getElementById('toDate').value       || null;
        var orderStatus  = document.getElementById('orderStatus').value  || null;
        var paymentStatus= document.getElementById('paymentStatus').value|| null;
        var searchText   = document.getElementById('searchText').value   || null;

        document.getElementById('errorMsg').style.display  = 'none';
        document.getElementById('loadingMsg').style.display = 'block';
        document.getElementById('tbData').innerHTML = '';

        fetch('/Admin/Report/GetOrderReport', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ fromDate, toDate, orderStatus, paymentStatus, searchText, pageIndex: 1, pageSize: 1000 })
        })
        .then(function(res) { return res.json(); })
        .then(function(result) {
            document.getElementById('loadingMsg').style.display = 'none';

            if (!result || !result.success) {
                document.getElementById('errorMsg').innerText = (result && result.message) || 'Failed to load report.';
                document.getElementById('errorMsg').style.display = 'block';
                return;
            }

            var rows = (result.data && result.data.tableData) || [];
            var total = (result.data && result.data.tableSettings && result.data.tableSettings.totalCount) || rows.length;

            document.getElementById('totalCount').innerText = 'Showing ' + rows.length + ' of ' + total + ' orders';

            if (!rows.length) {
                document.getElementById('tbData').innerHTML = '<tr><td colspan="7" class="text-center text-muted py-4">No orders found.</td></tr>';
                return;
            }

            document.getElementById('tbData').innerHTML = rows.map(function(x) {
                var d = x.orderDate ? new Date(x.orderDate).toLocaleDateString('en-IN') : '-';
                return '<tr>' +
                    '<td><strong>' + (x.orderNumber || '-') + '</strong></td>' +
                    '<td>' + (x.customerName || '-') + '</td>' +
                    '<td>' + d + '</td>' +
                    '<td>' + fmt(x.totalAmount) + '</td>' +
                    '<td>' + (x.paymentMethod || '-') + '</td>' +
                    '<td>' + statusBadge(x.paymentStatus) + '</td>' +
                    '<td>' + statusBadge(x.orderStatus) + '</td>' +
                    '</tr>';
            }).join('');
        })
        .catch(function(err) {
            document.getElementById('loadingMsg').style.display = 'none';
            document.getElementById('errorMsg').innerText = 'Request error: ' + err;
            document.getElementById('errorMsg').style.display = 'block';
        });
    }
</script>
