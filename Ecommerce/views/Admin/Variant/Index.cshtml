@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Variant Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Variant</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>

        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Variant List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#variantModal" onclick="openCreateVariantModal()">
                                <i class="ti ti-plus"></i> Add New Variant
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search variants...">
                                </div>
                            </div>
                        </div>

                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table align-middle mb-0 admin-master-list-table" id="variantTable">
                                    <thead>
                                        <tr>
                                            <th class="col-name text-start">Name</th>
                                            <th class="col-desc text-start">Description</th>
                                            <th class="col-order text-start">Display order</th>
                                            <th class="col-status text-start">Status</th>
                                            <th class="col-actions text-start">Actions</th>
                                            <th class="col-expand text-start" style="width:48px;" title="Values">Values</th>
                                        </tr>
                                    </thead>
                                    <tbody id="variantTableBody">
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadVariants()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination"></ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

<!-- Variant modal -->
<div class="modal fade" id="variantModal" tabindex="-1" aria-labelledby="variantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="variantModalLabel">Add Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="variantForm">
                    <input type="hidden" id="variantID" value="0">
                    <div class="mb-3">
                        <label for="variantName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="variantName" maxlength="255" required>
                    </div>
                    <div class="mb-3">
                        <label for="variantDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="variantDescription" rows="3" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="displayOrder" class="form-label">Display order</label>
                        <input type="number" class="form-control" id="displayOrder" value="0" min="0">
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="variantIsActive" checked>
                        <label class="form-check-label" for="variantIsActive">Status (active)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveVariant()">Save Variant</button>
            </div>
        </div>
    </div>
</div>

<!-- Variant delete -->
<div class="modal fade" id="deleteVariantModal" tabindex="-1" aria-labelledby="deleteVariantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteVariantModalLabel">Delete Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this variant?</p>
                <div class="mb-3">
                    <label for="deleteVariantReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteVariantReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteVariantID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteVariant()">Delete</button>
            </div>
        </div>
    </div>
</div>

<!-- Variant value modal (nested CRUD) -->
<div class="modal fade" id="variantValueModal" tabindex="-1" aria-labelledby="variantValueModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="variantValueModalLabel">Add value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="variantValueForm">
                    <input type="hidden" id="vvId" value="0">
                    <input type="hidden" id="vvFkVariant" value="0">
                    <div class="mb-3">
                        <label for="vvName" class="form-label">Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="vvName" maxlength="255" required>
                    </div>
                    <div class="mb-3">
                        <label for="vvDescription" class="form-label">Description</label>
                        <textarea class="form-control" id="vvDescription" rows="2" maxlength="500"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="vvDisplayOrder" class="form-label">Display order</label>
                        <input type="number" class="form-control" id="vvDisplayOrder" value="0" min="0">
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveVariantValue()">Save</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="deleteVariantValueModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Delete value</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Delete this variant value?</p>
                <input type="hidden" id="deleteVvId" value="0">
                <input type="hidden" id="deleteVvParentVariantId" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDeleteVariantValue()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let paginationInstance;
    let variantSearchTimeout;

    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '...' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate text-start" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }

    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: "pagination",
            infoId: "paginationInfo",
            onPageChange: loadVariants
        });
        loadVariants();

        document.getElementById('searchText').addEventListener('input', function () {
            const value = this.value.trim();
            clearTimeout(variantSearchTimeout);
            variantSearchTimeout = setTimeout(function () {
                loadVariants(1);
            }, 500);
        });
    });

    async function loadVariants(page = 1) {
        currentPage = page;
        const input = {
            searchText: document.getElementById('searchText').value || '',
            filterVariantIDs: '',
            pageIndex: page,
            pageSize: parseInt(document.getElementById('pageSize').value) || 10,
            sortColumn: 0,
            sortMode: ''
        };

        try {
            const response = await fetch('/Admin/Variant/GetVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!result.success) {
                emptyState.showError(
                    'variantTableBody',
                    result.errors?.length ? result.errors.join('<br>') : result.message,
                    { onRetry: 'loadVariants()', title: 'Error loading variants' },
                    6
                );
                return;
            }

            const data = result.data;
            if (!data?.tableData?.length) {
                emptyState.showNoData('variantTableBody', {
                    title: 'No variants found',
                    message: 'Try adjusting your search.',
                    onClear: 'clearVariantSearch()'
                }, 6);
                return;
            }

            renderVariantRows(data.tableData);
            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(data.tableSettings);
            }
        } catch (e) {
            console.error(e);
            emptyState.showError(
                'variantTableBody',
                'Unable to connect to server.',
                { onRetry: 'loadVariants()', title: 'Server Error' },
                6
            );
        }
    }

    function renderVariantRows(rows) {
        const tbody = document.getElementById('variantTableBody');
        const html = rows.map(function (v) {
            const vid = v.variantID ?? v.VariantID ?? 0;
            const nameRaw = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
            const descRaw = v.description ?? v.Description ?? '';
            const order = v.displayOrder ?? v.DisplayOrder ?? 0;
            const isActive = v.isActive ?? v.IsActive ?? true;
            const cancelled = v.cancelled ?? v.Cancelled ?? false;
            const badgeClass = isActive ? 'bg-success' : 'bg-danger';
            const statusText = isActive ? 'Active' : 'Inactive';
            return `
                <tr>
                    <td class="col-name text-start">${truncatedCellHtml(nameRaw)}</td>
                    <td class="col-desc text-start">${truncatedCellHtml(descRaw)}</td>
                    <td class="col-order text-start">${escapeHtml(String(order))}</td>
                    <td class="col-status text-start">
                        <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip">${statusText}</span>
                    </td>
                    <td class="col-actions text-start">
                        ${cancelled ? '' : `
                        <div class="table-actions">
                            <button type="button" class="btn-action" onclick="openEditVariantModal(${vid})" title="Edit"><i class="ti ti-edit"></i></button>
                            <button type="button" class="btn-action" onclick="openDeleteVariantModal(${vid})" title="Delete"><i class="ti ti-trash"></i></button>
                        </div>`}
                    </td>
                    <td class="col-expand text-start">
                        ${cancelled ? '' : `<button type="button" class="btn-action" onclick="toggleValuesPanel(${vid})" title="Values"><i class="ti ti-list"></i></button>`}
                    </td>
                </tr>
                <tr id="vv-panel-${vid}" class="d-none">
                    <td colspan="6" class="bg-light p-3 border-top-0">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <strong class="small text-muted">Values</strong>
                            <button type="button" class="btn btn-sm btn-primary" onclick="openCreateValueModal(${vid})"><i class="ti ti-plus"></i> Add value</button>
                        </div>
                        <div id="vv-inner-${vid}"><span class="text-muted small">Open to load values…</span></div>
                    </td>
                </tr>`;
        }).join('');
        tbody.innerHTML = html;
        initTableTooltips(tbody);
    }

    async function toggleValuesPanel(variantId) {
        const panel = document.getElementById('vv-panel-' + variantId);
        if (!panel) return;
        const opening = panel.classList.contains('d-none');
        document.querySelectorAll('[id^="vv-panel-"]').forEach(function (el) { el.classList.add('d-none'); });
        if (opening) {
            panel.classList.remove('d-none');
            await loadValuesIntoPanel(variantId);
        }
    }

    async function loadValuesIntoPanel(variantId) {
        const inner = document.getElementById('vv-inner-' + variantId);
        if (!inner) return;
        inner.innerHTML = '<span class="text-muted small">Loading…</span>';
        try {
            const r = await fetch('/Admin/VariantValue/GetByVariant/' + variantId);
            if (!r.ok) throw new Error('load failed');
            const list = await r.json();
            if (!Array.isArray(list) || !list.length) {
                inner.innerHTML = '<span class="text-muted small">No values yet.</span>';
                return;
            }
            inner.innerHTML = `
                <div class="table-container">
                    <table class="table table-sm align-middle mb-0 admin-master-list-table">
                        <thead><tr>
                            <th class="text-start">Name</th>
                            <th class="text-start">Description</th>
                            <th class="text-start">Order</th>
                            <th class="text-start">Actions</th>
                        </tr></thead>
                        <tbody>
                        ${list.map(function (x) {
                            const id = x.variantValueID ?? x.VariantValueID ?? 0;
                            const nm = x.name ?? x.Name ?? x.valueName ?? x.ValueName ?? '';
                            const desc = x.description ?? x.Description ?? '';
                            const ord = x.displayOrder ?? x.DisplayOrder ?? 0;
                            return `<tr>
                                <td class="text-start">${truncatedCellHtml(nm)}</td>
                                <td class="text-start">${truncatedCellHtml(desc, 40)}</td>
                                <td class="text-start">${escapeHtml(String(ord))}</td>
                                <td class="text-start">
                                    <div class="table-actions">
                                        <button type="button" class="btn-action" onclick="openEditValueModal(${variantId}, ${id})" title="Edit"><i class="ti ti-edit"></i></button>
                                        <button type="button" class="btn-action" onclick="openDeleteValueModal(${variantId}, ${id})" title="Delete"><i class="ti ti-trash"></i></button>
                                    </div>
                                </td>
                            </tr>`;
                        }).join('')}
                        </tbody>
                    </table>
                </div>`;
            initTableTooltips(inner);
        } catch (e) {
            console.error(e);
            inner.innerHTML = '<span class="text-danger small">Could not load values.</span>';
        }
    }

    function openCreateVariantModal() {
        document.getElementById('variantModalLabel').textContent = 'Add Variant';
        document.getElementById('variantForm').reset();
        document.getElementById('variantID').value = '0';
        document.getElementById('displayOrder').value = '0';
        document.getElementById('variantIsActive').checked = true;
        document.getElementById('variantDescription').value = '';
    }

    async function openEditVariantModal(id) {
        try {
            const r = await fetch('/Admin/Variant/GetById/' + id);
            if (!r.ok) throw new Error('not found');
            const v = await r.json();
            const vid = v.variantID ?? v.VariantID ?? 0;
            document.getElementById('variantModalLabel').textContent = 'Edit Variant';
            document.getElementById('variantID').value = String(vid);
            document.getElementById('variantName').value = v.name ?? v.Name ?? v.variantName ?? v.VariantName ?? '';
            document.getElementById('variantDescription').value = v.description ?? v.Description ?? '';
            document.getElementById('displayOrder').value = String(v.displayOrder ?? v.DisplayOrder ?? 0);
            document.getElementById('variantIsActive').checked = (v.isActive ?? v.IsActive ?? true) === true;
            new bootstrap.Modal(document.getElementById('variantModal')).show();
        } catch (e) {
            showError('Error', 'Could not load variant.');
        }
    }

    async function saveVariant() {
        const variantID = parseInt(document.getElementById('variantID').value, 10);
        const name = document.getElementById('variantName').value.trim();
        const description = document.getElementById('variantDescription').value.trim();
        const displayOrder = parseInt(document.getElementById('displayOrder').value, 10) || 0;
        if (!name) {
            showWarning('Validation', 'Please enter variant name.');
            return;
        }
        const input = {
            variantID: variantID,
            name: name,
            description: description,
            displayOrder: displayOrder,
            isActive: document.getElementById('variantIsActive').checked
        };
        const url = variantID === 0 ? '/Admin/Variant/Create' : '/Admin/Variant/Update';
        try {
            const r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });
            const result = await r.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('variantModal')).hide();
                loadVariants(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Saved.');
            } else {
                showError('Error', result.responseMsg || result.ResponseMsg || 'Save failed.');
            }
        } catch (e) {
            showError('Error', 'Save failed.');
        }
    }

    function openDeleteVariantModal(id) {
        document.getElementById('deleteVariantID').value = String(id);
        document.getElementById('deleteVariantReason').value = '';
        new bootstrap.Modal(document.getElementById('deleteVariantModal')).show();
    }

    async function confirmDeleteVariant() {
        const id = parseInt(document.getElementById('deleteVariantID').value, 10);
        const input = {
            variantID: id,
            cancelledReason: document.getElementById('deleteVariantReason').value.trim()
        };
        try {
            const r = await fetch('/Admin/Variant/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });
            const result = await r.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('deleteVariantModal')).hide();
                loadVariants(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Deleted.');
            } else {
                showError('Error', result.responseMsg || result.ResponseMsg || 'Delete failed.');
            }
        } catch (e) {
            showError('Error', 'Delete failed.');
        }
    }

    function openCreateValueModal(variantId) {
        document.getElementById('variantValueModalLabel').textContent = 'Add value';
        document.getElementById('vvId').value = '0';
        document.getElementById('vvFkVariant').value = String(variantId);
        document.getElementById('vvName').value = '';
        document.getElementById('vvDescription').value = '';
        document.getElementById('vvDisplayOrder').value = '0';
        new bootstrap.Modal(document.getElementById('variantValueModal')).show();
    }

    async function openEditValueModal(variantId, valueId) {
        try {
            const r = await fetch('/Admin/VariantValue/GetById/' + valueId);
            if (!r.ok) throw new Error('x');
            const x = await r.json();
            document.getElementById('variantValueModalLabel').textContent = 'Edit value';
            document.getElementById('vvId').value = String(x.iD_VariantValue ?? x.ID_VariantValue ?? x.id_VariantValue ?? 0);
            document.getElementById('vvFkVariant').value = String(x.fk_Variant ?? x.FK_Variant ?? variantId);
            document.getElementById('vvName').value = x.name ?? x.Name ?? x.valueName ?? x.ValueName ?? '';
            document.getElementById('vvDescription').value = x.description ?? x.Description ?? '';
            document.getElementById('vvDisplayOrder').value = String(x.displayOrder ?? x.DisplayOrder ?? 0);
            new bootstrap.Modal(document.getElementById('variantValueModal')).show();
        } catch (e) {
            showError('Error', 'Could not load value.');
        }
    }

    async function saveVariantValue() {
        const id = parseInt(document.getElementById('vvId').value, 10);
        const fk = parseInt(document.getElementById('vvFkVariant').value, 10);
        const name = document.getElementById('vvName').value.trim();
        const description = document.getElementById('vvDescription').value.trim();
        const ord = parseInt(document.getElementById('vvDisplayOrder').value, 10) || 0;
        if (!name) {
            showWarning('Validation', 'Enter value name.');
            return;
        }
        if (!fk) {
            showWarning('Validation', 'Invalid variant.');
            return;
        }
        const body = id === 0
            ? { variantValueID: 0, fk_Variant: fk, name: name, description: description, displayOrder: ord }
            : { variantValueID: id, fk_Variant: fk, name: name, description: description, displayOrder: ord };
        const url = id === 0 ? '/Admin/VariantValue/Create' : '/Admin/VariantValue/Update';
        try {
            const r = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(body)
            });
            const result = await r.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('variantValueModal')).hide();
                loadVariants(currentPage);
                const pid = fk;
                const p = document.getElementById('vv-panel-' + pid);
                if (p && !p.classList.contains('d-none')) {
                    await loadValuesIntoPanel(pid);
                }
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Saved.');
            } else {
                showError('Error', result.responseMsg || result.ResponseMsg || 'Save failed.');
            }
        } catch (e) {
            showError('Error', 'Save failed.');
        }
    }

    function openDeleteValueModal(variantId, valueId) {
        document.getElementById('deleteVvId').value = String(valueId);
        document.getElementById('deleteVvParentVariantId').value = String(variantId);
        new bootstrap.Modal(document.getElementById('deleteVariantValueModal')).show();
    }

    async function confirmDeleteVariantValue() {
        const id = parseInt(document.getElementById('deleteVvId').value, 10);
        const parent = parseInt(document.getElementById('deleteVvParentVariantId').value, 10);
        const input = { variantValueID: id };
        try {
            const r = await fetch('/Admin/VariantValue/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });
            const result = await r.json();
            if (result.statusCode || result.StatusCode) {
                bootstrap.Modal.getInstance(document.getElementById('deleteVariantValueModal')).hide();
                loadVariants(currentPage);
                const p = document.getElementById('vv-panel-' + parent);
                if (p && !p.classList.contains('d-none')) {
                    await loadValuesIntoPanel(parent);
                }
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Deleted.');
            } else {
                showError('Error', result.responseMsg || result.ResponseMsg || 'Delete failed.');
            }
        } catch (e) {
            showError('Error', 'Delete failed.');
        }
    }

    function clearVariantSearch() {
        document.getElementById('searchText').value = '';
        loadVariants(1);
    }
</script>
