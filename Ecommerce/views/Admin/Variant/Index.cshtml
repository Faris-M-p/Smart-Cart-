@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Variant Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Variant</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Variant List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#variantModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Variant
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search variants...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadVariants()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Variant Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="variantTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">Variant Name</th>
                                            <th class="text-muted">Description</th>
                                            <th class="text-muted">Display Order</th>
                                            <th class="text-muted">Status</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="variantTableBody">
                                        <tr>
                                            <td colspan="6" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadVariants()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Variant Modal (Create/Edit) -->
<div class="modal fade" id="variantModal" tabindex="-1" aria-labelledby="variantModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="variantModalLabel">Add Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="variantForm">
                    <input type="hidden" id="variantID" name="ID_Variant" value="0">
                    <div class="mb-3">
                        <label for="variantName" class="form-label">Variant Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="variantName" name="VariantName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="displayOrder" class="form-label">Display Order <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="displayOrder" name="DisplayOrder" value="1" min="1" required>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveVariant()">Save Variant</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Variant</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this variant?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion <span class="text-danger">*</span></label>
                    <textarea class="form-control" id="deleteReason" rows="3" required></textarea>
                </div>
                <input type="hidden" id="deleteVariantID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 10;

    document.addEventListener('DOMContentLoaded', function() {
        loadVariants();
        
        document.getElementById('searchText').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadVariants();
            }
        });
    });

    async function loadVariants(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        const searchText = document.getElementById('searchText').value || '';

        const input = {
            SearchText: searchText,
            FilterVariantIDs: '',
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: '',
            SortMode: ''
        };

        try {
            const response = await fetch('/Admin/Variant/GetVariantList', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) throw new Error('Network response was not ok');

            const data = await response.json();
            displayVariants(data.TableData || []);
            displayPagination(data.TableSettings);
        } catch (error) {
            console.error('Error loading variants:', error);
            const tbody = document.getElementById('variantTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-state">
                        <i class="ti ti-alert-circle"></i>
                        <h5>Error loading variants</h5>
                        <p class="text-muted">${escapeHtml(error.message || 'An error occurred while loading variants. Please try again.')}</p>
                    </td>
                </tr>
            `;
        }
    }

    function displayVariants(variants) {
        const tbody = document.getElementById('variantTableBody');
        
        if (!variants || variants.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="6" class="empty-state">
                        <i class="ti ti-package-off"></i>
                        <h5>No variants found</h5>
                        <p class="text-muted">Try adjusting your filters or search term</p>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = variants.map(v => {
            const statusClass = v.Cancelled ? 'badge-inactive' : 'badge-active';
            const statusText = v.Cancelled ? 'Deleted' : 'Active';
            
            return `
                <tr>
                    <td>${v.ID_Variant}</td>
                    <td>${escapeHtml(v.VariantName)}</td>
                    <td>${escapeHtml(v.Description || '')}</td>
                    <td>${v.DisplayOrder}</td>
                    <td>
                        <span class="badge ${statusClass}">
                            ${statusText}
                        </span>
                    </td>
                    <td class="text-end">
                        ${v.Cancelled ? '' : `
                            <button class="btn-action" onclick="openEditModal(${v.ID_Variant})" title="Edit">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button class="btn-action" onclick="openDeleteModal(${v.ID_Variant})" title="Delete">
                                <i class="ti ti-trash"></i>
                            </button>
                        `}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((settings.PageIndex - 1) * settings.PageSize) + 1;
        const end = Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount);
        paginationInfo.textContent = `${start} to ${end} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (settings.PageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadVariants(${settings.PageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 1 && i <= settings.PageIndex + 1)) {
                if (i === settings.PageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadVariants(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === settings.PageIndex - 2 || i === settings.PageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (settings.PageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadVariants(${settings.PageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('variantModalLabel').textContent = 'Add Variant';
        document.getElementById('variantForm').reset();
        document.getElementById('variantID').value = '0';
        document.getElementById('displayOrder').value = '1';
    }

    async function openEditModal(variantID) {
        try {
            const response = await fetch(`/Admin/Variant/GetById/${variantID}`);
            if (!response.ok) throw new Error('Failed to fetch variant');

            const variant = await response.json();
            
            document.getElementById('variantModalLabel').textContent = 'Edit Variant';
            document.getElementById('variantID').value = variant.ID_Variant;
            document.getElementById('variantName').value = variant.VariantName || '';
            document.getElementById('description').value = variant.Description || '';
            document.getElementById('displayOrder').value = variant.DisplayOrder || 1;
            
            const modal = new bootstrap.Modal(document.getElementById('variantModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading variant:', error);
            alert('Error loading variant details.');
        }
    }

    function openDeleteModal(variantID) {
        document.getElementById('deleteVariantID').value = variantID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveVariant() {
        const variantID = parseInt(document.getElementById('variantID').value);
        const variantName = document.getElementById('variantName').value.trim();
        const description = document.getElementById('description').value.trim();
        const displayOrder = parseInt(document.getElementById('displayOrder').value) || 1;

        if (!variantName) {
            alert('Please enter variant name.');
            return;
        }

        const input = {
            ID_Variant: variantID,
            VariantName: variantName,
            Description: description,
            DisplayOrder: displayOrder
        };

        const url = variantID === 0 ? '/Admin/Variant/Create' : '/Admin/Variant/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('variantModal'));
                modal.hide();
                loadVariants(currentPage);
                alert(result.ResponseMsg || 'Variant saved successfully.');
            } else {
                if (result.errors && result.errors.length > 0) {
                    alert('Validation errors:\n' + result.errors.join('\n'));
                } else {
                    alert(result.ResponseMsg || 'Error saving variant.');
                }
            }
        } catch (error) {
            console.error('Error saving variant:', error);
            alert('Error saving variant. Please try again.');
        }
    }

    async function confirmDelete() {
        const variantID = parseInt(document.getElementById('deleteVariantID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        if (!reason) {
            alert('Please enter reason for deletion.');
            return;
        }

        const input = {
            ID_Variant: variantID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/Variant/Delete', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadVariants(currentPage);
                alert(result.ResponseMsg || 'Variant deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting variant.');
            }
        } catch (error) {
            console.error('Error deleting variant:', error);
            alert('Error deleting variant. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('pageSize').value = '10';
        loadVariants(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
