@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Supplier Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Supplier</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>Supplier List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#supplierModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Supplier
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Filter and Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <!-- Filter Button -->
                            <button class="btn btn-outline-secondary" type="button" data-bs-toggle="collapse" data-bs-target="#filterCollapse" aria-expanded="false" aria-controls="filterCollapse">
                                <i class="ti ti-filter"></i> Filter
                            </button>
                            
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search suppliers...">
                                </div>
                            </div>
                        </div>

                        <!-- Collapsible Filter Section -->
                        <div class="collapse mb-3" id="filterCollapse">
                            <div class="card-body">
                                <div class="row g-3">
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">Status</label>
                                        <select id="showCancelled" class="form-select">
                                            <option value="false">Active Only</option>
                                            <option value="true">Show All</option>
                                        </select>
                                    </div>
                                    
                                    <div class="col-md-3">
                                        <label class="form-label small text-muted mb-1">&nbsp;</label>
                                        <div class="d-flex gap-2">
                                            <button type="button" class="btn btn-primary btn-sm" onclick="loadSuppliers()">
                                                <i class="ti ti-check"></i> Apply
                                            </button>
                                            <button type="button" class="btn btn-outline-secondary btn-sm" onclick="resetFilters()">
                                                <i class="ti ti-refresh"></i> Reset
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Supplier Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table table-hover align-middle mb-0" id="supplierTable">
                                    <thead>
                                        <tr>
                                            <th class="text-muted">ID</th>
                                            <th class="text-muted">Supplier Name</th>
                                            <th class="text-muted">Contact Person</th>
                                            <th class="text-muted">Phone</th>
                                            <th class="text-muted">Email</th>
                                            <th class="text-muted">GST Number</th>
                                            <th class="text-muted">Created Date</th>
                                            <th class="text-muted">Status</th>
                                            <th class="text-muted text-end">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="supplierTableBody">
                                        <tr>
                                            <td colspan="9" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="loadSuppliers()">
                                    <option value="10">10</option>
                                    <option value="20" selected>20</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Supplier Modal (Create/Edit) -->
<div class="modal fade" id="supplierModal" tabindex="-1" aria-labelledby="supplierModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="supplierModalLabel">Add Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="supplierForm">
                    <input type="hidden" id="supplierID" name="ID_Supplier" value="0">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="supplierName" class="form-label">Supplier Name <span class="text-danger">*</span></label>
                            <input type="text" class="form-control" id="supplierName" name="SupplierName" required>
                            <div class="invalid-feedback"></div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="contactPerson" class="form-label">Contact Person</label>
                            <input type="text" class="form-control" id="contactPerson" name="ContactPerson">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="phone" class="form-label">Phone</label>
                            <input type="text" class="form-control" id="phone" name="Phone">
                        </div>
                        <div class="col-md-6 mb-3">
                            <label for="email" class="form-label">Email</label>
                            <input type="email" class="form-control" id="email" name="Email">
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label for="gstNumber" class="form-label">GST Number</label>
                            <input type="text" class="form-control" id="gstNumber" name="GSTNumber">
                        </div>
                    </div>
                    <div class="mb-3">
                        <label for="address" class="form-label">Address</label>
                        <textarea class="form-control" id="address" name="Address" rows="3"></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveSupplier()">Save Supplier</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Supplier</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this supplier?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteSupplierID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    let currentPage = 1;
    let pageSize = 20;

    // Load suppliers on page load
    document.addEventListener('DOMContentLoaded', function() {
        loadSuppliers();
        
        // Enter key search
        document.getElementById('searchText').addEventListener('keypress', function(e) {
            if (e.key === 'Enter') {
                loadSuppliers();
            }
        });
    });

    async function loadSuppliers(page = 1) {
        currentPage = page;
        pageSize = parseInt(document.getElementById('pageSize').value) || 20;
        const searchText = document.getElementById('searchText').value || '';
        const showCancelled = document.getElementById('showCancelled').value === 'true';

        const input = {
            SearchText: searchText,
            FilterSupplierIDs: '',
            ShowCancelled: showCancelled,
            PageIndex: page,
            PageSize: pageSize,
            SortColumn: '',
            SortMode: ''
        };

        try {
            const response = await fetch('/Admin/Supplier/GetSupplierList', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                throw new Error('Network response was not ok');
            }

            const data = await response.json();
            displaySuppliers(data.TableData || []);
            displayPagination(data.TableSettings);
        } catch (error) {
            console.error('Error loading suppliers:', error);
            const tbody = document.getElementById('supplierTableBody');
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="empty-state">
                        <i class="ti ti-alert-circle"></i>
                        <h5>Error loading suppliers</h5>
                        <p class="text-muted">${escapeHtml(error.message || 'An error occurred while loading suppliers. Please try again.')}</p>
                    </td>
                </tr>
            `;
        }
    }

    function displaySuppliers(suppliers) {
        const tbody = document.getElementById('supplierTableBody');
        
        if (!suppliers || suppliers.length === 0) {
            tbody.innerHTML = `
                <tr>
                    <td colspan="9" class="empty-state">
                        <i class="ti ti-package-off"></i>
                        <h5>No suppliers found</h5>
                        <p class="text-muted">Try adjusting your filters or search term</p>
                    </td>
                </tr>
            `;
            return;
        }

        tbody.innerHTML = suppliers.map(supplier => {
            const statusClass = supplier.Cancelled ? 'badge-inactive' : 'badge-active';
            const statusText = supplier.Cancelled ? 'Deleted' : 'Active';
            
            return `
                <tr>
                    <td>${supplier.ID_Supplier}</td>
                    <td>${escapeHtml(supplier.SupplierName)}</td>
                    <td>${escapeHtml(supplier.ContactPerson || '-')}</td>
                    <td>${escapeHtml(supplier.Phone || '-')}</td>
                    <td>${escapeHtml(supplier.Email || '-')}</td>
                    <td>${escapeHtml(supplier.GSTNumber || '-')}</td>
                    <td>${supplier.CreatedOn ? new Date(supplier.CreatedOn).toLocaleDateString() : '-'}</td>
                    <td>
                        <span class="badge ${statusClass}">
                            ${statusText}
                        </span>
                    </td>
                    <td class="text-end">
                        ${supplier.Cancelled ? '' : `
                            <button class="btn-action" onclick="openEditModal(${supplier.ID_Supplier})" title="Edit">
                                <i class="ti ti-edit"></i>
                            </button>
                            <button class="btn-action" onclick="openDeleteModal(${supplier.ID_Supplier})" title="Delete">
                                <i class="ti ti-trash"></i>
                            </button>
                        `}
                    </td>
                </tr>
            `;
        }).join('');
    }

    function displayPagination(settings) {
        if (!settings) return;

        const totalPages = Math.ceil(settings.TotalCount / settings.PageSize);
        const pagination = document.getElementById('pagination');
        const paginationInfo = document.getElementById('paginationInfo');

        const start = ((settings.PageIndex - 1) * settings.PageSize) + 1;
        const end = Math.min(settings.PageIndex * settings.PageSize, settings.TotalCount);
        paginationInfo.textContent = `${start} to ${end} of ${settings.TotalCount} entries`;

        let paginationHTML = '';
        
        // Previous button
        if (settings.PageIndex <= 1) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Previous</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadSuppliers(${settings.PageIndex - 1}); return false;">Previous</a>
            </li>`;
        }

        // Page numbers
        for (let i = 1; i <= totalPages; i++) {
            if (i === 1 || i === totalPages || (i >= settings.PageIndex - 1 && i <= settings.PageIndex + 1)) {
                if (i === settings.PageIndex) {
                    paginationHTML += `<li class="page-item active">
                        <span class="page-link">${i}<span class="sr-only">(current)</span></span>
                    </li>`;
                } else {
                    paginationHTML += `<li class="page-item">
                        <a class="page-link" href="#!" onclick="loadSuppliers(${i}); return false;">${i}</a>
                    </li>`;
                }
            } else if (i === settings.PageIndex - 2 || i === settings.PageIndex + 2) {
                paginationHTML += `<li class="page-item disabled"><span class="page-link">...</span></li>`;
            }
        }

        // Next button
        if (settings.PageIndex >= totalPages) {
            paginationHTML += `<li class="page-item disabled"><span class="page-link">Next</span></li>`;
        } else {
            paginationHTML += `<li class="page-item">
                <a class="page-link" href="#!" onclick="loadSuppliers(${settings.PageIndex + 1}); return false;">Next</a>
            </li>`;
        }

        pagination.innerHTML = paginationHTML;
    }

    function openCreateModal() {
        document.getElementById('supplierModalLabel').textContent = 'Add Supplier';
        document.getElementById('supplierForm').reset();
        document.getElementById('supplierID').value = '0';
    }

    async function openEditModal(supplierID) {
        try {
            const response = await fetch(`/Admin/Supplier/GetById/${supplierID}`);
            if (!response.ok) throw new Error('Failed to fetch supplier');

            const supplier = await response.json();
            
            document.getElementById('supplierModalLabel').textContent = 'Edit Supplier';
            document.getElementById('supplierID').value = supplier.ID_Supplier;
            document.getElementById('supplierName').value = supplier.SupplierName || '';
            document.getElementById('contactPerson').value = supplier.ContactPerson || '';
            document.getElementById('phone').value = supplier.Phone || '';
            document.getElementById('email').value = supplier.Email || '';
            document.getElementById('gstNumber').value = supplier.GSTNumber || '';
            document.getElementById('address').value = supplier.Address || '';
            
            const modal = new bootstrap.Modal(document.getElementById('supplierModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading supplier:', error);
            alert('Error loading supplier details.');
        }
    }

    function openDeleteModal(supplierID) {
        document.getElementById('deleteSupplierID').value = supplierID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function saveSupplier() {
        const supplierID = parseInt(document.getElementById('supplierID').value);
        const supplierName = document.getElementById('supplierName').value.trim();
        const contactPerson = document.getElementById('contactPerson').value.trim();
        const phone = document.getElementById('phone').value.trim();
        const email = document.getElementById('email').value.trim();
        const gstNumber = document.getElementById('gstNumber').value.trim();
        const address = document.getElementById('address').value.trim();

        if (!supplierName) {
            alert('Please enter supplier name.');
            return;
        }

        const input = {
            ID_Supplier: supplierID,
            SupplierName: supplierName,
            ContactPerson: contactPerson || null,
            Phone: phone || null,
            Email: email || null,
            GSTNumber: gstNumber || null,
            Address: address || null
        };

        const url = supplierID === 0 ? '/Admin/Supplier/Create' : '/Admin/Supplier/Update';

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('supplierModal'));
                modal.hide();
                loadSuppliers(currentPage);
                alert(result.ResponseMsg || 'Supplier saved successfully.');
            } else {
                if (result.errors && result.errors.length > 0) {
                    alert('Validation errors:\n' + result.errors.join('\n'));
                } else {
                    alert(result.ResponseMsg || 'Error saving supplier.');
                }
            }
        } catch (error) {
            console.error('Error saving supplier:', error);
            alert('Error saving supplier. Please try again.');
        }
    }

    async function confirmDelete() {
        const supplierID = parseInt(document.getElementById('deleteSupplierID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            ID_Supplier: supplierID,
            CancelledReason: reason
        };

        try {
            const response = await fetch('/Admin/Supplier/Delete', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadSuppliers(currentPage);
                alert(result.ResponseMsg || 'Supplier deleted successfully.');
            } else {
                alert(result.ResponseMsg || 'Error deleting supplier.');
            }
        } catch (error) {
            console.error('Error deleting supplier:', error);
            alert('Error deleting supplier. Please try again.');
        }
    }

    function resetFilters() {
        document.getElementById('searchText').value = '';
        document.getElementById('showCancelled').value = 'false';
        document.getElementById('pageSize').value = '20';
        loadSuppliers(1);
    }

    function escapeHtml(text) {
        if (!text) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
<!-- [ Main Content ] end -->
