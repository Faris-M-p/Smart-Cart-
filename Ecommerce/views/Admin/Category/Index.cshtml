@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Category Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">Category</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row" data-permission-module="Categories">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2">
                            <h5 class="mb-0">Category List</h5>
                            <button type="button" class="btn btn-primary" data-action="Create" data-bs-toggle="modal" data-bs-target="#categoryModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New Category
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <!-- Search Box -->
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search categories...">
                                </div>
                            </div>
                        </div>

                        <!-- Category Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table align-middle mb-0 admin-master-list-table" id="categoryTable">
                                    <thead>
                                        <tr>
                                            <th class="col-name">Category Name</th>
                                            <th class="col-desc">Description</th>
                                            <th class="col-status">Status</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="categoryTableBody">
                                        <tr>
                                            <td colspan="4" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                        <!-- Pagination will be generated here -->
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- Category Modal (Create/Edit) -->
<div class="modal fade" id="categoryModal" tabindex="-1" aria-labelledby="categoryModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="categoryModalLabel">Add Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="categoryForm">
                    <input type="hidden" id="categoryID" name="CategoryID" value="0">
                    <div class="mb-3">
                        <label for="categoryName" class="form-label">Category Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="categoryName" name="CategoryName" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Image</label>
                        <div class="d-flex align-items-center gap-3">
                            <div id="categoryImagePlaceholder" class="list-entity-initials list-entity-initials-lg">—</div>
                            <img id="categoryImagePreview" src="" alt="Category preview" class="list-entity-thumb list-entity-thumb-lg d-none">
                            <div>
                                <input type="file" class="form-control" id="categoryImage" accept=".jpg,.jpeg,.png,.webp">
                                <div class="form-text">Allowed: jpg, jpeg, png, webp. Max 2MB.</div>
                                <button type="button" class="btn btn-sm btn-outline-danger mt-2 d-none" id="btnRemoveCategoryImage" onclick="clearCategoryImage()">Remove image</button>
                            </div>
                        </div>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="categoryIsActive" checked>
                        <label class="form-check-label" for="categoryIsActive">Status (active)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveCategory()">Save Category</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete Category</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this category?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteCategoryID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let paginationInstance = null;
    let searchTimeout = null;

    const TABLE_BODY_ID = 'categoryTableBody';
    const TABLE_COLUMN_COUNT = 4;

    // 2. API Endpoints
    const API = {
        getList: '/Admin/Category/GetCategoryList',
        getById: '/Admin/Category/GetById',
        create: '/Admin/Category/Create',
        update: '/Admin/Category/Update',
        delete: '/Admin/Category/Delete'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: 'pagination',
            infoId: 'paginationInfo',
            onPageChange: loadCategories
        });

        document.getElementById('searchText').addEventListener('input', handleSearch);
        document.getElementById('categoryImage').addEventListener('change', previewCategoryImage);
        document.getElementById('categoryName').addEventListener('input', refreshCategoryPlaceholder);
        loadCategories();
    });

    let removeCategoryImage = false;

    function nameInitials(name) {
        const text = String(name || '').trim();
        return text ? text.substring(0, 2) : '—';
    }

    function renderListThumb(imageUrl, name) {
        const media = imageUrl
            ? `<img src="${escapeAttr(imageUrl)}" alt="" class="list-entity-thumb">`
            : `<span class="list-entity-initials">${escapeHtml(nameInitials(name))}</span>`;
        return `<div class="list-entity-cell">${media}<span class="list-entity-name" title="${escapeAttr(name)}">${escapeHtml(name)}</span></div>`;
    }

    function resetCategoryImage() {
        removeCategoryImage = false;
        document.getElementById('categoryImage').value = '';
        setCategoryImagePreview('');
    }

    function setCategoryImagePreview(url) {
        const preview = document.getElementById('categoryImagePreview');
        const placeholder = document.getElementById('categoryImagePlaceholder');
        const removeBtn = document.getElementById('btnRemoveCategoryImage');
        if (url) {
            preview.src = url;
            preview.classList.remove('d-none');
            placeholder.classList.add('d-none');
            removeBtn.classList.remove('d-none');
            return;
        }
        preview.src = '';
        preview.classList.add('d-none');
        placeholder.classList.remove('d-none');
        placeholder.textContent = nameInitials(document.getElementById('categoryName').value);
        removeBtn.classList.add('d-none');
    }

    function previewCategoryImage() {
        const file = document.getElementById('categoryImage').files?.[0];
        if (!file) {
            return;
        }
        removeCategoryImage = false;
        setCategoryImagePreview(URL.createObjectURL(file));
        document.getElementById('btnRemoveCategoryImage').classList.remove('d-none');
    }

    function clearCategoryImage() {
        document.getElementById('categoryImage').value = '';
        removeCategoryImage = true;
        setCategoryImagePreview('');
    }

    function refreshCategoryPlaceholder() {
        if (document.getElementById('categoryImagePreview').classList.contains('d-none')) {
            document.getElementById('categoryImagePlaceholder').textContent =
                nameInitials(document.getElementById('categoryName').value);
        }
    }

    // 4. Event Handlers
    function handleSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
            loadCategories(1);
        }, 500);
    }

    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        loadCategories(1);
    }

    // 5. Listing API
    async function loadCategories(page = 1) {
        currentPage = page;

        const input = {
            searchText: document.getElementById('searchText').value || '',
            filterCategoryIDs: '',
            pageIndex: currentPage,
            pageSize: pageSize,
            sortColumn: 0,
            sortMode: ''
        };

        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'Category List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const data = result?.data;

            if (!data?.tableData?.length) {
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
                return;
            }

            displayCategories(data.tableData);

            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(data.tableSettings);
            }
        } catch (error) {
            listing.handleListingError(
                'Category List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displayCategories(categories) {
        const tableBody = document.getElementById(TABLE_BODY_ID);
        tableBody.innerHTML = categories.map(category => createCategoryRow(category)).join('');
        initTableTooltips(tableBody);
    }

    // 7. Row Creation
    function createCategoryRow(category) {
        const isActive = category.isActive ?? category.IsActive ?? true;
        const badgeClass = isActive ? 'bg-success' : 'bg-danger';
        const statusText = isActive ? 'Active' : 'Inactive';
        const nameRaw = category.categoryName || category.CategoryName || '';
        const descRaw = category.description || category.Description || '';
        const categoryID = category.categoryID ?? category.CategoryID;

        return `
            <tr>
                <td class="col-name">${renderListThumb(category.imageUrl || category.ImageUrl || '', nameRaw)}</td>
                <td class="col-desc">${truncatedCellHtml(descRaw)}</td>
                <td class="col-status">
                    <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip" data-bs-placement="top">${statusText}</span>
                </td>
                <td class="col-actions">
                    ${category.cancelled ? '' : `
                        <div class="table-actions">
                        <button type="button" class="btn-action" data-action="Edit" onclick="openEditModal(${categoryID})" title="Edit" data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="ti ti-edit"></i>
                        </button>
                        <button type="button" class="btn-action" data-action="Delete" onclick="openDeleteModal(${categoryID})" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top">
                            <i class="ti ti-trash"></i>
                        </button>
                        </div>
                    `}
                </td>
            </tr>
        `;
    }

    // 8. Create / Edit
    function openCreateModal() {
        document.getElementById('categoryModalLabel').textContent = 'Add Category';
        document.getElementById('categoryForm').reset();
        document.getElementById('categoryID').value = '0';
        document.getElementById('categoryIsActive').checked = true;
        resetCategoryImage();
    }

    async function openEditModal(categoryID) {
        try {
            const response = await fetch(`${API.getById}/${categoryID}`);
            if (!response.ok) throw new Error('Failed to fetch category');

            const data = await response.json();
            const category = data.tableData?.[0] ?? data.TableData?.[0] ?? data;
            const cid = category.categoryID ?? category.CategoryID ?? 0;
            if (!category || cid <= 0) {
                throw new Error('Category not found');
            }
            
            document.getElementById('categoryModalLabel').textContent = 'Edit Category';
            document.getElementById('categoryID').value = String(cid);
            document.getElementById('categoryName').value = category.categoryName || category.CategoryName || '';
            document.getElementById('description').value = category.description || category.Description || '';
            document.getElementById('categoryIsActive').checked =
                (category.isActive ?? category.IsActive ?? true) === true;
            resetCategoryImage();
            setCategoryImagePreview(category.imageUrl || category.ImageUrl || '');
            
            const modal = new bootstrap.Modal(document.getElementById('categoryModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading category:', error);
            showError('Error', 'Error loading category details.');
        }
    }

    async function saveCategory() {
        const categoryID = parseInt(document.getElementById('categoryID').value);
        const categoryName = document.getElementById('categoryName').value.trim();
        const description = document.getElementById('description').value.trim();

        if (!categoryName) {
            showWarning('Validation Error', 'Please enter category name.');
            return;
        }

        const formData = new FormData();
        formData.append('CategoryID', String(categoryID));
        formData.append('CategoryName', categoryName);
        formData.append('Description', description);
        formData.append('IsActive', document.getElementById('categoryIsActive').checked ? 'true' : 'false');
        formData.append('RemoveImage', removeCategoryImage ? 'true' : 'false');
        const imageFile = document.getElementById('categoryImage').files?.[0];
        if (imageFile) {
            formData.append('CategoryImage', imageFile);
        }

        const url = categoryID === 0 ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                body: formData
            });

            if (!response.ok) {
                handleApiError?.('failure', 'Category Save', { url, method: 'POST', payload: { categoryID, categoryName }, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('categoryModal'));
                modal.hide();
                loadCategories(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Category saved successfully.');
            } else {
                handleApiError?.('failure', 'Category Save (business)', { url, method: 'POST', payload: { categoryID, categoryName }, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error saving category.');
            }
        } catch (error) {
            console.error('Error saving category:', error);
            handleApiError?.('crash', 'Category Save', { url, method: 'POST', payload: { categoryID, categoryName }, error });
            showError('Error', 'Error saving category. Please try again.');
        }
    }

    // 9. Delete
    function openDeleteModal(categoryID) {
        document.getElementById('deleteCategoryID').value = categoryID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function confirmDelete() {
        const categoryID = parseInt(document.getElementById('deleteCategoryID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            categoryID: categoryID,
            cancelledReason: reason
        };

        try {
            const url = API.delete;
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'Category Delete', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadCategories(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Category deleted successfully.');
            } else {
                handleApiError?.('failure', 'Category Delete (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error deleting category.');
            }
        } catch (error) {
            console.error('Error deleting category:', error);
            handleApiError?.('crash', 'Category Delete', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error deleting category. Please try again.');
        }
    }

    // 10. Page-specific Helper Functions
    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '...' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
  


</script>
