@model Ecommerce.Models.Admin.UserRoleModel.UserRole?
@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
    var isBlocked = ViewBag.IsBlocked == true;
    var blockedMessage = ViewBag.BlockedMessage as string ?? "This system role cannot be modified.";
    var roleId = Model?.UserRoleID ?? 0;
    var roleName = Model?.RoleName ?? string.Empty;
    var roleDescription = Model?.Description ?? string.Empty;
    var selectedPermissionIds = Model?.SelectedPermissionIds ?? new List<int>();
}

<style>
    .permission-mapping-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        margin-bottom: 1rem;
    }

    .permission-mapping-search {
        max-width: 320px;
        min-width: 220px;
    }

    .permission-tree {
        display: flex;
        flex-direction: column;
        gap: 1.15rem;
    }

    .permission-tree-node.search-hidden {
        display: none;
    }

    .permission-tree-node.is-collapsed > .permission-tree-children {
        display: none;
    }

    .permission-tree-row {
        display: flex;
        align-items: center;
        gap: 0.45rem;
        min-height: 2rem;
    }

    .permission-tree-toggle {
        width: 1.35rem;
        height: 1.35rem;
        padding: 0;
        border: 0;
        background: transparent;
        color: #6c757d;
        line-height: 1;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .permission-tree-toggle i {
        font-size: 1rem;
    }

    .permission-tree-toggle.is-leaf {
        visibility: hidden;
    }

    .permission-tree-children {
        margin-left: 1.15rem;
        padding-left: 0.9rem;
        border-left: 1px solid #e9ecef;
    }

    .permission-tree-group > .permission-tree-row {
        font-weight: 600;
        margin-bottom: 0.2rem;
    }

    .permission-tree-feature > .permission-tree-row {
        font-weight: 500;
    }

    .permission-tree-leaf > .permission-tree-row {
        font-weight: 400;
    }

    .permission-tree-row .form-check {
        margin-bottom: 0;
        min-height: auto;
        display: flex;
        align-items: center;
        gap: 0.4rem;
    }

    .permission-tree-row .form-check-input {
        margin-top: 0;
    }

    .permission-mapping-actions {
        display: flex;
        justify-content: flex-end;
        gap: 0.75rem;
        margin-top: 1.25rem;
        padding-top: 1rem;
        border-top: 1px solid #edf1f5;
    }

    .permission-mapping-error {
        min-height: 1.25rem;
    }
</style>

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">Permission Mapping</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="/Admin/UserRole">User Roles</a></li>
                    <li class="breadcrumb-item" aria-current="page">Permission Mapping</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

@if (isBlocked)
{
    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="alert alert-warning mb-3">@blockedMessage</div>
                    <a href="/Admin/UserRole" class="btn btn-secondary">Back to User Roles</a>
                </div>
            </div>
        </div>
    </div>
}
else
{
    <div class="row">
        <div class="col-12">
            <div class="card mb-3">
                <div class="card-body">
                    <h5 class="mb-2">Permission Mapping</h5>
                    <div class="mb-1"><strong>Role:</strong> @roleName</div>
                    <div class="text-muted">
                        <strong>Description:</strong>
                        @(string.IsNullOrWhiteSpace(roleDescription) ? "—" : roleDescription)
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        <div class="col-12">
            <div class="card">
                <div class="card-body">
                    <div class="permission-mapping-toolbar">
                        <div class="form-check">
                            <input class="form-check-input" type="checkbox" id="selectAllPermissions">
                            <label class="form-check-label fw-semibold" for="selectAllPermissions">Select All Permissions</label>
                        </div>
                        <div class="input-group permission-mapping-search">
                            <span class="input-group-text"><i class="ti ti-search"></i></span>
                            <input type="search" id="permissionSearch" class="form-control" placeholder="Search permissions...">
                        </div>
                    </div>
                    <div class="invalid-feedback d-block permission-mapping-error" id="permissionTreeError"></div>
                    <div id="permissionTree">
                        <div class="text-center py-5">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    </div>
                    <div class="permission-mapping-actions">
                        <a href="/Admin/UserRole" class="btn btn-secondary">Cancel</a>
                        <button type="button" class="btn btn-primary" onclick="savePermissions()">Save Permissions</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@if (!isBlocked)
{
<script>
    const permissionUserRoleId = @roleId;
    const existingPermissionIds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(selectedPermissionIds));
    let permissionTreeBound = false;

    const API = {
        getTree: '/Admin/UserRole/GetPermissionTree',
        save: '/Admin/UserRole/SavePermissions'
    };

    document.addEventListener('DOMContentLoaded', function () {
        loadPermissionTree();
    });

    async function loadPermissionTree() {
        const container = document.getElementById('permissionTree');
        const listing = window.emptyState;
        const url = API.getTree;
        container.dataset.listingLoading = 'true';
        container.innerHTML = `
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Loading...</span>
                </div>
            </div>
        `;

        try {
            const response = await fetch(url);
            const modules = await response.json();

            if (!response.ok || modules?.success === false) {
                listing.handleListingError(
                    'Permission Tree Load',
                    { url, method: 'GET', response, result: modules },
                    null,
                    6,
                    'permissionTree'
                );
                return;
            }

            const tree = Array.isArray(modules) ? modules : [];
            renderPermissionTree(tree);
            bindPermissionTreeEvents();
            setSelectedPermissionIds(existingPermissionIds);
        } catch (error) {
            listing.handleListingError(
                'Permission Tree Load',
                { url, method: 'GET', error },
                null,
                6,
                'permissionTree'
            );
        } finally {
            listing.endListingLoadInContainer('permissionTree');
        }
    }

    function renderPermissionTree(groups) {
        const container = document.getElementById('permissionTree');
        if (!groups.length) {
            emptyState.showListingEmptyInContainer('permissionTree');
            return;
        }

        container.innerHTML = `<div class="permission-tree">${groups.map(renderGroup).join('')}</div>`;
    }

    function renderGroup(group) {
        const groupKey = group.groupKey || group.GroupKey || '';
        const groupName = group.groupName || group.GroupName || '';
        const features = group.features || group.Features || [];
        const featureHtml = features.map(feature => renderFeature(feature, groupKey)).join('');

        return `
            <div class="permission-tree-node permission-tree-group" data-tree-node="group" data-group-key="${escapeAttr(groupKey)}" data-search-text="${escapeAttr(groupName.toLowerCase())}">
                <div class="permission-tree-row">
                    <button type="button" class="permission-tree-toggle" data-toggle-node aria-label="Collapse ${escapeAttr(groupName)}">
                        <i class="ti ti-chevron-down"></i>
                    </button>
                    <div class="form-check">
                        <input class="form-check-input group-check" type="checkbox" id="group_${escapeAttr(groupKey)}" data-group-key="${escapeAttr(groupKey)}">
                        <label class="form-check-label" for="group_${escapeAttr(groupKey)}">${escapeHtml(groupName)}</label>
                    </div>
                </div>
                <div class="permission-tree-children">
                    ${featureHtml}
                </div>
            </div>`;
    }

    function renderFeature(feature, groupKey) {
        const moduleId = feature.moduleID ?? feature.ModuleID;
        const moduleName = feature.displayName || feature.DisplayName || feature.moduleName || feature.ModuleName || '';
        const permissions = feature.permissions || feature.Permissions || [];
        const leaves = permissions.map(permission => renderLeaf(permission, moduleId, groupKey)).join('');

        return `
            <div class="permission-tree-node permission-tree-feature" data-tree-node="feature" data-group-key="${escapeAttr(groupKey)}" data-module-id="${moduleId}" data-search-text="${escapeAttr(moduleName.toLowerCase())}">
                <div class="permission-tree-row">
                    <button type="button" class="permission-tree-toggle" data-toggle-node aria-label="Collapse ${escapeAttr(moduleName)}">
                        <i class="ti ti-chevron-down"></i>
                    </button>
                    <div class="form-check">
                        <input class="form-check-input feature-check" type="checkbox" id="feature_${moduleId}" data-module-id="${moduleId}" data-group-key="${escapeAttr(groupKey)}">
                        <label class="form-check-label" for="feature_${moduleId}">${escapeHtml(moduleName)}</label>
                    </div>
                </div>
                <div class="permission-tree-children">
                    ${leaves}
                </div>
            </div>`;
    }

    function renderLeaf(permission, moduleId, groupKey) {
        const permissionId = permission.permissionID ?? permission.PermissionID;
        const permissionName = permission.permissionName || permission.PermissionName || '';

        return `
            <div class="permission-tree-node permission-tree-leaf" data-tree-node="leaf" data-group-key="${escapeAttr(groupKey)}" data-module-id="${moduleId}" data-search-text="${escapeAttr(permissionName.toLowerCase())}">
                <div class="permission-tree-row">
                    <button type="button" class="permission-tree-toggle is-leaf" tabindex="-1" aria-hidden="true"></button>
                    <div class="form-check">
                        <input class="form-check-input permission-check" type="checkbox"
                               id="perm_${permissionId}" value="${permissionId}"
                               data-module-id="${moduleId}" data-group-key="${escapeAttr(groupKey)}">
                        <label class="form-check-label" for="perm_${permissionId}">${escapeHtml(permissionName)}</label>
                    </div>
                </div>
            </div>`;
    }

    function bindPermissionTreeEvents() {
        const selectAll = document.getElementById('selectAllPermissions');
        const search = document.getElementById('permissionSearch');

        if (!permissionTreeBound) {
            permissionTreeBound = true;
            selectAll.addEventListener('change', function () {
                document.querySelectorAll('.permission-check').forEach(cb => { cb.checked = this.checked; });
                syncTreeChecks();
            });
            search.addEventListener('input', function () {
                filterPermissionTree(this.value);
            });
        }

        document.querySelectorAll('[data-toggle-node]').forEach(button => {
            button.addEventListener('click', function () {
                const node = this.closest('[data-tree-node]');
                if (!node || node.dataset.treeNode === 'leaf') return;
                const collapsed = node.classList.toggle('is-collapsed');
                const icon = this.querySelector('i');
                if (icon) {
                    icon.className = collapsed ? 'ti ti-chevron-right' : 'ti ti-chevron-down';
                }
            });
        });

        document.querySelectorAll('.group-check').forEach(groupCb => {
            groupCb.addEventListener('change', function () {
                document.querySelectorAll(`.permission-check[data-group-key="${this.dataset.groupKey}"]`)
                    .forEach(cb => { cb.checked = this.checked; });
                syncTreeChecks();
            });
        });

        document.querySelectorAll('.feature-check').forEach(featureCb => {
            featureCb.addEventListener('change', function () {
                document.querySelectorAll(`.permission-check[data-module-id="${this.dataset.moduleId}"]`)
                    .forEach(cb => { cb.checked = this.checked; });
                syncTreeChecks();
            });
        });

        document.querySelectorAll('.permission-check').forEach(cb => {
            cb.addEventListener('change', syncTreeChecks);
        });
    }

    function syncTreeChecks() {
        const allPerms = document.querySelectorAll('.permission-check');
        const checkedPerms = document.querySelectorAll('.permission-check:checked');
        const selectAll = document.getElementById('selectAllPermissions');
        selectAll.checked = allPerms.length > 0 && checkedPerms.length === allPerms.length;
        selectAll.indeterminate = checkedPerms.length > 0 && checkedPerms.length < allPerms.length;

        document.querySelectorAll('.feature-check').forEach(featureCb => {
            const featurePerms = document.querySelectorAll(`.permission-check[data-module-id="${featureCb.dataset.moduleId}"]`);
            const featureChecked = document.querySelectorAll(`.permission-check[data-module-id="${featureCb.dataset.moduleId}"]:checked`);
            featureCb.checked = featurePerms.length > 0 && featureChecked.length === featurePerms.length;
            featureCb.indeterminate = featureChecked.length > 0 && featureChecked.length < featurePerms.length;
        });

        document.querySelectorAll('.group-check').forEach(groupCb => {
            const groupPerms = document.querySelectorAll(`.permission-check[data-group-key="${groupCb.dataset.groupKey}"]`);
            const groupChecked = document.querySelectorAll(`.permission-check[data-group-key="${groupCb.dataset.groupKey}"]:checked`);
            groupCb.checked = groupPerms.length > 0 && groupChecked.length === groupPerms.length;
            groupCb.indeterminate = groupChecked.length > 0 && groupChecked.length < groupPerms.length;
        });
    }

    function filterPermissionTree(query) {
        const q = (query || '').trim().toLowerCase();
        const nodes = document.querySelectorAll('[data-tree-node]');

        if (!q) {
            nodes.forEach(node => node.classList.remove('search-hidden'));
            return;
        }

        nodes.forEach(node => {
            node.dataset.selfMatch = (node.dataset.searchText || '').includes(q) ? '1' : '0';
        });

        nodes.forEach(node => {
            const selfMatch = node.dataset.selfMatch === '1';
            const childMatch = !!node.querySelector('[data-tree-node][data-self-match="1"]');
            const visible = selfMatch || childMatch;
            node.classList.toggle('search-hidden', !visible);
            if (visible && node.dataset.treeNode !== 'leaf') {
                node.classList.remove('is-collapsed');
                const icon = node.querySelector(':scope > .permission-tree-row [data-toggle-node] i');
                if (icon) icon.className = 'ti ti-chevron-down';
            }
        });
    }

    function setSelectedPermissionIds(selectedIds) {
        const selected = new Set((selectedIds || []).map(Number));
        document.querySelectorAll('.permission-check').forEach(cb => {
            cb.checked = selected.has(Number(cb.value));
        });
        syncTreeChecks();
    }

    function getSelectedPermissionIds() {
        return Array.from(document.querySelectorAll('.permission-check:checked'))
            .map(cb => parseInt(cb.value, 10))
            .filter(id => id > 0);
    }

    async function savePermissions() {
        const selectedPermissionIds = getSelectedPermissionIds();
        const errorEl = document.getElementById('permissionTreeError');
        errorEl.textContent = '';

        if (!selectedPermissionIds.length) {
            errorEl.textContent = 'At least one permission must be selected.';
            showWarning('Validation Error', 'At least one permission must be selected.');
            return;
        }

        const input = {
            id_UserRole: permissionUserRoleId,
            FK_UserRole: permissionUserRoleId,
            selectedPermissionIds: selectedPermissionIds,
            PermissionIds: selectedPermissionIds
        };

        const url = API.save;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'Permission Mapping Save', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'Permissions saved successfully.');
                window.location.href = '/Admin/UserRole';
            } else {
                handleApiError?.('failure', 'Permission Mapping Save (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error saving permissions.');
            }
        } catch (error) {
            console.error(error);
            handleApiError?.('crash', 'Permission Mapping Save', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error saving permissions. Please try again.');
        }
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = String(text);
        return div.innerHTML;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }
</script>
}
