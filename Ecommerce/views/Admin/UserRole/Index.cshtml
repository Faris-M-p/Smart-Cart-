@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
    <div class="page-block">
        <div class="row align-items-center">
            <div class="col-md-12">
                <div class="page-header-title">
                    <h5 class="m-b-10">User Role Management</h5>
                </div>
                <ul class="breadcrumb">
                    <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
                    <li class="breadcrumb-item"><a href="javascript: void(0)">User Role</a></li>
                    <li class="breadcrumb-item" aria-current="page">List</li>
                </ul>
            </div>
        </div>
    </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <div class="d-flex justify-content-between align-items-center">
                            <h5>User Role List</h5>
                            <button type="button" class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#userRoleModal" onclick="openCreateModal()">
                                <i class="ti ti-plus"></i> Add New User Role
                            </button>
                        </div>
                    </div>
                    <div class="card-body pt-3">
                        <!-- Search Bar -->
                        <div class="d-flex justify-content-between align-items-center mb-3 gap-2 flex-wrap">
                            <div class="flex-grow-1 mx-3 search-input">
                                <div class="input-group">
                                    <span class="input-group-text">
                                        <i class="ti ti-search"></i>
                                    </span>
                                    <input type="text" id="searchText" class="form-control" placeholder="Search user roles...">
                                </div>
                            </div>
                        </div>

                        <!-- User Role Table -->
                        <div class="table-container">
                            <div class="table-scroll-wrapper">
                                <table class="table align-middle mb-0 admin-master-list-table" id="userRoleTable">
                                    <thead>
                                        <tr>
                                            <th class="col-name">Role Name</th>
                                            <th class="col-desc">Description</th>
                                            <th class="col-status">Status</th>
                                            <th>System Role</th>
                                            <th class="col-actions">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody id="userRoleTableBody">
                                        <tr>
                                            <td colspan="5" class="text-center py-5">
                                                <div class="spinner-border text-primary" role="status">
                                                    <span class="visually-hidden">Loading...</span>
                                                </div>
                                            </td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        </div>

                        <!-- Pagination Section -->
                        <div class="d-flex justify-content-between align-items-center mt-3 pt-3 border-top pagination-wrapper">
                            <div class="d-flex align-items-center gap-2">
                                <span class="text-muted small">Show</span>
                                <select id="pageSize" class="form-select form-select-sm" style="width: auto;" onchange="handlePageSizeChange()">
                                    <option value="10">10</option>
                                    <option value="25">25</option>
                                    <option value="50">50</option>
                                    <option value="100">100</option>
                                </select>
                                <span class="text-muted small">per page</span>
                            </div>
                            
                            <div class="d-flex align-items-center gap-3">
                                <span id="paginationInfo" class="text-muted small"></span>
                                <nav aria-label="Page navigation">
                                    <ul class="pagination pagination-sm mb-0" id="pagination">
                                    </ul>
                                </nav>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
<!-- [ Main Content ] end -->

<!-- User Role Modal (Create/Edit) -->
<div class="modal fade" id="userRoleModal" tabindex="-1" aria-labelledby="userRoleModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="userRoleModalLabel">Add User Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="userRoleForm">
                    <input type="hidden" id="userRoleID" name="UserRoleID" value="0">
                    <div class="mb-3">
                        <label for="roleName" class="form-label">Role Name <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="roleName" name="RoleName" maxlength="100" required>
                        <div class="invalid-feedback"></div>
                    </div>
                    <div class="mb-3">
                        <label for="description" class="form-label">Description</label>
                        <textarea class="form-control" id="description" name="Description" rows="3" maxlength="1000"></textarea>
                    </div>
                    <div class="mb-3 form-check form-switch">
                        <input class="form-check-input" type="checkbox" id="userRoleIsActive" checked>
                        <label class="form-check-label" for="userRoleIsActive">Status (active)</label>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-primary" onclick="saveUserRole()">Save User Role</button>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="deleteModalLabel">Delete User Role</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete this user role?</p>
                <div class="mb-3">
                    <label for="deleteReason" class="form-label">Reason for deletion</label>
                    <textarea class="form-control" id="deleteReason" rows="3" placeholder="Optional"></textarea>
                </div>
                <input type="hidden" id="deleteUserRoleID" value="0">
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="button" class="btn btn-danger" onclick="confirmDelete()">Delete</button>
            </div>
        </div>
    </div>
</div>

<script>
    // 1. Page Variables
    let currentPage = 1;
    let pageSize = 10;
    let paginationInstance = null;
    let searchTimeout = null;

    const TABLE_BODY_ID = 'userRoleTableBody';
    const TABLE_COLUMN_COUNT = 5;

    // 2. API Endpoints
    const API = {
        getList: '/Admin/UserRole/GetUserRoleList',
        getById: '/Admin/UserRole/GetById',
        create: '/Admin/UserRole/Create',
        update: '/Admin/UserRole/Update',
        delete: '/Admin/UserRole/Delete'
    };

    // 3. Page Initialization
    document.addEventListener('DOMContentLoaded', function () {
        paginationInstance = new Pagination({
            containerId: 'pagination',
            infoId: 'paginationInfo',
            onPageChange: loadUserRoles
        });

        document.getElementById('searchText').addEventListener('input', handleSearch);
        loadUserRoles();
    });

    // 4. Event Handlers
    function handleSearch() {
        clearTimeout(searchTimeout);
        searchTimeout = setTimeout(function () {
            loadUserRoles(1);
        }, 500);
    }

    function handlePageSizeChange() {
        pageSize = parseInt(document.getElementById('pageSize').value) || 10;
        loadUserRoles(1);
    }

    // 5. Listing API
    async function loadUserRoles(page = 1) {
        currentPage = page;

        const input = {
            searchText: document.getElementById('searchText').value || '',
            filterUserRoleIDs: '',
            pageIndex: currentPage,
            pageSize: pageSize,
            sortColumn: 0,
            sortMode: ''
        };

        const listing = window.emptyState;
        listing.showListingLoader(TABLE_BODY_ID, TABLE_COLUMN_COUNT);

        try {
            const response = await fetch(API.getList, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(input)
            });

            const result = await response.json();

            if (!response.ok || result?.success === false) {
                listing.handleListingError(
                    'User Role List Load',
                    { url: API.getList, method: 'POST', payload: input, response, result },
                    TABLE_BODY_ID,
                    TABLE_COLUMN_COUNT
                );
                return;
            }

            const data = result?.data;

            if (!data?.tableData?.length) {
                listing.showListingEmpty(TABLE_BODY_ID, TABLE_COLUMN_COUNT);
                return;
            }

            displayUserRoles(data.tableData);

            if (paginationInstance && data.tableSettings) {
                paginationInstance.render(data.tableSettings);
            }
        } catch (error) {
            listing.handleListingError(
                'User Role List Load',
                { url: API.getList, method: 'POST', payload: input, error },
                TABLE_BODY_ID,
                TABLE_COLUMN_COUNT
            );
        } finally {
            listing.endListingLoad(TABLE_BODY_ID);
        }
    }

    // 6. Listing Display
    function displayUserRoles(roles) {
        const tableBody = document.getElementById(TABLE_BODY_ID);
        tableBody.innerHTML = roles.map(role => createUserRoleRow(role)).join('');
        initTableTooltips(tableBody);
    }

    // 7. Row Creation
    function createUserRoleRow(role) {
        const isActive = role.isActive ?? role.IsActive ?? true;
        const isSystem = role.isSystemRole ?? role.IsSystemRole ?? false;
        const badgeClass = isActive ? 'bg-success' : 'bg-danger';
        const statusText = isActive ? 'Active' : 'Inactive';
        const nameRaw = role.roleName || role.RoleName || '';
        const descRaw = role.description || role.Description || '';
        const roleId = role.userRoleID ?? role.UserRoleID;
        const cancelled = role.cancelled ?? role.Cancelled ?? false;
        const actions = cancelled ? '' : (isSystem
            ? '<span class="badge bg-secondary" title="Protected" data-bs-toggle="tooltip" data-bs-placement="top">Protected</span>'
            : `<div class="table-actions">
                <button type="button" class="btn-action" onclick="openEditModal(${roleId})" title="Edit" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="ti ti-edit"></i>
                </button>
                <a class="btn-action" href="/admin/user-roles/${roleId}/permissions" title="Permissions" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="ti ti-key"></i>
                </a>
                <button type="button" class="btn-action" onclick="openDeleteModal(${roleId})" title="Delete" data-bs-toggle="tooltip" data-bs-placement="top">
                    <i class="ti ti-trash"></i>
                </button>
               </div>`);

        return `
            <tr>
                <td class="col-name">${truncatedCellHtml(nameRaw)}</td>
                <td class="col-desc">${truncatedCellHtml(descRaw)}</td>
                <td class="col-status">
                    <span class="badge ${badgeClass}" title="${escapeAttr(statusText)}" data-bs-toggle="tooltip" data-bs-placement="top">${statusText}</span>
                </td>
                <td>${isSystem ? 'Yes' : 'No'}</td>
                <td class="col-actions">${actions}</td>
            </tr>
        `;
    }

    // 8. Create / Edit
    function openCreateModal() {
        document.getElementById('userRoleModalLabel').textContent = 'Add User Role';
        document.getElementById('userRoleForm').reset();
        document.getElementById('userRoleID').value = '0';
        document.getElementById('userRoleIsActive').checked = true;
    }

    async function openEditModal(userRoleID) {
        try {
            const response = await fetch(`${API.getById}/${userRoleID}`);
            if (!response.ok) throw new Error('Failed to fetch user role');

            const data = await response.json();
            const role = data.tableData?.[0] ?? data.TableData?.[0] ?? data;
            const rid = role.userRoleID ?? role.UserRoleID ?? 0;
            if (!role || rid <= 0) {
                throw new Error('User role not found');
            }

            if (role.isSystemRole ?? role.IsSystemRole) {
                showWarning('Protected', 'System roles cannot be modified.');
                return;
            }

            document.getElementById('userRoleModalLabel').textContent = 'Edit User Role';
            document.getElementById('userRoleID').value = String(rid);
            document.getElementById('roleName').value = role.roleName || role.RoleName || '';
            document.getElementById('description').value = role.description || role.Description || '';
            document.getElementById('userRoleIsActive').checked =
                (role.isActive ?? role.IsActive ?? true) === true;

            const modal = new bootstrap.Modal(document.getElementById('userRoleModal'));
            modal.show();
        } catch (error) {
            console.error('Error loading user role:', error);
            showError('Error', 'Error loading user role details.');
        }
    }

    async function saveUserRole() {
        const userRoleID = parseInt(document.getElementById('userRoleID').value);
        const roleName = document.getElementById('roleName').value.trim();
        const description = document.getElementById('description').value.trim();

        if (!roleName) {
            showWarning('Validation Error', 'Please enter role name.');
            return;
        }

        const input = {
            userRoleID: userRoleID,
            roleName: roleName,
            description: description,
            isActive: document.getElementById('userRoleIsActive').checked
        };

        const isCreate = userRoleID === 0;
        const url = isCreate ? API.create : API.update;

        try {
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'User Role Save', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('userRoleModal'));
                modal.hide();

                if (isCreate) {
                    const newId = result.responseCode ?? result.ResponseCode;
                    window.location.href = `/admin/user-roles/${newId}/permissions`;
                    return;
                }

                loadUserRoles(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'User role saved successfully.');
            } else {
                handleApiError?.('failure', 'User Role Save (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error saving user role.');
            }
        } catch (error) {
            console.error('Error saving user role:', error);
            handleApiError?.('crash', 'User Role Save', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error saving user role. Please try again.');
        }
    }

    // 9. Delete
    function openDeleteModal(userRoleID) {
        document.getElementById('deleteUserRoleID').value = userRoleID;
        document.getElementById('deleteReason').value = '';
        const modal = new bootstrap.Modal(document.getElementById('deleteModal'));
        modal.show();
    }

    async function confirmDelete() {
        const userRoleID = parseInt(document.getElementById('deleteUserRoleID').value);
        const reason = document.getElementById('deleteReason').value.trim();

        const input = {
            userRoleID: userRoleID,
            cancelledReason: reason
        };

        try {
            const url = API.delete;
            const response = await fetch(url, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify(input)
            });

            if (!response.ok) {
                handleApiError?.('failure', 'User Role Delete', { url, method: 'POST', payload: input, response, result: null });
                throw new Error(`HTTP ${response.status}: ${response.statusText}`);
            }

            const result = await response.json();

            if (result.statusCode || result.StatusCode) {
                const modal = bootstrap.Modal.getInstance(document.getElementById('deleteModal'));
                modal.hide();
                loadUserRoles(currentPage);
                showSuccess('Success', result.responseMsg || result.ResponseMsg || 'User role deleted successfully.');
            } else {
                handleApiError?.('failure', 'User Role Delete (business)', { url, method: 'POST', payload: input, response, result });
                showError('Error', result.responseMsg || result.ResponseMsg || 'Error deleting user role.');
            }
        } catch (error) {
            console.error('Error deleting user role:', error);
            handleApiError?.('crash', 'User Role Delete', { url, method: 'POST', payload: input, error });
            showError('Error', 'Error deleting user role. Please try again.');
        }
    }

    // 10. Page-specific Helper Functions
    function truncateText(text, limit = 25) {
        if (!text) return '';
        const s = String(text);
        return s.length > limit ? s.substring(0, limit) + '...' : s;
    }

    function escapeAttr(text) {
        if (text == null || text === '') return '';
        return String(text)
            .replace(/&/g, '&amp;')
            .replace(/"/g, '&quot;')
            .replace(/'/g, '&#39;')
            .replace(/</g, '&lt;')
            .replace(/>/g, '&gt;');
    }

    function truncatedCellHtml(fullText, limit = 25) {
        const full = (fullText == null || fullText === undefined) ? '' : String(fullText);
        if (!full.trim()) return '<span class="text-muted">—</span>';
        const short = truncateText(full, limit);
        const display = escapeHtml(short);
        const tip = escapeAttr(full);
        return `<span class="cell-truncate" title="${tip}" data-bs-toggle="tooltip" data-bs-placement="top">${display}</span>`;
    }

    function initTableTooltips(root) {
        if (!root || typeof bootstrap === 'undefined' || !bootstrap.Tooltip) return;
        root.querySelectorAll('[data-bs-toggle="tooltip"]').forEach(function (el) {
            const existing = bootstrap.Tooltip.getInstance(el);
            if (existing) existing.dispose();
            new bootstrap.Tooltip(el);
        });
    }

    function escapeHtml(text) {
        if (text == null || text === undefined) return '';
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
    }
</script>
