@{
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<!-- [ breadcrumb ] start -->
<div class="page-header">
  <div class="page-block">
    <div class="row align-items-center">
      <div class="col-md-12">
        <div class="page-header-title"><h5 class="m-b-10">Home</h5></div>
        <ul class="breadcrumb">
          <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
          <li class="breadcrumb-item" aria-current="page">Dashboard</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
<div class="row" id="dashContent">

  <!-- KPI Cards -->
  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="mb-2 f-w-400 text-muted">Total Revenue</h6>
            <h4 class="mb-1" id="kpiRevenue"><span class="placeholder col-6"></span></h4>
            <p class="mb-0 text-muted text-sm" id="kpiRevenueMonth"></p>
          </div>
          <div class="avtar avtar-s rounded-circle bg-light-success"><i class="ti ti-currency-rupee f-20 text-success"></i></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="mb-2 f-w-400 text-muted">Total Orders</h6>
            <h4 class="mb-1" id="kpiOrders"><span class="placeholder col-4"></span></h4>
            <p class="mb-0 text-muted text-sm" id="kpiOrdersMonth"></p>
          </div>
          <div class="avtar avtar-s rounded-circle bg-light-primary"><i class="ti ti-shopping-cart f-20 text-primary"></i></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="mb-2 f-w-400 text-muted">Customers</h6>
            <h4 class="mb-1" id="kpiCustomers"><span class="placeholder col-4"></span></h4>
            <p class="mb-0 text-muted text-sm" id="kpiPending"></p>
          </div>
          <div class="avtar avtar-s rounded-circle bg-light-info"><i class="ti ti-users f-20 text-info"></i></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center">
          <div class="flex-grow-1">
            <h6 class="mb-2 f-w-400 text-muted">Products</h6>
            <h4 class="mb-1" id="kpiProducts"><span class="placeholder col-4"></span></h4>
            <p class="mb-0 text-muted text-sm" id="kpiLowStock"></p>
          </div>
          <div class="avtar avtar-s rounded-circle bg-light-warning"><i class="ti ti-box f-20 text-warning"></i></div>
        </div>
      </div>
    </div>
  </div>

  <!-- Revenue Chart (last 30 days) -->
  <div class="col-md-12 col-xl-8">
    <div class="card">
      <div class="card-header"><h5 class="mb-0">Revenue — Last 30 Days</h5></div>
      <div class="card-body"><div id="revenueChart" style="min-height:280px"></div></div>
    </div>
  </div>

  <!-- Order Status Donut -->
  <div class="col-md-12 col-xl-4">
    <div class="card h-100">
      <div class="card-header"><h5 class="mb-0">Orders by Status</h5></div>
      <div class="card-body"><div id="statusChart" style="min-height:280px"></div></div>
    </div>
  </div>

  <!-- Recent Orders Table -->
  <div class="col-12">
    <div class="card">
      <div class="card-header d-flex justify-content-between align-items-center">
        <h5 class="mb-0">Recent Orders</h5>
        <a href="/Admin/Order" class="btn btn-sm btn-outline-primary">View All</a>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>Order No.</th>
                <th>Customer</th>
                <th>Date</th>
                <th>Amount</th>
                <th>Status</th>
              </tr>
            </thead>
            <tbody id="recentOrdersBody">
              <tr><td colspan="5" class="text-center py-4"><div class="spinner-border spinner-border-sm text-primary"></div> Loading...</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

</div>
<!-- [ Main Content ] end -->

<script>
(function () {
    var revenueChart = null;
    var statusChart  = null;

    function fmt(n) {
        return '₹' + (n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    }

    function pct(cur, prev) {
        if (!prev || prev === 0) return '';
        var p = ((cur - prev) / prev * 100).toFixed(1);
        var cls = p >= 0 ? 'text-success' : 'text-danger';
        var icon = p >= 0 ? 'ti-trending-up' : 'ti-trending-down';
        return ' <small class="' + cls + '"><i class="ti ' + icon + '"></i> ' + Math.abs(p) + '% vs last month</small>';
    }

    function statusBadge(s) {
        var map = { Placed:'primary', Confirmed:'info', Shipped:'warning', Delivered:'success', Cancelled:'danger' };
        return '<span class="badge bg-' + (map[s] || 'secondary') + '">' + (s || '-') + '</span>';
    }

    function loadDashboard() {
        fetch('/Admin/Dashboard/GetStats', {
            method: 'GET',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(function(r) { return r.json(); })
        .then(function(result) {
            if (!result || !result.success) return;
            var d = result.data;

            // ── KPI Cards ──
            document.getElementById('kpiRevenue').innerHTML     = fmt(d.totalRevenue);
            document.getElementById('kpiRevenueMonth').innerHTML = 'This month: ' + fmt(d.revenueThisMonth) + pct(d.revenueThisMonth, d.revenuePrevMonth);

            document.getElementById('kpiOrders').innerText      = (d.totalOrders || 0).toLocaleString('en-IN');
            document.getElementById('kpiOrdersMonth').innerHTML = 'This month: ' + (d.ordersThisMonth || 0) + pct(d.ordersThisMonth, d.ordersPrevMonth);

            document.getElementById('kpiCustomers').innerText   = (d.totalCustomers || 0).toLocaleString('en-IN');
            document.getElementById('kpiPending').innerHTML     = '<span class="text-warning">' + (d.pendingOrders || 0) + '</span> pending orders';

            document.getElementById('kpiProducts').innerText    = (d.totalProducts || 0).toLocaleString('en-IN');
            document.getElementById('kpiLowStock').innerHTML    = '<span class="text-danger">' + (d.lowStockProducts || 0) + '</span> low / out of stock';

            // ── Revenue Chart ──
            var days   = (d.last30DaySales || []).map(function(x) { return x.date; });
            var totals = (d.last30DaySales || []).map(function(x) { return x.total; });

            if (revenueChart) { revenueChart.destroy(); }
            revenueChart = new ApexCharts(document.getElementById('revenueChart'), {
                chart : { type: 'area', height: 280, toolbar: { show: false }, zoom: { enabled: false } },
                series: [{ name: 'Revenue', data: totals }],
                xaxis : { categories: days, labels: { rotate: -45, style: { fontSize: '10px' } } },
                yaxis : { labels: { formatter: function(v) { return '₹' + v.toLocaleString('en-IN'); } } },
                colors: ['#4680ff'],
                fill  : { type: 'gradient', gradient: { shadeIntensity: 1, opacityFrom: 0.4, opacityTo: 0.05 } },
                stroke: { width: 2, curve: 'smooth' },
                tooltip: { y: { formatter: function(v) { return '₹' + v.toLocaleString('en-IN'); } } },
                dataLabels: { enabled: false },
                grid: { borderColor: '#f0f0f0' }
            });
            revenueChart.render();

            // ── Status Donut ──
            var statuses = (d.ordersByStatus || []).map(function(x) { return x.status; });
            var counts   = (d.ordersByStatus || []).map(function(x) { return x.count;  });

            if (statusChart) { statusChart.destroy(); }
            statusChart = new ApexCharts(document.getElementById('statusChart'), {
                chart  : { type: 'donut', height: 280 },
                series : counts,
                labels : statuses,
                colors : ['#4680ff','#2ca87f','#e58a00','#dc2626','#888888'],
                legend : { position: 'bottom' },
                plotOptions: { pie: { donut: { size: '65%' } } },
                dataLabels: { enabled: true, formatter: function(v, opts) { return opts.w.config.series[opts.seriesIndex]; } }
            });
            statusChart.render();

            // ── Recent Orders ──
            var rows = (d.recentOrders || []);
            document.getElementById('recentOrdersBody').innerHTML = rows.length
                ? rows.map(function(o) {
                    var dt = o.orderDate ? new Date(o.orderDate).toLocaleDateString('en-IN') : '-';
                    return '<tr>' +
                        '<td><a href="/Admin/Order">#' + (o.orderNumber || '-') + '</a></td>' +
                        '<td>' + (o.customerName || '-') + '</td>' +
                        '<td>' + dt + '</td>' +
                        '<td><strong>' + fmt(o.totalAmount) + '</strong></td>' +
                        '<td>' + statusBadge(o.orderStatus) + '</td>' +
                        '</tr>';
                }).join('')
                : '<tr><td colspan="5" class="text-center text-muted py-4">No orders yet.</td></tr>';
        })
        .catch(function(err) {
            console.error('Dashboard load error:', err);
        });
    }

    // Wait for ApexCharts to be available
    if (typeof ApexCharts !== 'undefined') {
        loadDashboard();
    } else {
        document.addEventListener('DOMContentLoaded', function() {
            var t = setInterval(function() {
                if (typeof ApexCharts !== 'undefined') {
                    clearInterval(t);
                    loadDashboard();
                }
            }, 100);
        });
    }
})();
</script>