<!-- [ breadcrumb ] start -->
<div class="page-header">
  <div class="page-block">
    <div class="row align-items-center">
      <div class="col-md-12">
        <div class="page-header-title">
          <h5 class="m-b-10">Dashboard</h5>
        </div>
        <ul class="breadcrumb">
          <li class="breadcrumb-item"><a href="/Admin/Dashboard">Home</a></li>
          <li class="breadcrumb-item" aria-current="page">Overview</li>
        </ul>
      </div>
    </div>
  </div>
</div>
<!-- [ breadcrumb ] end -->

<!-- [ Main Content ] start -->
<div class="row" data-permission-module="Dashboard" id="dashboardRoot">
  <div class="col-12 mb-3">
    <div class="d-flex align-items-center justify-content-between flex-wrap gap-2">
      <div>
        <h5 class="mb-1">Store performance</h5>
        <p class="text-muted mb-0 small" id="dashboardUpdatedAt">Loading live metrics…</p>
      </div>
      <button type="button" class="btn btn-outline-primary btn-sm" id="btnDashboardRefresh">
        <i class="ti ti-refresh"></i> Refresh
      </button>
    </div>
  </div>

  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h6 class="mb-2 f-w-400 text-muted">Online orders</h6>
            <h4 class="mb-1" id="kpiTotalOrders">—</h4>
            <p class="mb-0 text-muted text-sm"><span id="kpiOrdersToday">0</span> today · <span id="kpiPendingOrders">0</span> pending</p>
          </div>
          <div class="avtar avtar-s bg-light-primary text-primary"><i class="ti ti-shopping-cart f-18"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h6 class="mb-2 f-w-400 text-muted">Online revenue</h6>
            <h4 class="mb-1" id="kpiOnlineRevenue">—</h4>
            <p class="mb-0 text-muted text-sm"><span id="kpiOnlineRevenueToday">₹0</span> today</p>
          </div>
          <div class="avtar avtar-s bg-light-success text-success"><i class="ti ti-currency-rupee f-18"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h6 class="mb-2 f-w-400 text-muted">Catalogue</h6>
            <h4 class="mb-1" id="kpiActiveProducts">—</h4>
            <p class="mb-0 text-muted text-sm"><span id="kpiActiveSkus">0</span> SKUs · <span id="kpiSellOnlineSkus">0</span> online</p>
          </div>
          <div class="avtar avtar-s bg-light-warning text-warning"><i class="ti ti-package f-18"></i></div>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-6 col-xl-3">
    <div class="card">
      <div class="card-body">
        <div class="d-flex align-items-center justify-content-between">
          <div>
            <h6 class="mb-2 f-w-400 text-muted">Customers</h6>
            <h4 class="mb-1" id="kpiCustomers">—</h4>
            <p class="mb-0 text-muted text-sm"><span id="kpiLowStock">0</span> low-stock SKUs · POS <span id="kpiPosRevenue">₹0</span></p>
          </div>
          <div class="avtar avtar-s bg-light-danger text-danger"><i class="ti ti-users f-18"></i></div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-xl-8">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between">
        <h5 class="mb-0">Orders &amp; revenue (14 days)</h5>
      </div>
      <div class="card-body">
        <div id="chartOrderTrend" style="min-height: 360px;"></div>
      </div>
    </div>
  </div>
  <div class="col-md-12 col-xl-4">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Order status mix</h5>
      </div>
      <div class="card-body">
        <div id="chartOrderStatus" style="min-height: 360px;"></div>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-xl-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Online vs counter sales</h5>
      </div>
      <div class="card-body">
        <div id="chartSalesCompare" style="min-height: 320px;"></div>
      </div>
    </div>
  </div>
  <div class="col-md-12 col-xl-6">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Top products by quantity</h5>
      </div>
      <div class="card-body">
        <div id="chartTopProducts" style="min-height: 320px;"></div>
      </div>
    </div>
  </div>

  <div class="col-md-12 col-xl-8">
    <div class="card tbl-card">
      <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="mb-0">Recent orders</h5>
        <a href="/Admin/Order" class="btn btn-sm btn-link" data-permission="Orders.View">View all</a>
      </div>
      <div class="card-body">
        <div class="table-responsive">
          <table class="table table-hover table-borderless mb-0">
            <thead>
              <tr>
                <th>Order</th>
                <th>Customer</th>
                <th>Status</th>
                <th>Date</th>
                <th class="text-end">Amount</th>
              </tr>
            </thead>
            <tbody id="recentOrdersBody">
              <tr>
                <td colspan="5" class="text-muted text-center py-4">Loading…</td>
              </tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
  <div class="col-md-12 col-xl-4">
    <div class="card">
      <div class="card-header d-flex align-items-center justify-content-between flex-wrap gap-2">
        <h5 class="mb-0">Low stock alert</h5>
        <a href="/Admin/Inventory" class="btn btn-sm btn-link" data-permission="Stock.View">Inventory</a>
      </div>
      <div class="card-body p-0">
        <div class="list-group list-group-flush" id="lowStockList">
          <div class="list-group-item text-muted text-center py-4">Loading…</div>
        </div>
      </div>
    </div>
  </div>

  <div class="col-12">
    <div class="card">
      <div class="card-header">
        <h5 class="mb-0">Quick actions</h5>
      </div>
      <div class="card-body">
        <div class="d-flex flex-wrap gap-2">
          <a href="/Admin/Order" class="btn btn-outline-primary" data-permission="Orders.View"><i class="ti ti-truck-delivery"></i> Orders</a>
          <a href="/Admin/Product" class="btn btn-outline-primary" data-permission="Products.View"><i class="ti ti-box"></i> Products</a>
          <a href="/Admin/Inventory" class="btn btn-outline-primary" data-permission="Stock.View"><i class="ti ti-stack-2"></i> Inventory</a>
          <a href="/Admin/Purchase" class="btn btn-outline-primary" data-permission="Purchases.View"><i class="ti ti-file-invoice"></i> Purchases</a>
          <a href="/Admin/Homepage" class="btn btn-outline-primary" data-permission="Homepage.View"><i class="ti ti-layout-dashboard"></i> Homepage</a>
          <a href="/Admin/Sale" class="btn btn-outline-primary" data-permission="Sales.View"><i class="ti ti-receipt"></i> Counter sales</a>
        </div>
      </div>
    </div>
  </div>
</div>
<!-- [ Main Content ] end -->

@section Scripts {
  <script src="/Admin/assets/js/pages/dashboard-smartcart.js"></script>
}
