// Modules(ID_Module, ModuleName, DisplayName, DisplayOrder, IsActive, Cancelled)
// 1, 'Dashboard', 'Dashboard', 10, true, false
// 2, 'Categories', 'Categories', 20, true, false
// 3, 'SubCategories', 'Sub Categories', 30, true, false
// 4, 'Brands', 'Brands', 40, true, false
// 5, 'Products', 'Products', 50, true, false
// 6, 'Suppliers', 'Suppliers', 90, true, false
// 7, 'Purchases', 'Purchases', 100, true, false
// 8, 'Orders', 'Orders', 120, true, false

// Seed Roles
// UserRoles(ID_UserRole, RoleName, Description, IsSystemRole, IsActive, Cancelled)
// 1, 'Admin', 'System Administrator with complete access', true, true, false

// Seed Admin Users
// AdminUsers(ID_AdminUser, FK_UserRole, UserName, FullName, Email, IsActive, Cancelled)
// 1, 1, 'admin', 'System Administrator', 'admin@smartcart.local', true, false

// Sample Customer
// Users(UserId, UserName, FullName, Email, IsAdmin, Cancelled)
// 1, 'customer1', 'John Doe', 'john.doe@example.com', false, false
